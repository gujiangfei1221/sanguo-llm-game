actionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":38605,"turn":14,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，天人共愤，孤与吴侯唇齿相依，今再续同盟，共举义兵讨逆，兴复汉室！ 决策理由：接受东吴同盟提议，巩固联吴抗曹大局，开发江州农业，积攒军资粮草，为后续北伐讨曹做准备。；密谋揭晓：准备守约"},{"id":38606,"turn":14,"type":"decision_revealed","factionId":"wu","message":"吴：许昌围城逾两旬，今举柴桑全军攻关，一鼓而下！蜀吴新盟已立，曹贼亡在旦夕！ 决策理由：围许昌已及三分之二，若不持续施压则进度衰减、前功尽弃。魏库存连番溢出，资源紧张，许昌城防未复仅余七兵，正可乘之机。举柴桑十营全力攻关，期一鼓破城。；密谋揭晓：准备守约"},{"id":38607,"turn":14,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":38608,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":38609,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":38610,"turn":14,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":38611,"turn":14,"type":"develop_city","factionId":"shu","message":"蜀 将江州建设为农桑专精 2 级"},{"id":38612,"turn":14,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":38613,"turn":14,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 6，守方损失 5，围城进度升至 3/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":10}},{"id":38614,"turn":15,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":38615,"turn":15,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 8 金、0 粮"},{"id":38616,"turn":15,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、9 粮"},{"id":38617,"turn":15,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 21 金、0 粮"},{"id":38618,"turn":15,"type":"turn_prepared","factionId":null,"message":"第 15 回合（争锋阶段）收入与维持已结算"},{"id":38619,"turn":15,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原根本，今加筑城防以御吴军。关羽乃当世虎将，孤素爱之，愿以礼相待，共图大业。 决策理由：许昌围城已满，虽当前守军可挡吴军，但城防未修，必须加固以防后续猛攻。宛城暂无陷落风险。尝试招降关羽，若成则大增实力，不成亦无损。；密谋揭晓：无隐秘意图"},{"id":38620,"turn":15,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，天人共愤。孤与吴侯唇齿相依，同盟既立，今整兵补强汉中门户，共践讨曹逆之约，兴复汉室指日可待。 决策理由：汉中为蜀汉北伐咽喉，当前魏驻宛城兵力可威胁汉中失陷，故征兵增强守备。接受东吴共同伐魏提议，巩固吴蜀同盟，坚持联吴抗曹国策，牵制魏军配合吴军攻取许昌。；密谋揭晓：准备守约"},{"id":38621,"turn":15,"type":"decision_revealed","factionId":"wu","message":"吴：围许昌累月，兵损而城未下。今厚集柴桑之师，待时一鼓而破，与蜀共图中原。 决策理由：前番攻关皆因兵少而顿，攻许昌连番受挫、损兵过半却不能下。今征募柴桑五营厚集前线，备下回合举全军全力攻关，一举而下。维持与蜀盟约，续图曹魏，不受魏停战之诱。；密谋揭晓：准备守约"},{"id":38622,"turn":15,"type":"character_recruited","factionId":"wei","message":"关羽接受招降，转投魏"},{"id":38623,"turn":15,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":38624,"turn":15,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":38625,"turn":15,"type":"fortify","factionId":"wei","message":"魏 加固了许昌城防"},{"id":38626,"turn":15,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":38627,"turn":16,"type":"siege_decayed","factionId":"shu","message":"蜀 对宛城的围城进度衰减"},{"id":38628,"turn":16,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 4 金、0 粮"},{"id":38629,"turn":16,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、33 粮"},{"id":38630,"turn":16,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 11 金、0 粮"},{"id":38631,"turn":16,"type":"turn_prepared","factionId":null,"message":"第 16 回合（争锋阶段）收入与维持已结算"},{"id":38632,"turn":16,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原根本，孤亲督守备。今增兵固城，吴军若再来，必令其铩羽而归。蜀汉若明智，当思吴人野心，勿为前驱。 决策理由：吴军围许昌已久，柴桑重兵压境，许昌若失则根基动摇，故优先募兵补防。宛城虽受蜀军威胁，但尚可支撑，且已向蜀提议停战以缓压力。；密谋揭晓：无隐秘意图"},{"id":38633,"turn":16,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，天人共愤。蜀吴同盟既立，备今尽起汉中之师征伐宛城，与吴侯共讨逆贼，兴复汉室！ 决策理由：践行吴蜀联合伐魏之约，出兵进攻宛城牵制曹魏西线主力，配合吴军攻取许昌，坚持联吴抗曹的既定国策。；密谋揭晓：准备守约"},{"id":38634,"turn":16,"type":"decision_revealed","factionId":"wu","message":"吴：许昌围城已久，曹贼屡施离间之计，权岂受惑！今举柴桑全军攻关，克此中原根本，与皇叔共图曹魏！ 决策理由：围许昌进度已满3/3，合法行动白名单仅攻关与攻江州（须背盟）两项可选。背盟攻江州损声威且开树敌，得不偿失；攻关许昌正当其时。魏军连番库存溢出、士气低落，许昌仅7守军城防1级，集全军9兵攻关可期一鼓而下，兑现吴蜀讨曹之约。；密谋揭晓：准备守约"},{"id":38635,"turn":16,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 3 兵力"},{"id":38636,"turn":
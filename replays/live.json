,{"id":40898,"turn":1,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":40899,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 1 级"},{"id":40900,"turn":1,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 1 级"},{"id":40901,"turn":1,"type":"transfer","factionId":"wei","message":"魏 从洛阳向宛城调动 7 兵力","payload":{"sourceCityId":"luoyang","targetCityId":"wancheng","troops":7}},{"id":40902,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":40903,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：孙权将军，曹某已率宛城之师攻汉中。愿吴军自柴桑北上，共分蜀地。 决策理由：宛城兵力充足，趁蜀军未备直取汉中；同时再邀吴共击，避免两线受敌。；密谋揭晓：准备守约"},{"id":40904,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室后裔，曹操窃国篡权，愿与吴侯结为同盟，共讨汉贼，匡扶汉室，二国同休共戚，永不为敌。 决策理由：曹魏势大侵我汉中前线，二弱合势方可对抗强敌，升级汉中军事专精巩固边防，接受东吴结盟邀约，重申联合攻魏之议，符合联弱抗强、兴复汉室的既定战略。；密谋揭晓：准备守约"},{"id":40905,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，先固根本。曹公厚意权已心领，然蜀吴唇齿相依，不宜轻动干戈。容权整军经年，再议大计。 决策理由：柴桑为江东门户，驻军8略显单薄，本回合全力征兵至14，强化抗曹抗蜀双线防御根基。魏蜀皆邀约攻伐对方，皆拒之，待局势明朗再做决断。；密谋揭晓：无隐秘意图"},{"id":40906,"turn":2,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":40907,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":40908,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":40909,"turn":2,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 2 级"},{"id":40910,"turn":2,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":40911,"turn":2,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 5 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":14}},{"id":40912,"turn":2,"type":"character_captured","factionId":"wei","message":"关羽在城破后被魏俘虏"},{"id":40913,"turn":3,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":40914,"turn":3,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":40915,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":40916,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：关将军乃当世虎将，曹某敬其忠义，今释归蜀以表诚意。盼刘备将军念汉室大义，与魏罢兵修好，共御东吴。 决策理由：许昌急需补兵防吴，释放关羽可缓和蜀魏战事，争取时间稳定汉中，避免两线受敌。；密谋揭晓：无隐秘意图"},{"id":40917,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：曹孟德篡汉夺我汉中，虏我关云长，我与吴侯唇齿相依，愿共举义兵共讨汉贼，匡扶汉室同享太平。 决策理由：曹魏侵占我汉中前线，俘虏大将关羽，威胁益州根本。本回合征兵整备，邀约同盟东吴共伐汉贼，延续联弱抗强、兴复汉室的既定战略。；密谋揭晓：准备守约"},{"id":40918,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：江东防务既固，已与蜀汉约为唇齿之盟。曹操新克汉中，士卒疲敝，此正可乘之时。愿与刘皇叔共议进兵之期，协力破曹。 决策理由：建业为都城，本回合征兵5以固根本，驻军升至13。柴桑前哨14兵已稳，无需再加。乘魏新占汉中、许昌空虚之机，向蜀提议联合攻魏，为下回合协同出兵、共分魏地早作准备。；密谋揭晓：准备守约"},{"id":40919,"turn":3,"type":"character_released","factionId":"wei","message":"魏释放了关羽，声望提升"},{"id":40920,"turn":3,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":40921,"turn":3,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":40922,"turn":3,"type":"recruit","factionId":"wu","message":"吴 在建业征募 5 兵力"},{"id":40923,"turn":3,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":40924,"turn":3,"type":"recruit","factionId":"shu","message":"蜀 在成都征募 5 兵力"},{"id":40925,"turn":4,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":40926,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":40927,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：孙将军，魏吴本无宿怨，操愿与江东结好，共谋天下太平。汉中乃蜀军必攻之地，操已严阵以待。 决策理由：宛城兵力单薄，本回合征兵加强第二道防线；同时向吴示好，尝试离间蜀吴同盟，为后续战略争取空间。；密谋揭晓：无隐秘意图"},{"id":40928,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡夺汉室，窃我汉中，今我与吴侯同心缔盟，共讨汉贼，匡扶汉室，指日可待！ 决策理由：曹魏侵占我方汉中，威胁益州根本，今吴邀约共伐汉贼，我顺应同盟之约出兵反攻汉中，符合联弱抗曹、兴复汉室的既定战略。；密谋揭晓：准备守约"},{"id":40929,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：江东已固，柴桑军镇再升。权与刘皇叔约为唇齿之盟，下回合当共讨汉贼，克复中原。 决策理由：接受蜀联合攻魏提议。柴桑为江东门户与北伐前线，专精升至军镇二级以增强攻防。下回合以十三兵自柴桑攻许昌，与蜀协同作战，享联合进攻加成。；密谋揭晓：准备守约"},{"id":40930,"turn":4,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":40931,"turn":4,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":40932,"turn":4,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":40933,"turn":4,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":40934,"turn":4,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 2 级"},{"id":40935,"turn":4,"type":"city_captured","factionId":"shu","message":"蜀 攻占汉中，损失 5 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"wei","sourceCityId":"chengdu","targetCityId":"hanzhong","troops":12}},{"id":40936,"turn":4,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":40937,"turn":4,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":40938,"turn":5,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":40939,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":40940,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：宛城乃西面屏障，今增兵固守。吴侯若有意弃暗投明，魏吴结好，共图蜀地，操愿以诚相待。 决策理由：蜀军新据汉中，宛城兵薄恐遭夹击，故征兵加强防御，同时向吴示好以拆散蜀吴同盟。；密谋揭晓：无隐秘意图"},{"id":40941,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：备与吴侯缔盟共讨汉贼，整备益州后方，充实粮秣，同心协力匡扶汉室，克复中原指日可待。 决策理由：发展成都农业充实军粮，为即将到来的联合攻魏做好后勤准备，重申与吴的攻魏约定，信守盟约巩固同盟，符合联弱抗曹战略。；密谋揭晓：准备守约"},{"id":40942,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：江东已固，今与汉室苗裔共讨篡贼！本督亲率柴桑精兵十三万北上，直取许昌，与刘皇叔会猎中原！ 决策理由：与蜀联合攻魏之约既定，蜀已克汉中在前，吴不可再失信于盟。柴桑驻军十四，以十三兵出击许昌，留一守城；十三兵加联合加成可破许昌十三驻军。速战以免曹操从容布防。；密谋揭晓：准备守约"},{"id":40943,"turn":5,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":40944,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":40945,"turn":5,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 1 级"},{"id":40946,"turn":5,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":40947,"turn":5,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 8，守方损失 5，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":13}},{"id":40948,"turn":5,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":40949,"turn":6,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":40950,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"},{"id":40951,"turn":6,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯新败，曹某愿与江东共图蜀地。许昌已增兵固守，若吴军北上，可会猎汉中，平分益州。 决策理由：许昌为东线要冲，征兵加强防务；吴攻许昌受挫，正是离间蜀吴之时，故提议联合攻蜀以打破两线夹击之势。；密谋揭晓：准备守约"},{"id":40952,"turn":6,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室苗裔，志在讨灭篡汉逆贼曹操，今汉中前线整备已毕，愿再与吴侯同心协力，共破曹魏，匡扶汉室社稷。 决策理由：魏于宛城屯重兵，汉中本回合有被攻占风险，因此从江州调兵充实汉中防御，同时邀约东吴延续联合攻魏约定，信守盟约巩固同盟，符合联弱抗曹兴复汉室的既定战略。；密谋揭晓：准备守约"},{"id":40953,"turn":6,"type":"decision_revealed","factionId":"wu","message":"吴：周郎陨于许昌城下，江东上下同仇敌忾。权已令柴桑大举征兵，整军经武，以慰英灵，再图北伐。 决策理由：上回合攻许昌失利损兵八千、周瑜阵亡，柴桑前线亟需补充。接受蜀联合攻魏之议，本回合全力征兵7恢复柴桑至13兵，下回合以满编之势再攻城防归零之许昌，与蜀军协同作战，攻守兼备。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":40954,"turn":6,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":40955,"turn":6,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":40956,"turn":6,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 7 兵力"},{"id":40957,"turn":6,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":40958,"turn":6,"type":"transfer","factionId":"shu","message":"蜀 从江州向汉中调动 6 兵力","payload":{"sourceCityId":"jiangzhou","targetCityId":"hanzhong","troops":6}},{"id":40959,"turn":7,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":40960,"turn":7,"type":"turn_prepared","factionId":null,"message":"第 7 回合（蓄势阶段）收入与维持已结算"}],"createdAt":"2026-08-19T15:05:39.582Z","updatedAt":"2026-08-19T15:11:58.652Z","exportedAt":"2026-08-19T15:12:07.106Z"}
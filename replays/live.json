turn":17,"type":"turn_prepared","factionId":null,"message":"第 17 回合（争锋阶段）收入与维持已结算"},{"id":42385,"turn":17,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯既遣盟书，孤当允之。蜀贼窃我许昌、囚孤身，今以洛阳精兵收复许昌，与吴共讨不义！ 决策理由：接受吴国同盟，拆散吴蜀合力；趁许昌守军薄弱，以洛阳主力奇袭，力求救回曹操并重夺都城。若成，则魏复有根基，可再图中原。；密谋揭晓：准备守约"},{"id":42386,"turn":17,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，奉辞伐罪，今擒得篡汉逆曹，王师直捣洛阳，必兴复汉室，终守与吴侯同盟之约！ 决策理由：魏仅剩洛阳一城，趁其立足未稳主动出击，攻灭曹魏篡逆，信守联吴抗曹盟约，践行兴复汉室大义。；密谋揭晓：准备守约"},{"id":42387,"turn":17,"type":"decision_revealed","factionId":"wu","message":"吴：建业增兵以固江东根本；赠魏黄金二十，聊表睦邻之谊。 决策理由：建业仅1兵，征五人充实根本。魏困守洛阳，赠金二十示好，望其允同盟之议，共抗强蜀。吴蜀盟约尚存一日，信义不亏。；密谋揭晓：准备守约"},{"id":42388,"turn":17,"type":"diplomacy_response","factionId":"wei","message":"魏接受了 吴 的结盟提议"},{"id":42389,"turn":17,"type":"character_executed","factionId":"shu","message":"蜀处决了曹操，天下震动，声望大降"},{"id":42390,"turn":17,"type":"gold_offered","factionId":"wu","message":"吴向魏献上 20 金"},{"id":42391,"turn":17,"type":"recruit","factionId":"wu","message":"吴 在建业征募 5 兵力"},{"id":42392,"turn":17,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻洛阳失败，进攻方损失 3，守方损失 4","payload":{"sourceCityId":"wancheng","targetCityId":"luoyang","troops":5}},{"id":42393,"turn":17,"type":"attack_cancelled","factionId":"wei","message":"魏 的出征因来源城局势变化而取消","payload":{"sourceCityId":"luoyang","targetCityId":"xuchang","troops":10}},{"id":42394,"turn":17,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":42395,"turn":18,"type":"diplomacy_changed","factionId":null,"message":"魏 与 吴 的关系变为同盟"},{"id":42396,"turn":18,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 18 金、0 粮"},{"id":42397,"turn":18,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 6 金、8 粮"},{"id":42398,"turn":18,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、2 粮"},{"id":42399,"turn":18,"type":"turn_prepared","factionId":null,"message":"第 18 回合（争锋阶段）收入与维持已结算"},{"id":42400,"turn":18,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯既已同盟，孤当先固洛阳根本。今征兵五人以备守御，并愿与吴共约讨蜀，待兵马齐整，同取许昌、宛城，恢复汉室旧都。 决策理由：魏仅余洛阳一城，贸然出击恐折根本；先征兵固城，同时向吴提议联合攻蜀，既稳守势又谋进取。；密谋揭晓：无隐秘意图"},{"id":42401,"turn":18,"type":"decision_revealed","factionId":"shu","message":"蜀：吾乃汉室宗亲，奉辞伐罪，曹逆仅剩洛阳孤城，今王师直进，必克洛阳，兴复汉室，还于旧都！ 决策理由：魏篡汉自立，如今仅余洛阳孤城，主动出击攻灭曹魏，既解除宛城被攻占的威胁，又完成兴复汉室的大义，巩固北伐成果。；密谋揭晓：准备守约"},{"id":42402,"turn":18,"type":"decision_revealed","factionId":"wu","message":"吴：蜀负盟犯边，权顺天应人，取江州以固江东，与魏共安天下！ 决策理由：蜀势日盛，袭魏都、囚魏主，又窥江东。吴蜀盟约虽存，蜀已无信；与魏新盟已就，当先制蜀以自保。柴桑六兵南下取江州，绝蜀东进之路；余四兵守柴桑以备许昌之敌。；密谋揭晓：准备守约"},{"id":42403,"turn":18,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":42404,"turn":18,"type":"alliance_betrayed","factionId":"wu","message":"吴突然背盟，转而对蜀动手，声望大降"},{"id":42405,"turn":18,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":42406,"turn":18,"type":"city_captured","factionId":"wu","message":"吴 攻占江州，损失 2 兵力","payload":{"cityId":"jiangzhou","defenderFactionId":"shu","sourceCityId":"chaisang","targetCityId":"jiangzhou","troops":6}},{"id":42407,"turn":18,"type":"character_captured","factionId":"wu","message":"张飞在城破后被吴俘虏"},{"id":42408,"turn":18,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻洛阳失败，进攻方损失 3，守方损失 4","payload":{"sourceCityId":"xuchang","targetCityId":"luoyang","troops":5}},{"id":42409,"turn":19,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":42410,"turn":19,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、49 粮"},{"id":42411,"turn":19,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":42412,"turn":19,"type":"turn_prepared","factionId":null,"message":"第 19 回合（决战阶段）收入与维持已结算"},{"id":42413,"turn":19,"type":"decision_revealed","factionId":"wei","message":"魏：蜀贼弑孤，窃据许昌。今洛阳精兵尽出，誓复旧都！吴已伐蜀，此天时也。 决策理由：魏仅余洛阳，需趁蜀军分散夺回许昌以固根本；洛阳留一兵守城，七兵攻许昌，与吴呼应。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":42414,"turn":19,"type":"decision_revealed","factionId":"shu","message":"蜀：备为汉室宗亲，吴贼背盟投逆，窃我江州囚我翼德，今先固北伐门户，整兵备敌，终当扫灭群凶，兴复汉室。 决策理由：许昌是北伐前沿，魏屯重兵于洛阳，当前许昌守军薄弱，有被魏军攻占的风险，全额征兵充实城防，防备来犯之敌。；密谋揭晓：无隐秘意图"},{"id":42415,"turn":19,"type":"decision_revealed","factionId":"wu","message":"吴：江州既定，权当秣马厉兵，集精锐于柴桑，会同魏公共讨逆蜀。张翼德虽勇，今已就擒，当善用之。 决策理由：决战之时当集中兵力。江州新定蜀势已衰，张翼德被擒可招降以添羽翼。调江州建业精兵八人南下柴桑，汇合本镇四兵共十二人，与魏洛阳军形成钳击许昌之势。；密谋揭晓：准备守约"},{"id":42416,"turn":19,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的联合进攻提议"},{"id":42417,"turn":19,"type":"character_refused","factionId":"wu","message":"张飞拒绝吴招降，忠诚受到动摇"},{"id":42418,"turn":19,"type":"recruit","factionId":"shu","message":"蜀 在许昌征募 3 兵力"},{"id":42419,"turn":19,"type":"city_captured","factionId":"wei","message":"魏 攻占许昌，损失 3 兵力","payload":{"cityId":"xuchang","defenderFactionId":"shu","sourceCityId":"luoyang","targetCityId":"xuchang","troops":7}},{"id":42420,"turn":19,"type":"mobilize","factionId":"wu","message":"吴向柴桑战略集结 8 兵"},{"id":42421,"turn":19,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":42422,"turn":20,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":42423,"turn":20,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 10 金、50 粮"},{"id":42424,"turn":20,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":42425,"turn":20,"type":"turn_prepared","factionId":null,"message":"第 20 回合（决战阶段）收入与维持已结算"},{"id":42426,"turn":20,"type":"decision_revealed","factionId":"wei","message":"魏：魏军虽复许昌，但洛阳空虚，蜀军虎视宛城。孤先稳守，厚待关羽，再图破蜀。 决策理由：洛阳仅余一兵且面临宛城威胁，强行进攻徒耗兵力；许昌城防尚固，暂以逸待劳，待吴军配合再大举伐蜀。；密谋揭晓：无隐秘意图"},{"id":42427,"turn":20,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，志在兴复汉室，吴贼背盟投逆，窃我国土囚我翼德，今整兵固边，愿与魏公共讨吴虏，共安天下。 决策理由：宛城为我北伐门户，毗邻魏新占的许昌，征兵充实防务巩固边境。吴背盟害我，提议联魏攻吴，分化吴魏同盟，缓解我方两面受敌的困境。；密谋揭晓：准备守约"},{"id":42428,"turn":20,"type":"decision_revealed","factionId":"wu","message":"吴：魏据许昌新克未稳，权当顺天应人，一举而定中原！ 决策理由：决战之时当果断。魏困守二城，许昌新克仅四兵可守，柴桑十一精锐南下必克。虽负盟义，然联盟明日届满，势已去，不如先发制人。得许昌则金脉通、势连北地，可西图汉中。（命令非法：不能进攻盟友，改为休整）；密谋揭晓：无隐秘意图"},{"id":42429,"turn":20,"type":"joint_attack_proposed","factionId
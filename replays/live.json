ad":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":15}},{"id":25746,"turn":4,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":25747,"turn":4,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":25748,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":25749,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：宛城乃西线门户，今增兵固防，以御蜀军来犯。 决策理由：第4回合攻汉中失利，宛城兵力尚需补充。征兵5人以增强城防，确保西线稳定，待机再图汉中。；密谋揭晓：无隐秘意图"},{"id":25750,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：备与吴侯盟好共讨篡汉曹贼，今兴义师出汉中攻宛城，誓清中原，兴复汉室！ 决策理由：践行吴蜀联合攻魏盟约，攻取宛城打开进逼中原通道，削弱曹魏前线兵力，巩固同盟信任，符合联弱抗曹兴汉大义。；密谋揭晓：准备守约"},{"id":25751,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼屡犯边境，天兵再发许昌。吴蜀盟好，当共图中原，克复汉室。 决策理由：许昌城防已破，屯兵仅七，正是天赐良机。倾柴桑精锐一鼓而下，可断魏中原脊梁，迫其两线难顾。；密谋揭晓：准备守约"},{"id":25752,"turn":5,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":25753,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":25754,"turn":5,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":25755,"turn":5,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":25756,"turn":5,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 6，守方损失 5，城防降低 1 级","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":10}},{"id":25757,"turn":5,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 5，守方损失 3，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":8}},{"id":25758,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"},{"id":25759,"turn":6,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原根本，今增兵固防。孙权若愿息兵，曹操可与其共讨刘备，以安天下。 决策理由：吴蜀之盟将尽，吴屡攻许昌。先固许昌守备，再向吴提议停战，以分化吴蜀。；密谋揭晓：准备守约"},{"id":25760,"turn":6,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹贼篡汉窃据天下，今与吴侯同心缔盟，共举义兵讨伐国贼，兴复汉室指日可待！ 决策理由：曹魏屯重兵于宛城，汉中随时有被攻占风险，顺吴侯联合攻魏之议，出兵攻取宛城，践行吴蜀盟约，保卫汉室疆土。；密谋揭晓：准备守约"},{"id":25761,"turn":6,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑乃江东门户，征募精兵以厚军力，备北伐之需。吴蜀盟好，当戮力同心，共克中原。 决策理由：柴桑前线仅余四兵，征募五人以重建攻势。接受蜀联合攻魏之议，维系盟约共图中原；新提攻势以延续吴蜀合作。许昌城防空虚，正当一鼓而下之机。；密谋揭晓：准备守约"},{"id":25762,"turn":6,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":25763,"turn":6,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":25764,"turn":6,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":25765,"turn":6,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":25766,"turn":6,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":25767,"turn":6,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 3，守方损失 3，围城进度升至 1/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":4}},{"id":25768,"turn":6,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":25769,"turn":6,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":25770,"turn":7,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":25771,"turn":7,"type":"turn_prepared","factionId":null,"message":"第 7 回合（蓄势阶段）收入与维持已结算"},{"id":25772,"turn":7,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀盟约已散，孙权若愿与魏共讨刘备，许昌可罢兵言和。今先取汉中，断蜀之臂。 决策理由：宛城五兵，汉中仅两兵，攻之可断蜀军西线。许昌守备足挡吴军，且已提议吴共伐蜀，故西进攻汉中。；密谋揭晓：无隐秘意图"},{"id":25773,"turn":7,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹贼篡汉窃据神器，今与吴侯同心戮力，共举义兵讨伐国贼，增兵汉中保卫汉疆，兴复汉室之志绝不改移！ 决策理由：曹魏宛城重兵窥伺汉中，汉中城防空虚有被攻占风险，调成都主力增援汉中守备，接受吴侯联合攻魏提议，续盟吴蜀共讨曹贼，符合同盟大义与兴汉目标。；密谋揭晓：准备守约"},{"id":25774,"turn":7,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼议和乃缓兵之计，吴不受其愚。柴桑之师再发许昌，续盟攻伐之约，以安江东、靖中原。 决策理由：许昌围城进度1/3，弃攻则前功尽弃。倾柴桑8兵续攻，胜可夺魏都，败亦削敌。拒魏议和因其非诚；蜀盟虽立约已到期，当速续以固同盟基础。；密谋揭晓：准备守约"},{"id":25775,"turn":7,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":25776,"turn":7,"type":"dip
d":36166,"turn":48,"type":"decision_revealed","factionId":"wei","message":"魏：蜀主之约，孤本欲应之；然魏吴有盟，信义为重，且洛阳兵寡，实难助战。愿蜀吴各安疆界，休兵养民。 决策理由：魏仅有洛阳四兵，且与吴同盟至50回合，无法背盟攻吴；拒绝蜀联攻，维持现状，静观吴蜀相争。；密谋揭晓：无隐秘意图"},{"id":36167,"turn":48,"type":"decision_revealed","factionId":"shu","message":"蜀：吴贼背盟侵我疆土，掳我义弟张飞，残虐百姓。备奉汉室正统大义，邀魏公共讨逆贼，安靖天下，拯救生民。 决策理由：宛城当前防务空虚，确有被吴军攻占风险，调汉中合法可调兵力增援宛城巩固前线，邀约魏国共同伐吴，延续联魏抗吴的既定方略，图谋光复失地救回张飞。；密谋揭晓：准备守约"},{"id":36168,"turn":48,"type":"decision_revealed","factionId":"wu","message":"吴：宛城乃西川锁钥，吴军顺流而下，必取之以定三分之势！ 决策理由：宛城蜀兵仅一，城防空虚，集许昌五兵攻之必克。此城南通许昌、西连汉中、北接洛阳，拔之则西川门户洞开，汉中、成都皆在兵锋之下。虽江州或有蜀军袭扰，然得失相权，攻取宛城方为决战之上策。；密谋揭晓：准备守约"},{"id":36169,"turn":48,"type":"diplomacy_response","factionId":"wei","message":"魏拒绝了 蜀 的联合进攻提议"},{"id":36170,"turn":48,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":36171,"turn":48,"type":"character_refused","factionId":"wu","message":"张飞拒绝吴招降，忠诚受到动摇"},{"id":36172,"turn":48,"type":"city_captured","factionId":"wu","message":"吴 攻占宛城，损失 2 兵力","payload":{"cityId":"wancheng","defenderFactionId":"shu","sourceCityId":"xuchang","targetCityId":"wancheng","troops":5}},{"id":36173,"turn":48,"type":"transfer_cancelled","factionId":"shu","message":"蜀的调兵因战场局势变化而取消"},{"id":36174,"turn":49,"type":"ceasefire_expired","factionId":null,"message":"蜀 与 魏 的停战到期"},{"id":36175,"turn":49,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 4 金、4 粮"},{"id":36176,"turn":49,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 34 金、40 粮"},{"id":36177,"turn":49,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 11 金、14 粮"},{"id":36178,"turn":49,"type":"turn_prepared","factionId":null,"message":"第 49 回合（决战阶段）收入与维持已结算"},{"id":36179,"turn":49,"type":"decision_revealed","factionId":"wei","message":"魏：蜀主所请，孤深知其意；然魏吴同盟尚在，信义为重，不可背盟攻吴。愿与蜀各守疆界，休兵养民。 决策理由：魏吴盟约至50回合，背盟必损声望；魏仅洛阳一城、兵微粮寡，不宜再启战端。先固本休整，待盟约期满再定方略。；密谋揭晓：无隐秘意图"},{"id":36180,"turn":49,"type":"decision_revealed","factionId":"shu","message":"蜀：吴贼背盟侵我疆土，掳吾义弟张飞，残虐百姓。备奉汉室大义，愿与魏公共讨逆贼，安靖天下，拯救生民。 决策理由：东吴背盟攻占我宛城、江州，俘获张飞，威胁益州腹地。今调汉中可调兵力增援成都巩固后方，邀约魏国共同伐吴，延续联魏抗吴方略，稳固蜀汉根本。；密谋揭晓：准备守约"},{"id":36181,"turn":49,"type":"decision_revealed","factionId":"wu","message":"吴：江州西陲要冲，增兵以固根本；张飞被擒，再修书以诚相招，望其早归。 决策理由：江州守军仅一，蜀可自汉中出兵二来攻，按阈值1.1则城池必失。强征一兵使守军达二，敌无力再图，代价仅失军事专精一级。再招张飞，削蜀战力。；密谋揭晓：无隐秘意图"},{"id":36182,"turn":49,"type":"diplomacy_response","factionId":"wei","message":"魏拒绝了 蜀 的联合进攻提议"},{"id":36183,"turn":49,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":36184,"turn":49,"type":"character_recruited","factionId":"wu","message":"张飞接受招降，转投吴"},{"id":36185,"turn":49,"type":"forced_levy","factionId":"wu","message":"吴 在江州强征 1 兵力，城市发展受损"},{"id":36186,"turn":49,"type":"transfer","factionId":"shu","message":"蜀 从汉中向成都调动 2 兵力","payload":{"sourceCityId":"hanzhong","targetCityId":"chengdu","troops":2}},{"id":36187,"turn":50,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 4 金、4 粮"},{"id":36188,"turn":50,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 14 金、10 粮"},{"id":36189,"turn":50,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 11 金、14 粮"},{"id":36190,"turn":50,"type":"turn_prepared","factionId":null,"message":"第 50 回合（决战阶段）收入与维持已结算"},{"id":36191,"turn":50,"type":"decision_revealed","factionId":"wei","message":"魏：孤与吴素无相负，今愿再缔停战之约，各守疆界。蜀主所请伐吴，恕难从命。 决策理由：魏仅洛阳一城四兵，无力攻吴；与吴盟约刚满，先固守并请吴停战，避免两面受敌。拒绝蜀联攻以全信义。；密谋揭晓：暗中寻求议和"},{"id":36192,"turn":50,"type":"decision_revealed","factionId":"shu","message":"蜀：吴贼背盟侵我疆土，掳我手足，备身为汉室后裔，必讨此逆贼。今愿与魏公永修和好，共伐吴贼，安靖天下。 决策理由：汉中为益州门户，吴兵压境，城池有失陷风险，因此调成都兵力增援巩固边防；接受魏停战提议，邀约魏共伐背盟吴贼，稳固蜀汉根本。；密谋揭晓：准备守约"},{"id":36193,"turn":50,"type":"decision_revealed","factionId":"wu","message":"吴：江东整军经武，调宛城精兵至许昌，以备天时。魏吴旧好虽满，赠金以修前好，各安疆界，共抗蜀扰。 决策理由：魏吴盟约T50届满，三方关系重置。蜀势渐衰，汉中仅一兵，成都三兵，乃天赐良机。调宛城二兵至许昌，集结兵力为下回合进取汉中作准备。赠魏金二十修好，确保魏于盟后仍守中立，避免两面受敌之困。江州保持二兵不动，防蜀自成都来袭。；密谋揭晓：准备守约"},{"id":36194,"turn":50,"type":"diplomacy_response","factionId":"wei","message":"魏拒绝了 蜀 的联合进攻提议"},{"id":36195,"turn":50,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 魏 的停战提议"},{"id":36196,"turn":50,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":36197,"turn":50,"type":"gold_offered","factionId":"wu","message":"吴向魏献上 20 金"},{"id":36198,"turn":50,"type":"transfer","factionId":"shu","message":"蜀 从成都向汉中调动 2 兵力","payload":{"sourceCityId":"chengdu","targetCityId":"hanzhong","troops":2}},{"id":36199,"turn":50,"type":"transfer","factionId":"wu","message":"吴 从宛城向许昌调动 2 兵力","payload":{"sourceCityId":"wancheng","targetCityId":"xuchang","troops":2}},{"id":36200,"turn":50,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":36201,"turn":51,"type":"alliance_expired","factionId":null,"message":"魏 与 吴 的同盟到期"},{"id":36202,"turn":51,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 24 金、4 粮"},{"id":36203,"turn":51,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 14 金、10 粮"},{"id":36204,"turn":51,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 9 金、12 粮"},{"id":36205,"turn":51,"type":"turn_prepared","factionId":null,"message":"第 51 回合（决战阶段）收入与维持已结算"},{"id":36206,"turn":51,"type":"decision_revealed","factionId":"wei","message":"魏：蜀主邀我攻吴，然魏兵微地狭，不宜再启战端。孤愿与吴重修盟好，各守疆界，共安天下。 决策理由：魏仅洛阳一城四兵，无力卷入吴蜀之战；拒绝蜀国联攻以保中立，同时向吴提议结盟，稳固边防，争取喘息之机。；密谋揭晓：无隐秘意图"},{"id":36207,"turn":51,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室后裔，吴贼背盟侵我疆土、掳我手足，愿与魏公共讨逆贼，复我疆宇，安靖天下。 决策理由：延续联魏抗吴既定方略，调兵巩固成都后方，邀约魏国共伐背盟吴贼，稳固蜀汉根本。；密谋揭晓：准备守约"},{"id":36208,"turn":51,"type":"decision_revealed","factionId":"wu","message":"吴：宛城西陲要冲，增兵固守以保疆土。江东愿与魏重修旧好，各安疆界，共图久安。 决策理由：宛城守军仅一，蜀自汉中可出兵二来攻，按阈值1.1城必失；强征二兵使守军达三，敌无力再图，方保西陲门户。同时接受魏停战之请，维系中立。；密谋揭晓：准备守约"},{"id":36209,"turn":51,"type":"diplomacy_response","factionId":"wei","message":"魏拒绝了 蜀 的联合进攻提议"},{"id":36210,"turn":51,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":36211,"turn":51,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":36212,"turn":51,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的停战提议"},{"id":36213,"turn":51,"type":"alliance_proposed","factionId":"wu","message":"吴 向 魏 提议结盟"},{"id":36214,"turn":51,"type":"forced_levy","factionId":"wu","message":"吴 在宛城强征 2 兵力，城市发展受损"},{"id":36215,"turn":51,"type":"transfer","factionId":"shu","message":"蜀 从汉中向成都调动 2 兵力","payload":{"sourceCityId":"hanzhong","targetCityId":"chengdu","troops":2}},{"id":36216,"turn":52,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":36217,"turn":52,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 4 金、4 粮"},{"id":36218,"turn":52,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 14 金、10 粮"},{"id":36219,"turn":52,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 9 金、12 粮"},{"id":36220,"turn":52,"type":"turn_prepared","factionId":null,"message":"第 52 回合（决战阶段）收入与维持已结算"},{"id":36221,"turn":52,"type":"decision_revealed","factionId":"wei","message":"魏：魏吴结盟，共安疆界。蜀主所请伐吴，恕难从命。孤当休兵养民，静观其变。 决策理由：魏仅洛阳一城四兵，粮金有限，无力攻吴；与蜀停战至53、与吴停战至54，宜守不宜攻。接受吴盟可保西境，拒绝蜀联攻以免卷入战事。；密谋揭晓：无隐秘意图"},{"id":36222,"turn":52,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室大义，吴贼背盟侵疆掳弟，望魏公共举义兵，共讨逆贼，安靖天下。 决策理由：汉中为益州门户，吴兵压境本回合可能失陷，调成都援兵增援巩固边防，邀约魏国共伐背盟吴贼，延续联魏抗吴方略。；密谋揭晓：准备守约"},{"id":36223,"turn":52,"type":"decision_revealed","factionId":"wu","message":"吴：魏吴结盟，共安天下。蜀贼背盟侵我疆土、掳我将士，江东愿与魏公携手共讨逆贼。 决策理由：接受魏盟约以破魏蜀联军之谋，孤立蜀国。提议魏共伐蜀，转守为攻。休整蓄力，待机而动。；密谋揭晓：准备守约"},{"id":36224,"turn":52,"type":"diplomacy_response","factionId":"wei","message":"魏拒绝了 蜀 的联合进攻提议"},{"id":36225,"turn":52,"type":"diplomacy_response","factionId":"wei","message":"魏接受了 吴 的结盟提议"},{"id":36226,"turn":52,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":36227,"turn":52,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的结盟提议"},{"id":36228,"turn":52,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 魏 提议共同进攻 蜀"},{"id":36229,"turn":52,"type":
30108,"turn":61,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，与魏公缔盟共讨吴逆，今增兵柴桑巩固前线，誓破江东吴贼，复我汉家疆土！ 决策理由：柴桑为我攻吴前线，当前吴可集结重兵攻占柴桑，故集结汉中兵力增援巩固防线，同时提议魏联合攻吴，恪守同盟约定，防范吴进犯。；密谋揭晓：准备守约"},{"id":30109,"turn":61,"type":"decision_revealed","factionId":"wu","message":"吴：江东虎贲席卷柴桑，一雪前耻！曹公当明大势，吴蜀盟散在即，何不共谋长远？ 决策理由：柴桑仅1兵无防御，正是收复良机。建业留1兵自守，攻取柴桑可切断蜀军东进之路，夺回战略主动。许昌孤悬被围势在必失，弃之集中兵力于根本。献金魏以离间魏蜀、铺垫和谈。；密谋揭晓：暗中寻求议和"},{"id":30110,"turn":61,"type":"diplomacy_response","factionId":"wei","message":"魏接受了 蜀 的联合进攻提议"},{"id":30111,"turn":61,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":30112,"turn":61,"type":"gold_offered","factionId":"wu","message":"吴向魏献上 20 金"},{"id":30113,"turn":61,"type":"city_captured","factionId":"wei","message":"魏 攻占许昌，损失 2 兵力","payload":{"cityId":"xuchang","defenderFactionId":"wu","sourceCityId":"luoyang","targetCityId":"xuchang","troops":4}},{"id":30114,"turn":61,"type":"city_pacified","factionId":"wu","message":"柴桑多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":30115,"turn":61,"type":"city_captured","factionId":"wu","message":"吴 攻占柴桑，损失 1 兵力","payload":{"cityId":"chaisang","defenderFactionId":"shu","sourceCityId":"jianye","targetCityId":"chaisang","troops":4}},{"id":30116,"turn":61,"type":"mobilize_cancelled","factionId":"shu","message":"蜀的战略集结因战场局势变化而取消"},{"id":30117,"turn":61,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":30118,"turn":62,"type":"alliance_expired","factionId":null,"message":"蜀 与 魏 的同盟到期"},{"id":30119,"turn":62,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":30120,"turn":62,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 8 金、0 粮"},{"id":30121,"turn":62,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 35 金、53 粮"},{"id":30122,"turn":62,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 2 金、2 粮"},{"id":30123,"turn":62,"type":"turn_prepared","factionId":null,"message":"第 62 回合（决战阶段）收入与维持已结算"},{"id":30124,"turn":62,"type":"decision_revealed","factionId":"wei","message":"魏：蜀屡次联攻不践其约，同盟已散，不可再信。吴连番示好，孤愿与江东共击西蜀，以安天下。 决策理由：本回合无攻吴路线，许昌虽有威胁但宛城可募兵自固。蜀之联攻屡屡失约，再应无益；转向吴提议联合攻蜀，既可解许昌之危，又可西取汉中。；密谋揭晓：准备守约"},{"id":30125,"turn":62,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，与魏公同仇敌忾共讨吴寇，旧盟到期，愿再缔盟约，同心破吴，复安汉家社稷。 决策理由：江州遭吴军威胁，capturePossible为真，有失城风险，集结汉中兵力增援巩固前线；与魏续缔同盟，维持联魏伐吴方略，恪守同盟信义。；密谋揭晓：准备守约"},{"id":30126,"turn":62,"type":"decision_revealed","factionId":"wu","message":"吴：曹公克复旧都，孙权谨致贺忱。江东虽小，亦知天命所归，愿与魏公休战修好，共享太平。 决策理由：建业仅余1兵极危，从吴郡调3兵回防都城，使建业达4兵可保根本。魏蜀同盟本回合已到期，魏方克复许昌后战略目标已就，值此窗口提议停战。；密谋揭晓：暗中寻求议和"},{"id":30127,"turn":62,"type":"diplomacy_response","factionId":"wei","message":"魏拒绝了 蜀 的联合进攻提议"},{"id":30128,"turn":62,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":30129,"turn":62,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 魏 提议结盟"},{"id":30130,"turn":62,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 2 兵力"},{"id":30131,"turn":62,"type":"mobilize","factionId":"shu","message":"蜀向江州战略集结 3 兵"},{"id":30132,"turn":62,"type":"transfer","factionId":"wu","message":"吴 从吴郡向建业调动 3 兵力","payload":{"sourceCityId":"wujun","targetCityId":"jianye","troops":3}},{"id":30133,"turn":63,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":30134,"turn":63,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 4 金、0 粮"},{"id":30135,"turn":63,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 7 金、17 粮"},{"id":30136,"turn":63,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 2 金、2 粮"},{"id":30137,"turn":63,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 0 金、6 粮"},{"id":30138,"turn":63,"type":"turn_prepared","factionId":null,"message":"第 63 回合（决战阶段）收入与维持已结算"},{"id":30139,"turn":63,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀相争，正是我取汉中良机。宛城强征三军，下回合与吴共击西蜀，收复汉中。 决策理由：许昌受吴军威胁，暂无攻吴路线；转向联合吴国伐蜀，并强征宛城兵力以备攻取汉中。；密谋揭晓：准备守约"},{"id":30140,"turn":63,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，愿与魏公再续前盟，同心守境共安天下，今整兵汉中固境，静候魏公佳音。 决策理由：汉中当前遭魏威胁，本回合有被攻占风险，故集结兵力巩固防线；同时向魏提议续缔同盟，维持联魏方略，保障蜀境安全。；密谋揭晓：准备守约"},{"id":30141,"turn":63,"type":"decision_revealed","factionId":"wu","message":"吴：曹公明鉴，蜀贼屡负盟约，天人共弃。今与魏公携手共击西蜀，江东愿为前驱，荡平巴蜀。 决策理由：魏蜀同盟已散，蜀多次违约失信，魏主动转向联吴攻蜀，此千载良机。柴桑5兵已就位，建业4兵固守首都，无需调动。接受联合攻蜀，下回合自柴桑出兵攻江州，履行盟约以取信于魏。；密谋揭晓：准备守约"},{"id":30142,"turn":63,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的联合进攻提议"},{"id":30143,"turn":63,"type":"forced_levy","factionId":"wei","message":"魏 在宛城强征 3 兵力，城市发展受损"},{"id":30144,"turn":63,"type":"mobilize","factionId":"shu","message":"蜀向汉中战略集结 3 兵"},{"id":30145,"turn":64,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 7 金、17 粮"},{"id":30146,"turn":64,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 0 金、13 粮"},{"id":30147,"turn":64,"type":"turn_prepared","factionId":null,"message":"第 64 回合（决战阶段）收入与维持已结算"},{"id":30148,"turn":64,"type":"decision_revealed","factionId":"wei","message":"魏：孤已与吴约共击西蜀，今宛城大军西进汉中，誓复汉家疆土。 决策理由：宛城有7兵可攻汉中，吴方已接受联攻，且当前无更优路线；强攻汉中可削弱蜀军并兑现对吴承诺。；密谋揭晓：准备守约"},{"id":30149,"turn":64,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室后裔，志在安境保民。今魏吴联兵犯境，备整兵汉中固守疆土，仍愿与魏重修旧好，共息干戈，不忍生灵涂炭。 决策理由：汉中遭魏重兵威胁，本回合存在失陷风险，强征汉中兵力巩固城防，同时向魏提议结盟，试图化解魏吴联合攻蜀的危局。；密谋揭晓：无隐秘意图"},{"id":30150,"turn":64,"type":"decision_revealed","factionId":"wu","message":"吴：孙权令甘宁率柴桑精兵东出，与魏公并力夹击，一举攻取江州！ 决策理由：履行与魏联攻蜀之约。江州仅1兵1城防，柴桑4兵出击必克，可切断蜀东西联系，与魏夹击汉中形成犄角。建业4兵自守无忧，柴桑留1兵维持。；密谋揭晓：准备守约"},{"id":30151,"turn":64,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":30152,"turn":64,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 魏 提议结盟"},{"id":30153,"turn":64,"type":"forced_levy","factionId":"shu","message":"蜀 在汉中强征 3 兵力，城市发展受损"},{"id":30154,"turn":64,"type":"city_pacified","factionId":"wei","message":"汉中多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":30155,"turn":64,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 3 兵力，获得联合进攻加成","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":7}},{"id":30156,"turn":64,"type":"character_captured","factionId":"wei","message":"赵云在城破后被魏俘虏"},{"id":30157,"turn":64,"type":"city_pacified","factionId":"wu","message":"江州多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":30158,"turn":64,"type":"city_captured","factionId":"wu","message":"吴 攻占江州，损失 1 兵力，获得联合进攻加成","payload":{"cityId":"jiangzhou","defenderFactionId":"shu","sourceCityId":"chaisang","targetCityId":"jiangzhou","troops":4}},{"id":30159,"turn":64,"type":"joint_attack_honored","factionId":null,"message":"魏与吴兑现承诺，共同进攻蜀"},{"id":30160,"turn":65,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":30161,"turn":65,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":30162,"turn":65,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 20 金、55 粮"},{"id":30163,"turn":65,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":30164,"turn":65,"type":"turn_prepared","factionId":null,"message":"第 65 回合（决战阶段）收入与维持已结算"},{"id":30165,"turn":65,"type":"decision_revealed","factionId":"wei","message":"魏：吴据江州坐大，孤允蜀同盟共讨吴贼。许昌强征三军，以备东征。 决策理由：蜀弱可联，吴强须制；许昌为都且近柴桑，募兵备攻。汉中六兵自守无虞。；密谋揭晓：准备守约"},{"id":30166,"turn":65,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，志在安民，不忍蜀中百姓遭刀兵涂炭，愿献金于魏公，休兵止戈，共安苍生。 决策理由：成都遭魏吴两路夹击，本回合有失城风险，强征成都兵源巩固城防，献金于魏谋求停战，试图化解当前危局。；密谋揭晓：无隐秘意图"},{"id":30167,"turn":65,"type":"decision_revealed","factionId":"wu","message":"吴：权受曹公约，自建业调兵柴桑，西取成都以践前约。 决策理由：曹公约共击西蜀，受之。江州新定5兵1城防稳，毋动；自建业调3兵至柴桑，使柴桑达4兵1防，可攻可守。下回合联合攻蜀生效，自江州出4兵抢攻成都，与魏犄角并进一举灭蜀。履约双方得战斗加成，失约损声威。；密谋揭晓：准备守约"},{"id":30168,"turn":65,"type":"diplomacy_response","factionId":"wei","message":"魏接受了 蜀 的结盟提议"},{"id":30169,"turn":65,"type":"gold_offered","factionId":"shu","message":"蜀向魏献上 20 金"},{"id":30170,"turn":65,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的联合进攻提议"},{"id":30171,"turn":65,"type":"forced_levy","factionId":"shu","message":"蜀 在成都强征 3 兵力，城市发展受损"},{"id":30172,"turn":65,"type":"forced_levy","factionId":"wei","message":"魏 在许昌强征 3 兵力，城市发展受损"},{"id":30173,"turn":65,"type":"transfer","factionId":"wu","message":"吴 从建业向柴桑调动 3 兵力","payload":{"sourceCityId":"jianye","targetCityId":"chaisang","troops":3}},{"id":30174,"turn":66,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 魏 的关系变为同盟"},{"id":30175,"turn":66,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":30176,"turn":66,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、20 粮"},{"id":30177,"turn":66,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":30178,"turn":66,"type":"turn_prepared","factionId":null,"message":"第 66 回合（决战阶段）收入与维持已结算"},{"id":30179,"turn":66,"type":"decision_revealed","factionId":"wei","message":"魏：吴贼据柴桑阻我东进，孤今亲率许昌精兵攻之。玄德可速攻江州，两路夹击，共成霸业。 决策理由：吴军主力将攻成都，柴桑分兵可断其归路；履行与蜀联攻之约，并趁吴顾此失彼之际削弱其防线。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":30180,"turn":66,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，志在安境保民，今与魏公同盟共对强吴，整肃境内以待共讨吴寇，不使蜀中生灵涂炭。 决策理由：我方当前仅保有成都一域，按合法规则选择休整，巩固城防，维系与魏的同盟关系，静待后续战机。；密谋揭晓：无隐秘意图"},{"id":30181,"turn":66,"type":"decision_revealed","factionId":"wu","message":"吴：闻曹公与蜀修好，江东自当整军戒备，以固疆土。 决策理由：魏蜀突结同盟，联攻蜀之约已名存实亡。柴桑面临许昌魏军直接威胁，自江州调4兵回援，使柴桑兵力充实以备不测。江州留1兵凭1级城防仍可自保。；密谋揭晓：无隐秘意图"},{"id":30182,"turn":66,"type":"attack_repulsed","factionId":"wei","message":"魏 进攻柴桑失败，进攻方损失 3，守方损失 2，城防降低 1 级","payload":{"sourceCityId":"xuchang","targetCityId":"chaisang","troops":4}},{"id":30183,"turn":66,"type":"transfer","factionId":"wu","message":"吴 从江州向柴桑调动 4 兵力","payload":{"sourceCityId":"jiangzhou","targetCityId":"chaisang","troops":4}},{"id":30184,"turn":66,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":30185,"turn":67,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 3 金、4 粮"},{"id":30186,"turn":67,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、8 粮"},{"id":30187,"turn":67,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":30188,"turn":67,"type":"turn_prepared","factionId":null,"message":"第 67 回合（决战阶段）收入与维持已结算"},{"id":30189,"turn":67,"type":"decision_revealed","factionId":"wei","message":"魏：吴师压境，孤已调汉中劲旅驰援许昌。子龙乃当世虎将，若肯归顺，必以国士待之。愿与吴各守疆界，共息兵戈。 决策理由：许昌为都且面临吴军直接威胁，故从汉中调兵回防；同时尝试招降赵云以增强实力。若吴不攻，则下回合可据许昌重兵反制柴桑。；密谋揭晓：无隐秘意图"},{"id":30190,"turn":67,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，志在安民保境，今固守成都，与魏同盟共制强吴，不忍蜀中生灵再遭涂炭。 决策理由：当前合法行动仅休整，故选择休整巩固成都防务，维系与魏同盟关系，静待后续战机。；密谋揭晓：无隐秘意图"},{"id":30191,"turn":67,"type":"decision_revealed","factionId":"wu","message":"吴：江州乃江东门户，岂容有失。强征守城，以固疆土。 决策理由：江州遭魏蜀两路夹击威胁，仅1兵1防御极易被攻破。强征3兵使江州达4兵1防，防御力提升至4.2，可有效抵御蜀方进攻并大幅增加魏方攻取难度。虽损失商业专精1级并消耗24金18粮，但保住7金收入的关键城池势在必行。；密谋揭晓：无隐秘意图"},{"id":30192,"turn":67,"type":"character_refused","factionId":"wei","message":"赵云拒绝魏招降，忠诚受到动摇"},{"id":30193,"turn":67,"type":"forced_levy","factionId":"wu","message":"吴 在江州强征 3 兵力，城市发展受损"},{"id":30194,"turn":67,"type":"mobilize","factionId":"wei","message":"魏向许昌战略集结 5 兵"},{"id":30195,"turn":67,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":30196,"turn":68,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 3 金、4 粮"},{"id":30197,"turn":68,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、8 粮"},{"id":30198,"turn":68,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":30199,"turn":68,"type":"turn_prepared","factionId":null,"message":"第 68 回合（决战阶段）收入与维持已结算"},{"id":30200,"turn":68,"type":"decision_revealed","factionId":"wei","message":"魏：吴军觊觎汉中，孤已令汉中强征守城，确保不失。许昌重兵不动，待机破敌；蜀为同盟，当共御吴贼。 决策理由：汉中仅一兵且有被吴攻占之险，故强征三兵增强城防；许昌七兵继续威慑柴桑，待下回合再图攻吴。；密谋揭晓：无隐秘意图"},{"id":30201,"turn":68,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，今固守成都，与魏公同盟共讨强吴，保境安民，不使蜀中生灵涂炭。 决策理由：当前合法行动仅允许休整，故选择休整巩固成都防务，维系与魏的同盟关系，遵守盟约静待战机。；密谋揭晓：无隐秘意图"},{"id":30202,"turn":68,"type":"decision_re
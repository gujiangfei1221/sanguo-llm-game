":10629,"turn":48,"type":"recruit","factionId":"shu","message":"蜀 在柴桑征募 2 兵力"},{"id":10630,"turn":49,"type":"director_last_stand","factionId":"wu","message":"吴触发背水一战（2/2），建业集结 4 兵，但民心动荡"},{"id":10631,"turn":49,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 9 金、12 粮"},{"id":10632,"turn":49,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 11 金、25 粮"},{"id":10633,"turn":49,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 0 金、2 粮"},{"id":10634,"turn":49,"type":"turn_prepared","factionId":null,"message":"第 49 回合（决战阶段）收入与维持已结算"},{"id":10635,"turn":49,"type":"decision_revealed","factionId":"shu","message":"蜀：孤乃汉室皇叔，奉天命讨江东逆贼，今日提王师直捣建业，扫平分裂，兴复汉室！ 决策理由：吴贼窃据江东抗拒王师，今决战阶段柴桑兵力充足，直捣吴都建业，同时招降魏将夏侯惇充实战力，一举底定江东。；密谋揭晓：无隐秘意图"},{"id":10636,"turn":49,"type":"decision_revealed","factionId":"wu","message":"吴：江东子弟听令！柴桑蜀寇盘踞日久，今举建业精兵七千，水陆并进，誓复上游屏障！ 决策理由：柴桑为东吴门户，蜀军仅五兵驻守，建业以七兵强攻必克。克柴桑则断蜀东进之路，保吴郡、建业百年无忧；建业虽余一兵，然敌无路可达，固若金汤。决战之际当断则断。；密谋揭晓：无隐秘意图"},{"id":10637,"turn":49,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻建业失败，进攻方损失 3，守方损失 3，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"jianye","troops":4}},{"id":10638,"turn":49,"type":"attack_cancelled","factionId":"wu","message":"吴 的出征因来源城局势变化而取消","payload":{"sourceCityId":"jianye","targetCityId":"chaisang","troops":7}},{"id":10639,"turn":50,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 9 金、12 粮"},{"id":10640,"turn":50,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 15 金、24 粮"},{"id":10641,"turn":50,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 8 金、13 粮"},{"id":10642,"turn":50,"type":"turn_prepared","factionId":null,"message":"第 50 回合（决战阶段）收入与维持已结算"},{"id":10643,"turn":50,"type":"decision_revealed","factionId":"shu","message":"蜀：孤乃汉室皇叔，奉天命讨逆。吴贼窃据江东，敢窥我柴桑门户，今整兵固垒，再捣建业，不日便可扫平吴寇，兴复汉室一统天下！ 决策理由：柴桑为我东进核心门户，吴贼重兵压境本回合可能被攻占，决战之际强征兵员充实防御，招降魏将夏侯惇扩充军力，维持对吴都建业的围困，推进统一大业。；密谋揭晓：无隐秘意图"},{"id":10644,"turn":50,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑蜀寇屡犯建业，今举江东精锐四千人，水陆并进，誓复上游屏障，护我江东百年基业！ 决策理由：柴桑为东吴门户，蜀军屡次东进犯境，背水一战之利正盛，建业五兵攻二兵驻守之柴桑，胜算极大。克柴桑则断蜀东进之路，解建业之围，并可西向威胁许昌。；密谋揭晓：无隐秘意图"},{"id":10645,"turn":50,"type":"forced_levy","factionId":"shu","message":"蜀 在柴桑强征 3 兵力，城市发展受损"},{"id":10646,"turn":50,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻柴桑失败，进攻方损失 3，守方损失 2，围城进度升至 1/3","payload":{"sourceCityId":"jianye","targetCityId":"chaisang","troops":4}},{"id":10647,"turn":51,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 9 金、12 粮"},{"id":10648,"turn":51,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、10 粮"},{"id":10649,"turn":51,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 12 金、11 粮"},{"id":10650,"turn":51,"type":"turn_prepared","factionId":null,"message":"第 51 回合（决战阶段）收入与维持已结算"},{"id":10651,"turn":51,"type":"decision_revealed","factionId":"shu","message":"蜀：孤乃汉室皇叔，奉天命讨平江东逆贼，今整调兵马巩固战线，不日便要直捣吴都，扫平分裂，兴复汉室！ 决策理由：柴桑当前守军充足，无被攻占风险，调冗余兵力集结至前线许昌要点，同时招降被俘魏将夏侯惇扩充军力，为总攻吴都做准备。；密谋揭晓：无隐秘意图"},{"id":10652,"turn":51,"type":"decision_revealed","factionId":"wu","message":"吴：建业乃江东根本，今强征精兵固守都城，誓与东吴社稷共存亡！ 决策理由：borderThreats明确显示建业可被攻占（capturePossible=true），柴桑蜀军已三犯建业，围城进度1/3。建业为吴都，丢失则亡国。当务之急是巩固首都，强征3兵使建业驻军由2升至5，可有效抵御柴桑蜀军2兵攻势。消耗24金18粮尚可承受，换取都城安全。；密谋揭晓：无隐秘意图"},{"id":10653,"turn":51,"type":"forced_levy","factionId":"wu","message":"吴 在建业强征 3 兵力，城市发展受损"},{"id":10654,"turn":51,"type":"transfer","factionId":"shu","message":"蜀 从柴桑向许昌调动 2 兵力","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":2}},{"id":10655,"turn":52,"type":"siege_decayed","factionId":"shu","message":"蜀 对建业的围城进度衰减"},{"id":10656,"turn":52,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 9 金、12 粮"},{"id":10657,"turn":52,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 6 金、28 粮"},{"id":10658,"turn":52,"type":"turn_prepared","factionId":null,"message":"第 52 回合（决战阶段）收入与维持已结算"},{"id":10659,"turn":52,"type":"decision_revealed","factionId":"shu","message":"蜀：吾乃汉室皇叔，吴贼窥我柴桑门户，今调兵增防，招降魏将，共讨江东逆贼，兴复汉室指日可待！ 决策理由：柴桑为我东进门户，当前确有被吴军攻占的风险，故从许昌调兵增援稳固防线，同时招降魏将夏侯惇充实战力，为后续灭吴做准备。；密谋揭晓：无隐秘意图"},{"id":10660,"turn":52,"type":"decision_revealed","factionId":"wu","message":"吴：洛阳乃中原屏障，岂容蜀寇觊觎。今强征精兵固守要塞，誓保江东门户不失！ 决策理由：borderThreats明确显示洛阳本回合可能被蜀军攻占（capturePossible=true），许昌守军3可调2兵来攻。洛阳现有驻军1不足抵御，必须立即强征3兵使驻军升至4，方可守住此中原要冲。消耗24金18粮尚可承受，换取洛阳安全与持续金粮收入。同时避免建业分兵导致都城空虚。；密谋揭晓：无隐秘意图"},{"id":10661,"turn":52,"type":"forced_levy","factionId":"wu","message":"吴 在洛阳强征 3 兵力，城市发展受损"},{"id":10662,"turn":52,"type":"transfer","factionId":"shu","message":"蜀 从许昌向柴桑调动 2 兵力","payload":{"sourceCityId":"xuchang","targetCityId":"chaisang","troops":2}},{"id":10663,"turn":53,"type":"siege_decayed","factionId":"wu","message":"吴 对柴桑的围城进度衰减"},{"id":10664,"turn":53,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 9 金、12 粮"},{"id":10665,"turn":53,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 15 金、28 粮"},{"id":10666,"turn":53,"type":"turn_prepared","factionId":null,"message":"第 53 回合（决战阶段）收入与维持已结算"}],"createdAt":"2026-08-16T21:11:27.457Z","updatedAt":"2026-08-16T22:19:16.867Z","exportedAt":"2026-08-16T22:20:06.297Z"}
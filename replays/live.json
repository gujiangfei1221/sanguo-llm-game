4024,"turn":13,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":44025,"turn":13,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":44026,"turn":13,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":44027,"turn":13,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":44028,"turn":13,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 7 兵力"},{"id":44029,"turn":13,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":44030,"turn":14,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":44031,"turn":14,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":44032,"turn":14,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":44033,"turn":14,"type":"turn_prepared","factionId":null,"message":"第 14 回合（争锋阶段）收入与维持已结算"},{"id":44034,"turn":14,"type":"decision_revealed","factionId":"wei","message":"魏：洛阳守备已足，朕愿与吴修好。若孙权释还，可罢兵息民，共防蜀汉。 决策理由：洛阳为魏唯一根基，先募兵增强城防；同时向吴再提停战，尝试分化吴蜀，争取喘息之机。；密谋揭晓：暗中寻求议和"},{"id":44035,"turn":14,"type":"decision_revealed","factionId":"shu","message":"蜀：备以兴复汉室为己任，今与吴侯续同盟约，同心共讨曹贼篡逆，中原指日可定！ 决策理由：魏残兵据洛阳，觊觎我新取宛城，增兵宛城巩固防线防其突袭。接受吴侯同盟提议，维系蜀吴联合抗魏大局，践行讨贼兴汉承诺。；密谋揭晓：准备守约"},{"id":44036,"turn":14,"type":"decision_revealed","factionId":"wu","message":"吴：江东与蜀汉唇齿相依，共图中原。今续盟约，拒魏分化之策，待曹魏既灭再论天下。 决策理由：吴势虽张，蜀吴之盟正固，柴桑得mobilize八兵充实近忧已解。征吴郡五兵以厚后方储备，备下回合北伐调度。续盟蜀汉以维系夹击洛阳之势，拒魏分化。曹操仍押作筹码，待价而沽。；密谋揭晓：准备守约"},{"id":44037,"turn":14,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":44038,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":44039,"turn":14,"type":"recruit","factionId":"wu","message":"吴 在吴郡征募 5 兵力"},{"id":44040,"turn":14,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 3 兵力"},{"id":44041,"turn":14,"type":"transfer","factionId":"shu","message":"蜀 从汉中向宛城调动 7 兵力","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":7}},{"id":44042,"turn":15,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":44043,"turn":15,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 3 金、0 粮"},{"id":44044,"turn":15,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":44045,"turn":15,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":44046,"turn":15,"type":"turn_prepared","factionId":null,"message":"第 15 回合（争锋阶段）收入与维持已结算"},{"id":44047,"turn":15,"type":"decision_revealed","factionId":"wei","message":"魏：洛阳虽孤，朕志未衰。愿与吴罢兵修好，释还曹公，共御蜀汉；若执意相攻，亦当死战。 决策理由：当前洛阳城防尚足，先筑城固守，避免被吴蜀联军趁隙攻破；同时再向吴提停战，继续分化吴蜀，为后续争取时间与转机。；密谋揭晓：暗中寻求议和"},{"id":44048,"turn":15,"type":"decision_revealed","factionId":"shu","message":"蜀：曹孟德篡逆汉室，窃据洛阳孤城，备与吴侯同盟同心讨贼，今提宛城锐旅直捣洛阳，兴复汉室指日可待！ 决策理由：践行吴蜀同盟讨魏约定，乘曹魏仅余洛阳残兵，出兵进取洛阳，攻灭篡逆势力，维系盟友信任，推进兴复汉室大业。；密谋揭晓：准备守约"},{"id":44049,"turn":15,"type":"decision_revealed","factionId":"wu","message":"吴：许昌新克，当固根本。曹魏困守洛阳，败局已定。吴愿与中原罢兵息战，各保疆土，蓄养力量。 决策理由：许昌面临洛阳魏军反扑（14兵+防1，max攻13），城防薄弱（10兵、防0），急需巩固以防失城。接受魏停战，止战养兵；保留主力，避免强攻洛阳徒损兵力。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":44050,"turn":15,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的停战提议"},{"id":44051,"turn":15,"type":"fortify","factionId":"wu","message":"吴 加固了许昌城防"},{"id":44052,"turn":15,"type":"fortify","factionId":"wei","message":"魏 加固了洛阳城防"},{"id":44053,"turn":15,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻洛阳失败，进攻方损失 9，守方损失 5，城防降低 1 级","payload":{"sourceCityId":"wancheng","targetCityId":"luoyang","troops":14}},{"id":44054,"turn":15,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":44055,"turn":16,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 4 金、0 粮"},{"id":44056,"turn":16,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":44057,"turn":16,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":44058,"turn":16,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 4 金、0 粮"},{"id":44059,"turn":16,"type":"turn_prepared","factionId":null,"message":"第 16 回合（争锋阶段）收入与维持已结算"},{"id":44060,"turn":16,"type":"decision_revealed","factionId":"wei","message":"魏：洛阳守备尚坚，朕再募兵固防。吴蜀同盟虽在，然孙权岂甘久居人下？愿与吴共讨蜀汉，共成大业。 决策理由：洛阳为魏唯一根基，当前守军九人，征兵二人加强防御，防吴蜀再犯。同时向吴提出联合攻蜀，尝试离间吴蜀，若吴应允则可扭转困局。；密谋揭晓：无隐秘意图"},{"id":44061,"turn":16,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃据洛阳孤城，备奉衣带诏讨贼，今提宛城锐旅直捣黄龙，兴复汉室在此一役！ 决策理由：曹魏残兵孤守洛阳，觊觎我方宛城，主动出击攻灭残魏，践行吴蜀同盟讨贼约定，消除北方威胁，推进兴复汉室大业。；密谋揭晓：准备守约"},{"id":44062,"turn":16,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏困守孤城，气数已尽。江东秣马厉兵，待天时一到，便可兵临洛阳，一战定中原。 决策理由：吴魏已停战至turn18，洛阳仅9兵孤城，调动柴桑、吴郡共8兵集结许昌，使许昌驻军达18。下回合可发17兵总攻，以压倒优势一战灭魏，结束中原战事，得洛阳金+10粮+6收入。；密谋揭晓：无隐秘意图"},{"id":44063,"turn":16,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":44064,"turn":16,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 2 兵力"},{"id":44065,"turn":16,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻洛阳失败，进攻方损失 3，守方损失 4","payload":{"sourceCityId":"wancheng","targetCityId":"luoyang","troops":5}},{"id":44066,"turn":16,"type":"mobilize","factionId":"wu","message":"吴向许昌战略集结 8 兵"},{"id":44067,"turn":16,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":44068,"turn":17,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 6 金、0 粮"},{"id":44069,"turn":17,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":44070,"turn":17,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 3 金、0 粮"},{"id":44071,"turn":17,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":44072,"turn":17,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 11 金、0 粮"},{"id":44073,"turn":17,"type":"turn_prepared","factionId":null,"message":"第 17 回合（争锋阶段）收入与维持已结算"},{"id":44074,"turn":17,"type":"decision_revealed","factionId":"wei","message":"魏：曹某已亲率洛阳精兵攻取宛城，向吴侯表明伐蜀之诚。魏吴本无深仇，何必为蜀火并？愿与吴共分蜀地，共享天下。请孙权速决。 决策理由：吴魏停战至18，吴已在许昌集结重兵，下回合必攻洛阳。坐守孤城必亡，不如先发制人夺取宛城，扩大纵深。同时以实际行动向吴示好，促成联合攻蜀，分化吴蜀同盟。若得宛城，魏尚有回旋余地；若吴应约，则可反守为攻。；密谋揭晓：准备守约"},{"id":44075,"turn":17,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉衣带诏讨篡逆之贼，今曹贼窥我宛城，集结锐旅巩固防线，将与吴侯同心协力，共破曹魏，兴复汉室。 决策理由：宛城守备薄弱，魏兵可直接攻取，有失陷风险，亟需增兵巩固。集结江州兵力驰援宛城，消除隐患，后续进取洛阳，践行吴蜀同盟讨魏约定。；密谋揭晓：准备守约"},{"id":44076,"turn":17,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏篡汉窃据孤城，气数已尽。江东奉天之命，今许昌大军北进，誓克洛阳，还天下清明！ 决策理由：许昌驻军十八，洛阳魏军仅七且城防虽一，攻防悬殊。发十七兵压境，一战可下。克洛阳则魏灭，金十粮六入账，江东版图北扩。停战虽毁，曹魏本孤城一座朝不保夕，此天赐良机不可坐失。（命令非法：停战期间不能进攻对方，改为休整）；密谋揭晓：无隐秘意图"},{"id":44077,"turn":17,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":44078,"turn":17,"type":"city_captured","factionId":"wei","message":"魏 攻占宛城，损失 2 兵力","payload":{"cityId":"wancheng","defenderFactionId":"shu","sourceCityId":"luoyang","targetCityId":"wancheng","troops":6}},{"id":44079,"turn":17,"type":"mobilize_cancelled","factionId":"shu","message":"蜀的战略集结因战场局势变化而取消"},{"id":44080,"turn":18,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":44081,"turn":18,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 32 金、0 粮"},{"id":44082,"turn":18,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":44083,"turn":18,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 19 金、0 粮"},{"id":44084,"turn":18,"type":"turn_prepared","factionId":null,"message":"第 18 回合（争锋阶段）收入与维持已结算"},{"id":44085,"turn":18,"type":"decision_revealed","factionId":"wei","message":"魏：魏吴本无深仇，愿与吴结盟共讨蜀汉。若允，可还曹公，共分蜀地，成就霸业。 决策理由：洛阳仅剩一兵，吴军压境。先募二兵加强守备，同时向吴提出结盟，分化吴蜀，争取喘息之机。；密谋揭晓：准备守约"},{"id":44086,"turn":18,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡夺汉室，侵我宛城窥我汉中门户。备已调主力驰援，誓与吴侯同心戮力，共讨篡逆，兴复汉室。 决策理由：汉中是蜀地北方门户，魏占宛城后兵临城下，本回合有被攻占风险，故调江州主力驰援巩固防线，继续维系吴蜀同盟共讨曹魏。；密谋揭晓：准备守约"},{"id":44087,"turn":18,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏篡汉窃据孤城，气数已尽。今江东奉天之命，许昌大军北进，誓克洛阳，还天下清明！ 决策理由：许昌驻军十八，洛阳魏军仅余一人且城防一级，攻防悬殊。发
ourceCityId":"hanzhong","targetCityId":"wancheng","troops":5}},{"id":40124,"turn":10,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":40125,"turn":10,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":40126,"turn":11,"type":"director_stalemate","factionId":"shu","message":"战局久滞，流民投奔蜀，补充兵源并集结 2 兵"},{"id":40127,"turn":11,"type":"turn_prepared","factionId":null,"message":"第 11 回合（争锋阶段）收入与维持已结算"},{"id":40128,"turn":11,"type":"decision_revealed","factionId":"wei","message":"魏：刘备窃据汉中，屡犯中原。今孤亲率大军收复汉中，以正汉室纲纪。孙权若念苍生，当与魏共讨刘备，平分蜀地；若仍执迷，则魏军破蜀之后，江东自见分晓。 决策理由：汉中为宛城心腹之患，蜀军两番来犯，今汉中仅3兵守备空虚，正宜速取。宛城9兵遣8攻汉中，留1兵镇守，攻取后蜀仅剩成都、江州，可断其一臂。同时向吴提议共击刘备，以离间吴蜀之盟，若吴应允，则蜀可平矣。；密谋揭晓：无隐秘意图"},{"id":40129,"turn":11,"type":"decision_revealed","factionId":"shu","message":"蜀：吾与吴侯共为唇齿，同讨篡汉曹贼。今整兵固守益州门户，誓与吴侯同心破曹，兴复汉室。 决策理由：汉中为蜀地门户，魏宛城重兵压境，本回合有失陷风险，征兵补强守备，续提联合攻魏，维系吴蜀同盟共抗曹贼，符合兴复汉室大义。；密谋揭晓：准备守约"},{"id":40130,"turn":11,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼假意议和，实为缓兵分化之计。权已严词拒绝，必与皇叔同心讨贼，共克中原。 决策理由：围城已两回合未施压，进度将衰减。然以柴桑5兵攻许昌6守军，攻力约8对防6胜算不足，且损兵后柴桑仅余1-2兵，恐遭魏军反噬。不如歇此回合保全部队，T12征兵建业5、T13征兵吴郡5，T14调兵柴桑，T15集15以上大军一举破许昌，方为万全之策。；密谋揭晓：准备守约"},{"id":40131,"turn":11,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":40132,"turn":11,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":40133,"turn":11,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":40134,"turn":11,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":40135,"turn":11,"type":"attack_repulsed","factionId":"wei","message":"魏 进攻汉中失败，进攻方损失 5，守方损失 4，围城进度升至 1/3","payload":{"sourceCityId":"wancheng","targetCityId":"hanzhong","troops":8}},{"id":40136,"turn":12,"type":"siege_decayed","factionId":"wu","message":"吴 对许昌的围城进度衰减"},{"id":40137,"turn":12,"type":"turn_prepared","factionId":null,"message":"第 12 回合（争锋阶段）收入与维持已结算"},{"id":40138,"turn":12,"type":"decision_revealed","factionId":"wei","message":"魏：孙权若知时势，当趁吴蜀之盟将尽，与魏共讨刘备，平分蜀地。孤已令宛城整军，若江东应约，则汉室可兴，天下可安。 决策理由：宛城是中原屏障，蜀军屡犯，需增强守军并为收复汉中积蓄力量。许昌现有九兵足御吴军，暂不抽调；继续观望吴蜀动向，若吴应约共击蜀，则全力取汉中。；密谋揭晓：准备守约"},{"id":40139,"turn":12,"type":"decision_revealed","factionId":"shu","message":"蜀：吾与吴侯唇齿相依，共讨篡汉逆曹，深耕益州充实军资，誓克复中原，兴复汉室。 决策理由：汉中为益州北伐门户，升级农业专精可充实军粮，保障长期对魏作战需求，续提联合攻魏巩固吴蜀同盟。；密谋揭晓：准备守约"},{"id":40140,"turn":12,"type":"decision_revealed","factionId":"wu","message":"吴：江东厚植实力，蓄势待发。与皇叔同心讨贼，共克许昌。 决策理由：依预定方略T12征兵建业5，为T15集大军破许昌蓄力。围城已衰减，但柴桑5兵攻许昌9守军力不足(攻7对9)，强攻徒损。续纳蜀联合攻魏之议，拒魏离间之计，稳步推进。；密谋揭晓：准备守约"},{"id":40141,"turn":12,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":40142,"turn":12,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":40143,"turn":12,"type":"recruit","factionId":"wu","message":"吴 在建业征募 5 兵力"},{"id":40144,"turn":12,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":40145,"turn":12,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为农桑专精 2 级"},{"id":40146,"turn":13,"type":"turn_prepared","factionId":null,"message":"第 13 回合（争锋阶段）收入与维持已结算"},{"id":40147,"turn":13,"type":"decision_revealed","factionId":"wei","message":"魏：汉中乃蜀之门户，今守备空虚，孤已发宛城精锐收复。孙权若知天命，可与魏共击刘备，平分益州；若仍执迷，则蜀破之后江东自见。 决策理由：宛城9兵，攻汉中以8兵留1守城。汉中现仅4兵，趁其未及征兵速取，断蜀一臂；同时再邀吴共击蜀，离间吴蜀，观其动向。；密谋揭晓：无隐秘意图"},{"id":40148,"turn":13,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窥我汉中，备今整兵补强门户，与吴侯同心共讨逆贼，兴复汉室指日可待！ 决策理由：汉中为益州门户，魏宛城重兵压境，本回合不补强即有失陷风险，故征兵巩固防务，续与吴订联合攻魏之约，恪守同盟共讨曹魏。；密谋揭晓：准备守约"},{"id":40149,"turn":13,"type":"decision_revealed","factionId":"wu","message":"吴：江东整军经武，柴桑前屯已固，蓄势待发。与皇叔同心讨贼，共克许昌指日可待。 决策理由：依预定方略T13于吴郡征兵5，为T15集大军破许昌蓄力。许昌9守军攻力薄弱，柴桑military L2攻力加成显著，集18兵攻力约25可期破城。续与蜀联合攻魏，拒魏离间之计。；密谋揭晓：准备守约"},{"id":40150,"turn":13,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":40151,"turn":13,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":40152,"turn":13,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":401
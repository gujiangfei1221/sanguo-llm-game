wu","factionId":"wu","locationCityId":"jianye","status":"active","loyalty":80,"resentment":0}],"director":{"lastCaptureTurn":0,"lastEventTurn":0,"lastStandCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":20705,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":20706,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：魏吴休兵结盟，共御西蜀；我自固许昌，以安中原。 决策理由：先稳根基，再图进取；联吴制蜀可免两线受敌，本回合于许昌征兵以备后需。；密谋揭晓：准备守约"},{"id":20707,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，志在清剿曹贼、兴复汉室，愿与江东孙权共举义兵，同伐汉贼，共享太平。 决策理由：首回合蓄势，先发展蜀中根基，充盈粮秣，同时邀约东吴联合攻魏，符合联弱抗强、共讨国贼的方略。；密谋揭晓：无隐秘意图"},{"id":20708,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，先固根本。建业乃都城所在，当以商路通财，厚植基业，徐图进取。 决策理由：柴桑虽两面受敌，然本回合敌军兵力不足以攻取(capturePossible:false)，暂无燃眉之急。建业为都城且安全，首选商路专精以积金；柴桑留作军事前线，后续再行强化。；密谋揭晓：无隐秘意图"},{"id":20709,"turn":1,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":20710,"turn":1,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":20711,"turn":1,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":20712,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 1 级"},{"id":20713,"turn":1,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 1 级"},{"id":20714,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":20715,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：魏吴本为唇齿，蜀逆必先剪除。今宛城增兵，愿与江东共约伐蜀，以定天下。 决策理由：宛城为西线要冲，增兵固防可慑汉中，亦为攻蜀蓄力。联合东吴可断蜀之臂助，避免两线受敌。；密谋揭晓：准备守约"},{"id":20716,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，志在诛灭曹贼兴复汉室，今整备汉中前线，静候孙吴共举义旗，同伐国贼。 决策理由：汉中为北伐曹贼的前沿重镇，发展军事专精可增强前线防御与军力，符合联吴抗曹、积蓄力量讨贼的长期方略。；密谋揭晓：无隐秘意图"},{"id":20717,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，以固守为上。柴桑前哨筑城以固藩篱，外交从容，待时而动。 决策理由：柴桑正对魏许昌，本回合有被攻占之险（capturePossible: true），优先筑城提升城防以固根本。外交上魏蜀双方各有提案，仓促结盟或伐魏皆非所宜，暂皆婉拒，保留灵活余地。；密谋揭晓：无隐秘意图"},{"id":20718,"turn":2,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":20719,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":20720,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":20721,"turn":2,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 1 级"},{"id":20722,"turn":2,"type":"fortify","factionId":"wu","message":"吴 加固了柴桑城防"},{"id":20723,"turn":2,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":20724,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":20725,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：魏已起宛城之兵直取汉中，请孙吴共践前约，同伐西蜀。汉中既下，蜀寇可破。 决策理由：宛城兵足，汉中守军未固，乘其未备而攻之，可断蜀出川之路。同时再邀吴共攻，以成夹击之势。；密谋揭晓：准备守约"},{"id":20726,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，志在诛灭曹贼兴复汉室，今汉中已整军待发，愿再次邀约江东孙将军共举义兵，同讨国贼，共复汉室江山。 决策理由：汉中直面宛城魏寇，本回合有被攻占风险，因此增兵巩固前线防线；再次邀约东吴联合伐魏，符合联弱抗曹、兴复汉室的长期方略。；密谋揭晓：准备守约"},{"id":20727,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：江东固本为先，柴桑增兵以固藩篱；曹贼势大不可与之谋，吴蜀唇齿相依，当共图之。 决策理由：柴桑筑城后城防已固，capturePossible解除，但许昌魏军仍强（13兵）。本回合征兵5将柴桑提至13兵，以应对长期威胁。外交上拒魏伐蜀之议——助魏灭蜀则唇亡齿寒，江东独自难挡曹操；转而主动联蜀，方为孙氏长策。；密谋揭晓：无隐秘意图"},{"id":20728,"turn":3,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":20729,"turn":3,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":20730,"turn":3,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":20731,"turn":3,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":20732,"turn":3,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 6 兵力"},{"id":20733,"turn":3,"type":"attack_repulsed","factionId":"wei","message":"魏 进攻汉中失败，进攻方损失 8，守方损失 5，城防降低 1 级","payload":{"sourceCityId":"wancheng","targetCityId":"hanzhong","troops":12}},{"id":20734,"turn":3,"type":"character_fallen","factionId":"wei","message":"张辽在惨烈战斗中阵亡"},{"id":20735,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":20736,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：宛城乃西线要冲，今急募兵固守，防蜀军乘虚而入。待兵粮稍足，再图汉中。 决策理由：上轮攻汉中受挫，宛城仅余5兵，蜀汉中有9兵且可攻宛，capturePossible为真。本回合在宛城征募5兵，使宛城兵力增至10，消除被占风险；暂缓进攻，休整再战。；密谋揭晓：无隐秘意图"},{"id":20737,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：备为汉室宗亲，与江东孙将军唇齿相依共拒曹贼，今欣然应允结盟之议。我已起汉中精兵北伐宛城，愿与孙将军共举义旗，同复汉室江山。 决策理由：曹魏窃据汉室神器，吴蜀结盟符合联弱抗曹大义，宛城魏军兵力薄弱，我军出兵攻取宛城，打开北伐通道，契合兴复汉室的目标。；密谋揭晓：准备守约"},{"id":20738,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼暴虐，戮害忠良，天下共愤。今魏军新折于汉中，张辽殒命，正当乘其疲弊、共举义旗。孤已允蜀汉之约，同伐许昌，以安天下苍生。 决策理由：魏攻汉中惨败，丧兵八千、折一大将，士气受挫；许昌虽屯兵十三，然新败之余正是用兵之时。与前两回合外交走向一脉相承——拒魏伐蜀之议、转而联蜀，今正式接受联合攻魏之请，锁定战略方向。本回合不急于出兵，先升建业商贸专精至二级，厚植财力以供后续军需。；密谋揭晓：准备守约"},{"id":20739,"turn":4,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":20740,"turn":4,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":20741,"turn":4,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":20742,"turn":4,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 2 级"},{"id":20743,"turn":4,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 5，守方损失 4，城防降低 1 级","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":8}},{"id":20744,"turn":4,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":20745,"turn":5,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":20746,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"}],"createdAt":"2026-08-17T19:55:07.183Z","updatedAt":"2026-08-17T19:58:26.165Z","exportedAt":"2026-08-17T20:00:06.884Z"}
"status":"active","loyalty":70,"resentment":0},{"id":"luxun","name":"陆逊","originalFactionId":"wu","factionId":"wu","locationCityId":"jianye","status":"active","loyalty":80,"resentment":0}],"director":{"lastCaptureTurn":0,"lastEventTurn":0,"lastStandCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":41319,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":41320,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：孟德愿与江东结好，共保安宁。许昌增兵只为固守根本，绝无针对吴侯之意。 决策理由：当前无迫近战事，先强化许昌并尝试与吴结盟，避免两线受敌，为后续行动保留主动。；密谋揭晓：无隐秘意图"},{"id":41321,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，志在诛灭曹贼恢复汉室，愿与江东孙将军结为同盟，共拒强敌同安天下。 决策理由：曹魏篡汉势大难独抗，我军初立需稳固基业，后方成都发展农业积蓄粮草，主动联结孙权缔盟共抗曹贼，符合长远利益。；密谋揭晓：无隐秘意图"},{"id":41322,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑北据许昌，西临江州，乃江东门户。权当先固要塞、练水军，广蓄钱粮，以待天下之变。 决策理由：柴桑为吴之咽喉，两面受敌（魏许昌、蜀江州），军事专精可提升城防与战力，长期巩固江东根基。外交上主动结好蜀汉，分化潜在威胁，为后续抗魏争取战略空间。；密谋揭晓：无隐秘意图"},{"id":41323,"turn":1,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":41324,"turn":1,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":41325,"turn":1,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":41326,"turn":1,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":41327,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 1 级"},{"id":41328,"turn":1,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 1 级"},{"id":41329,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":41330,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃根本，兴商富民以充军资。对吴之盟约仍待其答复，我无意先启战端。 决策理由：当前无迫近威胁，趁间隙发展许昌商业增加收入，为后续扩军与攻防储备资源；暂不主动出击，避免两线树敌。；密谋揭晓：无隐秘意图"},{"id":41331,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，诚心与孙吴缔盟，共拒曹贼，同安巴蜀江东，共扶汉室社稷。 决策理由：目前仍处蓄势阶段，继续发展成都农业充实粮草储备，接受东吴结盟提议，提议联合共抗曹魏，符合联弱抗曹、积蓄国力的长远战略。；密谋揭晓：准备守约"},{"id":41332,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，先固门户。柴桑要塞乃吾根基，此番加固城防，以保境安民。盟约之事，容权详察各方诚意后再议。 决策理由：柴桑当前防御力9.6，魏许昌最大攻击12可触发攻占（所需11.52），形势紧迫。本回合优先fortify提升防御等级至2，化解即时威胁。暂拒魏蜀双盟，保最大外交灵活度，待下回合视各方动向再定盟。；密谋揭晓：无隐秘意图"},{"id":41333,"turn":2,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":41334,"turn":2,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":41335,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":41336,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的结盟提议"},{"id":41337,"turn":2,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 2 级"},{"id":41338,"turn":2,"type":"fortify","factionId":"wu","message":"吴 加固了柴桑城防"},{"id":41339,"turn":2,"type":"develop_city","factionId":"wei","message":"魏 将许昌建设为商贸专精 1 级"},{"id":41340,"turn":3,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":41341,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":41342,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原根本，增兵固防以安百姓。江东若肯结好，魏无西顾之忧。 决策理由：蜀吴已盟，魏需加强许昌兵力以应对潜在威胁；同时尝试拉拢吴国，分化蜀吴同盟。；密谋揭晓：无隐秘意图"},{"id":41343,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，与孙吴同盟共讨篡汉曹贼，今整备汉中前线厉兵秣马，盼与吴侯同力北伐，扫清中原恢复汉室社稷。 决策理由：汉中为对魏前线，发展军事专精可强化边境战力，巩固北伐根基，继续推动与东吴联合伐魏，落实联弱抗曹的既定战略，积蓄实力以待出师。；密谋揭晓：准备守约"},{"id":41344,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，府库未丰，柴桑要塞虽固，尚需广积钱粮以图长远。联合攻魏之事，容权详察天时地利再议。 决策理由：柴桑fortify后防御稳固（11.2>魏最大攻击12的capture阈值13.44），边境威胁解除。当前处于蓄势阶段第3回合，我军仅24兵，不宜过早与魏13兵许昌正面对决。优先发展建业商业提升金收，厚植根基；婉拒蜀联合攻魏，待经济与兵力充裕后再议。；密谋揭晓：无隐秘意图"},{"id":41345,"turn":3,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":41346,"turn":3,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":41347,"turn":3,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 1 级"},{"id":41348,"turn":3,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":41349,"turn":3,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 1 级"},{"id":41350,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":41351,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：许昌增兵固防，再遣使重申与吴结好之意。蜀汉坐大对江东亦非福，望孙权明察利害。 决策理由：当前蜀吴虽盟但吴未全力附蜀，仍有机会分化。许昌增兵增强核心防御，同时以汉中扩张威胁江东为由拉拢吴国，争取打破两线受敌局面。（外交行为不在当前白名单中，已忽略）；密谋揭晓：无隐秘意图"},{"id":41352,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，志在诛灭篡汉曹贼、恢复汉室社稷。今强化汉中前线军镇，再约吴侯同力北伐，共清中原，同安天下。 决策理由：当前仍处蓄势阶段，汉中为对魏北伐前线，升级军事专精可强化边境战力，再次邀约东吴同盟联合攻魏，维系同盟信任，落实联弱抗曹的既定战略。；密谋揭晓：准备守约"},{"id":41353,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：江东门户柴桑乃江东之咽喉，权当加固城防以保境安民，不欲轻启战端。吴蜀盟约既定，当共扶汉室、抵御曹贼。 决策理由：柴桑面临魏许昌威胁（攻17需13.44可攻占），本回合优先fortify提升防御等级至3，化解即时威胁。外交上拒绝魏结盟（已与蜀盟约至T6，背叛代价高），传书魏各守疆土以安其心；暂不出兵，维持蓄势。（外交行为不在当前白名单中，已忽略）；密谋揭晓：无隐秘意图"},{"id":41354,"turn":4,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":41355,"turn":4,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":41356,"turn":4,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 4 兵力"},{"id":41357,"turn":4,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 2 级"},{"id":41358,"turn":4,"type":"fortify","factionId":"wu","message":"吴 加固了柴桑城防"},{"id":41359,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"}],"createdAt":"2026-08-19T15:52:54.538Z","updatedAt":"2026-08-19T15:55:34.789Z","exportedAt":"2026-08-19T15:56:08.558Z"}
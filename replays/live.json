d":1989,"turn":17,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":1990,"turn":17,"type":"turn_prepared","factionId":null,"message":"第 17 回合（争锋阶段）收入与维持已结算"},{"id":1991,"turn":17,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，奉苍生之望讨割据不臣之孙权。许昌守备空虚，今提宛城锐师取之，扫清中原再定江东，兴复汉室就在今日！ 决策理由：魏已覆灭，吴割据江东图谋争锋，许昌作为吴前线重镇仅有1名守军，空隙明显。我宛城已有充足兵力，趁势攻取许昌，打开进取通道，符合统一大业需求。；密谋揭晓：无隐秘意图"},{"id":1992,"turn":17,"type":"decision_revealed","factionId":"wu","message":"吴：许昌新附，防务为先。孤今补兵实边，巩固根本。曹氏旧将愿降者纳之，江东广蓄英才。两强相争，稳者得天下。 决策理由：许昌仅1兵，蜀可自宛城发4兵直接攻占，调兵与集结均战后才到，唯有征兵能即时补防，增至6兵化解危局并保住北进跳板。同时招降夏侯惇充实将力。；密谋揭晓：无隐秘意图"},{"id":1993,"turn":17,"type":"recruit","factionId":"wu","message":"吴 在许昌征募 5 兵力"},{"id":1994,"turn":17,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻许昌失败，进攻方损失 3，守方损失 2，围城进度升至 1/3","payload":{"sourceCityId":"wancheng","targetCityId":"xuchang","troops":4}},{"id":1995,"turn":18,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":1996,"turn":18,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 17 金、22 粮"},{"id":1997,"turn":18,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":1998,"turn":18,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 2 金、0 粮"},{"id":1999,"turn":18,"type":"turn_prepared","factionId":null,"message":"第 18 回合（争锋阶段）收入与维持已结算"},{"id":2000,"turn":18,"type":"decision_revealed","factionId":"shu","message":"蜀：备为汉室宗亲，志在兴复汉室，孙权割据江东反叛同盟，备整兵宛城续攻许昌，誓扫吴虏定天下！ 决策理由：宛城是我方前线重镇，当前守备薄弱，有被吴军攻占风险，征募兵力巩固防务，同时维持对许昌的围城压力，为后续破城铺路。；密谋揭晓：无隐秘意图"},{"id":2001,"turn":18,"type":"decision_revealed","factionId":"wu","message":"吴：蜀军新败，江州守备空虚。孤今遣柴桑锐师溯江取之，直捣成都门户。两强之争，先发者制人。 决策理由：决战阶段蜀总兵力仅约5，江州仅1守军防1，柴桑以6兵出击可稳取，形成6城对3城优势，并从侧翼威胁成都。许昌现有4兵，蜀宛城仅2兵无法即刻来攻，下回合再行补防。；密谋揭晓：无隐秘意图"},{"id":2002,"turn":18,"type":"recruit","factionId":"shu","message":"蜀 在宛城征募 5 兵力"},{"id":2003,"turn":18,"type":"city_captured","factionId":"wu","message":"吴 攻占江州，损失 2 兵力","payload":{"cityId":"jiangzhou","defenderFactionId":"shu","sourceCityId":"chaisang","targetCityId":"jiangzhou","troops":6}},{"id":2004,"turn":18,"type":"character_captured","factionId":"wu","message":"张飞在城破后被吴俘虏"},{"id":2005,"turn":19,"type":"director_last_stand","factionId":"shu","message":"蜀触发背水一战（1/2），成都集结 4 兵，但民心动荡"},{"id":2006,"turn":19,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 40 金、37 粮"},{"id":2007,"turn":19,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 11 金、14 粮"},{"id":2008,"turn":19,"type":"turn_prepared","factionId":null,"message":"第 19 回合（决战阶段）收入与维持已结算"},{"id":2009,"turn":19,"type":"decision_revealed","factionId":"shu","message":"蜀：孙权背盟夺我江州，窥我西川腹地，备身为汉室宗亲，提锐师反攻复疆，誓扫吴虏兴复汉室。 决策理由：江州为成都门户，落入吴军后直接威胁汉中、成都安危，符合进攻路线要求，先发制人解除侧翼威胁。；密谋揭晓：无隐秘意图"},{"id":2010,"turn":19,"type":"decision_revealed","factionId":"wu","message":"吴：蜀军宛城蠢动，许昌告急。孤今急补五营实边，坚壁清野待其来攻。江东基业稳如泰山，皇叔虽负隅成都，天下大势已定。 决策理由：许昌守备4，蜀可自宛城发6兵直接攻陷，capturePossible为真，是本回合唯一即时可失之城。调兵与集结均战后方至，唯征兵可即时补防，增至9兵使守力远超蜀军攻力上限，化解危局并将蜀军主力拖在坚城之下。；密谋揭晓：无隐秘意图"},{"id":2011,"turn":19,"type":"recruit","factionId":"wu","message":"吴 在许昌征募 5 兵力"},{"id":2012,"turn":19,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻江州失败，进攻方损失 3，守方损失 2，围城进度升至 1/3","payload":{"sourceCityId":"chengdu","targetCityId":"jiangzhou","troops":4}},{"id":2013,"turn":20,"type":"siege_decayed","factionId":"shu","message":"蜀 对许昌的围城进度衰减"},{"id":2014,"turn":20,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 12 金、17 粮"},{"id":2015,"turn":20,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 11 金、14 粮"},{"id":2016,"turn":20,"type":"turn_prepared","factionId":null,"message":"第 20 回合（决战阶段）收入与维持已结算"}],"updatedAt":"2026-08-16T04:39:20.530Z","exportedAt":"2026-08-16T04:39:45.196Z"}
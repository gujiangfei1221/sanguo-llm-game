id":"ganning","name":"甘宁","originalFactionId":"wu","factionId":"wu","locationCityId":"wujun","status":"active","loyalty":70,"resentment":0},{"id":"luxun","name":"陆逊","originalFactionId":"wu","factionId":"wu","locationCityId":"jianye","status":"active","loyalty":80,"resentment":0}],"director":{"lastCaptureTurn":0,"lastEventTurn":0,"lastStandCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":16540,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":16541,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原腹心，先固本培元，充实府库，以图后举。 决策理由：魏据中原三城，暂无迫在眉睫之危。发展许昌商业可增加长期金收入，为后续征兵、备战和外交行动积累资源。；密谋揭晓：无隐秘意图"},{"id":16542,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹操篡夺汉祚、祸乱天下，愿与江东孙氏同讨汉贼，共匡汉室，平分疆土。 决策理由：第一回合为蓄势阶段，先稳固后方根基，发展农业保障后续粮秣，遵循联吴抗曹的既定方略，邀约孙权共伐曹魏，合乎大义与战略需求。；密谋揭晓：准备守约"},{"id":16543,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，先固根本。建业为都，当兴商聚财，以蓄实力。 决策理由：首回合蓄势，柴桑暂无被攻破之虞（capturePossible=false），前线周瑜镇守无忧。建业为都城且位居后方，最宜定为商都长线生金，所得可用于后续外交离间、征兵与强征。吴郡与柴桑留待下回合视局势再定专精。；密谋揭晓：无隐秘意图"},{"id":16544,"turn":1,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":16545,"turn":1,"type":"develop_city","factionId":"wei","message":"魏 将许昌建设为商贸专精 1 级"},{"id":16546,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 1 级"},{"id":16547,"turn":1,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 1 级"},{"id":16548,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":16549,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：吴主若愿共讨刘备，魏军自宛城出击汉中，请吴军自柴桑策应，事成之后共分蜀地。 决策理由：蜀国已向吴提议攻我，必须分化孙刘。先稳固洛阳军备，同时向吴提出联合攻蜀，若吴应允则两面夹击蜀国。；密谋揭晓：准备守约"},{"id":16550,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：吾为汉室宗亲，志在诛曹贼复汉祚，愿与江东孙将军同心讨贼，整军备边静候盟约敲定。 决策理由：当前仍处蓄势阶段，汉中是对魏前线要塞，发展军事专精可增强边境守备，也为后续攻伐曹贼积蓄力量，坚持联吴抗曹方略不变。；密谋揭晓：准备守约"},{"id":16551,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：建业商都初成，今再升一级以聚江东财力，蓄势待时。 决策理由：柴桑前线暂安，魏蜀皆无力犯境（capturePossible=false）。建业商都已至一级，升二级可显著提升金入，为后续征兵、外交离间与战备储备资源。拒蜀联曹之议，因实力未充、北上风险过大，稳健为本。（外交行为不在当前白名单中，已忽略）；密谋揭晓：无隐秘意图"},{"id":16552,"turn":2,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":16553,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":16554,"turn":2,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 1 级"},{"id":16555,"turn":2,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 2 级"},{"id":16556,"turn":2,"type":"develop_city","factionId":"wei","message":"魏 将洛阳建设为军镇专精 1 级"},{"id":16557,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":16558,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：吴主若愿共讨刘备，魏军自宛城攻汉中，吴军自柴桑北上，两面夹击，蜀地可图。 决策理由：蜀屡次联吴攻我，必须分化孙刘。先升宛城军备以备攻蜀，同时再邀吴共击蜀，若成则两面夹击。；密谋揭晓：准备守约"},{"id":16559,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹贼篡汉窃国，天下共愤。愿再邀孙将军共举义兵同讨汉贼，事成之后共分魏土，同保江东巴蜀太平。 决策理由：当前仍处蓄势阶段，提升成都农业专精可增加粮食产出，为后续征兵备战积蓄资源，坚持联吴抗曹方略，再次邀约东吴共伐曹魏。；密谋揭晓：准备守约"},{"id":16560,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑北连许昌、西接江州，地当江东门户，两面受敌。今建军镇以固根本，外可屏障建业，内可蓄养士卒。 决策理由：柴桑为江东第一要冲，北临许昌、西接江州，长期两面受敌。建军镇可永久提升城防战力，深固根基。魏约伐蜀乃驱虎吞狼之计，拒之可保我独立地位；蜀为唇齿之邦，当先结盟以抗曹，联守而非联攻最为稳妥。；密谋揭晓：无隐秘意图"},{"id":16561,"turn":3,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":16562,"turn":3,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":16563,"turn":3,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":16564,"turn":3,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 1 级"},{"id":16565,"turn":3,"type":"develop_city","factionId":"wei","message":"魏 将宛城建设为军镇专精 1 级"},{"id":16566,"turn":3,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 2 级"},{"id":16567,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":16568,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：魏愿与吴结盟修好，互不犯境；同时宛城增兵，稳固西线，静观局势。 决策理由：宛城为西线要冲，征兵增强后续攻防实力；向吴提盟可避免两线受敌，若吴应允则攻蜀更有把握。当前无迫在眉睫威胁，暂不主动开战。；密谋揭晓：准备守约"},{"id":16569,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃据神器，天下共愤。今与孙将军缔结盟约，同心共讨汉贼，匡复汉室，共保苍生太平。 决策理由：吴蜀唇齿相依，共抗曹贼乃是大势，接受东吴盟约符合联吴抗曹的既定方略。汉中为对魏前线要塞，升级军事专精可增强守备，为后续伐魏积蓄力量。；密谋揭晓：准备守约"},{"id":16570,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，柴桑军镇已立，吴郡今兴农桑以蓄粮秣，固本培元为先。 决策理由：吴郡未定专精，借蓄势之机定为农桑，稳固江东粮道。柴桑军镇L1已固、建业商都L2已成，北线暂安，无需急于攻伐。；密谋揭晓：无隐秘意图"},{"id":16571,"turn":4,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":16572,"turn":4,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":16573,"turn":4,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":16574,"turn":4,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 6 兵力"},{"id":16575,"turn":4,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 2 级"},{"id":16576,"turn":4,"type":"develop_city","factionId":"wu","message":"吴 将吴郡建设为农桑专精 1 级"},{"id":16577,"turn":5,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":16578,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":16579,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀既盟，魏暂不轻启战端。今于宛城增兵，巩固西线；同时再向吴伸善意，望能分化孙刘、共保太平。 决策理由：吴蜀同盟已成，若贸然攻蜀恐遭两面夹击。故先在宛城征兵增强军力，再向吴示好，观察其是否愿背蜀联魏；若吴仍附蜀，则继续坚守积粮。；密谋揭晓：无隐秘意图"},{"id":16580,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃据中原，屯兵宛城窥视汉中，孤整军备敌，愿与孙吴同心共讨汉贼，匡复汉室。 决策理由：汉中为对魏前线，魏在宛城屯重兵，本回合有被攻占风险，急需补强守备，同时邀约同盟东吴共伐曹魏，坚持联吴抗曹既定方略。；密谋揭晓：准备守约"},{"id":16581,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑军镇初成，今再升一级以固江东门户。孙刘盟好在前，伐盟之事权宁死不为；曹公若愿各安边境，权亦愿修好如初。 决策理由：柴桑为江东第一要冲，北连许昌、西接江州，两面受敌。军镇L1已立，升级L2可大幅提升城防与战力，深固根本以备不测。拒魏结盟之议以保吴蜀盟约（信任60，续至第8回合），以和待势、静观其变。（外交行为不在当前白名单中，已忽略）；密谋揭晓：无隐秘意图"},{"id":16582,"turn":5,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":16583,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":16584,"turn":5,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 7 兵力"},{"id":16585,"turn":5,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 2 级"},{"id":16586,"turn":5,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 6 兵力"},{"id":16587,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"},{"id":16588,"turn":6,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀同盟尚在，魏暂不兴兵。今于宛城再募精卒，固我西线，待时而动。 决策理由：吴仍与蜀同盟，贸然攻蜀恐陷两面作战。宛城为攻汉中前哨，先补兵力以固防守，待同盟期满或吴中立后再图西进。；密谋揭晓：无隐秘意图"},{"id":16589,"turn":6,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃据中原，我蜀吴唇齿相依，愿同心共讨汉贼，匡复汉室，整备基业以待义兵。 决策理由：江州未确定城市专精，将其开发为军事专精可提升边境战力，再次邀约同盟东吴共伐曹魏，坚持联吴抗曹的既定方略，积蓄实力等待时机。；密谋揭晓：准备守约"},{"id":16590,"turn":6,"type":"decision_revealed","factionId":"wu","message":"吴：吴郡农桑升二级，江东粮道更固。伐魏之事非其时也，权愿与诸公共保边境，待天时人和再议。 决策理由：柴桑前线capturePossible=false，本回合暂无兵戈之危。吴郡农桑L1已立，升级L2可显著提升粮产，为后续持久战备足仓廪。蜀连请联攻魏五次，今非决战之时，仍守盟静观。；密谋揭晓：无隐秘意图"},{"id":16591,"turn":6,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":16592,"turn":6,"type":"develop_city","factionId":"wu","message":"吴 将吴郡建设为农桑专精 2 级"},{"id":16593,"turn":6,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 2 兵力"},{"id":16594,"turn":6,"type":"develop_city","factionId":"shu","message":"蜀 将江州建设为军镇专精 1 级"},{"id":16595,"turn":7,"type":"turn_prepared","factionId":null,"message":"第 7 回合（蓄势阶段）收入与维持已结算"}],"createdAt":"2026-08-17T11:57:28.733Z","updatedAt":"2026-08-17T12:04:
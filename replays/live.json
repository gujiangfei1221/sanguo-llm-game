ack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 3，守方损失 2，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":5}},{"id":12621,"turn":18,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":12622,"turn":18,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 8 金、0 粮"},{"id":12623,"turn":18,"type":"turn_prepared","factionId":null,"message":"第 18 回合（争锋阶段）收入与维持已结算"},{"id":12624,"turn":18,"type":"decision_revealed","factionId":"wei","message":"魏：魏仍愿与吴息兵。吴蜀同盟将尽，孙权何苦为刘备火中取栗？洛阳增兵只为自守，非攻吴也。 决策理由：魏军于洛阳续募精兵，巩固中原根基；并再向吴提议停战，愿以诚意化解干戈，使吴蜀同盟自散。宛城仍可坚守，暂不调兵。；密谋揭晓：暗中寻求议和"},{"id":12625,"turn":18,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃据中原，孤与吴侯同举义兵共讨篡逆，兴复汉室，万死不辞！ 决策理由：接受吴侯联攻伐魏提议，履行盟约巩固同盟信任，募兵汉中前线，筹备攻取宛城，打破曹魏西线门户，保障蜀汉边境安全。；密谋揭晓：准备守约"},{"id":12626,"turn":18,"type":"decision_revealed","factionId":"wu","message":"吴：许昌乃江东门户，曹贼屡施诈和，孤绝不与谋。与蜀戮力同心，共讨篡逆，克复中原！ 决策理由：许昌守军仅3、城防0，围城进度1/3已严重削弱其防御。柴桑发兵5击之，胜算极大。接受蜀联攻提议续盟并获战斗加成，拒绝魏之和议诱降。；密谋揭晓：准备守约"},{"id":12627,"turn":18,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":12628,"turn":18,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":12629,"turn":18,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":12630,"turn":18,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 4 兵力"},{"id":12631,"turn":18,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 7 兵力"},{"id":12632,"turn":18,"type":"city_pacified","factionId":"wu","message":"许昌多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":12633,"turn":18,"type":"city_captured","factionId":"wu","message":"吴 攻占许昌，损失 2 兵力","payload":{"cityId":"xuchang","defenderFactionId":"wei","sourceCityId":"chaisang","targetCityId":"xuchang","troops":5}},{"id":12634,"turn":18,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":12635,"turn":18,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":12636,"turn":19,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":12637,"turn":19,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":12638,"turn":19,"type":"turn_prepared","factionId":null,"message":"第 19 回合（决战阶段）收入与维持已结算"},{"id":12639,"turn":19,"type":"decision_revealed","factionId":"wei","message":"魏：孤今率洛阳精兵夺回许昌，并愿与蜀汉罢兵，不再为吴火中取栗。 决策理由：许昌为中原锁钥，吴据此则魏受制。趁吴蜀同盟破裂，先夺许昌救孤，再向蜀停战以稳宛城，避免两线受敌。；密谋揭晓：准备守约"},{"id":12640,"turn":19,"type":"decision_revealed","factionId":"shu","message":"蜀：孤奉汉室明诏讨篡逆，今兴汉中锐旅取宛城，愿与吴侯续盟同心，共破曹瞒，兴复汉室！ 决策理由：宛城为曹魏西线门户，窥我汉中，围城进度已足，今以主力攻取可破魏屏障，保障蜀汉边境；旧盟到期，续盟东吴共讨曹魏，维系同盟大局。；密谋揭晓：准备守约"},{"id":12641,"turn":19,"type":"decision_revealed","factionId":"wu","message":"吴：吴蜀盟约虽满，柴桑当江东门户，孤今增兵固防，以保三江之险。 决策理由：吴蜀盟约届满，柴桑毗邻蜀江州，亟需增兵。征柴桑6兵，使其驻军达7、防力8。江东根本稳固，方可相机而动。魏困于宛城、洛阳，自保不暇；蜀虽毁约于前，暂不轻绝亦不轻许。；密谋揭晓：无隐秘意图"},{"id":12642,"turn":19,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":12643,"turn":19,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":12644,"turn":19,"type":"attack_repulsed","factionId":"wei","message":"魏 进攻许昌失败，进攻方损失 4，守方损失 2，城防降低 1 级","payload":{"sourceCityId":"luoyang","targetCityId":"xuchang","troops":6}},{"id":12645,"turn":19,"type":"city_captured","factionId":"shu","message":"蜀 攻占宛城，损失 3 兵力","payload":{"cityId":"wancheng","defenderFactionId":"wei","sourceCityId":"hanzhong","targetCityId":"wancheng","troops":10}},{"id":12646,"turn":19,"type":"character_captured","factionId":"shu","message":"张辽在城破后被蜀俘虏"},{"id":12647,"turn":20,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":12648,"turn":20,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":12649,"turn":20,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":12650,"turn":20,"type":"turn_prepared","factionId":null,"message":"第 20 回合（决战阶段）收入与维持已结算"}],"createdAt":"2026-08-17T02:10:06.381Z","updatedAt":"2026-08-17T02:39:21.130Z","exportedAt":"2026-0
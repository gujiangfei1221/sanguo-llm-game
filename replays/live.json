Id":"xuchang","progress":1,"lastPressureTurn":11}],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":6716,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":6717,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯若能共击蜀汉，中原与江东两路夹击，可速定西川。此乃互利之盟。 决策理由：魏初据中原，宜先固本强兵。许昌为都，发展商贸可增岁入，为后续征募与扩军储备资财。同时向吴提出共击蜀汉，牵制汉中，为我夺取汉中创造时机。；密谋揭晓：准备守约"},{"id":6718,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：备以兴复汉室为己任，曹操窃据中原图谋不轨，愿与江东孙氏缔结盟约，同心破曹，共安天下黎民。 决策理由：汉中是我方对抗曹魏的前线，第一回合优先发展军事巩固边防，符合蓄势阶段需求；主动结盟东吴，契合我方联合弱者对抗曹操的战略。；密谋揭晓：准备守约"},{"id":6719,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，秣马厉兵以固疆土。愿与江州守望相助，共安天下。 决策理由：柴桑乃江东门户，北临许昌、东接江州，亟需以军政专精固我根基。本回合无即时城破之危，宜先专精后拓土，稳中求进。；密谋揭晓：准备守约"},{"id":6720,"turn":1,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":6721,"turn":1,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":6722,"turn":1,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":6723,"turn":1,"type":"develop_city","factionId":"wei","message":"魏 将许昌建设为商贸专精 1 级"},{"id":6724,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 1 级"},{"id":6725,"turn":1,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 1 级"},{"id":6726,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":6727,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：孤已增兵宛城，枕戈待旦。若吴侯愿践前约，共击蜀汉，则两路并进，汉中可定。若吴侯另有考量，孤亦当自固疆土。 决策理由：宛城为对蜀前线，征兵5以固边防并为联合攻蜀预作准备；继续向吴提议联合攻蜀，若吴应允则下回合依约进攻汉中。；密谋揭晓：准备守约"},{"id":6728,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：备以兴复汉室为己任，曹贼窃据中原祸乱苍生，今愿与江东孙将军结为同盟，同心共力讨灭曹逆，共安天下。 决策理由：汉中为抗魏前线，升级军事专精可巩固边防；接纳东吴同盟提议，顺应联合弱者对抗曹魏的战略，结盟后提议共伐曹操，符合我方兴复汉室的目标。；密谋揭晓：准备守约"},{"id":6729,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：江东孙氏与刘皇叔共续抗曹之谊，誓守同盟。柴桑要塞正加筑军备，以固江东门户，拒曹军于长江之北。 决策理由：拒魏之邀攻蜀——曹贼借刀杀人，弱蜀则吴独面中原之祸。纳蜀之盟——孙刘联合，共享长江、汉中地利，可分兵牵制许昌。柴桑续升军镇，巩固北大门，专精不可逆，稳步为上。；密谋揭晓：准备守约"},{"id":6730,"turn":2,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":6731,"turn":2,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":6732,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":6733,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":6734,"turn":2,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":6735,"turn":2,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 2 级"},{"id":6736,"turn":2,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 2 级"},{"id":6737,"turn":2,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":6738,"turn":3,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":6739,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":6740,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：许昌为中原腹心，北御强吴、西拒蜀汉，不可不厚其兵。孤今增兵许昌，以固根本。 决策理由：吴蜀已同盟，许昌紧邻柴桑，需加强守备以防东吴突袭。本回合优先在许昌征兵，增强都城防御，为后续攻守做准备。；密谋揭晓：无隐秘意图"},{"id":6741,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窃据中原，妄称天命，残害苍生。备与孙将军同盟共讨逆贼，今整兵汉中固边，同心破曹，兴复汉室！ 决策理由：曹魏屯兵宛城窥伺汉中，汉中有被攻占之危，增兵巩固前线边防；接受东吴联合攻魏提议，恪守孙刘同盟，符合讨贼兴汉目标。；密谋揭晓：准备守约"},{"id":6742,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：江东秣马厉兵，北望中原。与皇叔戮力同心，曹贼可图。 决策理由：蜀吴联盟既定，共击曹贼乃上策。柴桑为北伐前进之基，亟需厚兵；招募七卒以充驻军，待联合进攻生效后出大军攻关许昌。；密谋揭晓：准备守约"},{"id":6743,"turn":3,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":6744,"turn":3,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":6745,"turn":3,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 7 兵力"},{"id":6746,"turn":3,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":6747,"turn":3,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 7 兵力"},{"id":6748,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":6749,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：中原稳固，许昌乃根本之地，继续充实商贸以裕国用，待敌情明朗再行进取。 决策理由：当前无城可被敌直接攻破，暂不宜轻启战端。许昌商业已有基础，升级可增岁入，为后续扩军和应对吴蜀同盟积累资源。；密谋揭晓：无隐秘意图"},{"id":6750,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窃据中原，妄称天命，残害苍生。备与孙将军同盟同心，今日兴义兵伐逆，誓清中原，兴复汉室！ 决策理由：践行蜀吴联合攻魏约定，出兵攻取曹魏窥伺汉中的前沿重镇宛城，巩固同盟信任，推进讨曹兴汉大业。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":6751,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：江东精甲十万，今承同盟之约，与皇叔并力北伐。柴桑大军已发，直指许昌，曹贼授首在此一举！ 决策理由：孙刘联合攻魏之约于第5回合截止，本回合乃履约之机。柴桑军镇专精二级、驻军十五，以十四兵出击许昌，留一兵守城；许昌虽驻军十三有城防，然我挟军镇之利与盟军西线牵制，可一战而下。边境威胁已核算，柴桑余一兵亦不致被破。；密谋揭晓：准备守约"},{"id":6752,"turn":4,"type":"develop_city","factionId":"wei","message":"魏 将许昌建设为商贸专精 2 级"},{"id":6753,"turn":4,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 9，守方损失 6，城防降低 1 级","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":14}},{"id":6754,"turn":4,"type":"character_fallen","factionId":"shu","message":"关羽在惨烈战斗中阵亡"},{"id":6755,"turn":4,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 9，守方损失 6，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":14}},{"id":6756,"turn":4,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":6757,"turn":4,"type":"joint_attack_honored","factionId":null,"message":"吴与蜀兑现承诺，共同进攻魏"},{"id":6758,"turn":4,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":6759,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":6760,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：孤已加强许昌守备。吴蜀连兵犯境，虽败犹锐，今愿与吴侯罢兵，以免两败俱伤。若吴侯无意，孤亦不惧再战。 决策理由：许昌为都，吴军新败仍存威胁，自洛阳调兵加强守备。同时向吴提出停战，意在拆散吴蜀同盟、集中应对西线。若吴不应，则凭坚城御敌。；密谋揭晓：准备守约"},{"id":6761,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窃据中原，残害苍生，备与吴侯同心同盟，共举义兵讨逆，今再出锐师取宛城，誓清中原，兴复汉室！ 决策理由：恪守孙刘同盟约定，继续进攻曹魏宛城前沿据点，削弱魏西线防御，巩固汉中边防，维系同盟信任，推进讨曹兴汉大业。；密谋揭晓：准备守约"},{"id":6762,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：周瑜虽殁，江东基业不可动摇。柴桑增兵固防，以待天时。 决策理由：周瑜阵亡、柴桑折损九卒，前线骤虚，亟需重整。柴桑为江东北大门，军镇专精二级不可轻弃；征募七卒以复元气，待机再图中原。盟约尚在，联攻已践，暂养精蓄锐以观曹贼之变。；密谋揭晓：无隐秘意图"},{"id":6763,"turn":5,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":6764,"turn":5,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 7 兵力"},{"id":6765,"turn":5,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 3，守方损失 3，围城进度升至 1/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":5}},{"id":6766,"turn":5,"type":"transfer","factionId":"wei","message":"魏 从洛阳向许昌调动 7 兵力","payload":{"sourceCityId":"luoyang","targetCityId":"xuchang","troops":7}},{"id":6767,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"},{"id":6768,"turn":6,"type":"decision_revealed","factionId":"wei","message":"魏：宛城屡遭蜀军侵扰，孤今增兵五营以固西陲。同时遣使入蜀，愿与刘备罢兵息民；若其不允，则唯有一战。 决策理由：宛城被围且城防受损，需增兵防守以防蜀军再犯；向蜀提出停战以拆解两线压力，若蜀同意则可专对东吴。；密谋揭晓：无隐秘意图"},{"id":6769,"turn":6,"type":"decision_revealed","factionId":"shu","message":"蜀：备以兴复汉室为己任，与孙吴同盟共讨曹贼，今整兵汉中，誓清中原，同力破贼，绝不背约。 决策理由：恪守孙刘同盟约定，增兵前线汉中，维持对曹魏宛城的围城施压，巩固西线边防，维系同盟信任，推进讨曹兴汉大业。；密谋揭晓：准备守约"},{"id":6770,"turn":6,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼新败求和，岂可信哉！许昌城防已破，正天假我以讨贼之机。柴桑精甲已发，与皇叔并力，定当一鼓而下中原！ 决策理由：许昌城防归零、驻军虽十四而商贸专精二级，是中原腹心，值此良机不可失。以柴桑军镇十二精兵出击，留一兵守城；边境核算确认安全。拒魏停战以保攻势，续联蜀共击。；密谋揭晓：准备守约"},{"id":6771,"turn":6,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":6772,"turn":6,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":6773,"turn":6,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":6774,"turn":6,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 7 兵力"},{"id":6775,"turn":6,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 8，守方损失 6，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":12}},{"id":6776,"turn":6,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":6777,"turn":7,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":6778,"turn":7,"type":"turn_prepared","factionId":null,"message":"第 7 回合（蓄势阶段）收入与维持已结算"},{"id":6779,"turn":7,"type":"decision_revealed","factionId":"wei","message":"魏：孤以中原为念，不愿与吴久耗。许昌已固，宛城可守；若吴侯肯罢兵，魏吴可共讨蜀汉，各安其土。 决策理由：当前许昌、宛城均无被破之虞，然两线受敌非长久之计。先在许昌征兵五营巩固根本，并向吴提出停战，以拆散吴蜀旧盟；若吴应允，下回合可专力对蜀。；密谋揭晓：无隐秘意图"},{"id":6780,"turn":7,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉，求和乃是缓兵诡计，备誓与吴侯同心讨贼，不清中原不止，不兴汉室不休！ 决策理由：拒绝曹魏停战缓兵之计，续盟东吴维持联吴抗曹大局，出兵进攻宛城继续施压，巩固汉中边防，推进讨曹兴汉大业。；密谋揭晓：准备守约"},{"id":6781,"turn":7,"type":"decision_revealed","factionId":"wu","message":"吴：周瑜虽殁，江东基业不可动摇。吾已重整柴桑之防，并遣使入蜀，恳请皇叔续盟同心，共讨曹贼。 决策理由：柴桑前线仅余五卒，亟需补强以固江东北大门。征募四卒后柴桑可达九兵，边境核算已无忧。同盟虽已届满，蜀乃唇齿之邦，当遣使续盟以保两面夹击之势。；密谋揭晓：准备守约"},{"id":6782,"turn":7,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":6783,"turn":7,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":6784,"turn":7,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":6785,"turn":7,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":6786,"turn":7,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 4 兵力"},{"id":6787,"turn":7,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 6，守方损失 4，围城进度升至 2/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":9}},{"id":6788,"turn":8,"type":"turn_prepared","factionId":null,"message":"第 8 回合（蓄势阶段）收入与维持已结算"},{"id":6789,"turn":8,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯若肯罢兵结盟，魏吴共击蜀汉，平分其地；若执意助蜀，则两线皆战，胜负未可知。 决策理由：宛城受蜀军围城压力，征兵加强守备；同时向吴示好，以拆散吴蜀同盟，为专力对蜀创造条件。；密谋揭晓：暗中寻求议和"},{"id":6790,"turn":8,"type":"decision_revealed","factionId":"shu","message":"蜀：吾与吴侯唇齿相依，同心讨曹，今续盟修好，共举义兵，誓清汉贼，兴复汉室！ 决策理由：接受东吴续盟提议，巩固联吴抗曹大局，征募兵力充实汉中前线，维持对宛城的围城施压，推进讨曹兴汉大业。；密谋揭晓：准备守约"},{"id":6791,"turn":8,"type":"decision_revealed","factionId":"wu","message":"吴：周郎虽逝，江东之志不灭。今再整柴桑精甲攻许昌，续盟皇叔共讨曹贼，誓不与篡汉者同列。 决策理由：许昌围城进度1/3，若本回合不施压则下回合开始衰减，前功尽弃。以柴桑八兵出击维持攻势，同时续盟蜀汉、拒魏求和，保持两线夹击态势。；密谋揭晓：准备守约"},{"id":6792,"turn":8,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":6793,"turn":8,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":6794,"turn":8,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":6795,"turn":8,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":6796,"turn":8,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":6797,"turn":8,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":6798,"turn":8,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 6 兵力"},{"id":6799,"turn":8,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":6800,"turn":8,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 5，守方损失 5，围城进度升至 2/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":8}},{"id":6801,"turn":9,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":6802,"turn":9,"type":"turn_prepared","factionId":null,"message":"第 9 回合（争锋阶段）收入与维持已结算"},{"id":6803,"turn":9,"type":"decision_revealed","factionId":"wei","message":"魏：柴桑空虚，孤今取之！江东鼠辈只知趁虚偷袭，今教其知中原之威。若吴侯识时务，当速退兵，否则柴桑既失，建业亦难保。 决策理由：吴军主力已疲，柴桑仅余四卒，正是破其东线之机。以许昌七军攻柴桑，若下，许昌围解，且可直逼江东腹地；宛城十军坚守，足御蜀军。；密谋揭晓：无隐秘意图"},{"id":6804,"turn":9,"type":"decision_revealed","factionId":"shu","message":"蜀：备与吴侯唇齿同心，共讨篡汉曹贼，今发汉中精锐攻取宛城，清中原而复汉祚，义不旋踵！ 决策理由：恪守吴蜀同盟，响应联合攻魏约定，出兵进攻宛城维持围城施压，巩固同盟信任，推进讨曹兴汉大业。；密谋揭晓：准备守约"},{"id":6805,"turn":9,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑乃江东门户，必固守之。今再添精卒三营，严阵以待曹贼。联蜀讨魏之约，孙某铭记于心，绝不相负。 决策理由：柴桑前线驻军仅四，面临魏军自许昌反击之虞，亟需补强。本回合征募三卒，使柴桑达七人以上，可稳妥应对魏军可能的来犯
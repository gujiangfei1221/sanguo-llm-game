troops":8}},{"id":5400,"turn":10,"type":"mobilize","factionId":"wu","message":"吴向柴桑战略集结 8 兵"},{"id":5401,"turn":11,"type":"turn_prepared","factionId":null,"message":"第 11 回合（争锋阶段）收入与维持已结算"},{"id":5402,"turn":11,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀联军犯境，许昌乃中原根本，孤今日急募勇士固守。若吴侯愿罢兵修好，孤亦可共图天下。 决策理由：许昌正被吴军围城，柴桑可出12兵，现有7兵恐难守，故紧急征兵5人加强城防；宛城暂无破城之危，暂不动。其余兵马待后续调动。；密谋揭晓：无隐秘意图"},{"id":5403,"turn":11,"type":"decision_revealed","factionId":"shu","message":"蜀：备与吴侯同仇敌忾，共讨篡汉逆曹，今增兵巩固伐魏前线，誓复汉室，救还云长。 决策理由：汉中为西线伐魏要地，当前有被魏军攻占之险，调江州精兵增援巩固边防，续行联吴抗曹盟约，共图灭魏。；密谋揭晓：准备守约"},{"id":5404,"turn":11,"type":"decision_revealed","factionId":"wu","message":"吴：许昌城防空虚、围城已逾二分之期，江东十二精甲克日攻城，必破曹贼中原门户！西蜀盟友，权当与诸公共襄义举。 决策理由：许昌防御0、围城2/3、驻军7，柴桑13兵出12全力一击，预期破城。破城获金4粮6，并可觊觎关羽。接受蜀联合攻魏提议以维同盟，促其牵制魏西线。柴桑留1兵，borderThreat显示敌无力破城。；密谋揭晓：准备守约"},{"id":5405,"turn":11,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":5406,"turn":11,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":5407,"turn":11,"type":"city_captured","factionId":"wu","message":"吴 攻占许昌，损失 5 兵力","payload":{"cityId":"xuchang","defenderFactionId":"wei","sourceCityId":"chaisang","targetCityId":"xuchang","troops":12}},{"id":5408,"turn":11,"type":"character_captured","factionId":"wu","message":"曹操在城破后被吴俘虏"},{"id":5409,"turn":11,"type":"mobilize","factionId":"shu","message":"蜀向汉中战略集结 3 兵"},{"id":5410,"turn":11,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":5411,"turn":12,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":5412,"turn":12,"type":"turn_prepared","factionId":null,"message":"第 12 回合（争锋阶段）收入与维持已结算"},{"id":5413,"turn":12,"type":"decision_revealed","factionId":"wei","message":"魏：许昌虽失，中原根本未动。孤先固守洛阳，再图良策。若吴侯愿和，曹某亦可释怨共谋天下。 决策理由：许昌陷落、曹操被俘，当前两线受敌，不宜贸然反攻。洛阳为最后重镇，紧急征兵5人强化城防，同时向吴提出停战，争取外交空间，避免吴蜀夹击。；密谋揭晓：无隐秘意图"},{"id":5414,"turn":12,"type":"decision_revealed","factionId":"shu","message":"蜀：备与吴侯同践盟约，兴师伐魏攻取宛城，誓清篡汉逆贼，救还吾弟云长，光复汉室！ 决策理由：履行与东吴的联合攻魏盟约，从汉中出兵攻打曹魏宛城，推进西线伐魏进度，牵制曹魏兵力，呼应吴军攻势，维系同盟信义。；密谋揭晓：准备守约"},{"id":5415,"turn":12,"type":"decision_revealed","factionId":"wu","message":"吴：许昌既定，治本安民。江东愿与北方息战，各守疆界，共待时变。 决策理由：建业为江东根本，升商业专精厚植国力以备战。乘曹操被囚之际向魏议和稳定北线，留待蜀盟约到期后观其动向。；密谋揭晓：无隐秘意图"},{"id":5416,"turn":12,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 2 级"},{"id":5417,"turn":12,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":5418,"turn":12,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 4，守方损失 3，围城进度升至 2/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":6}},{"id":5419,"turn":13,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":5420,"turn":13,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":5421,"turn":13,"type":"turn_prepared","factionId":null,"message":"第 13 回合（争锋阶段）收入与维持已结算"},{"id":5422,"turn":13,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯既有诚意，孤愿应允停战。今先固宛城，防蜀军再犯。若吴不背盟，魏亦不犯吴。 决策理由：宛城面临吴军自许昌来攻之危，故募兵补强；同时接受吴方停战，避免两线作战，争取时间稳固中原。；密谋揭晓：准备守约"},{"id":5423,"turn":13,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃据神器，掳吾弟云长，蜀汉秉持大义整军，愿再与吴侯缔盟，共讨国贼，光复汉室。 决策理由：宛城围城进度已达三分之二，汉中作为伐魏前线急需补充兵力，重新与吴缔结同盟，延续联吴抗曹方略，为攻取宛城做好准备。；密谋揭晓：准备守约"},{"id":5424,"turn":13,"type":"decision_revealed","factionId":"wu","message":"吴：曹氏新败，洛阳孤悬，江东暂受其好，乘时缮兵。与蜀重续旧盟，固我屏藩。 决策理由：许昌新得驻七，魏自洛阳犹可反扑；受其停战以固新得，并征吴郡五兵厚实后备。蜀盟已失，即发新约以维东线无忧。Cao Cao仍囚为后手。；密谋揭晓：准备守约"},{"id":5425,"turn":13,"type":"diplomacy_response","factionId":"wei","message":"魏接受了 吴 的停战提议"},{"id":5426,"turn":13,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":5427,"turn":13,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的停战提议"},{"id":5428,"turn":13,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":5429,"turn":13,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 3 兵力"},{"id":5430,"turn":13,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 7 兵力"},{"id":5431,"turn":13,"type":"recruit","factionId":"wu","message":"吴 在吴郡征募 5 兵力"},{"id":5432,"turn":14,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":5433,"turn":14,"type":"turn_prepared","factionId":null,"message":"第 14 回合（争锋阶段）收入与维持已结算"},{"id":5434,"turn":14,"type":"decision_revealed","factionId":"wei","message":"魏：宛城难守，孤不争一城之失。今急募洛阳精兵固守根本，并愿与蜀休战，各安疆土，徐图后计。 决策理由：蜀军围宛城且本回合可破，增援不及；故收缩防线，在洛阳募兵5人强化根本。同时向蜀提议停战，争取时间重整，待曹操归位再图中原。；密谋揭晓：准备守约"},{"id":5435,"turn":14,"type":"decision_revealed","factionId":"shu","message":"蜀：孤承汉祚，志在灭曹复汉，今与吴侯重缔同盟，共讨篡汉逆贼，兴师攻取宛城，救还云长，匡扶汉室社稷。 决策理由：接受东吴同盟提议，延续联吴抗曹既定方略，从汉中出兵强攻宛城，延续围城进度，推进伐魏进度，兑现同盟义务，蚕食曹魏领土。；密谋揭晓：准备守约"},{"id":5436,"turn":14,"type":"decision_revealed","factionId":"wu","message":"吴：江东与蜀重续盟好，共维汉室。柴桑增兵以固西线，备他日之图。 决策理由：蜀汉重提盟约，吴允之以固屏藩、共图中原。停战尚余二回合，许昌暂安。柴桑为西进要冲，急征六兵充实前线，待停战期满与蜀共伐残魏。曹操仍囚不释，留作后手。；密谋揭晓：准备守约"},{"id":5437,"turn":14,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":5438,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":5439,"turn":14,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":5440,"turn":14,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":5441,"turn":14,"type":"city_captured","factionId":"shu","message":"蜀 攻占宛城，损失 3 兵力","payload":{"cityId":"wancheng","defenderFactionId":"wei","sourceCityId":"hanzhong","targetCityId":"wancheng","troops":9}},{"id":5442,"turn":15,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":5443,"turn":15,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":5444,"turn":15,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":5445,"turn":15,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":5446,"turn":15,"type":"turn_prepared","factionId":null,"message":"第 15 回合（争锋阶段）收入与维持已结算"},{"id":5447,"turn":15,"type":"decision_revealed","factionId":"wei","message":"魏：魏愿与蜀休战，互不侵犯，以安黎民。 决策理由：魏仅余洛阳，需休整并防吴军；向蜀提出停战以避免两线作战。；密谋揭晓：准备守约"},{"id":5448,"turn":15,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，掳吾弟云长，蜀汉奉汉室大义讨贼，岂容曹贼缓兵之计！吾与吴侯共守盟约，誓灭曹逆，光复汉室江山。 决策理由：魏贼战败乞和意在重整军力，我蜀汉志在灭曹复汉，绝不接受停战。在汉中前线募兵补强伐魏军力，践行与吴的同盟约定，筹备进取中原。；密谋揭晓：准备守约"},{"id":5449,"turn":15,"type":"decision_revealed","factionId":"wu","message":"吴：许昌新定人心未固，增兵以安城防。江东愿与中原息战各安疆土，共待时变。 决策理由：许昌7守不足魏所需8.05之数，有陷落之危。故征许昌4兵使城守升至11，超敌所需，方保新得之土。同步向魏提议结盟并暗示可还曹公，以外交缓解北线压力。曹操仍囚为后手，视魏回复再定去就。；密谋揭晓：无隐秘意图"},{"id":5450,"turn":15,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":5451,"turn":15,"type":"alliance_proposed","factionId":"wu","message":"吴 向 魏 提议结盟"},{"id":5452,"turn":15,"type":"recruit","factionId":"wu","message":"吴 在许昌征募 4 兵力"},{"id":5453,"turn":15,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 3 兵力"},{"id":5454,"turn":15,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":5455,"turn":16,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":5456,"turn":16,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":5457,"turn":16,"type":"turn_prepared","factionId":null,"message":"第 16 回合（争锋阶段）收入与维持已结算"},{"id":5458,"turn":16,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯既有诚意，孤愿应允结盟。刘备窃据中原，图谋不轨，愿与吴侯共讨之。 决策理由：魏仅余洛阳，需联合吴国制衡蜀国扩张。接受结盟以稳定北线，同时试探吴国是否有意共同对抗蜀国。；密谋揭晓：准备守约"},{"id":5459,"turn":16,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉犯我新得宛城，孤今增兵固守，誓与吴侯共讨逆贼，光复汉室河山。 决策理由：宛城新附，魏贼自洛阳来攻，城池有失陷之危，故调汉中精兵增援宛城，固守疆土，践行联吴抗曹大义。；密谋揭晓：准备守约"},{"id":5460,"turn":16,"type":"decision_revealed","factionId":"wu","message":"吴：许昌城防已固，江东士民可安。 决策理由：停战已止，许昌面临洛阳魏军威胁，加固城防以守疆土。向魏重申和平意愿并暗示释曹，争取外交缓冲。（外交行为不在当前白名单中，已忽略）；密谋揭晓：暗中寻求议和"},{"id":5461,"turn":16,"type":"diplomacy_response","factionId":"wei","message":"魏接受了 吴 的结盟提议"},{"id":5462,"turn":16,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":5463,"turn":16,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 1 兵力"},{"id":5464,"turn":16,"type":"fortify","factionId":"wu","message":"吴 加固了许昌城防"},{"id":5465,"turn":16,"type":"transfer","factionId":"shu","message":"蜀 从汉中向宛城调动 5 兵力","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":5}},{"id":5466,"turn":17,"type":"diplomacy_changed","factionId":null,"message":"魏 与 吴 的关系变为同盟"},{"id":5467,"turn":17,"type":"ceasefire_expired","factionId":null,"message":"魏 与 吴 的停战到期"},{"id":5468,"turn":17,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":5469,"turn":17,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":5470,"turn":17,"type":"turn_prepared","factionId":null,"message":"第 17 回合（争锋阶段）收入与维持已结算"},{"id":5471,"turn":17,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯，孤已率洛阳精兵进攻宛城，践共击蜀国之约。待宛城克复，愿与吴共分蜀土。 决策理由：宛城守军十一而城防未固，孤以洛阳精兵十四人攻之，留八人守洛阳以固根本；此举可断蜀军西进之路，亦兑现与吴共击蜀国之约。；密谋揭晓：准备守约"},{"id":5472,"turn":17,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃据洛阳，掳吾二弟关羽，孤今提宛城锐旅直捣黄龙，复汉室旧都，救手足归营！ 决策理由：魏陈重兵于洛阳，虎视我新得宛城，防守不如主动出击，直捣曹魏根本，一举歼灭残魏，践行与吴的同盟盟约，光复汉家疆土。；密谋揭晓：准备守约"},{"id":5473,"turn":17,"type":"decision_revealed","factionId":"wu","message":"吴：蜀汉背信弃义，袭我友邦城池。江东与魏修好，共兴义师，诛此不义。 决策理由：蜀据宛城威胁江东侧翼，值魏吴新盟之际，允魏所请共伐蜀汉。柴桑出兵六千袭取江州，固西陲屏障，曹操仍囚不释留作后手。；密谋揭晓：准备守约"},{"id":5474,"turn":17,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的联合进攻提议"},{"id":5475,"turn":17,"type":"alliance_betrayed","factionId":"wu","message":"吴突然背盟，转而对蜀动手，声望大降"},{"id":5476,"turn":17,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻洛阳失败，进攻方损失 6，守方损失 7","payload":{"sourceCityId":"wancheng","targetCityId":"luoyang","troops":10}},{"id":5477,"turn":17,"type":"city_captured","factionId":"wu","message":"吴 攻占江州，损失 2 兵力，获得联合进攻加成","payload":{"cityId":"jiangzhou","defenderFactionId":"shu","sourceCityId":"chaisang","targetCityId":"jiangzhou","troops":6}},{"id":5478,"turn":17,"type":"character_captured","factionId":"wu","message":"张飞在城破后被吴俘虏"},{"id":5479,"turn":17,"type":"city_captured","fact
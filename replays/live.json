":[{"id":40509,"turn":38,"type":"decision_revealed","factionId":"wu","message":"吴：曹操在握，江东已固。今魏势倾天下，孤欲与蜀共修盟好，同扶汉室，共抗强魏。 决策理由：魏吴盟约T39届满，导演明示魏势已成天下共敌。江州新克，集江州6兵于柴桑完成战略集结，拥9兵配军事专精可攻可守。审时度势当断则断，先发制人邀蜀共击强魏，以保江东基业。；密谋揭晓：准备守约"},{"id":40510,"turn":38,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":40511,"turn":38,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":40512,"turn":38,"type":"city_pacified","factionId":"wei","message":"成都多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":40513,"turn":38,"type":"city_captured","factionId":"wei","message":"魏 攻占成都，损失 2 兵力","payload":{"cityId":"chengdu","defenderFactionId":"shu","sourceCityId":"hanzhong","targetCityId":"chengdu","troops":6}},{"id":40514,"turn":38,"type":"character_captured","factionId":"wei","message":"赵云在城破后被魏俘虏"},{"id":40515,"turn":38,"type":"mobilize","factionId":"wu","message":"吴向柴桑战略集结 6 兵"},{"id":40516,"turn":39,"type":"decisive_alliance_ended","factionId":null,"message":"魏 与 吴 的同盟因进入两强决战而终止"},{"id":40517,"turn":39,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 8 金、10 粮"},{"id":40518,"turn":39,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":40519,"turn":39,"type":"turn_prepared","factionId":null,"message":"第 39 回合（决战阶段）收入与维持已结算"},{"id":40520,"turn":39,"type":"decision_revealed","factionId":"wei","message":"魏：吴军压境许昌，孤当机立断，紧急征募三营以固国都。许昌乃社稷根本，不容有失，待守势既定，必图江州、灭吴。 决策理由：许昌当前有被吴军攻占之险，必须立即补强。国库尚有九千金、二百余粮，可承受强征代价；许昌若失则根基动摇，故选择强征三营守城。；密谋揭晓：无隐秘意图"},{"id":40521,"turn":39,"type":"decision_revealed","factionId":"wu","message":"吴：魏吴盟约已尽，霸业当自决。孤据江东之利，今集柴桑精锐北出许昌，誓断魏之东西两线，一统天下！ 决策理由：决战已启，许昌仅1兵城防1，是魏最弱一环。柴桑拥9兵加军事专精，全力一击必克，留1兵守要塞。纵使江州遭魏成都之兵反扑而失，以许昌易之仍为四城，且许昌为魏旧都，攻之可乱其军心、断其东西联络，战略价值远胜江州。；密谋揭晓：准备守约"},{"id":40522,"turn":39,"type":"forced_levy","factionId":"wei","message":"魏 在许昌强征 3 兵力，城市发展受损"},{"id":40523,"turn":39,"type":"city_pacified","factionId":"wu","message":"许昌多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":40524,"turn":39,"type":"city_captured","factionId":"wu","message":"吴 攻占许昌，损失 3 兵力","payload":{"cityId":"xuchang","defenderFactionId":"wei","sourceCityId":"chaisang","targetCityId":"xuchang","troops":8}},{"id":40525,"turn":40,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":40526,"turn":40,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":40527,"turn":40,"type":"turn_prepared","factionId":null,"message":"第 40 回合（决战阶段）收入与维持已结算"},{"id":40528,"turn":40,"type":"decision_revealed","factionId":"wei","message":"魏：吴军压境，孤先固洛阳根本，再图反攻。赵云若归，如虎添翼。 决策理由：许昌已失，洛阳与宛城均受吴军威胁。洛阳为都城，不容有失，故从成都调兵五营驰援，确保守备。同时尝试招降赵云以增强实力。；密谋揭晓：无隐秘意图"},{"id":40529,"turn":40,"type":"decision_revealed","factionId":"wu","message":"吴：许昌兵北上江州，巩固西线屏障。张飞久慕江东，今归麾下，共图大业。 决策理由：江州遭魏成都6兵威胁，capturePossible为true。调许昌6兵北上，江州集7兵配城防可稳御魏军，舍许昌1兵留守都无虞。同步招降忠诚归零的张飞，易成，添一猛将。；密谋揭晓：准备守约"},{"id":40530,"turn":40,"type":"mobilize","factionId":"wu","message":"吴向江州战略集结 6 兵"},{"id":40531,"turn":40,"type":"mobilize","factionId":"wei","message":"魏向洛阳战略集结 5 兵"},{"id":40532,"turn":41,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 3 金、4 粮"},{"id":40533,"turn":41,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 0 金、7 粮"},{"id":40534,"turn":41,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":40535,"turn":41,"type":"turn_prepared","factionId":null,"message":"第 41 回合（决战阶段）收入与维持已结算"},{"id":40536,"turn":41,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃我旧都，曹公陷于敌手。今以洛阳精锐五营急击许昌，必复国都、救主公；西线暂守，待破吴后回援。 决策理由：集中兵力夺回许昌，切断吴军东西呼应；洛阳留一营守备。西部汉中、成都有被江州吴军威胁，但当前首要任务是收复旧都并救回曹操。；密谋揭晓：无隐秘意图"},{"id":40537,"turn":41,"type":"decision_revealed","factionId":"wu","message":"吴：魏寇西陲，孤当先发制人，集江州精锐北出汉中，断魏右臂，一统天下在此一举！ 决策理由：决战已启，魏主力龟缩洛阳6兵，许昌1兵城防1必被夺回不可守。汉中仅1兵0城防最为虚弱，江州7兵遣6出击必克，可夺城拓土并打通宛城-成都第二战线。克汉中后下回合可攻宛城直逼洛阳，或南下成都扩大战果。；密谋揭晓：无隐秘意图"},{"id":40538,"turn":41,"type":"city_pacified","factionId":"wei","message":"许昌多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":40539,"turn":41,"
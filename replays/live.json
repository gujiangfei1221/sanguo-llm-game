公休兵携手，共讨逆贼，兴复汉室。 决策理由：宛城遭魏吴两面威胁，失守则许都难保，调许昌精锐增援宛城固防。接受魏公停战提议，邀约魏公共伐背盟吴贼，顺承大义以图共安天下。；密谋揭晓：准备守约"},{"id":27950,"turn":32,"type":"decision_revealed","factionId":"wu","message":"吴：秣马厉兵，安境保民，与魏共修盟好。 决策理由：吴郡紧邻柴桑，若柴桑有失则直接暴露于蜀军锋芒。今募兵五以实郡治，备不虞之患。魏与我素无仇怨，信任已厚，结盟可固北疆。；密谋揭晓：无隐秘意图"},{"id":27951,"turn":32,"type":"diplomacy_response","factionId":"wei","message":"魏拒绝了 蜀 的联合进攻提议"},{"id":27952,"turn":32,"type":"alliance_proposed","factionId":"wei","message":"魏 向 蜀 提议结盟"},{"id":27953,"turn":32,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 魏 的停战提议"},{"id":27954,"turn":32,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":27955,"turn":32,"type":"alliance_proposed","factionId":"wu","message":"吴 向 魏 提议结盟"},{"id":27956,"turn":32,"type":"recruit","factionId":"wu","message":"吴 在吴郡征募 5 兵力"},{"id":27957,"turn":32,"type":"transfer","factionId":"shu","message":"蜀 从许昌向宛城调动 4 兵力","payload":{"sourceCityId":"xuchang","targetCityId":"wancheng","troops":4}},{"id":27958,"turn":33,"type":"ceasefire_expired","factionId":null,"message":"魏 与 吴 的停战到期"},{"id":27959,"turn":33,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 4 金、4 粮"},{"id":27960,"turn":33,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":27961,"turn":33,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 4 金、0 粮"},{"id":27962,"turn":33,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 11 金、14 粮"},{"id":27963,"turn":33,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 7 金、0 粮"},{"id":27964,"turn":33,"type":"turn_prepared","factionId":null,"message":"第 33 回合（决战阶段）收入与维持已结算"},{"id":27965,"turn":33,"type":"decision_revealed","factionId":"wei","message":"魏：吴主盛意相邀，孤愿与吴结盟共安天下。蜀之联攻，魏军今无攻吴之路，不能虚诺，恕不从命。 决策理由：魏仅存洛阳，本回合无进攻路线，只能休整；拒绝蜀联攻以免失诺，接受吴盟以固北线、防吴扩张。；密谋揭晓：无隐秘意图"},{"id":27966,"turn":33,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，吴贼背盟窃我蜀汉故土，今与魏公缔盟同心，共讨逆贼，兴复汉室！ 决策理由：许昌守备空虚，本回合可被敌军攻占，调宛城劲旅增援许昌巩固
ionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":41035,"turn":13,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":41036,"turn":13,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 2 级"},{"id":41037,"turn":13,"type":"recruit","factionId":"wu","message":"吴 在建业征募 5 兵力"},{"id":41038,"turn":14,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":41039,"turn":14,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":41040,"turn":14,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":41041,"turn":14,"type":"turn_prepared","factionId":null,"message":"第 14 回合（争锋阶段）收入与维持已结算"},{"id":41042,"turn":14,"type":"decision_revealed","factionId":"wei","message":"魏：孤据洛阳，整军备武。吴蜀背盟相攻，实为虎狼之约。若孙权醒悟，愿弃前怨，共讨蜀汉，以安天下。 决策理由：洛阳为魏国最后根基，本回合征兵五人以固城防，确保不被蜀吴攻破。同时向吴提议联合攻蜀，意在离间吴蜀同盟，为魏争取喘息与转机。；密谋揭晓：无隐秘意图"},{"id":41043,"turn":14,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室后裔，今重结吴侯同盟，同心共讨篡汉逆曹，兴复汉室大业指日可待！招纳贤才益我王师，共清中原。 决策理由：吴侯续缔同盟之议契合我联吴抗曹、兴复汉室的方略，故而接受；招降魏将张辽增强我方实力，开发江州农业充实军粮，支撑后续讨曹战事。；密谋揭晓：准备守约"},{"id":41044,"turn":14,"type":"decision_revealed","factionId":"wu","message":"吴：曹操篡汉，天下共愤。权岂会与国贼议和？今在柴桑广募精兵，与蜀汉同心讨贼，待来日北定洛阳，克复中原。 决策理由：许昌围城已解，本回合无合法攻击选项。集中资源在柴桑征兵7以扩充前线打击力量，为下回合联蜀攻取洛阳做准备。拒绝魏停战提议，保持对魏军事压力。；密谋揭晓：准备守约"},{"id":41045,"turn":14,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":41046,"turn":14,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":41047,"turn":14,"type":"character_recruited","factionId":"shu","message":"张辽接受招降，转投蜀"},{"id":41048,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":41049,"turn":14,"type":"develop_city","factionId":"shu","message":"蜀 将江州建设为农桑专精 1 级"},{"id":41050,"turn":14,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 7 兵力"},{"id":41051,"turn":14,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":41052,"turn":15,"type":"diplomacy_changed"
:3179,"turn":2,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 2 级"},{"id":3180,"turn":2,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":3181,"turn":2,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 6 兵力"},{"id":3182,"turn":3,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":3183,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":3184,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：曹某厉兵秣马，先固许昌。若吴蜀执意来犯，必教其知中原之威。 决策理由：吴蜀联合攻魏至第4回合，许昌为中原门户，先征兵增强守备；柴桑、汉中暂无破城之危，暂不主动出击。；密谋揭晓：无隐秘意图"},{"id":3185,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉，天人共诛！备与孙将军同举义兵，攻取宛城，誓清中原，兴复我汉家社稷！ 决策理由：恪守吴蜀同盟约定，履行联合攻魏承诺，出兵攻打曹魏宛城，践行兴复汉室大义，符合联弱抗强的既定方略。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":3186,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：曹氏之盟乃权宜之计，孤不受。今践吴蜀之约，柴桑大军直指许昌，与玄德公东西并举，共讨曹贼，兴复汉室。 决策理由：联合攻魏期限将至，柴桑已备大军，当践约出击。许昌守备虽固，强攻纵不克亦累积围城、削弱其防，为后续破城铺路。魏两度求盟恰证其惧两线作战，柴桑受袭风险有限，且若其倾巢来犯，我可反取许昌。拒魏盟以坚吴蜀之信。；密谋揭晓：准备守约"},{"id":3187,"turn":3,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":3188,"turn":3,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 6 兵力"},{"id":3189,"turn":3,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 8，守方损失 7，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":12}},{"id":3190,"turn":3,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":3191,"turn":3,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 5，守方损失 3，城防降低 1 级","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":7}},{"id":3192,"turn":3,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":3193,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":3194,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：曹某愿与江东罢兵休战，共谋安宁。今在宛城增兵固防，若吴主有意，可遣使议和。 决策理由：吴蜀联合攻魏已受挫，吴失周瑜，继续两线作战不利。先固宛城防务，同时向吴示好，以拆散吴蜀同盟，为中原争得喘息。；密谋揭晓：暗中寻求议和"},{"id":3195,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，志在诛灭篡逆曹贼，兴复汉家社稷。今与孙将军盟约在身，整备汉中雄兵，再伐宛城，共图中原！ 决策理由：汉中为伐魏前线，上回合攻城损耗兵力，募兵补充前线战力，恪守吴蜀同盟约定，继续筹备攻魏，符合兴复汉室方略。；密谋揭晓：准备守约"},{"id":3196,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：曹军屯许昌虎视柴桑，孤先增兵固守江防。上回合吴蜀同心破敌，许昌城防已损，愿再约玄德公东西并举，续攻曹贼，共图中原。 决策理由：柴桑告急：魏许昌可发12兵来袭，现城防仅6，不足拒敌。先征兵5万使柴桑守力超魏军进攻上限，确保江东门户不失。同时续提吴蜀联合攻魏，既坚同盟之信，又为柴桑稳固后再取许昌铺路，稳中求进。；密谋揭晓：准备守约"},{"id":3197,"turn":4,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":3198,"turn":4,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":3199,"turn":4,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 7 兵力"},{"id":3200,"turn":4,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":3201,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":3202,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：曹某厉兵秣马，固守中原。若吴主愿息兵戈，可共图安宁。 决策理由：许昌为中原门户，升军镇以固根本。吴蜀联合之势已疲，暂不主动出击，静观其变。；密谋揭晓：暗中寻求议和"},{"id":3203,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡夺汉室社稷，天人共怒。备与孙将军同盟讨逆，此番共举义兵攻取宛城，誓清中原，兴复我大汉天下。 决策理由：恪守吴蜀同盟约定，接受东吴联合攻魏提议，出兵攻打曹魏宛城，践行兴复汉室大义，削弱篡逆势力，符合联弱抗强权略。；密谋揭晓：准备守约"},{"id":3204,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼假意求和，实欲离间吴蜀，孤不受。今增兵柴桑固守江防，静待玄德公回音，共图许昌。 决策理由：柴桑当前守力12，魏最大攻力12，破城需14.4，本回合无忧。许昌城防已降至0，正是蓄力再战之机；拒魏停战以坚吴蜀之盟，续提联合攻魏待蜀回应。征兵5万使柴桑达15兵，下回合可留足守军的同时以约9兵再攻许昌，进退有据。；密谋揭晓：准备守约"},{"id":3205,"turn":5,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":3206,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":3207,"turn":5,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":3208,"turn":5,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":3209,"turn":5,"type":"develop_city","factionId":"wei","message":"魏 将许昌建设为军镇专精 2 级"},{"id":3210,"turn":5,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 6，守方损失 4，围城进度升至 1/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":9}},{"id":3211,"turn":5,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":3212,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"},{"id":3213,"turn":6,"type":"decision_revealed","factionId":"wei","message":"魏：宛城屡遭蜀军侵扰，今调洛阳之兵驰援固守。同时遣使入蜀，愿与刘备罢兵休战，共安百姓。 决策理由：蜀军连攻宛城，围城渐进，需增兵巩固。洛阳为后方，留一兵足矣，调七兵至宛城可拒蜀军。许昌现有十三兵，吴军暂难破城。向蜀提议停战，以观其意，若成则可专力对吴。；密谋揭晓：暗中寻求议和"},{"id":3214,"turn":6,"type":"decision_revealed","factionId":"shu","message":"蜀：吾与孙将军盟誓共讨曹贼篡逆，兴复汉室，今如约整兵，共清中原，绝不背负同盟之约。 决策理由：接受东吴联合攻魏提议，维系吴蜀同盟信任，补充汉中伐魏前线兵力，持续施压曹魏宛城，践行讨逆兴汉大义。；密谋揭晓：准备守约"},{"id":3215,"turn":6,"type":"decision_revealed","factionId":"wu","message":"吴：孤与玄德公有约在先，今柴桑精兵直指许昌，践盟讨贼。江东将士稳进稳战，与蜀东西并举，共耗曹魏，江东基业不失！ 决策理由：联合攻魏之约尚未兑现，上回合已失期损信，此番必践约以固吴蜀之盟。柴桑发9兵攻许昌，留6兵守土；魏素来守势，许昌城防已破，我进可续施压力、削弱曹魏，退可保江东门户，与蜀东西呼应。；密谋揭晓：准备守约"},{"id":3216,"turn":6,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":3217,"turn":6,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":3218,"turn":6,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 6 兵力"},{"id":3219,"turn":6,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 6，守方损失 5，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":9}},{"id":3220,"turn":6,"type":"transfer","factionId":"wei","message":"魏 从洛阳向宛城调动 7 兵力","payload":{"sourceCityId":"luoyang","targetCityId":"wancheng","troops":7}},{"id":3221,"turn":6,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":3222,"turn":7,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":3223,"turn":7,"type":"turn_prepared","factionId":null,"message":"第 7 回合（蓄势阶段）收入与维持已结算"},{"id":3224,"turn":7,"type":"decision_revealed","factionId":"wei","message":"魏：孤闻蜀人屡背盟约，孙权亦受其累。今愿与江东捐弃前嫌，结盟共御反复之徒。 决策理由：许昌、宛城均暂可守，洛阳扩军以固后方。蜀吴同盟已到期且蜀屡次未兑现攻约，正是离间时机。；密谋揭晓：准备守约"},{"id":3225,"turn":7,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡夺汉室社稷，图谋离间我吴蜀同盟，备绝不中此奸计，愿与孙将军再续盟约，共讨篡逆，兴复汉家天下！ 决策理由：曹魏遣使停战意在离间吴蜀，秉持联弱抗曹的一贯方略，拒绝其提议。出兵宛城持续施压曹魏，同时向东吴提议续盟，恪守讨逆兴汉的大义与同盟约定。；密谋揭晓：准备守约"},{"id":3226,"turn":7,"type":"decision_revealed","factionId":"wu","message":"吴：孤与玄德公续盟践约，柴桑发兵五万再压许昌，东西并举共耗曹贼。江东门户留兵固守，稳中求进，基业不失。 决策理由：接受蜀联合攻魏之约并立即出兵兑现承诺，避免再度失期损信；柴桑仅发最小兵力5万，留守4万以上确保门户无虞。同盟已到期，趁势提议续盟以稳固吴蜀联合抗魏大局。许昌城防已破，持续施压可保围城进度并削弱曹魏。；密谋揭晓：准备守约"},{"id":3227,"turn":7,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":3228,"turn":7,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":3229,"turn":7,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":3230,"turn":7,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":3231,"turn":7,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":3232,"turn":7,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":3233,"turn":7,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 6，守方损失 5，围城进度升至 2/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":9}},{"id":3234,"turn":7,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 3，守方损失 3，围城进度升至 2/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":5}},{"id":3235,"turn":7,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":3236,"turn":8,"type":"turn_prepared","factionId":null,"message":"第 8 回合（蓄势阶段）收入与维持已结算"},{"id":3237,"turn":8,"type":"decision_revealed","factionId":"wei","message":"魏：吴主明鉴：刘备背盟反复，孤今攻汉中，愿与江东共击之，平分蜀地。 决策理由：蜀军连攻宛城，围城已至三分；若不击其根本，中原难安。今宛城倾力攻汉中，汉中兵寡可下。同时向吴示好，若孙权应约共击蜀，则东西无忧。许昌暂可守，待吴回应后再定。；密谋揭晓：准备守约"},{"id":3238,"turn":8,"type":"decision_revealed","factionId":"shu","message":"蜀：备以兴复汉室为己任，与孙将军同仇敌忾，今续吴蜀同盟，共讨曹贼篡逆，整兵加固汉中之防，誓清中原！ 决策理由：曹魏图谋离间吴蜀，秉持联弱抗曹方略，接受东吴续盟提议，调兵加强汉中前线防御，防备曹魏乘势来犯，巩固同盟共讨篡逆。；密谋揭晓：准备守约"},{"id":3239,"turn":8,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏假意结盟，实欲离间吴蜀，孤不受。今与玄德公续盟，柴桑精兵再压许昌，围城已过半，当一鼓作气，共讨国贼。 决策理由：许昌守军仅5、城防已破，围城进度2/3，此乃最佳破城窗口，故发5兵续压；柴桑暂留1兵，魏正被蜀围宛城且屡次求和，无力反扑。接受蜀续盟以固抗魏大局，拒魏结盟以防离间，再提联合攻魏维持东西呼应。；密谋揭晓：准备守约"},{"id":3240,"turn":8,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":3241,"turn":8,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":3242,"turn":8,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":3243,"turn":8,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":3244,"turn":8,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":3245,"turn":8,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":3246,"turn":8,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 3，守方损失 3，围城进度升至 3/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":5}},{"id":3247,"turn":8,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 3 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":7}},{"id":3248,"turn":8,"type":"character_captured","factionId":"wei","message":"关羽在城破后被魏俘虏"},{"id":3249,"turn":8,"type":"transfer_cancelled","factionId":"shu","message":"蜀的调兵因战场局势变化而取消"},{"id":3250,"turn":9,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":3251,"turn":9,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":3252,"turn":9,"type":"turn_prepared","factionId":null,"message":"第 9 回合（争锋阶段）收入与维持已结算"},{"id":3253,"turn":9,"type":"decision_revealed","factionId":"wei","message":"魏：孤已调洛阳精兵驰援许昌，确保京师稳固。蜀若愿停战，可归还关羽，共图安宁。 决策理由：许昌为魏都，守军薄弱且吴军围城已满，必须先固根本。调洛阳之兵援许昌，同时以关羽为筹码向蜀示好，若成则离间吴蜀，若不成亦无损大局。；密谋揭晓：准备守约"},{"id":3254,"turn":9,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃据汉中，掳吾大将关羽，备今兴兵讨贼，与孙将军同盟共赴，誓复汉土，清灭奸凶！ 决
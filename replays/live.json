s":6}},{"id":35234,"turn":12,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":35235,"turn":13,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":35236,"turn":13,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":35237,"turn":13,"type":"turn_prepared","factionId":null,"message":"第 13 回合（争锋阶段）收入与维持已结算"},{"id":35238,"turn":13,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯明鉴：蜀汉坐大，必成江东之患。魏愿与吴携手，共击蜀汉，平分其地。 决策理由：洛阳兵少，先征兵固防。吴蜀同盟将尽，向吴示好并提议联攻蜀，分化敌盟，争取生存空间。；密谋揭晓：准备守约"},{"id":35239,"turn":13,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，与吴侯共盟讨逆，今整兵宛城厉兵秣马，旦夕破洛阳灭曹贼，兴复汉室！ 决策理由：曹魏仅余洛阳孤城，已被我军围困，充实宛城兵力，为下一攻灭曹魏做准备，恪守吴蜀同盟，践行联吴抗曹方略。；密谋揭晓：准备守约"},{"id":35240,"turn":13,"type":"decision_revealed","factionId":"wu","message":"吴：魏篡汉逆贼，困守孤城还敢乞和？江东雄师已集许昌，不日北伐，洛阳克日可下。孟德在吾军中安度余生便是。 决策理由：魏困守洛阳孤城，屡次乞和不过是缓兵之计。现自建业、柴桑、吴郡向前线许昌集结兵力，充实至十三，下回合以十二精兵北伐洛阳，毕其功于一役。；密谋揭晓：准备守约"},{"id":35241,"turn":13,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":35242,"turn":13,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":35243,"turn":13,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 1 兵力"},{"id":35244,"turn":13,"type":"recruit","factionId":"shu","message":"蜀 在宛城征募 5 兵力"},{"id":35245,"turn":13,"type":"mobilize","factionId":"wu","message":"吴向许昌战略集结 8 兵"},{"id":35246,"turn":14,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":35247,"turn":14,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 2 金、0 粮"},{"id":35248,"turn":14,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":35249,"turn":14,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、6 粮"},{"id":35250,"turn":14,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":35251,"turn":14,"type":"turn_prepared","factionId":null,"message":"第 14 回合（争锋阶段）收入与维持已结算"},{"id":35252,"turn":14,"type":"decision_revealed","factionId":"wei","message":"魏：孙将军：吴蜀之盟今日已尽，蜀汉坐大必成江东之患。魏愿与吴共击蜀，平分其地。孟德在吴，可为信质。 决策理由：吴蜀两军压境，洛阳孤城危在旦夕。故选加固城防以守根本，同时重申联吴攻蜀之意，分化敌盟，争取转机。；密谋揭晓：准备守约"},{"id":35253,"turn":14,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，奉大义讨篡逆，今率宛城义师进取洛阳，扫清曹贼，兴复汉室，与吴侯共守同盟，同成大业。 决策理由：曹魏仅剩洛阳孤城困守，我军已在宛城整备完毕，恪守吴蜀同盟共讨逆贼的约定，出兵攻取洛阳，一举覆灭曹魏，践行兴复汉室大义。；密谋揭晓：准备守约"},{"id":35254,"turn":14,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏篡逆，困守孤城。今倾江东之师北伐洛阳，誓灭此贼，一靖天下！孟德在吾军中当知天命。 决策理由：洛阳魏军仅余六千，孤城无援，外无寸土。许昌十三精兵已集，以十二之众北伐，泰山压卵之势，城可必破。克此则魏亡，中原可定。吴蜀盟好当续，借兵汉中以示诚信。（外交行为不在当前白名单中，已忽略）；密谋揭晓：无隐秘意图"},{"id":35255,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":35256,"turn":14,"type":"fortify","factionId":"wei","message":"魏 加固了洛阳城防"},{"id":35257,"turn":14,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻洛阳失败，进攻方损失 5，守方损失 3，城防降低 1 级","payload":{"sourceCityId":"wancheng","targetCityId":"luoyang","troops":7}},{"id":35258,"turn":14,"type":"city_captured","factionId":"wu","message":"吴 攻占洛阳，损失 3 兵力","payload":{"cityId":"luoyang","defenderFactionId":"wei","sourceCityId":"xuchang","targetCityId":"luoyang","troops":12}},{"id":35259,"turn":14,"type":"character_captured","factionId":"wu","message":"夏侯惇在城破后被吴俘虏"},{"id":35260,"turn":15,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":35261,"turn":15,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":35262,"turn":15,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、23 粮"},{"id":35263,"turn":15,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":35264,"turn":15,"type":"turn_prepared","factionId":null,"message":"第 15 回合（争锋阶段）收入与维持已结算"},{"id":35265,"turn":15,"type":"decision_revealed","factionId":"shu","message":"蜀：魏逆篡汉已灭，备愿与吴侯续盟修好，共安黎庶，整兵只为守境，绝无相犯之意。 决策理由：魏已覆灭，仅余吴蜀两家，边境告警，宛城守备薄弱，故先充实边防，赠金示好延续同盟，稳守边境再图后计，合乎联吴保境之道。；密谋揭晓：无隐秘意图"},{"id":35266,"turn":15,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏已亡，江东雄师西出进取江州。天下大势已定，望蜀汉早作抉择。 决策理由：魏已亡，吴蜀争雄。我拥五城31兵，远胜蜀之6众。江州乃入蜀要冲，柴桑7兵西征可必克。许昌虽蜀可窥，然洛阳9兵屏障北方，弃一城以取攻势，符合决战要旨。；密谋揭晓：无隐秘意图"},{"id":35267,"turn":15,"type":"gold_offered","factionId":"shu","message":"蜀向吴献上 20 金"},{"id":35268,"turn":15,"type":"recruit","factionId":"shu","message":"蜀 在宛城征募 5 兵力"},{"id":35269,"turn":15,"type":"city_captured","factionId":"wu","message":"吴 攻占江州，损失 2 兵力","payload":{"cityId":"jiangzhou","defenderFactionId":"shu","sourceCityId":"chaisang","targetCityId":"jiangzhou","troops":7}},{"id":35270,"turn":15,"type":"character_captured","factionId":"wu","message":"张飞在城破后被吴俘虏"},{"id":35271,"turn":16,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、47 粮"},{"id":35272,"turn":16,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 13 金、16 粮"},{"id":35273,"turn":16,"type":"turn_prepared","factionId":null,"message":"第 16 回合（争锋阶段）收入与维持已结算"},{"id":35274,"turn":16,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，志在安靖天下。魏逆已灭，吴侯何不归命汉室共扶社稷？孤兴义师收复汉家旧都许昌，非欲穷兵，只为兴复。 决策理由：许昌吴军仅一旅守备，防御空虚，我宛城精兵已整备完毕，趁势攻取许昌，获得中原战略支点，推进汉室统一大业。；密谋揭晓：无隐秘意图"},{"id":35275,"turn":16,"type":"decision_revealed","factionId":"wu","message":"吴：江东整军经武，许昌增兵固防。曹魏已灭，天命在吴。蜀汉当审时度势，早作抉择。 决策理由：许昌仅1兵，面对宛城7兵攻击极易陷落，失则北大门洞开。紧急征5兵使守军达6，可挡蜀军单次进攻。同步招降张飞，瓦解蜀军心志，加速统一。；密谋揭晓：无隐秘意图"},{"id":35276,"turn":16,"type":"character_refused","factionId":"wu","message":"张飞拒绝吴招降，忠诚受到动摇"},{"id":35277,"turn":16,"type":"recruit","factionId":"wu","message":"吴 在许昌征募 5 兵力"},{"id":35278,"turn":16,"type":"city_captured","factionId":"shu","message":"蜀 攻占许昌，损失 3 兵力","payload":{"cityId":"xuchang","defenderFactionId":"wu","sourceCityId":"wancheng","targetCityId":"xuchang","troops":7}},{"id":35279,"turn":16,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":35280,"turn":17,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":35281,"turn":17,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":35282,"turn":17,"type":"turn_prepared","factionId":null,"message":"第 17 回合（争锋阶段）收入与维持已结算"},{"id":35283,"turn":17,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，奉诏讨贼，逆曹已灭。吴侯若归命汉室共安天下，备必保吴侯裂土封王；如若执迷，备当率义师扫清江东，兴复汉室旧疆。 决策理由：许昌新定，宛城仅余一兵守备，洛阳吴军重兵压境，宛城有失陷风险，调许昌富余兵力增援宛城，巩固前线防线，为后续决战做准备。；密谋揭晓：无隐秘意图"},{"id":35284,"turn":17,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏已灭，天命东归！今倾洛阳精锐北伐许昌，中原当定，大业可期！ 决策理由：许昌蜀军仅4千、防御全无，乃其北窥中原之桥头堡，亦为柴桑之侧威胁。洛阳9兵中倾8而出，留1兵配9级城防固若金汤。以8击4，泰山压卵必克。克许昌则柴桑之危立解，北方屏障稳固，更可作为西进宛城、汉中之跳板，加速天下一统。；密谋揭晓：无隐秘意图"},{"id":35285,"turn":17,"type":"character_refused","factionId":"wu","message":"张飞拒绝吴招降，忠诚受到动摇"},{"id":35286,"turn":17,"type":"city_pacified","factionId":"wu","message":"许昌多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":35287,"turn":17,"type":"city_captured","factionId":"wu","message":"吴 攻占许昌，损失 3 兵力","payload":{"cityId":"xuchang","defenderFactionId":"shu","sourceCityId":"luoyang","targetCityId":"xuchang","troops":8}},{"id":35288,"turn":17,"type":"transfer_cancelled","factionId":"shu","message":"蜀的调兵因战场局势变化而取消"},{"id":35289,"turn":18,"type":"director_last_stand","factionId":"shu","message":"蜀触发背水一战（1/2），成都集结 4 兵，但民心动荡"},{"id":35290,"turn":18,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、29 粮"},{"id":35291,"turn":18,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 11 金、14 粮"},{"id":35292,"turn":18,"type":"turn_prepared","factionId":null,"message":"第 18 回合（争锋阶段）收入与维持已结算"},{"id":35293,"turn":18,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，志在兴复汉室。吴虏劫我翼德，侵我疆土，今日整精锐攻江州，誓清吴寇，还我汉家山河！ 决策理由：江州为吴西线重镇，守备薄弱，我集成都精锐全力攻取，拔之可破吴西线屏障，缓解汉蜀西线威胁，推进统一大业。；密谋揭晓：无隐秘意图"},{"id":35294,"turn":18,"type":"decision_revealed","factionId":"wu","message":"吴：江东精兵西出汉中，割蜀之臂。天下大势已明，望蜀汉顺天应人。 决策理由：汉中守军仅1，我以4兵攻之必克。既得汉中则蜀中分，秦岭险阻反为我屏障，为后续两路夹击成都创造有利态势。同步招降张飞，瓦解蜀军心志。；密谋揭晓：无隐秘意图"},{"id":35295,"turn":18,"type":"character_recruited","factionId":"wu","message":"张飞接受招降，转投吴"},{"id":35296,"turn":18,"t
dCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":28648,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":28649,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：今当广积粮草，固本培元。愿与吴侯修好，共谋大局。 决策理由：先稳后方，许昌为根基之地，发展农业以充军资；同时向吴示好，避免两线受敌。；密谋揭晓：无隐秘意图"},{"id":28650,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：备为汉室后裔，曹孟德篡夺汉室天下，天下共讨之。愿与江东孙将军结盟同心，共伐汉贼，匡扶刘氏社稷。 决策理由：当前处于蓄势阶段，先开发后方成都农业，夯实粮产基础。遵循联弱抗曹的大义，邀约东吴共讨曹魏，符合我方长期战略。；密谋揭晓：准备守约"},{"id":28651,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，先固根本。吴主开建业商路以充府库，并遣使入蜀，共议联盟抗曹之策。 决策理由：建业为都城，位置稳固，先发展商业充实金粮；柴桑虽有魏蜀两面威胁，但本回合无需惊慌，可从容设防。先联蜀以分曹军之势，为江东争取发展空间。；密谋揭晓：准备守约"},{"id":28652,"turn":1,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":28653,"turn":1,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":28654,"turn":1,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":28655,"turn":1,"type":"develop_city","factionId":"wei","message":"魏 将许昌建设为农桑专精 1 级"},{"id":28656,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 1 级"},{"id":28657,"turn":1,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 1 级"},{"id":28658,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":28659,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：魏已向吴递盟书，望孙将军共守南北。宛城紧邻汉中，蜀军虎视，今先募兵固防；若吴不弃，曹某必不负约。 决策理由：宛城直面汉中，刘备已邀吴共伐我，先募五营加强防御，避免蜀军趁虚东出；许昌虽有吴军威胁，但当前城防足以自守，待吴盟回应后再调整。；密谋揭晓：无隐秘意图"},{"id":28660,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：备与孙将军同怀讨贼扶汉之心，今结永好，同盟共伐曹贼，匡复刘氏社稷！ 决策理由：接受东吴同盟提议，落实联吴抗曹的大义战略，升级成都农业专精，进一步充实军粮储备，夯实我方发展根基，符合蓄势阶段的需求。；密谋揭晓：准备守约"},{"id":28661,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：江东以固本为先，府库充盈方能经略四方。曹孟德与刘玄德皆遣使结好，权当审慎以观其诚。 决策理由：蓄势阶段重在根基。建业为都城且位置稳固，升商贸专精至2级可显著提升金收，为后续军备与外交预留余裕。两面盟约皆暂拒，保持中立回旋余地，待局势明朗再定进止。；密谋揭晓：无隐秘意图"},{"id":28662,"turn":2,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":28663,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":28664,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":28665,"turn":2,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 2 级"},{"id":28666,"turn":2,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 2 级"},{"id":28667,"turn":2,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":28668,"turn":3,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":28669,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":28670,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：刘备联结东吴，名为同盟，实欲犯我西境。今宛城兵精粮足，正当先取汉中，以固关中之门，剪除蜀寇羽翼。 决策理由：蜀吴虽盟，然吴已两度拒蜀联合攻我，可见其心未定。汉中守军仅八，宛城有十三兵，可全力一击。若得汉中，则西线无忧，亦可震慑东吴。许昌守备足以抵御吴军，故调宛城主力西进。；密谋揭晓：无隐秘意图"},{"id":28671,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：曹孟德篡窃汉室，侵逼我汉中边境，备整军经武，愿与孙吴同盟同心，共讨汉贼，匡复刘氏社稷。 决策理由：汉中紧邻魏之宛城，敌势已盛，本回合不补强即有失城风险，故募兵充实汉中防御巩固边境。同时邀约东吴共伐曹魏，落实联吴抗曹的大义战略。；密谋揭晓：准备守约"},{"id":28672,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑北据许昌，西临江州，乃江东门户。今特筑垒训士，以固根本，使曹军不敢东窥。 决策理由：建业商贸已升至2级，金收稳固。柴桑为北上前哨，军事专精可显著强化城防并惠及后续兵源，将江东门户打造成铁壁，为日后北伐宛、许或西进江州奠定基础。；密谋揭晓：准备守约"},{"id":28673,"turn":3,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":28674,"turn":3,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 1 级"},{"id":28675,"turn":3,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":28676,"turn":3,"type":"attack_repulsed","factionId":"wei","message":"魏 进攻汉中失败，进攻方损失 8，守方损失 5，城防降低 1 级","payload":{"sourceCityId":"wancheng","targetCityId":"hanzhong","troops":12}},{"id":28677,"turn":3,"type":"character_fallen","factionId":"wei","message":"张辽在惨烈战斗中阵亡"},{"id":28678,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"}],"createdAt":"2026-08-18T12:57:44.995Z","updatedAt":"2026-08-18T13:01:09.096Z","exportedAt":"2026-08-18T13:02:08.654Z"}
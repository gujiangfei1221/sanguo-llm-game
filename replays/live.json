d":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":30534,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":30535,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：孙权将军：蜀据汉中、江州，西逼魏、南胁吴。愿与吴共同出兵击蜀，平分其地，以安天下。 决策理由：魏据中原，西有蜀汉，东有吴。先联吴击蜀，集中兵力攻汉中，吴攻江州，可破蜀犄角。本回合在宛城募兵以备西征。；密谋揭晓：准备守约"},{"id":30536,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹贼篡汉窃国，天人共愤。愿与江东孙将军同举义旗，共伐国贼，兴复汉室。 决策理由：首回合处于蓄势阶段，发展后方农业积蓄粮资，邀约东吴联合抗击篡汉曹魏，顺应大义，符合联合弱者的长远方略。；密谋揭晓：准备守约"},{"id":30537,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，先固根本、修内政，广积金粮，以待天下之变。 决策理由：建业为都城且暂无敌患，先行发展商业以增收金入，为后续外交、招降与战备积财。柴桑前线虽邻魏蜀，但本回合防御力足以自保（9.6 vs 敌方7），待同盟定局再加固。；密谋揭晓：无隐秘意图"},{"id":30538,"turn":1,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":30539,"turn":1,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":30540,"turn":1,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":30541,"turn":1,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":30542,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 1 级"},{"id":30543,"turn":1,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 1 级"},{"id":30544,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":30545,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：蜀据汉中，扼我西陲，今宛城兵精粮足，当先取汉中，再图中原。愿与吴共击蜀，平分其地。 决策理由：蜀与我接壤且刘备号召伐魏，威胁日增。宛城驻军充足，主动进攻汉中可削弱蜀国并打开西进道路；同时再邀吴夹击，若吴响应则形成南北合击之势。；密谋揭晓：准备守约"},{"id":30546,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：曹孟德篡汉窃国，天人共愤。今孤与孙将军缔结盟约，同举义兵，共诛国贼，兴复汉室。 决策理由：接受东吴同盟提议，共抗篡汉曹魏。汉中前线遭魏威胁，增募兵员巩固边防，为联合伐魏做准备，符合联弱抗强方略。；密谋揭晓：准备守约"},{"id":30547,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：江东以稳立基，柴桑前沿先募兵实防。盟约尚在权衡，吴不轻许，唯以诚信与江东利益为先。 决策理由：柴桑为吴之门户，今募兵5以厚实根基。两家联合攻伐之议时机未熟，暂皆婉拒，俟吴蜀同盟定局再相机而动。；密谋揭晓：无隐秘意图"},{"id":30548,"turn":2,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":30549,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":30550,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":30551,"turn":2,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":30552,"turn":2,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":30553,"turn":2,"type":"attack_repulsed","factionId":"wei","message":"魏 进攻汉中失败，进攻方损失 8，守方损失 5，城防降低 1 级","payload":{"sourceCityId":"wancheng","targetCityId":"hanzhong","troops":12}},{"id":30554,"turn":2,"type":"character_fallen","factionId":"wei","message":"张辽在惨烈战斗中阵亡"},{"id":30555,"turn":3,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":30556,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"}],"createdAt":"2026-08-18T17:05:57.408Z","updatedAt":"2026-08-18T17:07:55.623Z","exportedAt":"2026-08-18T17:08:06.801Z"}
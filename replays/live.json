resentment":0},{"id":"sunquan","name":"孙权","originalFactionId":"wu","factionId":"wu","locationCityId":"jianye","status":"active","loyalty":100,"resentment":0},{"id":"zhouyu","name":"周瑜","originalFactionId":"wu","status":"dead","loyalty":90,"resentment":0},{"id":"ganning","name":"甘宁","originalFactionId":"wu","factionId":"wu","locationCityId":"wujun","status":"active","loyalty":70,"resentment":0},{"id":"luxun","name":"陆逊","originalFactionId":"wu","factionId":"wu","locationCityId":"jianye","status":"active","loyalty":80,"resentment":0}],"director":{"lastCaptureTurn":4,"lastEventTurn":0,"lastStandCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[{"attackerFactionId":"wu","targetCityId":"xuchang","progress":1,"lastPressureTurn":5}],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"glm-latest"}]},"events":[{"id":3493,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":3494,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：曹某愿与江东结好，共谋天下，望孙将军应允。 决策理由：先巩固后方，发展许昌商贸，为日后征伐蓄积钱粮。；密谋揭晓：无隐秘意图"},{"id":3495,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹贼窃据中原、僭越汉室，愿与江东孙氏共讨逆贼，同保基业，恢复汉室江山。 决策理由：蓄势阶段优先发展后方根基，成都发展农业保障后续粮产，践行联吴抗曹方略，邀约东吴共伐曹魏，符合我方仁义正统定位与长期战略。；密谋揭晓：准备守约"},{"id":3496,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：江东初立，当先固本。孤于柴桑整军经武，以备两面之敌。素闻刘皇叔仁义布于四海，愿结吴蜀之好，共御曹瞒，保境安民。 决策理由：蓄势阶段宜固根本。柴桑西邻江州、北接许昌，两面受敌，先行军事专精强化边防，一劳永逸。曹操最强，联合弱者牵制强者乃江东立国之道，故向蜀提议同盟，诚意守约。；密谋揭晓：准备守约"},{"id":3497,"turn":1,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":3498,"turn":1,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":3499,"turn":1,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":3500,"turn":1,"type":"develop_city","factionId":"wei","message":"魏 将许昌建设为商贸专精 1 级"},{"id":3501,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 1 级"},{"id":3502,"turn":1,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 1 级"},{"id":3503,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":3504,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：许昌增兵以固根本，并邀吴共讨刘备，望孙权明断。 决策理由：当前蜀吴交好，若坐视其盟则魏两面受敌。以联合攻蜀之利分化吴蜀，同时加强许昌防务，为后续征战蓄力。；密谋揭晓：准备守约"},{"id":3505,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，素闻孙将军明大义，今愿结吴蜀同盟，共讨窃国逆贼曹操，同保两家基业，共图兴复汉室。 决策理由：曹魏势大，吴蜀唇齿相依，结盟抗曹符合双方共同利益。接纳同盟提议，开发前线汉中军事专精，整固边防蓄积讨逆力量，符合我方长期战略定位。；密谋揭晓：准备守约"},{"id":3506,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：曹公美意，孤心领然难从命。刘皇叔共讨国贼之约，孤欣然应允。今先移建业之兵充实柴桑，来日与蜀并力北向。吴蜀同心，何惧曹瞒！ 决策理由：柴桑北临许昌、西接江州，乃两面受敌之要冲。趁战事未起，以建业内郡之兵增防柴桑，为下回合践约攻魏做准备，调兵本回合后抵达故须提前一回合部署。外交上拒魏盟、联蜀抗曹，联弱制强乃江东立国之道。；密谋揭晓：准备守约"},{"id":3507,"turn":2,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":3508,"turn":2,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":3509,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":3510,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":3511,"turn":2,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 1 级"},{"id":3512,"turn":2,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":3513,"turn":2,"type":"transfer","factionId":"wu","message":"吴 从建业向柴桑调动 7 兵力","payload":{"sourceCityId":"jianye","targetCityId":"chaisang","troops":7}},{"id":3514,"turn":3,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":3515,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":3516,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：曹某于宛城增兵，以备西线；吴蜀虽盟，吾已有备。 决策理由：宛城邻近汉中，蜀吴联合攻魏，需加强西线兵力。征募5兵增强城防，同时为日后攻取汉中蓄力。；密谋揭晓：无隐秘意图"},{"id":3517,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，窃国逆贼曹操盘踞中原，今践吴蜀同盟之约，兴兵出汉中讨伐曹贼，攻取宛城，兴复汉室，吴蜀同心，共破曹瞒！ 决策理由：遵与吴联合攻魏的约定，从汉中出兵进攻曹魏宛城，履行承诺维系盟友信任，联吴抗曹讨逆复汉，符合我方长期战略定位。；密谋揭晓：准备守约"},{"id":3518,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：曹公挑拨吴蜀之计，孤岂不知。同盟之义，江东岂可背弃。今孤亲遣劲旅北攻许昌，以践共讨之约，望皇叔同步西进，同挫曹瞒。江东儿女，言出必行。 决策理由：联合攻魏期限至第4回合，本回合践约发兵攻许昌，柴桑尚留5兵据守军镇。魏挑拨联攻之议已拒，以全吴蜀信义，维持联弱制强方略。；密谋揭晓：准备守约"},{"id":3519,"turn":3,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":3520,"turn":3,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":3521,"turn":3,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 6，守方损失 5，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":10}},{"id":3522,"turn":3,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 5，守方损失 4","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":7}},{"id":3523,"turn":3,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":3524,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":3525,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：汉中空虚，曹某取之，以绝蜀寇北犯之路。吴若执迷联蜀，来日必悔。 决策理由：蜀汉中仅余3兵，宛城9兵足以克之。趁其援兵未至，出8兵奇袭汉中，断蜀北进咽喉；许昌、宛城守备仍足，吴军尚不能陷城。；密谋揭晓：无隐秘意图"},{"id":3526,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窃据中原，虎视我汉中前线，备当整固边防，与吴孙将军同心共讨逆贼，兴复汉室大业指日可待。 决策理由：汉中当前兵力单薄，魏宛城驻军势大，城池可能被攻占，故调成都后方兵力增援汉中巩固边防，延续联吴抗曹方略，维系盟友信任。；密谋揭晓：准备守约"},{"id":3527,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：江东整军柴桑，再募劲卒，以固边防。前与皇叔共伐曹瞒，信义未改。今孤重整旗鼓，愿再约蜀军并力北进，共图许昌，同分其利，保两家基业。 决策理由：许昌城防已降至0、守军8，然魏本回合极可能增援，贸然以8兵强攻胜算不足且柴桑空虚有失。故先在柴桑征兵6补足战力，同时向蜀提议再度联合攻魏，下回合以生力军配合盟军加成攻许昌，稳健且不失攻势。；密谋揭晓：准备守约"},{"id":3528,"turn":4,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":3529,"turn":4,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":3530,"turn":4,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":3531,"turn":4,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 3 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":8}},{"id":3532,"turn":4,"type":"character_captured","factionId":"wei","message":"关羽在城破后被魏俘虏"},{"id":3533,"turn":4,"type":"transfer_cancelled","factionId":"shu","message":"蜀的调兵因战场局势变化而取消"},{"id":3534,"turn":5,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":3535,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":3536,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀之盟将尽，刘备若明智，当与曹某共讨孙权。汉中关羽可归，以示诚意。 决策理由：许昌受吴军威胁，征兵固防；同时以攻吴之议试探蜀国，若刘备应允则分化吴蜀，若拒绝亦无妨。；密谋揭晓：无隐秘意图"},{"id":3537,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窃据汉中，虏吾关云长，备与孙将军同盟讨逆，同心共复汉室，此约备必践之。 决策理由：吴邀约共讨曹魏，符合我联吴抗曹方略，接受提议维系同盟信任，开发江州增加财政收入，蓄势准备收复汉中。；密谋揭晓：准备守约"},{"id":3538,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼夺汉中、虏关羽，欺吴蜀太甚！孤今亲率柴桑主力十四万北攻许昌，践吴蜀共讨之约。望皇叔同步进兵，两头夹击，共破曹瞒，兴复汉室！ 决策理由：许昌城防已降至0、守军8，且魏仅许昌一路可威胁柴桑。接受蜀的联合攻魏提议并立即全力攻许昌，兑现盟约获取加成；若克许昌即断魏都城并解除柴桑北面威胁，联弱制强正合江东利益。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":3539,"turn":5,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 蜀 提议共同进攻 吴"},{"id":3540,"turn":5,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":3541,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":3542,"turn":5,"type":"develop_city","factionId":"shu","message":"蜀 将江州建设为商贸专精 1 级"},{"id":3543,"turn":5,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":3544,"turn":5,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 9，守方损失 6，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":14}},{"id":3545,"turn":5,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":3546,"turn":5,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":3547,"turn":5,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"}],"createdAt":"2026-08-16T07:13:24.767Z","updatedAt":"2026-08-16T07:18:08.622Z","exportedAt":"2026-08-16T07:18:08.624Z"}
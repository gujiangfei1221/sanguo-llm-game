ionCityId":"jianye","status":"active","loyalty":100,"resentment":0},{"id":"zhouyu","name":"周瑜","originalFactionId":"wu","status":"dead","loyalty":90,"resentment":0},{"id":"ganning","name":"甘宁","originalFactionId":"wu","factionId":"wu","locationCityId":"wujun","status":"active","loyalty":70,"resentment":0},{"id":"luxun","name":"陆逊","originalFactionId":"wu","factionId":"wu","locationCityId":"jianye","status":"active","loyalty":80,"resentment":0}],"director":{"lastCaptureTurn":5,"lastEventTurn":0,"lastStandCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":27551,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":27552,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：愿与吴联手伐蜀，共取汉中。我先在宛城募兵，以备出击。 决策理由：宛城临蜀，募兵增强攻防；联合吴国共击刘备，避免两线作战。；密谋揭晓：准备守约"},{"id":27553,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹贼篡汉窃国，天下共击之。愿与江东孙将军同力破曹，匡扶汉室，共安天下。 决策理由：蓄势阶段优先稳固后方根基，发展成都农业保障后续粮秣供给，秉持联弱抗强的既定方略，邀约东吴共伐篡汉曹魏，符合兴复汉室的战略目标。；密谋揭晓：准备守约"},{"id":27554,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，先固根本。建业设市通商，以蓄财赋；遣使入蜀，共议破曹之策。 决策理由：建业为都城，首置商政可长增金入，奠定后方根基。柴桑现有8兵且城防稳固，本回合无忧。遣使联蜀攻魏，顺应天下大势，亦合吴之利。；密谋揭晓：准备守约"},{"id":27555,"turn":1,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":27556,"turn":1,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":27557,"turn":1,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":27558,"turn":1,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":27559,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 1 级"},{"id":27560,"turn":1,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 1 级"},{"id":27561,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":27562,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：魏继续整备宛城，再募精兵，愿与吴同攻蜀汉，共取汉中。 决策理由：宛城为攻蜀前哨，现有13兵，再募5兵至18，下回合可遣12兵攻汉中而留6兵守城，稳中求进；同时再邀吴共击蜀，促其履约。；密谋揭晓：准备守约"},{"id":27563,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，备与孙将军同举义兵共诛国贼，匡扶汉室！我已增兵汉中，静候联军共击曹魏。 决策理由：汉中直面曹魏宛城重兵，本回合有被攻占风险，故募兵增强守备。东吴提议联合攻魏，符合我联弱抗曹兴复汉室的方略，因此接受。；密谋揭晓：准备守约"},{"id":27564,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：建业为江东根本，本回合升商政至二级，厚殖财赋以备军用。蜀主亦倡联吴伐魏，其意甚合江东之利，当共图大计。曹魏欲借吴手灭蜀，分而制之，居心叵测，不可与谋。 决策理由：建业上回合已定商政一级，本回合升至二级可长增金入，稳固江东经济根基。柴桑城防稳固且无即时威胁，本回合专注经济建设。外交上，蜀汉与吴利益一致，同仇敌忾伐魏，故纳蜀请而拒魏议，并提议正式结盟固化关系。；密谋揭晓：准备守约"},{"id":27565,"turn":2,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":27566,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":27567,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":27568,"turn":2,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":27569,"turn":2,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":27570,"turn":2,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 2 级"},{"id":27571,"turn":2,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":27572,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":27573,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：魏据中原，兵精粮足。许昌增兵固守，以御不测。愿与吴修好，共图大业。 决策理由：许昌直面柴桑，需增兵以防吴军偷袭；宛城现有18兵可守，暂不攻汉中，待兵力集结后再讨。同时向吴示好，争取避免两线作战。；密谋揭晓：无隐秘意图"},{"id":27574,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：曹孟德篡汉窃国，天人共愤。孤今与孙吴缔盟，共举义兵征讨逆贼，攻取宛城，兴复汉室！ 决策理由：吴蜀结盟契合联弱抗曹兴复汉室的既定方略，此前双方约定联合攻魏，需履约出兵进攻宛城，以此巩固同盟信誉，践行伐魏诺言。；密谋揭晓：准备守约"},{"id":27575,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：江东以柴桑为前哨，厚植兵势，以待与蜀汉共击曹贼。 决策理由：柴桑为出击许昌唯一前线，今征募5兵蓄势，下回合以7兵出攻许昌，与蜀联合伐魏。建业商政已稳，吴郡暂不动。；密谋揭晓：准备守约"},{"id":27576,"turn":3,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":27577,"turn":3,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":27578,"turn":3,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":27579,"turn":3,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":27580,"turn":3,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 8，守方损失 6，城防降低 1 级","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":12}},{"id":27581,"turn":3,"type":"character_fallen","factionId":"shu","message":"关羽在惨烈战斗中阵亡"},{"id":27582,"turn":3,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":27583,"turn":3,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":27584,"turn":4,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":27585,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":27586,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：吴主：蜀汉中空虚，魏已发兵攻之。愿与吴共击刘备，分其疆土；若执意助蜀，恐为所累。 决策理由：趁汉中仅5兵且蜀新败，以宛城8兵攻取汉中，留4兵守城防蜀反扑；同时向吴提议共击蜀，拆散吴蜀同盟，避免两线作战。；密谋揭晓：准备守约"},{"id":27587,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：吾与孙吴同盟共讨篡汉逆贼曹操，今日兴兵出汉中取宛城，匡扶汉室，望孙将军履约出兵共破曹贼！ 决策理由：主动出击攻打魏前线宛城，履行吴蜀联合攻魏约定，巩固同盟信任，削弱曹魏对汉中的威胁，符合联弱抗曹兴复汉室方略。；密谋揭晓：准备守约"},{"id":27588,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：江东增兵柴桑，以固藩篱。曹公美意，权当铭感，然吴蜀盟好在前，未敢轻弃。容日后再议。 决策理由：柴桑为江东门户，前临许昌，亟需厚植兵势。曹魏虽提议结盟，然其图谋离间吴蜀之心昭然，况吴蜀盟约至第七回合方止，弃盟不义。今增兵柴桑蓄实力，下回合再相机北伐许昌，与蜀共击曹贼。；密谋揭晓：无隐秘意图"},{"id":27589,"turn":4,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":27590,"turn":4,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":27591,"turn":4,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":27592,"turn":4,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":27593,"turn":4,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 3 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":8}},{"id":27594,"turn":4,"type":"attack_cancelled","factionId":"shu","message":"蜀 的出征因来源城局势变化而取消","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":4}},{"id":27595,"turn":5,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":27596,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":27597,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：汉中新得，蜀必反扑，宛城为中原门户，不可有失。今调洛阳精兵七千入宛，以固西线；许昌重兵不动，东防柴桑。 决策理由：洛阳非前线，调兵后仍可自许昌补给；宛城得兵后城防稳固，可守可援汉中，同时保持许昌兵力以御吴军。；密谋揭晓：无隐秘意图"},{"id":27598,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窃我汉中益州门户，备今兴义兵收复故土，望孙将军恪守吴蜀同盟，共伐曹逆，匡扶汉室。 决策理由：汉中为蜀之屏障，落入曹魏后直接威胁成都、江州安全，出兵收复既保本土，又践行吴蜀联合攻魏之约，巩固同盟信任，符合兴复汉室大义。；密谋揭晓：准备守约"},{"id":27599,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：吴蜀盟约既立，义当共讨曹贼。今遣柴桑精兵北上许昌，以践前言，匡扶汉室。 决策理由：曹魏新占汉中锋芒正盛，吴蜀盟约延至第七回合，前番失约已损信用与声望，今必须履诺出兵以固盟好。柴桑十八兵中以十二兵攻许昌，留六兵守城，攻守兼备，可御魏军反扑。；密谋揭晓：准备守约"},{"id":27600,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":27601,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":27602,"turn":5,"type":"city_captured","factionId":"shu","message":"蜀 攻占汉中，损失 2 兵力，获得联合进攻加成","payload":{"cityId":"hanzhong","defenderFactionId":"wei","sourceCityId":"chengdu","targetCityId":"hanzhong","troops":7}},{"id":27603,"turn":5,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 8，守方损失 5，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":12}},{"id":27604,"turn":5,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":27605,"turn":5,"type":"transfer","factionId":"wei","message":"魏 从洛阳向宛城调动 7 兵力","payload":{"sourceCityId":"luoyang","targetCityId":"wancheng","troops":7}},{"id":27606,"turn":5,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":27607,"turn":6,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":27608,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"}],"createdAt":"2026-08-18T11:02:52.991Z","updatedAt":"2026-08-18T11:08:35.558Z","exportedAt":"2026-08-18T11:10:06.478Z"}
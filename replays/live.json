oint_attack_proposed","factionId":"wei","message":"魏 向 蜀 提议共同进攻 吴"},{"id":3742,"turn":20,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":3743,"turn":20,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":3744,"turn":20,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":3745,"turn":20,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":3746,"turn":20,"type":"recruit","factionId":"shu","message":"蜀 在成都征募 4 兵力"},{"id":3747,"turn":20,"type":"mobilize","factionId":"wu","message":"吴向许昌战略集结 7 兵"},{"id":3748,"turn":20,"type":"transfer","factionId":"wei","message":"魏 从汉中向宛城调动 5 兵力","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":5}},{"id":3749,"turn":20,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":3750,"turn":21,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":3751,"turn":21,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 2 金、5 粮"},{"id":3752,"turn":21,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 3 金、9 粮"},{"id":3753,"turn":21,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":3754,"turn":21,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 8 金、0 粮"},{"id":3755,"turn":21,"type":"turn_prepared","factionId":null,"message":"第 21 回合（决战阶段）收入与维持已结算"},{"id":3756,"turn":21,"type":"decision_revealed","factionId":"wei","message":"魏：吴囚孤于许昌，天下共见其野心。今宛城精锐已集，即刻收复许昌，望皇叔共击孙权，以安天下。 决策理由：东线吴军虽强，但许昌新占、城防低，宛城有5兵可攻；汉中留6兵守御蜀军。攻许昌救曹操，并再次联蜀制吴。；密谋揭晓：准备守约"},{"id":3757,"turn":21,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，与吴侯同心共讨曹贼，逆曹离间之谋绝不可行。今整兵攻取汉中，清荡寇氛，兴复汉室指日可待！ 决策理由：恪守联吴抗曹国策，拒绝曹魏离间性联合攻吴提议，接受吴侯联合攻魏约定，出兵攻取汉中，拔除曹魏侵逼蜀地的前沿据点，履行同盟承诺。；密谋揭晓：准备守约"},{"id":3758,"turn":21,"type":"decision_revealed","factionId":"wu","message":"吴：魏贼调兵宛城，扬言复夺许昌、迎回曹酋。孤今亲督大军自许昌直捣宛城，捣其巢穴，断其东进之路。请皇叔同步进攻汉中，东西并举，共灭曹魏！ 决策理由：联合攻魏期限至本回合，上回合已失约一次，必须兑现。魏宛城屯兵六万为许昌最大威胁，且扬言反扑；以八万大军攻宛城，兵力超过其守备所需，可一举夺城并根除许昌东面威胁。若攻克宛城，魏仅剩洛阳、汉中，洛阳孤悬可下，曹操仍押为质继续牵制。；密谋揭晓：准备守约"},{"id":3759,"turn":21,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的联合进攻提议"},{"id":3760,"turn":21,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":3761,"turn":21,"type":"city_captured","factionId":"wu","message":"吴 攻占宛城，损失 3 兵力，获得联合进攻加成","payload":{"cityId":"wancheng","defenderFactionId":"wei","sourceCityId":"xuchang","targetCityId":"wancheng","troops":8}},{"id":3762,"turn":21,"type":"character_captured","factionId":"wu","message":"张辽在城破后被吴俘虏"},{"id":3763,"turn":21,"type":"attack_cancelled","factionId":"wei","message":"魏 的出征因来源城局势变化而取消","payload":{"sourceCityId":"wancheng","targetCityId":"xuchang","troops":5}},{"id":3764,"turn":21,"type":"city_pacified","factionId":"shu","message":"汉中多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":3765,"turn":21,"type":"city_captured","factionId":"shu","message":"蜀 攻占汉中，损失 3 兵力，获得联合进攻加成","payload":{"cityId":"hanzhong","defenderFactionId":"wei","sourceCityId":"chengdu","targetCityId":"hanzhong","troops":9}},{"id":3766,"turn":21,"type":"joint_attack_honored","factionId":null,"message":"吴与蜀兑现承诺，共同进攻魏"},{"id":3767,"turn":21,"type":"joint_attack_honored","factionId":null,"message":"吴与蜀兑现承诺，共同进攻魏"},{"id":3768,"turn":22,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":3769,"turn":22,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 44 金、65 粮"},{"id":3770,"turn":22,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":3771,"turn":22,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":3772,"turn":22,"type":"turn_prepared","factionId":null,"message":"第 22 回合（决战阶段）收入与维持已结算"},{"id":3773,"turn":22,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯若肯罢兵，孤愿以洛阳为界，共御蜀寇；若不肯，洛阳守军亦誓死相抗。 决策理由：魏仅余洛阳，募兵固守以御吴军；同时向吴请和，争取喘息之机。；密谋揭晓：准备守约"},{"id":3774,"turn":22,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，与吴侯同心共讨残曹，整军充实前线，克复洛阳指日可待，兴复汉室就在眼前！ 决策理由：恪守吴蜀同盟既定国策，征募江州兵员充实前线，巩固东部边境，为共讨曹魏残余做准备，拒绝曹魏离间图谋。；密谋揭晓：准备守约"},{"id":3775,"turn":22,"type":"decision_revealed","factionId":"wu","message":"吴：宛城新复，孤调兵东集许昌，剑指洛阳，誓灭曹魏残余。张辽乃当世虎将，愿降则纳之，共图大业。曹操仍押为质。 决策理由：本回合无进攻路线，将宛城四兵调往许昌，与许昌守军汇合，下回合即可直取仅剩一兵的洛阳，兑现联蜀灭魏之约。同时招降张辽补充将才，曹操继续留作质子，不给魏任何喘息之机。；密谋揭晓：准备守约"},{"id":3776,"turn":22,"type":"character_refused","factionId":"wu","message":"张辽拒绝吴招降，忠诚受到动摇"},{"id":3777,"turn":22,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":3778,"turn":22,"type":"recruit","factionId":"shu","message":"蜀 在江州征募 5 兵力"},{"id":3779,"turn":22,"type":"transfer","factionId":"wu","message":"吴 从宛城向许昌调动 4 兵力","payload":{"sourceCityId":"wancheng","targetCityId":"xuchang","troops":4}},{"id":3780,"turn":23,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":3781,"turn":23,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":3782,"turn":23,"type":"turn_prepared","factionId":null,"message":"第 23 回合（决战阶段）收入与维持已结算"},{"id":3783,"turn":23,"type":"decision_revealed","factionId":"wei","message":"魏：洛阳虽孤，吾誓守之。征兵备武，静观其变。 决策理由：魏仅余洛阳，征兵加强城防；暂不发起无把握的攻势，以待吴蜀同盟生变。；密谋揭晓：无隐秘意图"},{"id":3784,"turn":23,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，与吴侯同心戮力共讨残曹，克复洛阳、兴复汉室就在眼前！ 决策理由：恪守吴蜀同盟国策，征募江州兵员充实东线前线，整军备战，为后续合力攻灭曹魏残余做准备，拒绝曹魏离间图谋。；密谋揭晓：准备守约"},{"id":3785,"turn":23,"type":"decision_revealed","factionId":"wu","message":"吴：曹氏求和不过缓兵之计，孤断然不许。今增兵许昌，剑指洛阳，誓灭残魏。张辽若肯归江东，既往不咎，共图大业。吴蜀盟好坚如磐石，皇叔勿疑。 决策理由：决战阶段魏仅余洛阳，其停战实为喘息之谋，予以拒绝。许昌增募三兵，兵力达八，既保东都不失（魏无力攻取），又为下回合攻洛阳蓄力。宛城无法即时补防，若魏来夺则洛阳空虚，反成可乘之机。再试招降张辽补充将才，曹操继续押为质。；密谋揭晓：准备守约"},{"id":3786,"turn":23,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":3787,"turn":23,"type":"character_recruited","factionId":"wu","message":"张辽接受招降，转投吴"},{"id":3788,"turn":23,"type":"recruit","factionId":"shu","message":"蜀 在江州征募 5 兵力"},{"id":3789,"turn":23,"type":"recruit","factionId":"wu","message":"吴 在许昌征募 3 兵力"},{"id":3790,"turn":23,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":3791,"turn":24,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 6 金、8 粮"},{"id":3792,"turn":24,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 1 金、0 粮"},{"id":3793,"turn":24,"type":"turn_prepared","factionId":null,"message":"第 24 回合（决战阶段）收入与维持已结算"},{"id":3794,"turn":24,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀盟约已至尽头，孙权囚孤、独吞中原。孤今攻许昌，愿与皇叔修好，共制江东。 决策理由：魏仅余洛阳，吴军集结许昌，下回合必攻洛阳；先发制人，以洛阳十一兵中之十兵攻许昌，夺回曹操并斩断吴军前线。洛阳留一兵守城，同时趁吴蜀盟约期满向蜀示好，离间吴蜀，争取喘息与转机。；密谋揭晓：暗中寻求议和"},{"id":3795,"turn":24,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，与吴侯同心共讨残曹，今整军集结于汉中前线，克复洛阳、兴复汉室就在眼前！ 决策理由：恪守吴蜀同盟既定国策，集结兵力于汉中前线，为合力攻灭曹魏残余做好准备，不违盟约，共襄兴复大义。；密谋揭晓：准备守约"},{"id":3796,"turn":24,"type":"decision_revealed","factionId":"wu","message":"吴：魏残寇困守洛阳仍图反扑许昌以夺回曹酋。孤于许昌紧急征发三军，誓保东都固若金汤，曹酋仍押为质。江东将士同仇敌忾，灭魏只在朝夕。 决策理由：边境告警显示许昌本回合有被洛阳魏军攻陷之险，城中还押着曹操。许昌人力已尽无法常规征兵，决战关头以强制征发补足三兵，使守备超出魏军最大攻击力，确保要地与人质不失；代价为商损一级与金粮消耗，可承受。；密谋揭晓：无隐秘意图"},{"id":3797,"turn":24,"type":"alliance_proposed","factionId":"wei","message":"魏 向 蜀 提议结盟"},{"id":3798,"turn":24,"type":"forced_levy","factionId":"wu","message":"吴 在许昌强征 3 兵力，城市发展受损"},{"id":3799,"turn":24,"type":"attack_repulsed","factionId":"wei","message":"魏 进攻许昌失败，进攻方损失 6，守方损失 5，围城进度升至 1/3","payload":{"sourceCityId":"luoyang","targetCityId":"xuchang","troops":10}},{"id":3800,"turn":24,"type":"mobilize","factionId":"shu","message":"蜀向汉中战略集结 8 兵"},{"id":3801,"turn":24,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":3802,"turn":25,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":3803,"turn":25,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 4 金、0 粮"},{"id":3804,"turn":25,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 6 金、8 粮"},{"id":3805,"turn":25,"type":"turn_prepared","factionId":null,"message":"第 25 回合（决战阶段）收入与维持已结算"},{"id":3806,"turn":25,"type":"decision_revealed","factionId":"wei","message":"魏：孙权背盟自肥，坐大江东。今吴蜀盟约已终，孤愿与皇叔共讨之，平分其地。 决策理由：魏仅余洛阳，正面攻许昌必败；吴蜀同盟到期且蜀已失信于吴，正是离间良机。以联合攻吴诱蜀背吴，若蜀应允则吴腹背受敌，魏可乘势收复中原。洛阳按兵不动，凭城坚守。；密谋揭晓：准备守约"},{"id":3807,"turn":25,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，誓兴复天下，绝不受曹魏奸计离间，愿与吴侯再续盟好，共灭残曹，清定中原！ 决策理由：拒绝曹魏结盟离间图谋，重申吴蜀同盟信义，提汉中劲旅攻取宛城，兑现联兵灭魏承诺，推进兴复汉室大业。；密谋揭晓：准备守约"},{"id":3808,"turn":25,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑增兵，防魏残寇流窜耳。宛城新附孤自料理。吴蜀唇齿之谊，孤愿再续前盟，互不加兵，共收中原，皇叔勿疑。 决策理由：柴桑仅一兵，蜀江州可发五兵来攻，若不补强本回合即失，强征三兵后防御可挡其最大攻击，保东线门户。宛城面对汉中重兵无论如何难守，许昌驻军是无法补充的唯一机动力量，攻洛阳五兵不及所需战力，贸然进攻反致许昌危殆、曹操脱手，故不冒险。同时向蜀提议续盟，避免两线受敌，维持现状优势。；密谋揭晓：准备守约"},{"id":3809,"turn":25,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 蜀 提议共同进攻 吴"},{"id":3810,"turn":25,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的结盟提议"},{"id":3811,"turn":25,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":3812,"turn":25,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":3813,"turn":25,"type":"forced_levy","factionId":"wu","message":"吴 在柴桑强征 3 兵力，城市发展受损"},{"id":3814,"turn":25,"type":"city_captured","factionId":"shu","message":"蜀 攻占宛城，损失 4 兵力","payload":{"cityId":"wancheng","defenderFactionId":"wu","sourceCityId":"hanzhong","targetCityId":"wancheng","troops":15}},{"id":3815,"turn":26,"type":"director_coalition","factionId":"shu","message":"蜀势大，引发天下共讨，声望下降"},{"id":3816,"turn":26,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":3817,"turn":26,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":3818,"turn":26,"type":"turn_prepared","factionId":null,"message":"第 26 回合（决战阶段）收入与维持已结算"},{"id":3819,"turn":26,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯明鉴：蜀逆坐大，已夺宛城，锋芒直指许昌、江东。魏虽残，愿与吴共击蜀，收复宛城，平分其地。若吴侯应允，孤当亲率洛阳之师共襄义举！ 决策理由：蜀势强盛，宛城蜀军可直接攻占洛阳。魏仅余洛阳，正面抗蜀必亡，唯有联合吴国共击蜀国，方能牵制蜀军、求得生机。向吴提议联合攻蜀，承诺下回合从洛阳进攻宛城，若吴兑现则蜀两面受敌。；密谋揭晓：准备守约"},{"id":3820,"turn":26,"type":"decision_revealed","factionId":"shu","message":"蜀：备为汉室后裔，志在兴复，绝不与曹贼同流合污，愿与吴侯再续盟好，同心共灭曹魏，清定中原！ 决策理由：拒绝曹魏离间诡计，接受吴侯续盟提议，调宛城主力前往汉中集结，为攻取洛阳攻灭曹魏做准备，恪守同盟信义，推进兴复大业。；密谋揭晓：准备守约"},{"id":3821,"turn":26,"type":"decision_revealed","factionId":"wu","message":"吴：吴蜀再续盟好，孤已应允，两不相攻，共守现势。建业增兵五万固本培元，曹操仍押许昌为质。皇叔以信义为先，江东亦不失信于天下。 决策理由：许昌受宛城十万蜀军压境，唯续盟可免战祸，故接受蜀方结盟。建业人力充足，常规征募五兵充实后方，为后续经柴桑增援东线蓄力。攻洛阳需战力六点六而路线上限五兵必败，且抽空许昌恐被魏夺回、曹操脱手，故不冒险，稳守四城至终局。；密谋揭晓：准备守约"},{"id":3822,"turn":26,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":3823,"turn":26,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的联合进攻提议"},{"id":3824,"turn":26,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":3825,"turn":26,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":3826,"turn":26,"type":"recruit","factionId":"wu","message":"吴 在建业征募 5 兵力"},{"id":3827,"turn":26,"type":"transfer","factionId":"shu","message":"蜀 从宛城向汉中调动 10 兵力","payload":{"sourceCityId":"wancheng","targetCityId":"hanzhong","troops":10}},{"id":3828,"turn":27,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":3829,"turn":27,"type":"siege_decayed","factionId":"wei","message":"魏 对许昌的围城进度衰减"},{"id":3830,"turn":27,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":3831,"turn":27,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 4 金、0 粮"},{"id":3832,"turn":27,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":3833,"turn":27,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 2 金、0 粮"},{"id":3834,"turn":27,"type":"turn_prepared","factionId":null,"message":"第 27 回合（决战阶段）收入与维持已结算"},{"id":3835,"turn":27,"type":"decision_revealed","factionId":"wei","message":"魏：孤已与吴侯约定共击蜀逆，今亲率洛阳之师收复宛城，断蜀北进之路。皇叔若肯罢兵，尚可保全宗庙。 决策理由：执行对吴联合攻蜀承诺，以洛阳4兵攻宛城。宛城仅1兵，攻取可断蜀前出洛阳之桥头堡；洛阳留1兵，吴军本回合无力破城。；密谋揭晓：准备守约"},{"id":3836,"turn":27,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，恪守吴蜀同盟之约，今调劲旅镇守宛城，整军待发，共灭曹魏残部，兴复汉室！ 决策理由：宛城守备薄弱，洛阳魏军可发动进攻，本回合即有失陷风险，调汉中主力增援宛城巩固边防，防范曹魏突袭，恪守吴蜀同盟信义，继续合力攻灭残曹。；密谋揭晓：准备守约"},{"id":3837,"turn":27,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏残虏屡施离间，孤与皇叔盟约至终局，同心不惑。吴郡增兵固本，江东四城安如磐石，曹酋仍押为质，静待天下定局。 决策理由：吴蜀同盟信义至终局，拒绝魏国离间以保全声望与信任；许昌守备6远超魏军最大攻势4无虞，柴桑4兵足挡江州；洛阳攻坚需6.6战力而路线上限5必败，故不冒险。吴郡人力充足，常规征募5兵充实后方，稳守四城至终局。；密谋揭晓：准备守约"},{"id":3838,"turn":27,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":3839,"turn":27,"type":"recruit","factionId":"wu","message":"吴 在吴郡征募 5 兵力"},{"id":3840,"turn":27,"type":"city_pacified","factionId":"wei","message":"宛城多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":3841,"turn":27,"type":"city_captured","factionId":"wei","message":"魏 攻占宛城，损失 1 兵力","payload":{"cityId":"wancheng","defenderFactionId":"shu","sourceCityId":"luoyang","targetCityId":"wancheng","troops":4}},{"id":3842,"turn":27,"type":"transfer_cancelled","factionId":"shu","message":"蜀的调兵因战场局势变化而取消"},{"id":3843,"turn":27,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":3844,"turn":28,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":3845,"turn":28,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 35 金、27 粮"},{"id":3846,"turn":28,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":3847,"turn":28,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 3 金、0 粮"},{"id":3848,"turn":28,"type":"turn_prepared","factionId":null,"message":"第 28 回合（决战阶段）收入与维持已结算"}],"createdAt":"2026-08-16T07:13:24.767Z","updatedAt":"2026-08-16T07:45:12.112Z","exportedAt":"2026-08-16T07:46:07.963Z"}
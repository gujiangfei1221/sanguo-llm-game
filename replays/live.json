ptured","factionId":"wu","message":"吴 攻占洛阳，损失 2 兵力","payload":{"cityId":"luoyang","defenderFactionId":"wei","sourceCityId":"xuchang","targetCityId":"luoyang","troops":5}},{"id":25558,"turn":101,"type":"character_captured","factionId":"wu","message":"夏侯惇在城破后被吴俘虏"},{"id":25559,"turn":101,"type":"transfer","factionId":"shu","message":"蜀 从汉中向宛城调动 5 兵力","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":5}},{"id":25560,"turn":102,"type":"decisive_alliance_ended","factionId":null,"message":"蜀 与 吴 的同盟因进入两强决战而终止"},{"id":25561,"turn":102,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":25562,"turn":102,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 11 金、0 粮"},{"id":25563,"turn":102,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":25564,"turn":102,"type":"turn_prepared","factionId":null,"message":"第 102 回合（决战阶段）收入与维持已结算"},{"id":25565,"turn":102,"type":"decision_revealed","factionId":"shu","message":"蜀：曹氏篡汉已灭，吴侯割据江东，妄窥神器。备身为汉室宗亲，今兴义师讨逆，扫清江东，兴复汉室！ 决策理由：曹魏已灭，天下只剩吴蜀两强，东吴割据不服王化，故此从宛城发兵进攻许昌，扫平割据，完成兴复汉室大业，同时招降故将张飞增强军力。；密谋揭晓：无隐秘意图"},{"id":25566,"turn":102,"type":"decision_revealed","factionId":"wu","message":"吴：魏已亡，吴蜀争雄。调洛阳兵并力许昌，固守中原要冲，静观其变。 决策理由：宛城6蜀兵威胁许昌、洛阳。许昌为中原枢纽联通柴桑，必固守。调洛阳2兵增防许昌，弃洛阳保要冲。许昌3兵加城防可抗蜀5兵之攻；洛阳仅1兵，若蜀攻则让之，以空间换时间。；密谋揭晓：无隐秘意图"},{"id":25567,"turn":102,"type":"city_pacified","factionId":"shu","message":"许昌多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":25568,"turn":102,"type":"city_captured","factionId":"shu","message":"蜀 攻占许昌，损失 2 兵力","payload":{"cityId":"xuchang","defenderFactionId":"wu","sourceCityId":"wancheng","targetCityId":"xuchang","troops":5}},{"id":25569,"turn":102,"type":"transfer_cancelled","factionId":"wu","message":"吴的调兵因战场局势变化而取消"},{"id":25570,"turn":102,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":25571,"turn":103,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 8 金、10 粮"},{"id":25572,"turn":103,"type":"administrat
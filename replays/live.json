sentment":0},{"id":"zhaoyun","name":"赵云","originalFactionId":"shu","factionId":"shu","locationCityId":"chengdu","status":"active","loyalty":85,"resentment":0},{"id":"sunquan","name":"孙权","originalFactionId":"wu","factionId":"wu","locationCityId":"jianye","status":"active","loyalty":100,"resentment":0},{"id":"zhouyu","name":"周瑜","originalFactionId":"wu","status":"dead","loyalty":90,"resentment":0},{"id":"ganning","name":"甘宁","originalFactionId":"wu","factionId":"wu","locationCityId":"wujun","status":"active","loyalty":70,"resentment":0},{"id":"luxun","name":"陆逊","originalFactionId":"wu","factionId":"wu","locationCityId":"jianye","status":"active","loyalty":80,"resentment":0}],"director":{"lastCaptureTurn":4,"lastEventTurn":0,"lastStandCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":36395,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":36396,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯：曹操愿与东吴合力攻蜀，共取汉中、江州。我已在宛城整备兵马，若蒙允诺，必全力出击。 决策理由：宛城直面汉中，需增强兵力以守备并预备对蜀攻势。联合吴国夹击蜀汉，可避免两线受敌，集中击破刘备。；密谋揭晓：准备守约"},{"id":36397,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：吾乃汉室宗亲，曹操篡汉窃国，愿与江东孙氏共诛国贼，匡扶汉室，共保基业。 决策理由：曹操为汉室奸贼，是天下公敌，联合东吴共伐曹魏符合大义，也契合我方联合弱者的方略。发展前线汉中军备，夯实进取根基。；密谋揭晓：无隐秘意图"},{"id":36398,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：江东初立，先固柴桑要塞，蓄势待时。 决策理由：柴桑乃江东门户，北拒许昌、西屏江州，优先发展军事专精以长效提升城防与战力。本回合无即时被攻风险，宜作长线投入。同时主动遣使蜀汉提议结盟，借抗曹之利换取西境安宁。；密谋揭晓：无隐秘意图"},{"id":36399,"turn":1,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":36400,"turn":1,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":36401,"turn":1,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":36402,"turn":1,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":36403,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 1 级"},{"id":36404,"turn":1,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 1 级"},{"id":36405,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":36406,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯：曹某已提兵出宛城攻汉中，请东吴履约夹击蜀汉。若得汉中、江州，共分其利。 决策理由：宛城驻军充裕，汉中为蜀军镇且邻近我境，先取汉中可削弱蜀汉并打通西进之路；同时履行与吴联合攻蜀之约，避免坐失战机。；密谋揭晓：准备守约"},{"id":36407,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：吾乃汉室宗亲，今与江东孙吴结为同盟，共诛曹操篡汉逆贼，匡扶社稷，同保山河，共进退不相负。 决策理由：曹操陈兵宛城，汉中前线有被攻占风险，升级汉中军镇专精强化防御；东吴主动提议结盟，契合联吴抗曹大义，故欣然应允。；密谋揭晓：无隐秘意图"},{"id":36408,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，务在固本。柴桑既为军镇，今再增其壁垒，北望许昌、西临江州，皆可恃而无恐。 决策理由：柴桑是江东门户，已为军镇专精一级。续升军事至二级，长效提升城防战力，以应对魏蜀双向潜在威胁。蓄势阶段以筑牢根基为先，外交观望，暂不出兵。；密谋揭晓：无隐秘意图"},{"id":36409,"turn":2,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":36410,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":36411,"turn":2,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 2 级"},{"id":36412,"turn":2,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 2 级"},{"id":36413,"turn":2,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 5 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":12}},{"id":36414,"turn":2,"type":"character_captured","factionId":"wei","message":"关羽在城破后被魏俘虏"},{"id":36415,"turn":3,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":36416,"turn":3,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":36417,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":36418,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：关云长在曹某帐下，刘备若念旧义，当罢兵休战，共御江东；若允停战，我可议还关羽。 决策理由：调洛阳兵增援宛城，稳固汉中侧翼；向蜀提议停战并以关羽为和谈筹码，避免两线作战，待西线安定后再图江东。；密谋揭晓：准备守约"},{"id":36419,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡汉窃据汉中，俘我大将关羽，备今提兵问罪，愿与孙吴同盟共诛国贼，光复汉室疆土。 决策理由：曹操夺我汉中俘我大将，身为汉室后裔必须兴兵复土，此次出击汉中讨伐曹魏，邀约同盟东吴共同攻魏，符合联吴抗曹的既定方略。；密谋揭晓：准备守约"},{"id":36420,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：江东整军经武，柴桑要塞增兵固守，蓄势待时。已遣使与蜀共议夹击曹贼。 决策理由：魏已取汉中并俘虏关羽，北上之势已成。吴蜀既为同盟，正宜协同反击。柴桑征募7兵，与周瑜共守要塞、集结精锐，为下回合联合攻魏备足兵力。；密谋揭晓：准备守约"},{"id":36421,"turn":3,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":36422,"turn":3,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":36423,"turn":3,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 7 兵力"},{"id":36424,"turn":3,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻汉中失败，进攻方损失 5，守方损失 3，围城进度升至 1/3","payload":{"sourceCityId":"chengdu","targetCityId":"hanzhong","troops":7}},{"id":36425,"turn":3,"type":"transfer","factionId":"wei","message":"魏 从洛阳向宛城调动 5 兵力","payload":{"sourceCityId":"luoyang","targetCityId":"wancheng","troops":5}},{"id":36426,"turn":4,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":36427,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":36428,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原腹心，曹某正加强守备。云长在营中，若刘使君愿罢兵修好，我可礼送其归去；若执意刀兵，则休怪曹某不念旧情。 决策理由：许昌面临柴桑重兵威胁，征兵固守以保中原稳定；同时尝试招降关羽，增强我军实力并瓦解蜀汉士气。若蜀愿停战，可再议归还关羽事宜。；密谋揭晓：准备守约"},{"id":36429,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡汉窃据汉中，俘我大将关羽，备身为汉室宗亲，必提兵复土救将，与江东同盟共诛国贼，匡扶汉室社稷。 决策理由：汉中为益州门户，落入曹魏之手直接威胁我后方，大将关羽被俘更不可不救。依联吴抗曹方略，接受同盟联合攻魏提议，拒绝曹魏停战引诱，兴兵复夺汉中。；密谋揭晓：准备守约"},{"id":36430,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：江东与蜀汉既为同盟，当共诛曹贼。本王已在柴桑增兵备战，待盟约生效，即刻北伐许昌，与汉中将军遥相呼应。 决策理由：柴桑为北伐前进基地且军事专精二级，征募五兵充实前线。接受蜀汉联合攻魏之议，候下回合生效后，以十四兵强攻许昌八守军，配合蜀军自江州西进，形成东西并进之势。；密谋揭晓：准备守约"},{"id":36431,"turn":4,"type":"character_refused","factionId":"wei","message":"关羽拒绝魏招降，忠诚受到动摇"},{"id":36432,"turn":4,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":36433,"turn":4,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":36434,"turn":4,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":36435,"turn":4,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":36436,"turn":4,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":36437,"turn":4,"type":"city_captured","factionId":"shu","message":"蜀 攻占汉中，损失 3 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"wei","sourceCityId":"jiangzhou","targetCityId":"hanzhong","troops":7}},{"id":36438,"turn":4,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":36439,"turn":4,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":36440,"turn":5,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":36441,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":36442,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：孙将军：蜀汉名为汉室，实为割据。吴蜀之盟，终为刘备所制。曹某愿与江东共击蜀汉，汉中益州之地，可分而治之。 决策理由：许昌为中原腹心，面临柴桑重兵威胁，故征兵固守；同时向吴示好，提议共击蜀汉，以分化吴蜀同盟，为下回合作战创造机会。；密谋揭晓：准备守约"},{"id":36443,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：吾乃汉室宗亲，曹操篡汉窃土、俘我大将关羽，今已复汉中，整军待发，与江东同盟共讨逆贼，誓迎云长复归，匡扶汉室社稷。 决策理由：汉中刚收复，魏在宛城陈兵，本回合有被攻占风险，调成都兵马增援汉中巩固前线，恪守吴蜀同盟约定，共抗曹魏，伺机营救关羽。；密谋揭晓：准备守约"},{"id":36444,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：吴蜀同盟既定，当共诛国贼。今遣柴桑之师北伐许昌，与汉中蜀军东西并进，必破曹贼！ 决策理由：吴蜀联合攻魏之约已生效，当守信履约。柴桑驻军二十、军镇专精二级，十四兵攻许昌十三守军，加盟约加成胜算极高。留六兵守城，依边境威胁测算仍可抵御许昌十二兵之反击。；密谋揭晓：准备守约"},{"id":36445,"turn":5,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":36446,"turn":5,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":36447,"turn":5,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":36448,"turn":5,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 9，守方损失 6，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":14}},{"id":36449,"turn":5,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":36450,"turn":5,"type":"transfer","factionId":"shu","message":"蜀 从成都向汉中调动 2 兵力","payload":{"sourceCityId":"chengdu","targetCityId":"hanzhong","troops":2}},{"id":36451,"turn":6,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":36452,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"}],"createdAt":"2026-08-19T04:21:32.469Z","updatedAt":"2026-08-19T04:28:03.961Z","exportedAt":"2026-08-19T04:28:06.548Z"}
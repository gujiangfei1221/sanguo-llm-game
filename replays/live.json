essApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":30942,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：再遣使促吴共击蜀汉。许昌增兵以固要冲，待吴回应后即刻进取汉中。 决策理由：许昌直面柴桑威胁，补足五兵可稳防线；继续联合吴国攻蜀，为下一步自宛城进取汉中创造条件。；密谋揭晓：准备守约"},{"id":30943,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：孤乃汉室宗亲，曹贼窃据神器害民乱国，今愿与孙将军缔盟，共举义旗同讨国贼，恢复汉室，共守疆土。 决策理由：曹贼为天下公敌，联吴抗曹符合大义与当前利益，接受东吴盟约，加固江州边境，防备不虞，稳固后方积蓄力量以备讨曹。；密谋揭晓：准备守约"},{"id":30944,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼欲行驱虎吞狼之计，其心可诛！江东已与蜀汉义结金兰，共讨国贼。柴桑要塞正厉兵秣马，以待北伐之期。 决策理由：魏强蜀弱，联弱抗强方为江东存亡之道。拒魏离间之计，纳蜀攻魏之约，柴桑征兵满编以固根本、备后图。；密谋揭晓：准备守约"},{"id":30945,"turn":2,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":30946,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":30947,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":30948,"turn":2,"type":"fortify","factionId":"shu","message":"蜀 加固了江州城防"},{"id":30949,"turn":2,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":30950,"turn":2,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":30951,"turn":3,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":30952,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":30953,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：许昌为中原锁钥，先补强驻军以固根本。同时向蜀示好，望其深思吴人无信，莫为东吴火中取栗。 决策理由：吴蜀联合在即，许昌直面柴桑重兵，征兵五人以稳防线。外交上尝试离间吴蜀，若蜀稍有动摇，西线可安，再图进取。；密谋揭晓：暗中寻求议和"},{"id":30954,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窃据神器，祸乱汉室，备与江东孙盟公共举义旗，今整兵汉中，不日将兴师北上诛灭国贼，恢复汉室河山。 决策理由：联吴抗曹大局已定，当前需充实汉中前线兵力，为下一回合联合进攻曹魏宛城做准备，稳固前线积蓄讨曹力量。；密谋揭晓：准备守约"},{"id":30955,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：孙权亲督江东精锐十七万，自柴桑北渡长江，直捣许昌。曹贼篡汉害民，今与汉室宗亲共举义旗，誓清中原！ 决策理由：蜀吴联合攻魏期限将至（至第4回合），今柴桑已满编十八兵，遂以十七兵出击许昌，留一兵守城。联合进攻有战力加成，足以撼动许昌十三守军，破曹都则魏势瓦解。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":30956,"turn":3,"type":"alliance_proposed","factionId":"wei","message":"魏 向 蜀 提议结盟"},{"id":30957,"turn":3,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":30958,"turn":3,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":30959,"turn":3,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 11，守方损失 7，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":17}},{"id":30960,"turn":3,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":30961,"turn":3,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":30962,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":30963,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：宛城告急，已调洛阳重兵驰援。同时向吴示好，愿息兵共御蜀汉。 决策理由：蜀汉汉中重兵压宛城，需立即补防；吴新败，提议停战可减西线压力，集中应对蜀军。；密谋揭晓：无隐秘意图"},{"id":30964,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窃据汉室神器，残害黎民，备与江东孙盟友缔盟共讨国贼，今日整兵出汉中直取宛城，誓灭曹贼，恢复汉室河山！ 决策理由：坚守联吴抗曹的大义，拒绝曹魏离间结盟的提议，兑现此前与东吴约定的联合攻魏承诺，出兵讨伐窃据中原的国贼曹魏。；密谋揭晓：准备守约"},{"id":30965,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：公瑾虽殁，江东志犹在。今调精锐屯于柴桑，待天时人事俱备，必当北定中原，以慰英灵。 决策理由：柴桑为吴蜀魏三国要冲，前番北伐虽未克许昌，已破其城防。眼下xuchang守军犹有十一，但城防已失。今夜调建业七兵前移，柴桑合十四兵，下回合可出兵六攻许昌而城守不虚。建业虽仅余一兵，然无魏军毗邻，可保无虞。；密谋揭晓：无隐秘意图"},{"id":30966,"turn":4,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的结盟提议"},{"id":30967,"turn":4,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":30968,"turn":4,"type":"city_captured","factionId":"shu","message":"蜀 攻占宛城，损失 5 兵力","payload":{"cityId":"wancheng","defenderFactionId":"wei","sourceCityId":"hanzhong","targetCityId":"wancheng","troops":12}},{"id":30969,"turn":4,"type":"character_captured","factionId":"shu","message":"张辽在城破后被蜀俘虏"},{"id":30970,"turn":4,"type":"transfer_cancelled","factionId":"wei","message":"魏的调兵因战场局势变化而取消"},{"id":30971,"turn":4,"type":"transfer","factionId":"wu","message":"吴 从建业向柴桑调动 7 兵力","payload":{"sourceCityId":"jianye","targetCityId":"chaisang","troops":7}},{"id":30972,"turn":5,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":30973,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":30974,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：洛阳屯田养民，巩固根本。同时向蜀递出善意，若能共御东吴，天下可定。 决策理由：洛阳缺兵，短期不宜攻宛；许昌需增兵，但本回合先以农业补粮，维持经济与军力平衡。对蜀停战可避免两线作战。；密谋揭晓：无隐秘意图"},{"id":30975,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：备为汉室宗亲，与江东孙将军同盟共讨曹贼，今招纳张辽整兵前线，誓清中原恢复汉室河山。 决策理由：新取宛城，曹魏图谋反扑，整兵汉中巩固前线，招降张辽增强我方实力，坚守联吴抗曹的大义。；密谋揭晓：准备守约"},{"id":30976,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼伪言停战，意图缓兵自保。江东不受其欺，已与蜀汉盟友共议克期会猎许昌，国贼授首在即！ 决策理由：魏军新败，许昌城防已失，士气低落，正是北伐良机。柴桑增兵五人以备下回合联合蜀军两路共攻许昌。拒绝魏之停战诈谋，接受蜀联合进攻之议，期一举而下许昌。；密谋揭晓：准备守约"},{"id":30977,"turn":5,"type":"character_refused","factionId":"shu","message":"张辽拒绝蜀招降，忠诚受到动摇"},{"id":30978,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":30979,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":30980,"turn":5,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":30981,"turn":5,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":30982,"turn":5,"type":"develop_city","factionId":"wei","message":"魏 将洛阳建设为农桑专精 1 级"},{"id":30983,"turn":6,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":30984,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"},{"id":30985,"turn":6,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原锁钥，今吴军压境，先征兵固城，以挫其锋。 决策理由：吴柴桑重兵虎视许昌，城防已失，本回合征兵五人以增强防守，确保不被吴军趁势攻陷。；密谋揭晓：无隐秘意图"},{"id":30986,"turn":6,"type":"decision_revealed","factionId":"shu","message":"蜀：吾为汉室宗亲，誓讨篡汉曹贼，不与奸贼媾和，今增兵宛城御敌，与江东孙盟友共复汉室河山。 决策理由：新占宛城有被曹魏攻占的风险，增兵固守，拒绝魏停战提议，坚守联吴抗曹大义，招降张辽增强我方实力。；密谋揭晓：准备守约"},{"id":30987,"turn":6,"type":"decision_revealed","factionId":"wu","message":"吴：吴蜀同盟既定，今自柴桑出兵北伐许昌，誓与汉室宗亲共灭国贼，复兴汉室！ 决策理由：联合攻魏期限将至（至第7回合），许昌城防已失而守军仅十一，柴桑十九兵出十三攻之，留六守城，胜算极厚。攻克许昌则魏都陷落，曹氏基业瓦解，吴蜀可分据中原，此千载一时之机也。；密谋揭晓：准备守约"},{"id":30988,"turn":6,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":30989,"turn":6,"type":"character_recruited","factionId":"shu","message":"张辽接受招降，转投蜀"},{"id":30990,"turn":6,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":30991,"turn":6,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 8，守方损失 6，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":13}},{"id":30992,"turn":6,"type":"transfer","factionId":"shu","message":"蜀 从汉中向宛城调动 5 兵力","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":5}},{"id":30993,"turn":6,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":30994,"turn":7,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":30995,"turn":7,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":30996,"turn":7,"type":"turn_prepared","factionId":null,"message":"第 7 回合（蓄势阶段）收入与维持已结算"},{"id":30997,"turn":7,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀同盟已破，蜀失信于天下。魏愿与吴共讨背盟之蜀，平分其地，以安苍生。 决策理由：许昌为都城，需增兵固防。吴蜀生隙，此时拉拢吴共击蜀，可破两线之危，集中力量削弱蜀军。；密谋揭晓：准备守约"},{"id":30998,"turn":7,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窃据汉室神器，荼毒天下，备今提义师从宛城伐许昌，与江东孙将军共复河山，誓清国贼！ 决策理由：坚守联吴抗曹的汉室大义，出兵攻击曹魏核心重镇许昌，兑现联合攻魏约定，重续吴蜀盟好，共灭篡汉国贼。；密谋揭晓：准备守约"},{"id":30999,"turn":7,"type":"decision_revealed","factionId":"wu","message":"吴：国贼曹氏窃据中原，吴蜀共愤。今自柴桑出精兵再伐许昌，誓清中原、复汉室河山！ 决策理由：许昌城防已失、围城进度1/3、守军仅十，柴桑十一兵出十攻之，留一守城。乘魏弱势一举而下其都城，则中原大局可定。；密谋揭晓：准备守约"},{"id":31000,"turn":7,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":31001,"turn":7,"type":"alliance_proposed","facti
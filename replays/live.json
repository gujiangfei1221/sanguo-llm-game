":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":11}},{"id":3595,"turn":9,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 4，守方损失 3，城防降低 1 级","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":6}},{"id":3596,"turn":9,"type":"joint_attack_honored","factionId":null,"message":"吴与蜀兑现承诺，共同进攻魏"},{"id":3597,"turn":9,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":3598,"turn":10,"type":"turn_prepared","factionId":null,"message":"第 10 回合（争锋阶段）收入与维持已结算"},{"id":3599,"turn":10,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原根本，孤今募兵固守，待敌疲而击。 决策理由：吴军仍围许昌，西线蜀军亦有威胁，当前以补强都城守军为先，避免两线冒险。；密谋揭晓：无隐秘意图"},{"id":3600,"turn":10,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，与吴侯同心讨贼，今增兵北鄙汉中，共御曹魏，同兴汉室，信义不改。 决策理由：汉中为蜀北门户，魏宛城驻军压境，当前守备不足，有被攻占风险，故调江州精兵增援巩固防线；续提联吴攻魏，恪守同盟盟约，践行联弱抗曹方略。；密谋揭晓：准备守约"},{"id":3601,"turn":10,"type":"decision_revealed","factionId":"wu","message":"吴：许昌守军虽困，孤不欲以寡兵浪战。今在柴桑增募六军，合兵十一，养锐一回合。请皇叔再续联攻之约，下回合并力破城，共讨曹贼。 决策理由：柴桑现仅五兵，路线限出四兵攻许昌守七，必败且空耗。许昌人力仅3、城防0，魏已近极限；围城进度2/3仅隔一回合不衰减。故本回合柴桑征六兵成十一之众，并邀蜀续联攻之约，下回合以全军携加成强攻，一举可克。；密谋揭晓：准备守约"},{"id":3602,"turn":10,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":3603,"turn":10,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":3604,"turn":10,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 3 兵力"},{"id":3605,"turn":10,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":3606,"turn":10,"type":"transfer","factionId":"shu","message":"蜀 从江州向汉中调动 4 兵力","payload":{"sourceCityId":"jiangzhou","targetCityId":"hanzhong","troops":4}},{"id":3607,"turn":11,"type":"director_stalemate","factionId":"shu","message":"战局久滞，流民投奔蜀，补充兵源并集结 2 兵"},{"id":3608,"turn":11,"type":"turn_prepared","factionId":null,"message":"第 11 回合（争锋阶段）收入与维持已结算"},{"id":3609,"turn":11,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原根本，孤今加固城防，以御吴军。同时愿与江东共谋益州，望孙权三思。 决策理由：吴军压境，许昌城防已破，必须先固守。外交上尝试离间吴蜀，为下回合争取转机。；密谋揭晓：无隐秘意图"},{"id":3610,"turn":11,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，与吴侯同心共讨汉贼，巩固北境，相约破魏，兴复汉室，信义不改！ 决策理由：恪守吴蜀同盟，接受吴联合攻魏提议，升级汉中军事专精，强化北境战力，牵制西线魏军，配合吴军东线攻魏，践行联弱抗曹方略。；密谋揭晓：准备守约"},{"id":3611,"turn":11,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏连岁疲敝，许昌人力枯竭、城防已破。孤亲率柴桑之师十万强攻许昌，围城之势不可中断。请皇叔同步进兵，吴蜀并力，共破曹贼！ 决策理由：围城进度2/3，若本回合不再施压将衰减，前功尽弃。许昌守10防0人力1，我出10兵携联攻加成胜算可观。接受蜀联攻之约并践诺出兵，维持吴蜀同盟与信任。柴桑留守1兵，柴桑暂无被攻陷之虞。；密谋揭晓：准备守约"},{"id":3612,"turn":11,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":3613,"turn":11,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":3614,"turn":11,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":3615,"turn":11,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":3616,"turn":11,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 2 级"},{"id":3617,"turn":11,"type":"fortify","factionId":"wei","message":"魏 加固了许昌城防"},{"id":3618,"turn":11,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 6，守方损失 4，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":10}},{"id":3619,"turn":11,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":3620,"turn":11,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":3621,"turn":12,"type":"turn_prepared","factionId":null,"message":"第 12 回合（争锋阶段）收入与维持已结算"},{"id":3622,"turn":12,"type":"decision_revealed","factionId":"wei","message":"魏：蜀军压宛城，孤已募兵固守。蜀屡背联攻之约，吴侯何必独力攻魏？愿与江东罢兵修好，共商大计。 决策理由：宛城正面临汉中蜀军威胁，若不加兵可能失陷，故在宛城募兵五万固守；许昌现有守军足以抵御吴军。外交上利用蜀未兑现联攻承诺，向吴提议停战，以拆散吴蜀同盟。；密谋揭晓：暗中寻求议和"},{"id":3623,"turn":12,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，与吴侯同心讨贼，今提锐师出汉中攻宛城，吴蜀东西夹击曹贼，兴复汉室，信义不改！ 决策理由：恪守吴蜀同盟，兑现联合攻魏承诺，出兵进攻宛城牵制魏军西线，配合吴军攻取许昌，践行联弱抗曹、讨逆复汉的方略。；密谋揭晓：准备守约"},{"id":3624,"turn":12,"type":"decision_revealed","factionId":"wu","message":"吴：曹操两度求和被拒，今又欲诱孤共攻蜀，此离间之计，孤已拒之。柴桑增兵蓄锐，吴蜀之好不改，愿再约皇叔共讨曹贼，下回合并力破许昌。 决策理由：许昌守6防0人力2，然本回合仅可出4兵，强攻必败且柴桑恐遭反夺。故柴桑征满4兵成9，养锐一回合；围城仅隔一回合不会衰减，下回合携联攻加成全力破城。拒魏联攻蜀之离间计，续与蜀约共伐魏，维持两线制曹格局。；密谋揭晓：准备守约"},{"id":3625,"turn":12,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":3626,"turn":12,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":3627,"turn":12,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":3628,"turn":12,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 4 兵力"},{"id":3629,"turn":12,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":3630,"turn":12,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 4，守方损失 4，围城进度升至 1/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":6}},{"id":3631,"turn":12,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":3632,"turn":13,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":3633,"turn":13,"type":"turn_prepared","factionId":null,"message":"第 13 回合（争锋阶段）收入与维持已结算"},{"id":3634,"turn":13,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀盟约已尽，刘备屡背信义，独力攻魏。孤愿与孙权结盟，共击蜀汉，平分益州，永结盟好。 决策理由：许昌面临吴军围攻，先募兵固守；同时利用吴蜀盟约到期，向吴提出结盟以拆散敌方联盟，争取下回合转攻汉中。；密谋揭晓：准备守约"},{"id":3635,"turn":13,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，与吴侯同心共讨曹贼，今续前盟，信义不改，共灭国贼，兴复汉室。 决策理由：江州守军仅1，有失陷风险，集结兵力巩固东线。接受吴联合攻魏提议，因原同盟到期续缔吴蜀同盟，践行联弱抗曹方略。；密谋揭晓：准备守约"},{"id":3636,"turn":13,"type":"decision_revealed","factionId":"wu","message":"吴：曹操求和实为缓兵之计，孤已拒之。今以柴桑之师强攻许昌，围城之势不可中断。吴蜀盟约虽期满，愿与皇叔再续同盟，东西并力，共讨国贼。 决策理由：许昌守6防0人力3，我出8兵胜算可观；围城进度2已一回合未施压，本回合必须进攻否则衰减，前功尽弃。魏停战乃缓兵之计，许昌未取前一律拒绝。吴蜀同盟到期，再提续盟维持两线制曹。柴桑留守1兵，魏许昌之军自顾不暇，下回合以建业吴郡新兵补防。；密谋揭晓：准备守约"},{"id":3637,"turn":13,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":3638,"turn":13,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":3639,"turn":13,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":3640,"turn":13,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":3641,"turn":13,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":3642,"turn":13,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 3 兵力"},{"id":3643,"turn":13,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 5，守方损失 4，围城进度升至 3/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":8}},{"id":3644,"turn":13,"type":"mobilize","factionId":"shu","message":"蜀向江州战略集结 4 兵"},{"id":3645,"turn":13,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":3646,"turn":14,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、3 粮"},{"id":3647,"turn":14,"type":"turn_prepared","factionId":null,"message":"第 14 回合（争锋阶段）收入与维持已结算"},{"id":3648,"turn":14,"type":"decision_revealed","factionId":"wei","message":"魏：蜀屡背盟约，独力犯我，今汉中空虚，孤亲率宛城之师攻取汉中，断蜀北线。吴侯若有意，愿与江东共分益州，永结盟好。 决策理由：汉中仅一兵，蜀主力集于江州，正是破蜀良机。攻取汉中可解宛城之围，断蜀北进之路，并为下回合威胁成都、江州铺路。同时向吴示好，离间吴蜀。；密谋揭晓：准备守约"},{"id":3649,"turn":14,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，今续与吴侯缔盟，同心共讨汉贼曹操，东西并举兴复汉室，信义昭然绝无二心。 决策理由：续缔吴蜀同盟维持联弱抗曹格局，调集江州兵力加强汉中防御，防范魏军突袭，准备兑现联合攻魏承诺，牵制西线魏军配合吴军攻取许昌。；密谋揭晓：准备守约"},{"id":3650,"turn":14,"type":"decision_revealed","factionId":"wu","message":"吴：曹操求盟乃缓兵之计，孤不受。吴蜀再续盟好，同讨国贼。柴桑增兵蓄锐，许昌之围不解，下回合力克之。 决策理由：本回合无进攻路线（柴桑可出之兵不足），且柴桑无失陷之虞。征柴桑2兵成6，为下回合强攻许昌做准备；围城3/3只需下回合继续施压即可保住。续吴蜀盟、拒魏盟，并约蜀联攻以取加成。；密谋揭晓：准备守约"},{"id":3651,"turn":14,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":3652,"turn":14,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":3653,"turn":14,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":3654,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":3655,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":3656,"turn":14,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":3657,"turn":14,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 2 兵力"},{"id":3658,"turn":14,"type":"city_pacified","factionId":"wei","message":"汉中多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":3659,"turn":14,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 2 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":5}},{"id":3660,"turn":14,"type":"mobilize_cancelled","factionId":"shu","message":"蜀的战略集结因战场局势变化而取消"},{"id":3661,"turn":15,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":3662,"turn":15,"type":"siege_decayed","factionId":"shu","message":"蜀 对宛城的围城进度衰减"},{"id":3663,"turn":15,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":3664,"turn":15,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 22 金、48 粮"},{"id":3665,"turn":15,"type":"turn_prepared","factionId":null,"message":"第 15 回合（争锋阶段）收入与维持已结算"},{"id":3666,"turn":15,"type":"decision_revealed","factionId":"wei","message":"魏：许昌危急，孤已募兵固守。吴侯若愿停战，魏吴可共分蜀地，永息干戈。 决策理由：许昌被吴围城至3/3，本回合若不补强恐陷，故征兵2以固守。同时向吴提议停战，争取拆散吴蜀同盟，缓解两线压力。；密谋揭晓：准备守约"},{"id":3667,"turn":15,"type":"decision_revealed","factionId":"shu","message":"蜀：备与吴侯同心讨贼，共兴汉室，今提锐师直取汉中，清剿曹虏，东西并举破贼，兴复汉室指日可待！ 决策理由：魏占汉中后成都门户洞开，国都有被攻占风险，必须反击夺回门户。恪守吴蜀同盟约定，接受联合攻魏提议，出兵夺还汉中解除西线威胁，牵制魏军配合吴军攻取许昌。；密谋揭晓：准备守约"},{"id":3668,"turn":15,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼屡施离间，孤皆拒之。今围城之势已成，柴桑之师全力攻许昌，与皇叔东西夹击，共讨国贼，兴复汉室！ 决策理由：许昌围城进度3/3，若本回合不进攻将衰减，前功尽弃。许昌守5防0，我出5兵并携围城之利，胜算可观。接受蜀联攻之约兑现承诺取加成，拒魏离间。柴桑虽留1兵，但魏无力攻取。克许昌则魏都失，天下势变。；密谋揭晓：准备守约"},{"id":3669,"turn":15,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":3670,"turn":15,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":3671,"turn":15,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":3672,"turn":15,"type":"joint_attack_proposed","faction
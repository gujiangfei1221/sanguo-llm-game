imax-m3"}]},"events":[{"id":10898,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":10899,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：愿与吴联手共击蜀汉，两路夹击，共安天下。 决策理由：蜀据汉中，威胁宛城；吴据柴桑，可攻江州。联合吴国夹击蜀汉，可保中原安稳。；密谋揭晓：准备守约"},{"id":10900,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：吾乃汉室宗亲，曹操篡汉窃国祸乱天下，愿与孙将军联手共讨汉贼，兴复汉室。 决策理由：曹操实为汉贼，为天下正统所不容，联吴抗魏符合我方战略。先开发后方成都农业，积蓄粮秣，蓄势待发。；密谋揭晓：准备守约"},{"id":10901,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，先固柴桑门户，以逸待劳，静观中原。 决策理由：柴桑西接许昌（魏）、江州（蜀），乃江东咽喉。当前沿虽暂无被破之险，然先升其城防至二级，可使敌来犯徒劳无功，契合蓄势阶段稳守根基之策。；密谋揭晓：无隐秘意图"},{"id":10902,"turn":1,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":10903,"turn":1,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":10904,"turn":1,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":10905,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 1 级"},{"id":10906,"turn":1,"type":"fortify","factionId":"wu","message":"吴 加固了柴桑城防"},{"id":10907,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":10908,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：魏愿与吴共击蜀汉，汉中乃宛城心腹之患，盼孙将军共襄盛举。 决策理由：继续在宛城征兵，强化对汉中的进攻准备；再次向吴提议联合攻蜀，若吴应允，下回合即可两路夹击。；密谋揭晓：准备守约"},{"id":10909,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，祸乱天下。孤整备汉中边防，静候孙将军共兴义师，清君侧，复汉室。 决策理由：汉中为对魏前线，魏屯重兵于宛城，本回合汉中有被攻占风险，因此征兵增强防御，同时示意东吴，促其回应联攻提议。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":10910,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，首重根基。建业乃都城所在，先增兵以固根本。两家盟约之请，容日后再议。 决策理由：柴桑城防已升至2级，短期无忧；建业为都城但驻军仅8，宜先募兵固防。魏蜀双方争相拉拢，此刻不宜轻表态，两面拒绝以保自主，待其互耗再定连横。；密谋揭晓：无隐秘意图"},{"id":10911,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":10912,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":10913,"turn":2,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":10914,"turn":2,"type":"recruit","factionId":"wu","message":"吴 在建业征募 5 兵力"},{"id":10915,"turn":2,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":10916,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"}],"createdAt":"2026-08-16T22:50:41.035Z","updatedAt":"2026-08-16T22:51:40.715Z","exportedAt":"2026-08-16T22:52:05.994Z"}
于前；刘备停战未久，不宜轻启战端。孤暂罢两方联攻之请，先固根本，厉兵秣马，待时而动。 决策理由：蜀吴皆请联攻对方，但吴已违约，蜀亦不可轻信。当前无进攻路线，宜征兵洛阳，增强实力，同时拒绝两方联合进攻提议，避免卷入失信之战。；密谋揭晓：无隐秘意图"},{"id":40290,"turn":23,"type":"decision_revealed","factionId":"shu","message":"蜀：孙权背盟弃义，勾结篡汉逆曹，侵我益州疆土。备身为汉室后裔，愿与魏修好，共讨吴贼，安境保民，兴复汉室。 决策理由：吴撕毁旧盟联魏犯境，成都直面魏汉中兵锋，存在失陷风险，故征兵充实成都守备；提议联魏共讨背义吴虏，保卫益州根基，合乎当前战略需求。；密谋揭晓：准备守约"},{"id":40291,"turn":23,"type":"decision_revealed","factionId":"wu","message":"吴：秣马厉兵已毕，今率盛兵南下攻取江州，固我长江天堑。 决策理由：吴魏联军既定，蜀腹背受敌。柴桑十四营，以十三营强攻江州（守军八、城防零），以盛击寡必克。践联军之约，断蜀东部门户，扩土添粮，稳固江东。；密谋揭晓：准备守约"},{"id":40292,"turn":23,"type":"diplomacy_response","factionId":"wei","message":"魏拒绝了 蜀 的联合进攻提议"},{"id":40293,"turn":23,"type":"diplomacy_response","factionId":"wei","message":"魏拒绝了 吴 的联合进攻提议"},{"id":40294,"turn":23,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":40295,"turn":23,"type":"recruit","factionId":"shu","message":"蜀 在成都征募 5 兵力"},{"id":40296,"turn":23,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":40297,"turn":23,"type":"city_captured","factionId":"wu","message":"吴 攻占江州，损失 5 兵力","payload":{"cityId":"jiangzhou","defenderFactionId":"shu","sourceCityId":"chaisang","targetCityId":"jiangzhou","troops":13}},{"id":40298,"turn":23,"type":"character_captured","factionId":"wu","message":"张飞在城破后被吴俘虏"},{"id":40299,"turn":24,"type":"ceasefire_expired","factionId":null,"message":"魏 与 吴 的停战到期"},{"id":40300,"turn":24,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":40301,"turn":24,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":40302,"turn":24,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 14 金、36 粮"},{"id":40303,"turn":24,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":40304,"turn":24,"type":"turn_prepared","factionId":null,"message":"第 24 回合（决战阶段）收入与维持已结算"},{"id":40305,"turn":24,"type":"decision_revealed","factionId":"wei","message":"魏：孙权外结盟好，内囚孤身，背信弃义。今孤已决意与蜀共讨吴贼，收复许昌，重振大魏！ 决策理由：吴占许昌、囚主公，且借同盟扩张；蜀请共击吴，正合当前危局。故背盟攻许昌，以七军直取，救主夺城，扭转决战之势。；密谋揭晓：准备守约"},{"id":40306,"turn":24,"type":"decision_revealed","factionId":"shu","message":"蜀：孙权背盟弃义，联魏侵我益州，窃我国土江州，俘我大将张飞，备身为汉室后裔，今兴兵讨逆收复故地，望魏共举义旗共灭吴贼。 决策理由：孙权撕毁吴蜀旧盟，侵占我方江州，俘获大将张飞，直接威胁益州核心安全。出兵进攻江州收复失地，邀约魏共伐吴，符合保境安民、讨伐背义逆贼的战略需求。；密谋揭晓：准备守约"},{"id":40307,"turn":24,"type":"decision_revealed","factionId":"wu","message":"吴：秣马厉兵，整军经武。江东将士枕戈待旦，以待天时。 决策理由：魏吴盟约已届，蜀汉新败于江州。乘此时机于建业募兵三营充实腹地，同时遣使与蜀议和，暂息刀兵，为后续进取蓄力。；密谋揭晓：准备守约"},{"id":40308,"turn":24,"type":"diplomacy_response","factionId":"wei","message":"魏接受了 蜀 的联合进攻提议"},{"id":40309,"turn":24,"type":"alliance_betrayed","factionId":"wei","message":"魏突然背盟，转而对吴动手，声望大降"},{"id":40310,"turn":24,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":40311,"turn":24,"type":"recruit","factionId":"wu","message":"吴 在建业征募 3 兵力"},{"id":40312,"turn":24,"type":"city_captured","factionId":"wei","message":"魏 攻占许昌，损失 2 兵力，获得联合进攻加成","payload":{"cityId":"xuchang","defenderFactionId":"wu","sourceCityId":"luoyang","targetCityId":"xuchang","troops":7}},{"id":40313,"turn":24,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻江州失败，进攻方损失 3，守方损失 3，围城进度升至 1/3","payload":{"sourceCityId":"chengdu","targetCityId":"jiangzhou","troops":5}},{"id":40314,"turn":24,"type":"joint_attack_honored","factionId":null,"message":"魏与蜀兑现承诺，共同进攻吴"},{"id":40315,"turn":24,"type":"joint_attack_honored","factionId":null,"message":"蜀与魏兑现承诺，共同进攻吴"},{"id":40316,"turn":25,"type":"siege_decayed","factionId":"shu","message":"蜀 对宛城的围城进度衰减"},{"id":40317,"turn":25,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":40318,"turn":25,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 4 金、7 粮"},{"id":40319,"turn":25,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":40320,"turn":25,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 13 金、0 粮"},{"id":40321,"turn":25,"type":"turn_prepared","factionId":null,"message":"第 25 回合
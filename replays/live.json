argetCityId":"xuchang","troops":5}},{"id":14107,"turn":20,"type":"attack_cancelled","factionId":"wu","message":"吴 的出征因来源城局势变化而取消","payload":{"sourceCityId":"xuchang","targetCityId":"wancheng","troops":10}},{"id":14108,"turn":20,"type":"city_captured","factionId":"wei","message":"魏 攻占宛城，损失 3 兵力","payload":{"cityId":"wancheng","defenderFactionId":"shu","sourceCityId":"luoyang","targetCityId":"wancheng","troops":9}},{"id":14109,"turn":20,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":14110,"turn":21,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":14111,"turn":21,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 19 金、0 粮"},{"id":14112,"turn":21,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":14113,"turn":21,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 18 金、0 粮"},{"id":14114,"turn":21,"type":"turn_prepared","factionId":null,"message":"第 21 回合（决战阶段）收入与维持已结算"},{"id":14115,"turn":21,"type":"decision_revealed","factionId":"wei","message":"魏：宛城新定，洛阳需固本。吴侯共击蜀汉之约，曹某铭记；待魏军整备完毕，必与吴会师伐蜀。 决策理由：魏刚攻占宛城，尚需整补，本回合无进攻路线。先征兵固守洛阳，同时婉拒吴联合攻蜀提议，避免空诺损信；若下回合有可攻路线再与吴会师。；密谋揭晓：无隐秘意图"},{"id":14116,"turn":21,"type":"decision_revealed","factionId":"shu","message":"蜀：吴贼背盟附逆，曹贼篡汉窃我宛城，孤整兵固守西川门户，誓当兴复汉室，扫清天下奸邪！ 决策理由：汉中为西川门户，魏据宛城后兵临城下，本回合不补强即有失陷风险，因此募兵补强汉中防务，筑牢蜀地屏障抵御贼寇。；密谋揭晓：无隐秘意图"},{"id":14117,"turn":21,"type":"decision_revealed","factionId":"wu","message":"吴：秣马厉兵北上，整军经武待时。与魏公分进合击，共讨僭号之蜀，克日可期。 决策理由：江州张飞孤军守备，正合用兵。调集许昌、建业、吴郡精兵北上柴桑，集结十有一军，为践盟攻蜀做充分准备。许昌留守七兵以固中原，盟约期内料魏不相犯。；密谋揭晓：准备守约"},{"id":14118,"turn":21,"type":"diplomacy_response","factionId":"wei","message":"魏拒绝了 吴 的联合进攻提议"},{"id":14119,"turn":21,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的联合进攻提议"},{"id":14120,"turn":21,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 4 兵力"},{"id":14121,"turn":21,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 7 兵力"},{"id":14122,"turn":21,"type":"mobilize","factionId":"wu","message":"吴向柴桑战略集结 8 兵"},{"id":14123,"turn":22,"type":"ceasefire_expired","factionId":null,"message":"魏 与 吴 的停战到期"},{"id":14124,"turn":22,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":14125,"turn":22,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":14126,"turn":22,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 11 金、0 粮"},{"id":14127,"turn":22,"type":"turn_prepared","factionId":null,"message":"第 22 回合（决战阶段）收入与维持已结算"},{"id":14128,"turn":22,"type":"decision_revealed","factionId":"wei","message":"魏：宛城新附，蜀军压境。孤已调洛阳之兵驰援，先固城防；与吴盟约不变，待整备完妥，再会猎汉中。 决策理由：蜀自汉中威逼宛城，若不增援有失陷之险。调洛阳四兵赴宛，使守军增至十人，可阻蜀军；洛阳留一兵守备，暂不攻许昌，以全吴盟。；密谋揭晓：无隐秘意图"},{"id":14129,"turn":22,"type":"decision_revealed","factionId":"shu","message":"蜀：吴贼背盟附逆，屯兵柴桑窥我江州，备整兵固守疆土，誓保汉室子民，终当扫清奸凶，匡复洛京。 决策理由：江州守备薄弱，吴虏重兵压境，本回合不补强即有失陷风险，就地征募精兵巩固防务，守住蜀地东大门。；密谋揭晓：无隐秘意图"},{"id":14130,"turn":22,"type":"decision_revealed","factionId":"wu","message":"吴：孙权令柴桑精兵南下攻江州，践魏吴盟约共击蜀汉之诺。 决策理由：履盟攻蜀。江州张飞仅1兵守备，柴桑以6兵南下攻之必克，可得第五城扩张疆土。许昌暂以魏盟暂保无虞，柴桑留5兵固守根本。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":14131,"turn":22,"type":"recruit","factionId":"shu","message":"蜀 在江州征募 5 兵力"},{"id":14132,"turn":22,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻江州失败，进攻方损失 4，守方损失 3，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"jiangzhou","troops":6}},{"id":14133,"turn":22,"type":"transfer","factionId":"wei","message":"魏 从洛阳向宛城调动 4 兵力","payload":{"sourceCityId":"luoyang","targetCityId":"wancheng","troops":4}},{"id":14134,"turn":22,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":14135,"turn":23,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":14136,"turn":23,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 19 金、0 粮"},{"id":14137,"turn":23,"type":"turn_prepared","factionId":null,"message":"第 23 回合（决战阶段）收入与维持已结算"},{"id":14138,"turn":23,"type":"decision_revealed","factionId":"wei","message":"魏：魏军已出宛城，九千精锐攻汉中，践魏吴之约共击蜀汉。望吴侯自江州并进，会猎成都！ 决策理由：汉中为蜀西川门户，当前宛城有兵可战，趁蜀后方空虚与吴合击，克汉中则蜀势衰，亦修复魏吴互信。洛阳留一兵守备。；密谋揭晓：准备守约"},{"id":14139,"turn":23,"type":"decision_revealed","factionId":"shu","message":"蜀：吴贼背盟弃义，私通篡贼欲侵我汉室疆土，孤今兴义师反攻宛城，愿与魏侯共击背义吴虏，安天下黎民。 决策理由：魏据宛城威逼汉中，吴屯兵柴桑窥伺江州，我主动出击反攻宛城消解正面威胁，趁魏吴同盟到期提议联魏攻吴，打破夹击困局。；密谋揭晓：准备守约"},{"id":14140,"turn":23,"type":"decision_revealed","factionId":"wu","message":"吴：江州城防已破，守军寡弱，此正天赐克城之机。权当亲督柴桑精兵南下，一举而定江东门户。 决策理由：江州城防已降一级，守军仅三，柴桑七兵南下以六攻之必克，可得第五城拓展疆土。许昌六兵自固，盟约期内不虞魏犯；同时提请魏公续盟共击蜀汉，维系中原大局。；密谋揭晓：准备守约"},{"id":14141,"turn":23,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":14142,"turn":23,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 魏 提议共同进攻 蜀"},{"id":14143,"turn":23,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 5，守方损失 4，围城进度升至 1/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":7}},{"id":14144,"turn":23,"type":"city_captured","factionId":"wu","message":"吴 攻占江州，损失 2 兵力","payload":{"cityId":"jiangzhou","defenderFactionId":"shu","sourceCityId":"chaisang","targetCityId":"jiangzhou","troops":6}},{"id":14145,"turn":23,"type":"character_captured","factionId":"wu","message":"张飞在城破后被吴俘虏"},{"id":14146,"turn":23,"type":"attack_cancelled","factionId":"wei","message":"魏 的出征因来源城局势变化而取消","payload":{"sourceCityId":"wancheng","targetCityId":"hanzhong","troops":9}},{"id":14147,"turn":24,"type":"alliance_expired","factionId":null,"message":"魏 与 吴 的同盟到期"},{"id":14148,"turn":24,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":14149,"turn":24,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 28 金、18 粮"},{"id":14150,"turn":24,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":14151,"turn":24,"type":"turn_prepared","factionId":null,"message":"第 24 回合（决战阶段）收入与维持已结算"}],"createdAt":"2026-08-17T05:55:43.286Z","updatedAt":"2026-08-17T06:37:22.756Z","exportedAt":"2026-08-17T06:38:06.575Z"}
蜀：孙权背盟夺我江州，大逆不道。备与魏同心讨逆，誓复故土，清定江南，兴复汉室。 决策理由：成都尚有可募兵力，增兵充实后方军力，延续与魏联合讨吴盟约，为克复江州做好准备。；密谋揭晓：准备守约"},{"id":24621,"turn":26,"type":"decision_revealed","factionId":"wu","message":"吴：魏蜀联兵犯境，权当固守要冲。调江州、建业之师集结柴桑，以待天时。 决策理由：魏集重兵于许昌十二营，下回合必攻柴桑。柴桑仅六营不足御敌，遂mobilize集江州三营、建业五营于柴桑，合计十四营，城防坚固，魏寇虽十一营亦不可破。江州虽减至一营，然蜀军力寡，攻力仅二，需三以上方可克城，且围城非必陷，仍可保。；密谋揭晓：无隐秘意图"},{"id":24622,"turn":26,"type":"diplomacy_response","factionId":"wei","message":"魏接受了 蜀 的联合进攻提议"},{"id":24623,"turn":26,"type":"alliance_proposed","factionId":"wei","message":"魏 向 蜀 提议结盟"},{"id":24624,"turn":26,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":24625,"turn":26,"type":"recruit","factionId":"shu","message":"蜀 在成都征募 5 兵力"},{"id":24626,"turn":26,"type":"city_pacified","factionId":"wei","message":"柴桑多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":24627,"turn":26,"type":"city_captured","factionId":"wei","message":"魏 攻占柴桑，损失 4 兵力","payload":{"cityId":"chaisang","defenderFactionId":"wu","sourceCityId":"xuchang","targetCityId":"chaisang","troops":11}},{"id":24628,"turn":26,"type":"mobilize_cancelled","factionId":"wu","message":"吴的战略集结因战场局势变化而取消"},{"id":24629,"turn":26,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":24630,"turn":27,"type":"ceasefire_expired","factionId":null,"message":"蜀 与 魏 的停战到期"},{"id":24631,"turn":27,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":24632,"turn":27,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、9 粮"},{"id":24633,"turn":27,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 61 金、0 粮"},{"id":24634,"turn":27,"type":"turn_prepared","factionId":null,"message":"第 27 回合（决战阶段）收入与维持已结算"}],"createdAt":"2026-08-18T03:35:16.865Z","updatedAt":"2026-08-18T04:16:38.413Z","exportedAt":"2026-08-18T04:18:07.965Z"}
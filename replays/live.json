urn":2,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":12445,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":12446,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":12447,"turn":2,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 6 兵力"},{"id":12448,"turn":2,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":12449,"turn":2,"type":"develop_city","factionId":"wei","message":"魏 将宛城建设为军镇专精 1 级"},{"id":12450,"turn":3,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":12451,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":12452,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原锁钥，今增兵五千，严防柴桑来犯。 决策理由：吴蜀联军以柴桑为跳板，许昌有被攻占之虞，故征兵加强守备；暂不出击，静观其变。；密谋揭晓：无隐秘意图"},{"id":12453,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡汉窃国，天下共诛之。孤与孙吴同盟共扶汉室，今整备汉中军防，待与盟友共讨逆贼兴复汉室。 决策理由：汉中是蜀汉对抗曹魏的前线，升级军事专精可提升前线攻防能力，为约定的联合攻魏做准备，同时巩固吴蜀同盟信任，符合当前蓄势需求。；密谋揭晓：准备守约"},{"id":12454,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：吴蜀同盟既定，本侯亲督江东精锐自柴桑北伐许昌，与汉中王夹击曹贼，共复汉室江山。 决策理由：联攻期限已至，履行攻魏之约。倾柴桑13兵北上许昌，凭联攻加成可期克敌；建业、吴郡后方稳固，无需分兵。；密谋揭晓：准备守约"},{"id":12455,"turn":3,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":12456,"turn":3,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 2 级"},{"id":12457,"turn":3,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 8，守方损失 5，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":13}},{"id":12458,"turn":3,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":12459,"turn":3,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":12460,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":12461,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯前约蜀共攻许昌，刘备却坐观成败。今若与魏共击汉中，蜀地平分，曹某以信义立世，绝不食言。 决策理由：宛城增兵，为西进做准备；吴蜀联攻已现裂痕，借蜀背约之机向吴提议共击汉中，争取避免两线作战。；密谋揭晓：准备守约"},{"id":12462,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡汉窃国，天人共愤。孤依吴蜀同盟之约，整备汉中精锐北伐宛城，共讨逆贼，兴复汉室！ 决策理由：此前与吴约定联合攻魏，今兑现承诺出兵进攻曹魏宛城前线，践行盟约巩固同盟信任，伸讨曹篡汉之大义。；密谋揭晓：准备守约"},{"id":12463,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑前线失利，痛失周郎。今秣马厉兵、整军经武，以待与盟友再会猎中原。 决策理由：上回合攻许昌失利折损8兵、阵亡周瑜，柴桑仅余6人，急需补充。征兵6人恢复前线军力，同时向蜀再提联攻魏国之议，维持同盟施压。；密谋揭晓：准备守约"},{"id":12464,"turn":4,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":12465,"turn":4,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":12466,"turn":4,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":12467,"turn":4,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 6 兵力"},{"id":12468,"turn":4,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":12469,"turn":4,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 8，守方损失 7，城防降低 1 级","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":13}},{"id":12470,"turn":4,"type":"character_fallen","factionId":"shu","message":"关羽在惨烈战斗中阵亡"},{"id":12471,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":12472,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯若与曹某共击刘备，汉中、江州可分；若坐视，曹某亦将独取汉中。许昌已增兵固守，望吴侯三思。 决策理由：许昌直面柴桑吴军威胁，征兵五千加强守备，防止再遭攻击；同时继续向吴提议联合攻蜀，以分化吴蜀同盟，若吴应允，下回合宛城主力将西取汉中。；密谋揭晓：准备守约"},{"id":12473,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡夺汉室江山，天人共愤！孤与吴侯结为同盟，共举义旗讨逆，今日出兵北伐宛城，誓兴复汉室，还于旧都！ 决策理由：依吴蜀同盟约定，接受吴方联合攻魏提议，出兵进攻曹魏宛城前线，践行盟约巩固同盟信任，消解曹魏对汉中的南侵威胁，伸讨贼大义。；密谋揭晓：准备守约"},{"id":12474,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：吴蜀同盟共扶汉室，誓伐曹贼。本侯亲督江东精锐自柴桑北伐许昌，与蜀汉盟友会猎中原。 决策理由：许昌城防已归零、守军仅八，柴桑十二兵可出十一攻之，胜算颇高。边境评估显示许昌无力反取柴桑，故倾力一击。接蜀联攻之请践行盟约，拒魏反间之策不为所动。；密谋揭晓：准备守约"},{"id":12475,"turn":5,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":12476,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":12477,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":12478,"turn":5,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":12479,"turn":5,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 3，守方损失 4","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":5}},{"id":12480,"turn":5,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 7，守方损失 6，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":11}},{"id":12481,"turn":5,"type":"joint_attack_honored","factionId":null,"message":"吴与蜀兑现承诺，共同进攻魏"},{"id":12482,"turn":5,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":12483,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"},{"id":12484,"turn":6,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原锁钥，今再募五千精兵固守。吴侯若愿休兵，魏可西进汉中，两家各得其所。 决策理由：吴军围城未解，许昌仅余七千，征兵五千加强守备；同时向吴提出停战以分化吴蜀，若吴应允则集中对付蜀汉。；密谋揭晓：无隐秘意图"},{"id":12485,"turn":6,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，重兵窥我汉中，孤与吴侯同盟共扶汉室，整军讨逆，誓保汉疆，兴复旧都。 决策理由：汉中直面曹魏宛城重兵，本回合有被攻占风险，急需征兵补强守备；续邀东吴联合攻魏，巩固同盟信任，践行讨曹大义。；密谋揭晓：准备守约"},{"id":12486,"turn":6,"type":"decision_revealed","factionId":"wu","message":"吴：周郎虽殁于王事，江东之志不可堕。今柴桑围城正紧，许昌旦夕可下；吴蜀盟约当续，共图中兴。 决策理由：许昌城防已破、士气低落，柴桑持续围攻可逐步蚕食曹贼；若停攻则围城进度消散，前功尽弃。吴蜀盟约本回合届满，魏屡施反间，续约可固同盟、维持对魏夹击之势。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":12487,"turn":6,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":12488,"turn":6,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":12489,"turn":6,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 7 兵力"},{"id":12490,"turn":6,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 3，守方损失 4","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":4}},{"id":12491,"turn":7,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":12492,"turn":7,"type":"turn_prepared","factionId":null,"message":"第 7 回合（蓄势阶段）收入与维持已结算"},{"id":12493,"turn":7,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯在上，刘备坐拥汉中，屡犯我境，实为天下公敌。今宛城精锐西出，愿与吴共击蜀汉，平分其地，以安天下。 决策理由：趁吴蜀同盟到期，主动攻汉中削弱蜀军，同时向吴示好提议联合攻蜀，分化吴蜀、避免两线作战。；密谋揭晓：准备守约"},{"id":12494,"turn":7,"type":"decision_revealed","factionId":"shu","message":"蜀：吾与吴侯同扶汉室共讨曹贼，旧盟期满，今续新盟，同心勠力克清凶逆，兴复汉室旧都。 决策理由：吴蜀同盟已到期，续缔同盟可维持夹击曹魏的有利态势，巩固盟友信任；征兵补强汉中前线，防备宛城魏军南侵，践行讨贼兴汉大义。；密谋揭晓：准备守约"},{"id":12495,"turn":7,"type":"decision_revealed","factionId":"wu","message":"吴：吴蜀之盟虽暂届，本侯已允蜀侯联攻之议，共击曹贼以安江东。周郎遗志未竟，岂容曹贼逍遥。 决策理由：柴桑仅2兵，魏许昌、蜀江州皆可7兵来攻，capturePossible为真，形势危急。建业调7兵入柴桑使守军达9，可御任何单面进攻。围城1/3停攻一回合不致衰减。受蜀联攻以续盟约，拒魏停战分化之策。；密谋揭晓：准备守约"},{"id":12496,"turn":7,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":12497,"turn":7,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":12498,"turn":7,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":12499,"turn":7,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":12500,"turn":7,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":12501,"turn":7,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":12502,"turn":7,"type":"attack_repulsed","factionId":"wei","message":"魏 进攻汉中失败，进攻方损失 6，守方损失 5，城防降低 1 级","payload":{"sourceCityId":"wancheng","targetCityId":"hanzhong","troops":9}},{"id":12503,"turn":7,"type":"transfer","factionId":"wu","message":"吴 从建业向柴桑调动 7 兵力","payload":{"sourceCityId":"jianye","targetCityId":"chaisang","troops":7}},{"id":12504,"turn":8,"type":"siege_decayed","factionId":"wu","message":"吴 对许昌的围城进度衰减"},{"id":12505,"turn":8,"type":"turn_prepared","factionId":null,"message":"第 8 回合（蓄势阶段）收入与维持已结算"},{"id":12506,"turn":8,"type":"decision_revealed","factionId":"wei","message":"魏：宛城直面蜀军重压，今征兵六营以固城防。同时向吴侯再伸和平之意，愿息兵共安天下。 决策理由：宛城当前守备不足，蜀军可能攻陷，优先征兵补强；许昌尚有八兵可
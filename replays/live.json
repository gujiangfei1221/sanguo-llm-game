t":0},{"id":"ganning","name":"甘宁","originalFactionId":"wu","factionId":"wu","locationCityId":"wujun","status":"active","loyalty":70,"resentment":0},{"id":"luxun","name":"陆逊","originalFactionId":"wu","status":"dead","loyalty":80,"resentment":0}],"director":{"lastCaptureTurn":102,"lastEventTurn":100,"lastStandCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[],"worldWearinessApplied":true},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":25459,"turn":92,"type":"forced_levy","factionId":"wei","message":"魏 在洛阳强征 3 兵力，城市发展受损"},{"id":25460,"turn":93,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":25461,"turn":93,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":25462,"turn":93,"type":"turn_prepared","factionId":null,"message":"第 93 回合（决战阶段）收入与维持已结算"},{"id":25463,"turn":93,"type":"decision_revealed","factionId":"wei","message":"魏：孙权，魏吴连年交兵，百姓疲敝，蜀坐大。孤愿与吴停战修好，共商大计。 决策理由：魏仅余洛阳、许昌，兵寡粮少，不宜再战。吴蜀同盟尚存，强攻无益。主动向吴求和，争取喘息之机，同时观察蜀吴动向，再定策略。；密谋揭晓：暗中寻求议和"},{"id":25464,"turn":93,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，窃据河洛。备与吴侯再续同盟大义，今招回翼德，整军汉中，共举义兵诛灭逆曹，兴复汉室，还于旧都！ 决策理由：秉持联吴抗魏的既定方针，招降我方被俘旧将张飞，集结江州兵力于汉中前线，巩固北伐基地，准备协同吴军共灭曹魏残余，践行兴复汉室的大义。；密谋揭晓：准备守约"},{"id":25465,"turn":93,"type":"decision_revealed","factionId":"wu","message":"吴：中原战事稍歇，孙权整军经武，固守疆界，以待时机。曹公在吴养病，礼遇有加，愿与魏早复和平。 决策理由：边境三城防御均稳，capturePossible皆为false，暂无战机。魏军困守许昌、洛阳两城，资源告急，反扑乏力。柴桑尚有1回合动荡，强征伤城，转移兵则削弱前哨。休整一回合，消耗金粮最低（仅行政3金4粮），待柴桑恢复、宛城城防稳定后再寻破魏之策。；密谋揭晓：无隐秘意图"},{"id":25466,"turn":93,"type":"mobilize","factionId":"shu","message":"蜀向汉中战略集结 4 兵"},{"id":25467,"turn":94,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":25468,"turn":94,"type":"turn_prepared","factionId":null,"message":"第 94 回合（决战阶段）收入与维持已结算"},{"id":25469,"turn":94,"type":"decision_revealed","factionId":"wei","message":"魏：孙权，魏吴皆疲，蜀坐大。孤愿与吴罢兵修好，共制西蜀，可乎？ 决策理由：魏仅余两城，兵寡粮少，不宜两线作战。移许昌一兵增援洛阳，同时再向吴提停战，争取分化吴蜀，以图喘息。；密谋揭晓：无隐秘意图"},{"id":25470,"turn":94,"type":"decision_revealed","factionId":"shu","message":"蜀：翼德乃我刘备手足兄弟，今日重归麾下。吾与吴侯永结同盟，同心戮力共讨篡汉曹贼，誓兴复汉室，还于旧都！ 决策理由：招降我方被俘旧将张飞，调汉中主力巩固东线江州前线防务，恪守吴蜀同盟，秉持联吴抗魏既定方针，筹备北伐灭魏。；密谋揭晓：准备守约"},{"id":25471,"turn":94,"type":"decision_revealed","factionId":"wu","message":"吴：魏困守二城，兵寡将乏，焉能言和？吴当整军蓄锐，待时而动，必不与篡汉之贼共戴天。 决策理由：魏仅余许昌、洛阳，金粮告急，已是强弩之末。吴边境三城防御稳固，borderThreats全false，无被攻破之虞。攻许昌需6.6、攻洛阳需4.4，当前仅能从宛城出兵4，强攻无必胜之算，反损宛城。故休整一回合，保存实力，待下回合强征蓄兵后相机而动。（外交行为不在当前白名单中，已忽略）；密谋揭晓：无隐秘意图"},{"id":25472,"turn":94,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":25473,"turn":94,"type":"transfer","factionId":"wei","message":"魏 从许昌向洛阳调动 1 兵力","payload":{"sourceCityId":"xuchang","targetCityId":"luoyang","troops":1}},{"id":25474,"turn":94,"type":"transfer","factionId":"shu","message":"蜀 从汉中向江州调动 4 兵力","payload":{"sourceCityId":"hanzhong","targetCityId":"jiangzhou","troops":4}},{"id":25475,"turn":95,"type":"director_stalemate","factionId":"wei","message":"战局久滞，流民投奔魏，补充兵源并集结 2 兵"},{"id":25476,"turn":95,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、12 粮"},{"id":25477,"turn":95,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":25478,"turn":95,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 0 金、10 粮"},{"id":25479,"turn":95,"type":"turn_prepared","factionId":null,"message":"第 95 回合（决战阶段）收入与维持已结算"},{"id":25480,"turn":95,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀之盟将尽，孙权久据宛城、柴桑，实为两家心腹之患。孤愿与皇叔停战修好，共制东吴，还天下太平。 决策理由：魏仅余二城，当先固本再图进取。洛阳增兵巩固北线，同时向蜀提出停战，以分化吴蜀同盟，暂不轻动。；密谋揭晓：无隐秘意图"},{"id":25481,"turn":95,"type":"decision_revealed","factionId":"shu","message":"蜀：翼德本我手足兄弟，今日重归麾下。备集结义兵于汉中，与吴侯同心戮力，共诛篡汉曹贼，兴复汉室指日可待！ 决策理由：招降我方旧将张飞，集结江州主力于汉中北伐基地，整军备战，恪守吴蜀同盟，秉持联吴抗魏兴复汉室的既定方针。；密谋揭晓：准备守约"},{"id":25482,"turn":95,"type":"decision_revealed","factionId":"wu","message":"吴：宛城强征三兵，整军蓄锐。天时已至，吴军当北上中原，毕其功于一役。 决策理由：边境三城暂无被破之虞，强征宛城三兵可令下回合出兵上限提至七，攻克洛阳防御4.4、许昌6.6皆有可能。决战之际，当速灭曹魏，不可再延。耗金24粮18，吴资充裕，可承受。；密谋揭晓：无隐秘意图"},{"id":25483,"turn":95,"type":"forced_levy","factionId":"wu","message":"吴 在宛城强征 3 兵力，城市发展受损"},{"id":25484,"turn":95,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 2 兵力"},{"id":25485,"turn":95,"type":"mobilize","factionId":"shu","message":"蜀向汉中战略集结 4 兵"},{"id":25486,"turn":96,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 4 金、8 粮"},{"id":25487,"turn":96,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":25488,"turn":96,"type":"turn_prepared","factionId":null,"message":"第 96 回合（决战阶段）收入与维持已结算"},{"id":25489,"turn":96,"type":"decision_revealed","factionId":"wei","message":"魏：孙权强征宛城，兵锋虽盛，然蜀吴之盟将尽。孤暂避其锋，固守许昌，坐待其变。 决策理由：许昌尚有兵源，征兵二名加强南线防御；吴军虽在宛城增兵，但尚不足以攻破我城。蜀吴同盟本回合到期，暂不轻动，先稳固防线再观局势。；密谋揭晓：无隐秘意图"},{"id":25490,"turn":96,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，天人共怒，备与吴侯缔盟共讨逆贼，岂容你离间诡计！汉室必复，逆魏必灭，绝不与贼媾和！ 决策理由：魏遣使停战欲离间吴蜀同盟，备恪守联吴抗魏大义，拒绝魏停战提议，招降故将张飞，汉中强征补充北伐兵力，整军备战共灭曹魏。；密谋揭晓：准备守约"},{"id":25491,"turn":96,"type":"decision_revealed","factionId":"wu","message":"吴：魏困守孤城，兵寡将乏。天予不取，反受其咎。今七万精兵北上，直捣洛阳，毕其功于一役！ 决策理由：魏仅余洛阳、许昌二城，洛阳守军七、防御零，攻克需4.4。宛城经强征后驻八，出兵上限七，可一举而下。边境三城borderThreats全false，无后顾之忧。攻下洛阳则魏失北都仅余许昌孤城，灭亡可期。曹操仍囚作筹码，不释不杀。；密谋揭晓：无隐秘意图"},{"id":25492,"turn":96,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":25493,"turn":96,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 2 兵力"},{"id":25494,"turn":96,"type":"forced_levy","factionId":"shu","message":"蜀 在汉中强征 3 兵力，城市发展受损"},{"id":25495,"turn":96,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻洛阳失败，进攻方损失 5，守方损失 3，围城进度升至 1/3","payload":{"sourceCityId":"wancheng","targetCityId":"luoyang","troops":7}},{"id":25496,"turn":97,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":25497,"turn":97,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":25498,"turn":97,"type":"turn_prepared","factionId":null,"message":"第 97 回合（决战阶段）收入与维持已结算"},{"id":25499,"turn":97,"type":"decision_revealed","factionId":"wei","message":"魏：蜀吴盟散，吴军新败。孤攻宛城以削吴势，愿与皇叔共击吴，平分江东。 决策理由：吴攻洛阳受挫，宛城兵寡，趁势攻取；蜀吴同盟已解，可争取蜀共制吴。；密谋揭晓：无隐秘意图"},{"id":25500,"turn":97,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室后裔，志在讨灭篡汉逆曹，今蜀吴同盟到期，愿与吴侯重缔盟约，同心共戮曹氏，兴复汉室，绝不背义！ 决策理由：江州临境防备薄弱，有失陷风险，故从汉中调精兵增援。蜀吴同盟到期，重提结盟，恪守联吴抗魏既定方针，共图灭魏兴汉。；密谋揭晓：准备守约"},{"id":25501,"turn":97,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑强征守备，固我根基。吴蜀旧盟虽到期，唇亡齿寒之理当共鉴，权已遣使重缔盟约。 决策理由：宛城兵寡三卒，borderThreats显示魏蜀皆可攻取，难保不失。强征柴桑三兵使城防由4.8升至8.4，超许昌威胁所需5.28，可保建业屏障。吴蜀同盟本回合到期，蜀为抗魏主力且屡拒曹贼，速续盟约保侧翼安全，并备下回合联兵破魏。；密谋揭晓：准备守约"},{"id":25502,"turn":97,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 蜀 提议共同进攻 吴"},{"id":25503,"turn":97,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":25504,"turn":97,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":25505,"turn":97,"type":"forced_levy","factionId":"wu","message":"吴 在柴桑强征 3 兵力，城市发展受损"},{"id":25506,"turn":97,"type":"city_pacified","factionId":"wei","message":"宛城多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":25507,"turn":97,"type":"city_captured","factionId":"wei","message":"魏 攻占宛城，损失 2 兵力","payload":{"cityId":"wancheng","defenderFactionId":"wu","sourceCityId":"xuchang","targetCityId":"wancheng","troops":5}},{"id":25508,"turn":97,"type":"transfer","factionId":"shu","message":"蜀 从汉中向江州调动 7 兵力","payload":{"sourceCityId":"hanzhong","targetCityId":"jiangzhou","troops":7}},{"id":25509,"turn":98,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":25510,"turn":98,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、2 粮"},{"id":25511,"turn":98,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 0 金、19 粮"},{"id":25512,"turn":98,"type":"turn_prepared","f
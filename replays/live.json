nId":"wu","locationCityId":"jianye","status":"active","loyalty":80,"resentment":0}],"director":{"lastCaptureTurn":12,"lastEventTurn":0,"lastStandCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":35603,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":35604,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀之盟将尽，曹某愿与江东共襄义举，同伐蜀汉，各安疆土。 决策理由：蜀汉连年扩军，汉中雄兵压境，其心可诛。我朝与江东本无深怨，今愿结好共图蜀地，以绝后患。；密谋揭晓：准备守约"},{"id":35605,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，曹操篡逆窃国，残害苍生，愿与江东孙盟共举义旗，同诛国贼，恢复汉室江山。 决策理由：升级成都商贸专精积蓄财力，巩固后方根基，再次邀约盟友吴共同伐魏，遵循联弱抗强既定方略，积蓄实力以待讨贼。；密谋揭晓：准备守约"},{"id":35606,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：吴郡乃江东后方根底，今添精兵以固疆域。柴桑要塞枕戈待旦，与盟友共议进取之机。 决策理由：吴郡仅8兵为后方薄弱环节，征兵5充实至13，强化防御纵深。盟约第6回合届满在即，今我军已兵厚粮足，主动向蜀提议联合伐魏：柴桑14兵出攻许昌13守军，蜀出汉中15兵夹击宛城20守军。联合加成可弥补兵力差距，须在魏宛城未及再厚之前速战。；密谋揭晓：准备守约"},{"id":35607,"turn":5,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":35608,"turn":5,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":35609,"turn":5,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":35610,"turn":5,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为商贸专精 2 级"},{"id":35611,"turn":5,"type":"recruit","factionId":"wu","message":"吴 在吴郡征募 5 兵力"},{"id":35612,"turn":5,"type":"develop_city","factionId":"wei","message":"魏 将许昌建设为商贸专精 1 级"},{"id":35613,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"},{"id":35614,"turn":6,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯明鉴：蜀汉刘备假仁义之名，实欲吞并江东。曹某愿与吴共结盟好，同伐蜀汉，汉中破后各安疆土。若蒙应允，曹军即刻出宛城夹击汉中。 决策理由：宛城增兵以备攻汉，再次向吴提议联合伐蜀，以破吴蜀之盟。若吴应允，下回合宛城大军出汉中；若不应，则固守待变。；密谋揭晓：准备守约"},{"id":35615,"turn":6,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡汉窃国，天人共怒，备身为汉室宗亲，今与江东孙盟同举义旗，共讨国贼，恢复汉室江山。 决策理由：联吴抗曹为我方既定方略，江东盟友主动邀约共伐篡逆曹魏，顺应盟约接受提议，开发江州为军镇，巩固后方军备，准备协力讨贼。；密谋揭晓：准备守约"},{"id":35616,"turn":6,"type":"decision_revealed","factionId":"wu","message":"吴：曹操僭越，残害苍生。吴蜀盟好，共诛国贼。今柴桑精兵北上，直捣许昌，愿与蜀盟夹击宛城，早定中原。 决策理由：魏都许昌守备仅13，柴桑14兵蓄势已久；与蜀联合攻魏时机已到。接受蜀联合攻魏提议，柴桑13兵出攻许昌，凭联合加成可破；魏宛城20兵远在西方，鞭长莫及。即便魏反扑柴桑，我得许昌亦断其都城，战略上占优。；密谋揭晓：准备守约"},{"id":35617,"turn":6,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":35618,"turn":6,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":35619,"turn":6,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":35620,"turn":6,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":35621,"turn":6,"type":"develop_city","factionId":"shu","message":"蜀 将江州建设为军镇专精 1 级"},{"id":35622,"turn":6,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 8，守方损失 5，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":13}},{"id":35623,"turn":6,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":35624,"turn":6,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":35625,"turn":6,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":35626,"turn":7,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":35627,"turn":7,"type":"turn_prepared","factionId":null,"message":"第 7 回合（蓄势阶段）收入与维持已结算"},{"id":35628,"turn":7,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯明鉴：蜀汉刘备背弃盟友，汉中陈兵虎视江东。曹某愿与江东共伐蜀汉，汉中破后各安疆土，永结盟好。 决策理由：吴蜀同盟已到期且蜀未兑现共同进攻，正是拉拢吴共抗蜀的时机。本回合在宛城征兵5，增强攻汉兵力，同时向吴提议联合攻蜀，若成则下回合夹击汉中。；密谋揭晓：准备守约"},{"id":35629,"turn":7,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡汉窃国，天人共怒。备与江东同履盟好共诛国贼，今整汉中雄兵击宛城，誓复汉室，愿与孙将军再续同盟共成大业。 决策理由：履行吴蜀联合攻魏约定，出兵攻击曹魏宛城，解除汉中被攻占的威胁，同时续盟东吴，坚守联弱抗曹、兴复汉室的既定方略。；密谋揭晓：准备守约"},{"id":35630,"turn":7,"type":"decision_revealed","factionId":"wu","message":"吴：许昌之役虽未竟全功，魏都城防已破，军心受挫。今重整柴桑要塞，与建业、吴郡互为掎角，待兵精粮足，再图北伐。 决策理由：上回合北伐许昌失利，丧师失将，亟需重整旗鼓。优先在柴桑征兵6恢复前线实力至12，三城合计38兵互为依托。魏都城防已破，暂无需急切再攻；蜀方负盟，不宜仓促续约，待其自省表态。；密谋揭晓：无隐秘意图"},{"id":35631,"turn":7,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":35632,"turn":7,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":35633,"turn":7,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":35634,"turn":7,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":35635,"turn":7,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 9，守方损失 9","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":14}},{"id":35636,"turn":7,"type":"character_fallen","factionId":"shu","message":"关羽在惨烈战斗中阵亡"},{"id":35637,"turn":7,"type":"character_fallen","factionId":"wei","message":"张辽在惨烈战斗中阵亡"},{"id":35638,"turn":8,"type":"turn_prepared","factionId":null,"message":"第 8 回合（蓄势阶段）收入与维持已结算"},{"id":35639,"turn":8,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯明鉴：蜀汉背盟弃义，非可久交。魏吴本无深仇，今愿先罢兵休战，再议共讨刘备。若蒙应允，我当专力汉中，江东亦可安守。 决策理由：许昌受吴军威胁，需补强防御；同时向吴提议停战，分化吴蜀，争取时间专攻汉中。本回合征兵2守许昌，待吴回应后再定攻守。；密谋揭晓：无隐秘意图"},{"id":35640,"turn":8,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡汉窃国，天人共怒。备整汉中锐士进击宛城，愿与江东孙将军再续同盟，同诛国贼，兴复汉室。 决策理由：汉中遭曹魏宛城重兵压境，有被攻占风险，故主动出击挫敌锋芒。续盟东吴坚守联吴抗曹方略，兑现共同伐魏承诺，维系盟友信任。；密谋揭晓：准备守约"},{"id":35641,"turn":8,"type":"decision_revealed","factionId":"wu","message":"吴：魏都城防已破，守军空虚，此天予我取许昌之时。柴桑精兵北上，必克中原。 决策理由：许昌城防经上回合攻伐已破，仅余8兵，防御力大降。柴桑出兵11，加军事专精加成，攻力远超守力，此乃破魏都之良机。取许昌可获金7粮6之入，并打通北进通道。即便受挫，柴桑仍可凭建业、吴郡互援稳固。；密谋揭晓：无隐秘意图"},{"id":35642,"turn":8,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":35643,"turn":8,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的结盟提议"},{"id":35644,"turn":8,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 2 兵力"},{"id":35645,"turn":8,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 3，守方损失 6","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":5}},{"id":35646,"turn":8,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 7，守方损失 5，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":11}},{"id":35647,"turn":9,"type":"turn_prepared","factionId":null,"message":"第 9 回合（争锋阶段）收入与维持已结算"},{"id":35648,"turn":9,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯明鉴：蜀汉负盟，汉中空虚，魏军已出宛城攻之。愿与江东共伐刘备，各取蜀土。若蒙应允，下回合同攻蜀地，以安天下。 决策理由：汉中守军薄弱，先取汉中可断蜀汉一臂；宛城留兵防守，防蜀反扑。同时向吴提议联合伐蜀，分化吴蜀，若吴应允则下回合夹击，若不应仍可凭汉中、宛城固守。；密谋揭晓：准备守约"},{"id":35649,"turn":9,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡汉窃国，祸乱天下，备身为汉室宗亲，志在兴复汉室。今添兵汉中御曹寇，愿约江东孙将军同举义旗，共诛国贼。 决策理由：汉中为蜀北门户，曹魏宛城屯重兵，城防不足有被攻占风险，故集结后方兵力增援加强防御，同时邀约东吴共伐曹魏，坚守联吴抗曹既定方略。；密谋揭晓：准备守约"},{"id":35650,"turn":9,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑乃江东门户，当固若金汤。今增城防，枕戈待旦，以待天时。魏寇虽遣使缓兵，许昌城防已破在即，岂可轻许。 决策理由：柴桑当前防御力6，而蜀江州敌军最大攻击7，缺口约0.9，若不立即加固有失城之险。优先fortify柴桑提升本回合防御。魏提议停战，然我围许昌已得1/3进度，且城防已破，正是破都良机，暂拒停战以保攻势。；密谋揭晓：无隐秘意图"},{"id":35651,"turn":9,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":35652,"turn":9,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":35653,"turn":9,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":35654,"turn":9,"type":"fortify","factionId":"wu","message":"吴 加固了柴桑城防"},{"id":35655,"turn":9,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 4 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":12}},{"id":35656,"turn":9,"type":"mobilize_cancelled","factionId":"shu","message":"蜀的战略集结因战场局势变化而取消"},{"id":35657,"turn":10,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":35658,"turn":10,"type":"turn_prepared","factionId":null,"message":"第 10 回合（争锋阶段）收入与维持已结算"},{"id":35659,"turn":10,"type":"decision_revealed","factionId":"wei","message":"魏：刘备：汉中已定，再战徒耗苍生。愿与蜀休战，共御孙吴。 决策理由：许昌为魏都，吴军围城未解，先募兵固守。同时向蜀提议休战，避免两线作战，以便集中对吴。；密谋揭晓：无隐秘意图"},{"id":35660,"turn":10,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，侵我汉中，备身为汉室宗亲，誓讨国贼。愿与孙将军同举义旗，共击曹魏，兴复汉室，永固盟好。 决策理由：江州为蜀汉前线军事重镇，升级军事专精可增强守备与战力，同时邀约东吴共伐曹魏，坚守联弱抗曹的既定方略，维系盟友信任。；密谋揭晓：准备守约"},{"id":35661,"turn":10,"type":"decision_revealed","factionId":"wu","message":"吴：许昌城防空虚，围城已得其半。今再发柴桑精兵，誓克魏都，底定中原。 决策理由：许昌城防0、兵仅5，围城进度1/3，正是一鼓而下之时。柴桑出兵4，凭军事专精与吴蜀联攻之利攻之，必有所获。克许昌则金7粮6入囊，更断魏一臂，使其洛阳、宛城孤立可图。；密谋揭晓：准备守约"},{"id":35662,"turn":10,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":35663,"turn":10,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":35664,"turn":10,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":35665,"turn":10,"type":"develop_city","factionId":"shu","message":"蜀 将江州建设为军镇专精 2 级"},{"id":35666,"turn":10,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 3，守方损失 3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":4}},{"id":35667,"turn":10,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":35668,"turn":11,"type":"siege_decayed","factionId":"wu","message":"吴 对许昌的围城进度衰减"},{"id":35669,"turn":11,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":35670,"turn":11,"type":"turn_prepared","factionId":null,"message":"第 11 回合（争锋阶段）收入与维持已结算"},{"id":35671,"turn":11,"type":"decision_revealed","factionId":"wei","message":"魏：孙权屡犯许昌，今柴桑守备空虚，正当乘势拔之，断其北进之路；汉中已固，蜀若来犯自有应对。 决策理由：许昌现有7兵，柴桑仅2兵且城防未足为恃；以6兵出击，胜则去一心腹之患，败亦不致动摇根本。同时留意汉中，暂无失陷之危。；密谋揭晓：无隐秘意图"},{"id":35672,"turn":11,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡汉窃我汉中，备身为汉室宗亲，誓讨国贼收复门户，愿与江东孙将军同心戮力，共灭曹贼，兴复汉室。 决策理由：汉中为蜀汉北部门户，落入曹魏之手，必须主动出兵收复。拒绝曹魏停战分化的阴谋，坚守联吴抗曹方略，维系盟友信任。；密谋揭晓：准备守约"},{"id":35673,"turn":11,"type":"decision_revealed","factionId":"wu","message":"吴：江东门户当固，增兵柴桑以御外侮。曹贼未灭，吴蜀宜共图之。 决策理由：柴桑守军仅二，城防虽固亦难挡蜀魏夹击。全力征兵六充实柴桑，使驻军达八、防御力骤升，方可保门户无虞。兼向蜀提议正式结盟，稳固侧翼后再图中原。；密谋揭晓：准备守约"},{"id":35674,"turn":11,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":35675,"turn":11,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":35676,"turn":11,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":35677,"turn":11,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":35678,"turn":11,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻汉中失败，进攻方损失 5，守方损失 3，围城进度升至 1/3","payload":{"sourceCityId":"chengdu","targetCityId":"hanzhong","troops":7}},{"id":35679,"turn":11,"type":"attack_repulsed","factionId":"wei","message":"魏 进攻柴桑失败，进攻方损失 4，守方损失 3，城防降低 1 级","payload":{"sourceCityId":"xuchang","targetCityId":"chaisang","troops":6}},{"id":35680,"turn":12,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 3 金、4 粮"},{"id":35681,"turn":12,"type":"turn_prepared","factionId":null,"message":"第 12 回合（争锋阶段）收入与维持已结算"},{"id":35682,"turn":12,"type":"decision_revealed","factionId":"wei","message":"魏：魏已加强许昌防务，并向吴提出休战，愿共谋蜀地，以安天下。 决策理由：许昌为魏都，吴军仍可威胁，故立即募兵补防。汉中虽受蜀军压力，但两线兼顾有限，先保都城再图后计。同时向吴提议停战，以缓两线压力。；密谋揭晓：无隐秘意图"},{"id":35683,"turn":12,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，誓讨篡汉逆贼曹孟德，今与吴侯缔盟共举义旗，出兵收复汉中门户，兴复汉室！ 决策理由：汉中为蜀汉北部门户，沦于曹贼之手，出兵收复失地；接受东吴结盟提议，践行联吴抗曹方略，稳固盟友信任。；密谋揭晓：准备守约"},{"id":35684,"turn":12,"type":"decision_revealed","factionId":"wu","message":"吴：蜀汉既有伐魏之约，权敢不从命？今江东精兵齐集柴桑，待约定期至，与汉中蜀军并力北向，共破曹贼。 决策理由：柴桑当前驻军仅五，防御力六，而蜀江州可出兵七、攻力七，存在被夺城风险。优先从前线后方调兵八至柴桑，使其驻军达十三，防御力远超威胁，确保门户安全后再图北伐。外交上接受蜀联合进攻魏之议，履约守信以固盟好。；密谋揭晓：准备守约"},{"id":35685,"turn":12,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":35686,"turn":12,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":35687,"turn":12,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":35688,"turn
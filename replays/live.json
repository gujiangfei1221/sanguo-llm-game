升联合行动信任与战斗加成。；密谋揭晓：准备守约"},{"id":40034,"turn":2,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":40035,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":40036,"turn":2,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":40037,"turn":2,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为农桑专精 1 级"},{"id":40038,"turn":2,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":40039,"turn":2,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":40040,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"}],"createdAt":"2026-08-19T12:48:48.771Z","updatedAt":"2026-08-19T12:49:58.486Z","exportedAt":"2026-08-19T12:50:08.309Z"}
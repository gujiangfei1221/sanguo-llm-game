,{"id":4117,"turn":12,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀之盟已生裂隙，蜀屡不践攻约。孤已固宛城，愿与吴侯休兵，共讨无信之蜀。 决策理由：宛城受蜀军围困且守力不足，本回合征募五营至满额，确保不被攻陷。趁吴蜀盟约松动，向吴提出停战以分化敌军。；密谋揭晓：无隐秘意图"},{"id":4118,"turn":12,"type":"decision_revealed","factionId":"shu","message":"蜀：孤奉汉室明诏，与吴侯戮力同心共讨篡魏逆贼，今倾汉中锐旅直取宛城，东西并进，兴复汉室指日可待！ 决策理由：兑现吴蜀联合伐魏盟约，出动汉中主力进攻曹魏宛城，持续施压推进围城进度，维系盟友信任，坚持联吴抗曹方略，打开北伐中原通道。；密谋揭晓：准备守约"},{"id":4119,"turn":12,"type":"decision_revealed","factionId":"wu","message":"吴：吴蜀同心讨逆，孤先集大军于柴桑，许昌围城之势已满，来日并力急攻，誓取中原门户，愿与玄德公再践前约。 决策理由：柴桑本回合无失守之危，而许昌围城已达3/3，此刻最忌断压致其衰减。今调建业九部增援柴桑，待大军毕集，下回合以围城全势强攻许昌；同时再约蜀联合伐魏，续东西夹击之势，守信于盟友。；密谋揭晓：准备守约"},{"id":4120,"turn":12,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":4121,"turn":12,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":4122,"turn":12,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":4123,"turn":12,"type":"city_captured","factionId":"shu","message":"蜀 攻占宛城，损失 5 兵力","payload":{"cityId":"wancheng","defenderFactionId":"wei","sourceCityId":"hanzhong","targetCityId":"wancheng","troops":11}},{"id":4124,"turn":12,"type":"character_captured","factionId":"shu","message":"张辽在城破后被蜀俘虏"},{"id":4125,"turn":12,"type":"transfer","factionId":"wu","message":"吴 从建业向柴桑调动 9 兵力","payload":{"sourceCityId":"jianye","targetCityId":"chaisang","troops":9}},{"id":4126,"turn":13,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":4127,"turn":13,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":4128,"turn":13,"type":"turn_prepared","factionId":null,"message":"第 13 回合（争锋阶段）收入与维持已结算"},{"id":4129,"turn":13,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯，蜀人无信，屡次违约。魏愿与吴共讨之，许昌可休兵，同取蜀地。 决策理由：许昌为魏都，吴军压境，急需募兵固守。同时向吴提议联合攻蜀，分化吴蜀同盟，争取战略主动。；密谋揭晓：准备守约"},{"id":4130,"turn":13,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室明诏讨逆，与吴侯同心戮力，今如约接受共伐曹贼之请，愿续同盟之好，共兴汉室。 决策理由：开发前线江州为军事专精，巩固边防应对边境威胁，接受东吴联合伐魏提议，主动续缔同盟，坚持联吴抗曹兴复汉室方略，维系盟友信任。；密谋揭晓：准备守约"},{"id":4131,"turn":13,"type":"decision_revealed","factionId":"wu","message":"吴：许昌围城之势已成，孤今倾柴桑之众并力急攻，誓破曹贼门户。曹氏停战之请，其意在缓兵分我吴蜀之盟，孤不受。玄德公，愿再续盟约，共定中原！ 决策理由：许昌围城进度已满3/3，若本回合停止施压则进度衰减，前功尽弃。柴桑守力15.6远超魏军可发之兵，无失守之危。以路线最大12兵强攻许昌（守军仅6且无城防），同时接受蜀联合伐魏之约并兑现，拒绝魏停战以免为其分化吴蜀之计所乘，另提议与蜀续盟巩固东西夹击。；密谋揭晓：准备守约"},{"id":4132,"turn":13,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":4133,"turn":13,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":4134,"turn":13,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":4135,"turn":13,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":4136,"turn":13,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":4137,"turn":13,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":4138,"turn":13,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":4139,"turn":13,"type":"develop_city","factionId":"shu","message":"蜀 将江州建设为军镇专精 1 级"},{"id":4140,"turn":13,"type":"city_captured","factionId":"wu","message":"吴 攻占许昌，损失 5 兵力","payload":{"cityId":"xuchang","defenderFactionId":"wei","sourceCityId":"chaisang","targetCityId":"xuchang","troops":12}},{"id":4141,"turn":13,"type":"character_captured","factionId":"wu","message":"曹操在城破后被吴俘虏"},{"id":4142,"turn":13,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":4143,"turn":13,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":4144,"turn":14,"type":"director_coalition","factionId":"shu","message":"蜀势大，引发天下共讨，声望下降"},{"id":4145,"turn":14,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 20 金、0 粮"},{"id":4146,"turn":14,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":4147,"turn":14,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":4148,"turn":14,"type":"turn_prepared","factionId":null,"message":"第 14 回合（争锋阶段）收入与维持已结算"},{"id":4149,"turn":14,"type":"decision_revealed","factionId":"wei","message":"魏：孤据洛阳，誓复许昌。吴侯若应共讨蜀逆，则东西并进，天下可定。 决策理由：洛阳危急，先固城防，再促吴背蜀，以缓夹击之势。；密谋揭晓：准备守约"},{"id":4150,"turn":14,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室明诏讨逆，今与吴侯续缔同盟，共伐篡汉曹氏，招降张辽助讨贼，兴复汉室指日可待！ 决策理由：坚持联吴抗曹核心方略，接受东吴同盟提议巩固盟约，升级江州军事专精巩固边防，招降张辽充实我方将才，维系盟友信任，符合兴复汉室大义。；密谋揭晓：准备守约"},{"id":4151,"turn":14,"type":"decision_revealed","factionId":"wu","message":"吴：许昌已入我手，曹操就擒，魏祚将尽。孤今续吴蜀之盟，共讨残魏。柴桑乃江西门戸，先募锐卒五部固守，再图西进。玄德公，东西之势不可失也。 决策理由：柴桑仅1兵且被判定可被蜀攻取，征5兵补强为第一要务；许昌7兵暂稳。接受蜀续盟维持东西夹击、避免两线受敌；拒绝魏攻蜀之约，因本回合无合法进攻路线，受约必致失约损信，且魏仅余洛阳一城，不足为援，不宜与强蜀轻启战端。；密谋揭晓：准备守约"},{"id":4152,"turn":14,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":4153,"turn":14,"type":"character_refused","factionId":"shu","message":"张辽拒绝蜀招降，忠诚受到动摇"},{"id":4154,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":4155,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":4156,"turn":14,"type":"develop_city","factionId":"shu","message":"蜀 将江州建设为军镇专精 2 级"},{"id":4157,"turn":14,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":4158,"turn":14,"type":"fortify","factionId":"wei","message":"魏 加固了洛阳城防"},{"id":4159,"turn":15,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":4160,"turn":15,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 1 金、0 粮"},{"id":4161,"turn":15,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":4162,"turn":15,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":4163,"turn":15,"type":"turn_prepared","factionId":null,"message":"第 15 回合（争锋阶段）收入与维持已结算"},{"id":4164,"turn":15,"type":"decision_revealed","factionId":"wei","message":"魏：洛阳乃魏之根本，孤已增兵固守。吴侯若肯弃暗投明，共讨无信之蜀，则魏吴息兵，天下可定。 决策理由：洛阳受吴蜀两面威胁，本回合征兵至满额以保都城。继续向吴提议联合攻蜀，离间吴蜀同盟，争取战略转机。；密谋揭晓：准备守约"},{"id":4165,"turn":15,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室明诏讨逆，与吴侯同心戮力，今提宛城锐旅直取洛阳，殄灭曹氏残逆，兴复汉室指日可待！ 决策理由：兑现吴蜀联合伐魏盟约，出兵进攻曹魏仅剩的洛阳，攻灭残魏，巩固同盟信任，同时招降张辽充实我方将才，符合兴复汉室大义。；密谋揭晓：准备守约"},{"id":4166,"turn":15,"type":"decision_revealed","factionId":"wu","message":"吴：许昌新定，洛阳残魏仅余一城。孤今调柴桑之师五部北上集结，来日合力直捣洛阳，与玄德公东西并进，共成灭魏大功。 决策理由：曹操就擒后魏仅剩洛阳孤城，此刻最忌迟疑让蜀抢先取洛阳坐大。柴桑暂无敌情，抽调五部集结许昌，为下回合强攻洛阳做兵力准备，同时维持吴蜀盟约共讨残魏，符合江东长远利益。；密谋揭晓：准备守约"},{"id":4167,"turn":15,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":4168,"turn":15,"type":"character_recruited","factionId":"shu","message":"张辽接受招降，转投蜀"},{"id":4169,"turn":15,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":4170,"turn":15,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻洛阳失败，进攻方损失 3，守方损失 2，城防降低 1 级","payload":{"sourceCityId":"wancheng","targetCityId":"luoyang","troops":5}},{"id":4171,"turn":15,"type":"transfer","factionId":"wu","message":"吴 从柴桑向许昌调动 5 兵力","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":5}},{"id":4172,"turn":16,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":4173,"turn":16,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":4174,"turn":16,"type":"turn_prepared","factionId":null,"message":"第 16 回合（争锋阶段）收入与维持已结算"},{"id":4175,"turn":16,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯明鉴：蜀人无信，屡背盟约。今魏虽弱，愿以洛阳之兵共讨蜀逆，克宛城、汉中，与吴分其地。若吴侯应允，魏吴可永息干戈。 决策理由：洛阳为魏都，征兵五部以固防。吴蜀同盟将尽，蜀坐大必危吴，故再提联合攻蜀，既解洛阳之围，又可共分蜀地，实为两利。；密谋揭晓：准备守约"},{"id":4176,"turn":16,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室诏命讨逆，与吴侯同心共灭残曹，整备前线军备，克复洛阳指日可待，兴复汉室就在今朝！ 决策理由：宛城为伐魏前线要地，未开发专精，建设为军镇可强化前线战力，坚持联吴抗曹核心方略，巩固同盟信任，为合力攻灭洛阳残魏做准备。；密谋揭晓：准备守约"},{"id":4177,"turn":16,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼仅剩洛阳孤城，孤今亲率九部之师直捣其巢，与玄德公东西并进，共成灭魏之功。魏人反间之计，孤不受也。 决策理由：洛阳守军仅4且城防受损，9兵进攻可破城灭魏；留3兵守许昌，魏军最多3兵来攻亦无法攻陷，确保Commerce重镇无虞。拒绝魏联合攻蜀之议，坚守吴蜀盟约至18回合，避免两线受敌。曹操继续扣押为筹码。；密谋揭晓：准备守约"},{"id":4178,"turn":16,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":4179,"turn":16,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":4180,"turn":16,"type":"develop_city","factionId":"shu","message":"蜀 将宛城建设为军镇专精 1 级"},{"id":4181,"turn":16,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻洛阳失败，进攻方损失 6，守方损失 4，城防降低 1 级","payload":{"sourceCityId":"xuchang","targetCityId":"luoyang","troops":9}},{"id":4182,"turn":16,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":4183,"turn":17,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":4184,"turn":17,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、14 粮"},{"id":4185,"turn":17,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":4186,"turn":17,"type":"turn_prepared","factionId":null,"message":"第 17 回合（争锋阶段）收入与维持已结算"}],"createdAt":"2026-08-16T08:03:48.719Z","updatedAt":"2026-08-16T08:20:55.811Z","exportedAt":"2026-08-16T08:22:07.212Z"}
调许昌精兵南下江州集结，为进取汉中（蜀仅3兵）做准备。蜀势已衰，再邀魏公联攻，若允则两路夹击；若不允，吴一己之力亦可制胜。；密谋揭晓：准备守约"},{"id":36238,"turn":53,"type":"transfer","factionId":"shu","message":"蜀 从汉中向成都调动 2 兵力","payload":{"sourceCityId":"hanzhong","targetCityId":"chengdu","troops":2}},{"id":36239,"turn":53,"type":"mobilize","factionId":"wu","message":"吴向江州战略集结 4 兵"},{"id":36240,"turn":54,"type":"ceasefire_expired","factionId":null,"message":"蜀 与 魏 的停战到期"},{"id":36241,"turn":54,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 4 金、4 粮"},{"id":36242,"turn":54,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 14 金、10 粮"},{"id":36243,"turn":54,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 9 金、12 粮"},{"id":36244,"turn":54,"type":"turn_prepared","factionId":null,"message":"第 54 回合（决战阶段）收入与维持已结算"},{"id":36245,"turn":54,"type":"decision_revealed","factionId":"wei","message":"魏：魏吴同盟如故，孤不助蜀攻吴，亦不轻动刀兵；与蜀停战只为保境安民。 决策理由：洛阳仅四兵，金粮有限，不宜卷入吴蜀之争；与蜀停战可保西境，同时维持魏吴同盟，按兵休整。；密谋揭晓：无隐秘意图"},{"id":36246,"turn":54,"type":"decision_revealed","factionId":"shu","message":"蜀：吴贼背盟侵我益州疆土，掳我三弟张飞，备身为汉室后裔，愿与魏公共讨逆贼，复安天下。 决策理由：汉中为益州门户，本回合有被吴军攻占风险，调成都主力增援巩固边防，邀约魏国共伐背盟吴贼，延续联魏抗吴既定方略。；密谋揭晓：准备守约"},{"id":36247,"turn":54,"type":"decision_revealed","factionId":"wu","message":"吴：蜀贼屡次背盟，掳我将士、侵我疆土。今魏蜀停战已绝，蜀势孤穷，江东奉天讨逆，一战克复成都！ 决策理由：蜀仅成都3兵、汉中1兵，魏蜀联合已散，蜀势孤立。江州集6精兵，以5兵直捣成都，1兵留守可保江州不失。城防零，攻五必克，灭蜀在此一举。魏吴盟约尚存，洛阳兵微，不敢妄动。；密谋揭晓：无隐秘意图"},{"id":36248,"turn":54,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 魏 提议共同进攻 吴"},{"id":36249,"turn":54,"type":"city_captured","factionId":"wu","message":"吴 攻占成都，损失 2 兵力","payload":{"cityId":"chengdu","defenderFactionId":"shu","sourceCityId":"jiangzhou","targetCityId":"chengdu","troops":5}},{"id":36250,"turn":54,"type":"character_captured","factionId":"wu","message":"刘备在城破后被吴俘虏"},{"id":36251,"turn":54,"type":"transfer_cancelled","factionId":"shu","message":"蜀的调兵因战场局势变化而取消"},{"id":36252,"turn":54,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":36253,"t
ops":10}},{"id":42368,"turn":15,"type":"city_captured","factionId":"shu","message":"蜀 攻占许昌，损失 4 兵力","payload":{"cityId":"xuchang","defenderFactionId":"wei","sourceCityId":"wancheng","targetCityId":"xuchang","troops":10}},{"id":42369,"turn":15,"type":"character_captured","factionId":"shu","message":"曹操在城破后被蜀俘虏"},{"id":42370,"turn":16,"type":"director_coalition","factionId":"shu","message":"蜀势大，引发天下共讨，声望下降"},{"id":42371,"turn":16,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 5 金、0 粮"},{"id":42372,"turn":16,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 8 金、10 粮"},{"id":42373,"turn":16,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 15 金、0 粮"},{"id":42374,"turn":16,"type":"turn_prepared","factionId":null,"message":"第 16 回合（争锋阶段）收入与维持已结算"},{"id":42375,"turn":16,"type":"decision_revealed","factionId":"wei","message":"魏：许昌虽失，孤尚在，洛阳魏旗不倒。今休整募兵，固守待变。若吴蜀肯罢兵，魏愿议和；否则唯有一战。 决策理由：洛阳为魏唯一根基，必须补强。本回合征兵五人以固城防，不主动出击；外交暂不轻动，等待吴蜀动向。；密谋揭晓：无隐秘意图"},{"id":42376,"turn":16,"type":"decision_revealed","factionId":"shu","message":"蜀：备为汉室宗亲，信守与吴侯同盟之约，今增兵宛城前沿，誓讨篡汉逆曹，终兴复汉室还于旧都。 决策理由：宛城为我北伐前沿门户，魏据洛阳屯兵，本回合宛城有被攻占风险，故全额征兵巩固防线，维系联吴抗曹大局，稳步推进北伐大业。；密谋揭晓：准备守约"},{"id":42377,"turn":16,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑增兵以固江防，伺机而动。许昌虽失于蜀，曹公下落不明，权当观望，再图良策。 决策理由：蜀势骤盛，攻取魏都，吴两次攻许昌皆折兵而还。柴桑乃江东门户，不可不固。征兵五人厚集前线，为变局预作准备。同时向魏提议结盟，共抗强蜀，以为长久之图。；密谋揭晓：无隐秘意图"},{"id":42378,"turn":16,"type":"alliance_proposed","factionId":"wu","message":"吴 向 魏 提议结盟"},{"id":42379,"turn":16,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":42380,"turn":16,"type":"recruit","factionId":"shu","message":"蜀 在宛城征募 5 兵力"},{"id":42381,"turn":16,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":42382,"turn":17,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 8 金、10 粮"},{"id":42383,"turn":17,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 5 金、0 粮"},{"id":42384,"turn":17,"type":"turn_prepared","factionId":null,"message":"第 17 回合（争锋阶段）收入与维持已结算"},{"id":42385,"turn":17,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯既遣盟书，孤当允之。蜀贼窃我许昌、囚孤身，今以洛阳精兵收复许昌，与吴共讨不义！ 决策理由：接受吴国同盟，拆散吴蜀合力；趁许昌守军薄弱，以洛阳主力奇袭，力求救回曹操并重夺都城。若成，则魏复有根基，可再图中原。；密谋揭晓：准备守约"},{"id":42386,"turn":17,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，奉辞伐罪，今擒得篡汉逆曹，王师直捣洛阳，必兴复汉室，终守与吴侯同盟之约！ 决策理由：魏仅剩洛阳一城，趁其立足未稳主动出击，攻灭曹魏篡逆，信守联吴抗曹盟约，践行兴复汉室大义。；密谋揭晓：准备守约"},{"id":42387,"turn":17,"type":"decision_revealed","factionId":"wu","message":"吴：建业增兵以固江东根本；赠魏黄金二十，聊表睦邻之谊。 决策理由：建业仅1兵，征五人充实根本。魏困守洛阳，赠金二十示好，望其允同盟之议，共抗强蜀。吴蜀盟约尚存一日，信义不亏。；密谋揭晓：准备守约"},{"id":42388,"turn":17,"type":"diplomacy_response","factionId":"wei","message":"魏接受了 吴 的结盟提议"},{"id":42389,"turn":17,"type":"character_executed","factionId":"shu","message":"蜀处决了曹操，天下震动，声望大降"},{"id":42390,"turn":17,"type":"gold_offered","factionId":"wu","message":"吴向魏献上 20 金"},{"id":42391,"turn":17,"type":"recruit","factionId":"wu","message":"吴 在建业征募 5 兵力"},{"id":42392,"turn":17,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻洛阳失败，进攻方损失 3，守方损失 4","payload":{"sourceCityId":"wancheng","targetCityId":"luoyang","troops":5}},{"id":42393,"turn":17,"type":"attack_cancelled","factionId":"wei","message":"魏 的出征因来源城局势变化而取消","payload":{"sourceCityId":"luoyang","targetCityId":"xuchang","troops":10}},{"id":42394,"turn":17,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":42395,"turn":18,"type":"diplomacy_changed","factionId":null,"message":"魏 与 吴 的关系变为同盟"},{"id":42396,"turn":18,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 18 金、0 粮"},{"id":42397,"turn":18,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 6 金、8 粮"},{"id":42398,"turn":18,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、2 粮"},{"id":42399,"turn":18,"type":"turn_prepared","factionId":null,"message":"第 18 回合（争锋阶段）收入与维持已结算"},{"id":42400,"turn":18,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯既已同盟，孤当先固洛阳根本。今征兵五人以备守御，并愿与吴共约讨蜀，待兵马齐
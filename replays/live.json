信守吴蜀同盟约定，增援受威胁的汉中巩固前线，防范曹魏趁机夺城，坚持联吴抗曹的兴复大义。；密谋揭晓：准备守约"},{"id":11855,"turn":10,"type":"decision_revealed","factionId":"wu","message":"吴：江东义旗高举，柴桑聚兵待发，必与蜀汉共克许昌，匡扶汉室。 决策理由：围许昌进度已至三分之二，柴桑仅余四兵不足再攻。本回合调建业、吴郡精兵入柴桑，集十二之众，下回合倾力一击必克许昌。信守盟约，接受蜀联合进攻之议，共图曹贼。；密谋揭晓：准备守约"},{"id":11856,"turn":10,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":11857,"turn":10,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":11858,"turn":10,"type":"city_pacified","factionId":"wei","message":"汉中多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":11859,"turn":10,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 2 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":7}},{"id":11860,"turn":10,"type":"transfer_cancelled","factionId":"shu","message":"蜀的调兵因战场局势变化而取消"},{"id":11861,"turn":10,"type":"mobilize","factionId":"wu","message":"吴向柴桑战略集结 8 兵"},{"id":11862,"turn":11,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":11863,"turn":11,"type":"turn_prepared","factionId":null,"message":"第 11 回合（争锋阶段）收入与维持已结算"},{"id":11864,"turn":11,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃魏都，今增兵固守，再向吴国提议休战，望孙权明察，勿再为蜀国火中取栗。 决策理由：许昌为都且可能被吴军攻占，本回合征兵至满，稳固城防。同时向吴再提停战，若成可全力对付蜀汉。汉中暂无破城之危，暂不调兵。；密谋揭晓：准备守约"},{"id":11865,"turn":11,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，信守吴蜀同盟之约，今发江州锐师进取汉中，清剿篡汉曹逆，与江东戮力同心，共兴汉室！ 决策理由：信守吴蜀联攻曹魏的约定，主动出击曹魏占据的汉中，解除成都被威胁的危机，巩固西线防线，维系同盟信义，坚持联吴抗曹大义。；密谋揭晓：准备守约"},{"id":11866,"turn":11,"type":"decision_revealed","factionId":"wu","message":"吴：江东义师围攻许昌，围城之势已成，今倾柴桑精兵一击必克。曹贼休战之议乃缓兵之计，绝不为其所惑！ 决策理由：围许昌进度2/3，柴桑12兵整装待发，以11兵攻许昌5守军，兵力碾压可必克。克许昌后留4兵守御，余8兵及建业、吴郡后备可应对宛城反扑。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":11867,"turn":11,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":11868,"turn":11,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":11869,"turn":11,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 3 兵力"},{"id":11870,"turn":11,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻汉中失败，进攻方损失 5，守方损失 3，城防降低 1 级","payload":{"sourceCityId":"jiangzhou","targetCityId":"hanzhong","troops":7}},{"id":11871,"turn":11,"type":"city_captured","factionId":"wu","message":"吴 攻占许昌，损失 3 兵力，获得联合进攻加成","payload":{"cityId":"xuchang","defenderFactionId":"wei","sourceCityId":"chaisang","targetCityId":"xuchang","troops":11}},{"id":11872,"turn":11,"type":"character_captured","factionId":"wu","message":"曹操在城破后被吴俘虏"},{"id":11873,"turn":11,"type":"joint_attack_honored","factionId":null,"message":"吴与蜀兑现承诺，共同进攻魏"},{"id":11874,"turn":11,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":11875,"turn":12,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":11876,"turn":12,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":11877,"turn":12,"type":"turn_prepared","factionId":null,"message":"第 12 回合（争锋阶段）收入与维持已结算"},{"id":11878,"turn":12,"type":"decision_revealed","factionId":"wei","message":"魏：许昌既失，洛阳不可再失。曹某愿与吴国休战，共图蜀汉。 决策理由：洛阳、宛城均面临吴军威胁，优先征兵固守洛阳。同时向吴国提议停战，若成则可专注西线。；密谋揭晓：准备守约"},{"id":11879,"turn":12,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，誓清篡汉曹逆，信守与江东同盟之约，整兵备甲，将再取汉中，共图中原兴复汉室。 决策理由：信守吴蜀联攻曹魏的约定，补充成都兵力整训备战，准备再度攻取汉中，巩固西线防线，维系同盟信义。；密谋揭晓：准备守约"},{"id":11880,"turn":12,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼篡汉，吴蜀义师共讨之。今柴桑增兵备战，待与蜀汉戮力同心，北定中原，匡扶汉室。 决策理由：许昌新克城防全毁，柴桑为北伐要冲仅余一兵，急需增兵巩固前线。本回合于柴桑征满六千，与建业、吴郡形成犄角，为进取宛城做准备。同时接受蜀联合进攻之议，维系同盟共图曹贼。；密谋揭晓：准备守约"},{"id":11881,"turn":12,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":11882,"turn":12,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":11883,"turn":12,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":11884,"turn":12,"type":"recruit","factionId":"shu","message":"蜀 在成都征募 5 兵力"},{"id":11885,"turn":13,"type":"alliance_expired","fact
urn":9,"type":"transfer","factionId":"wei","message":"魏 从洛阳向宛城调动 7 兵力","payload":{"sourceCityId":"luoyang","targetCityId":"wancheng","troops":7}},{"id":23608,"turn":9,"type":"transfer","factionId":"shu","message":"蜀 从江州向汉中调动 10 兵力","payload":{"sourceCityId":"jiangzhou","targetCityId":"hanzhong","troops":10}},{"id":23609,"turn":9,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":23610,"turn":10,"type":"turn_prepared","factionId":null,"message":"第 10 回合（争锋阶段）收入与维持已结算"},{"id":23611,"turn":10,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃魏都，今增兵固守，绝不容失。同时向吴侯表达停战诚意，愿与江东休兵，各安疆土。若吴侯执意来攻，孤亦不惧，唯有死战到底。 决策理由：吴军围许昌已三分，必须增兵以防城破。宛城九兵尚可御蜀，故征兵许昌四员固守。向吴提停战以分化吴蜀同盟，若吴应允则西线可专防蜀军，若不应则继续消耗。；密谋揭晓：暗中寻求议和"},{"id":23612,"turn":10,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，祸乱天下，吾与吴侯同盟共讨，今日兴师出汉中直取宛城，誓灭汉贼，兴复汉室！ 决策理由：信守吴蜀同盟约定，履行联合攻魏承诺，出兵讨伐曹魏宛城，打开北伐中原通道，巩固蜀地北方门户，拒绝曹魏离间阴谋。；密谋揭晓：准备守约"},{"id":23613,"turn":10,"type":"decision_revealed","factionId":"wu","message":"吴：江东义师围许昌已逾半成，贼势日蹙。今增兵柴桑固守前线，以待时机再攻关，与西蜀共图曹贼。 决策理由：柴桑围许昌进度至三分之二，前景可期。然柴桑仅余三兵，若魏军反扑则前线动摇。征四兵补强，既使下回合得以六兵再攻关，又防魏军突袭，巩固围城主基，待城防崩溃一鼓而下。；密谋揭晓：准备守约"},{"id":23614,"turn":10,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":23615,"turn":10,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 4 兵力"},{"id":23616,"turn":10,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 4 兵力"},{"id":23617,"turn":10,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 6，守方损失 4，围城进度升至 1/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":10}},{"id":23618,"turn":11,"type":"director_stalemate","factionId":"shu","message":"战局久滞，流民投奔蜀，补充兵源并集结 2 兵"},{"id":23619,"turn":11,"type":"turn_prepared","factionId":null,"message":"第 11 回合（争锋阶段）收入与维持已结算"},{"id":23620,"turn":11,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃魏都，孤已下令加固城防。吴侯若肯罢兵，魏吴可共息干戈；若执意来犯，孤必死守。 决策理由：吴军围许昌已深，今先固城防以保根本；同时再向吴示好，争取分化吴蜀之盟。宛城尚稳，暂不调动。；密谋揭晓：暗中寻求议和"},{"id":23621,"turn":11,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，祸乱苍生，吾与吴侯同盟共讨，今日兴师出汉中取宛城，誓灭汉贼，兴复汉室！ 决策理由：信守吴蜀同盟约定，兑现联合攻魏承诺，出兵施压曹魏宛城，削弱曹魏西线力量，巩固同盟信任，挫败曹魏离间图谋。；密谋揭晓：准备守约"},{"id":23622,"turn":11,"type":"decision_revealed","factionId":"wu","message":"吴：江东义师围攻许昌已逾两旬，贼势日蹙。今再发柴桑之兵，誓破许昌城防，与西蜀共灭汉贼。曹贼休兵之议，孤不为所动。 决策理由：围许昌进度已至三分之二，城防归零，胜算在即。柴桑七兵出六攻关，留一守城足以御敌（防御力9.8 vs 敌最大攻击8）。接受蜀联合攻魏之议以获战斗加成，拒曹停战离间之计。；密谋揭晓：准备守约"},{"id":23623,"turn":11,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":23624,"turn":11,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":23625,"turn":11,"type":"fortify","factionId":"wei","message":"魏 加固了许昌城防"},{"id":23626,"turn":11,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 3，守方损失 2，围城进度升至 2/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":4}},{"id":23627,"turn":11,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 4，守方损失 4，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":6}},{"id":23628,"turn":11,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":23629,"turn":12,"type":"turn_prepared","factionId":null,"message":"第 12 回合（争锋阶段）收入与维持已结算"},{"id":23630,"turn":12,"type":"decision_revealed","factionId":"wei","message":"魏：宛城乃西线要冲，孤已增兵固守。吴侯若愿与魏共讨刘备，则中原江东可永结同盟；若执意助蜀，唯有兵戎相见。 决策理由：蜀军连月攻宛城，围城已深。今征兵五员充实宛城，确保西线不失。同时向吴提议联合攻蜀，意在分化吴蜀之盟；若吴应允则南北夹击，若不应则固守待变。；密谋揭晓：无隐秘意图"},{"id":23631,"turn":12,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，祸乱苍生，吾与吴侯同盟共讨汉贼，整兵汉中增益北伐军力，誓破宛城，兴复汉室，绝不受曹贼离间！ 决策理由：信守吴蜀同盟约定，增兵北伐前沿汉中，筹备攻取宛城，继续履行联合攻魏承诺，挫败曹魏分化同盟图谋，巩固北伐根基。；密谋揭晓：准备守约"},{"id":23632,"turn":12,"type":"decision_revealed","factionId":"wu","message":"吴：江东整军柴桑，集结精锐以图许昌。与西蜀续盟共讨汉贼，誓灭曹氏。 决策理由：围许昌已逾半成，城防归零。调建业、吴郡之兵赴柴桑，期下回合以十一之众一鼓而下。同时向蜀提议续联合攻魏之约，维系联盟加成。；密谋揭晓：准备守约"},{"id":23633,"turn":12,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":23634,"turn":12,"type":"joint_
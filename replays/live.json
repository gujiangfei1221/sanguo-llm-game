ible:false，留1兵足以自守；7兵攻许昌13守军，配合蜀汉汉中出兵，有望破城。；密谋揭晓：准备守约"},{"id":44783,"turn":4,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":44784,"turn":4,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":44785,"turn":4,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":44786,"turn":4,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 5，守方损失 4","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":7}},{"id":44787,"turn":4,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 5，守方损失 4","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":7}},{"id":44788,"turn":4,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":44789,"turn":4,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":44790,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":44791,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原腹心，今再兴商市，充实国用。同时遣使东吴，晓以利害：蜀强则吴危，若共取益州，则两家皆安。 决策理由：吴蜀联盟虽在，然利益终有分歧。以攻蜀之议试孙权心意，若其应允，则可破蜀；若其不从，亦足离间。许昌商市升级可增岁入，为后续征战蓄力。；密谋揭晓：准备守约"},{"id":44792,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：吾与江东孙将军同盟共讨汉贼，今整兵汉中固防，再约同心协力，共破曹贼，兴复汉室！ 决策理由：汉中直面魏宛城重兵，当前有被攻占风险，故而征募兵力巩固前线边防，再提联合攻魏之议，维系吴蜀同盟信义，践行讨逆大义。；密谋揭晓：准备守约"},{"id":44793,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑乃江东门户，今调建业之兵北上增防，以固根本。与蜀同盟共讨国贼之议当延续，望刘皇叔再整旗鼓，共图许昌。 决策理由：柴桑borderThreat显示capturePossible为真，敌自许昌可发兵8攻我，而柴桑城防仅4.2，必须立即调兵增援。从建业调7兵至柴桑，使守军达10人，可保门户不失。魏方离间之计不可纳，拒其结盟以全信义；再向蜀提议联合攻魏延续盟约。；密谋揭晓：准备守约"},{"id":44794,"turn":5,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":44795,"turn":5,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":44796,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的结盟提议"},{"id":44797,"turn":5,"type":"joint_attack_proposed","factionId":"wu","message"
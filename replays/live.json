eTurn":14,"lastEventTurn":15,"lastStandCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":15464,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：江东与蜀汉唇齿相依，今共结同心，整军蓄势，待时而动，共讨曹贼。 决策理由：柴桑为江东门户，军事专精已立。魏方新败于汉中折损张辽，正处重整之期。依既定联蜀抗曹之策，允其合击之议，本回合先征兵六营充实前线，待下回合兵精粮足再与蜀军会猎许昌，方为万全。；密谋揭晓：准备守约"},{"id":15465,"turn":4,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":15466,"turn":4,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 2 级"},{"id":15467,"turn":4,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":15468,"turn":4,"type":"transfer","factionId":"wei","message":"魏 从洛阳向宛城调动 7 兵力","payload":{"sourceCityId":"luoyang","targetCityId":"wancheng","troops":7}},{"id":15469,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":15470,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀联盟，各怀鬼胎。孤增兵许昌，严阵以待，若其来犯，必叫江东子弟葬身城下。 决策理由：许昌为魏都，吴军柴桑增兵至十九，威胁日增。本回合征募五营守军，巩固根本，以观吴蜀之变。；密谋揭晓：无隐秘意图"},{"id":15471,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡逆窃据中原，陈兵宛城窥我汉中，备整军固防，信守与孙吴同盟之约，共图兴复汉室。 决策理由：汉中为我抗魏前沿，宛城魏军势大，本回合有失陷风险，就地募兵增强防御，信守与吴同盟约定，筹备后续共讨曹贼。；密谋揭晓：准备守约"},{"id":15472,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼僭越，兵犯汉中而败，张辽殒命。今与蜀汉结盟，当共讨国贼，兴复汉室！江东健儿，随我北上！ 决策理由：联蜀抗曹既定之策。魏攻汉中受挫折损张辽，士气低落；许昌守军仅十三城防亦薄，正可乘虚而入。柴桑军镇兵精，以十八兵出击，配以蜀军汉中夹击，胜算在握。纵使柴桑留兵少，魏无力攻取，可保无虞。；密谋揭晓：准备守约"},{"id":15473,"turn":5,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":15474,"turn":5,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":15475,"turn":5,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 11，守方损失 7，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":18}},{"id":15476,"turn":5,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":15477,"turn":5,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":15478,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"},{"id":15479,"turn":6,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀虽盟，蜀却背约未攻，吴已损兵折将。孤愿与江东共击蜀汉，平分西川，望孙将军思之。 决策理由：宛城直面汉中蜀军，增兵固守以稳西线；同时向吴示好，离间吴蜀，为后续破局留有余地。；密谋揭晓：无隐秘意图"},{"id":15480,"turn":6,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，信守与江东孙将军的同盟之约，今日举汉中之师讨伐曹贼宛城，愿与江东同心戮力，共诛篡逆，兴复汉室！ 决策理由：兑现此前与吴达成的联合攻魏约定，出兵进攻曹魏西线重镇宛城，削弱曹魏西线力量，维系同盟信任，坚持联吴抗曹的核心战略。；密谋揭晓：准备守约"},{"id":15481,"turn":6,"type":"decision_revealed","factionId":"wu","message":"吴：周瑜殒命，江东痛失柱石。权当整军经武，重振旗鼓，与盟友共图大业。 决策理由：周瑜阵亡元气大伤，柴桑前线需充实兵力。许昌城防虽破但魏仍可增兵至十营以上，此时强攻难胜。先募兵六营恢复前线，下回合兵精再举，方为万全之策。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":15482,"turn":6,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":15483,"turn":6,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":15484,"turn":6,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 6 兵力"},{"id":15485,"turn":6,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":15486,"turn":6,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 8，守方损失 6，城防降低 1 级","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":12}},{"id":15487,"turn":6,"type":"character_fallen","factionId":"shu","message":"关羽在惨烈战斗中阵亡"},{"id":15488,"turn":7,"type":"turn_prepared","factionId":null,"message":"第 7 回合（蓄势阶段）收入与维持已结算"},{"id":15489,"turn":7,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀盟约已尽，曹操愿与孙将军修好，共讨刘备，平分西川。望江东早做决断。 决策理由：许昌直面柴桑吴军，征兵五营巩固都城；再次向吴提议共击蜀汉，以离间吴蜀。若吴应约，则下回合自宛城取汉中。；密谋揭晓：准备守约"},{"id":15490,"turn":7,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹操窃据神器谋逆篡汉，今信守与江东同盟之约，出兵讨伐宛城逆贼，愿与孙将军同心戮力，共诛曹贼，兴复汉室。 决策理由：宛城魏军陈兵汉中外围，汉中本回合有失陷风险，主动出击攻打宛城削弱曹魏西线，信守与吴联合攻魏约定，巩固同盟信任，坚持联吴抗曹核心战略。；密谋揭晓：准备守约"},{"id":15491,"turn":7,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼僭越，残害忠良。今与蜀汉同心协力，共举义师，誓取许昌，兴复汉室！ 决策理由：许昌城防已破，仅余十一兵。柴桑十四兵携军事专精出击，配以蜀军联合夹击之利，胜算在握。曹操远在许昌，若一战而下，可动摇魏之根本。联盟之约本回合末届满，此战务必速决。；密谋揭晓：准备守约"},{"id":15492,"turn":7,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":15493,"turn":7,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":15494,"turn":7,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":15495,"turn":7,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 3，守方损失 4","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":4}},{"id":15496,"turn":7,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 8，守方损失 7，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":13}},{"id":15497,"turn":7,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":15498,"turn":8,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":15499,"turn":8,"type":"turn_prepared","factionId":null,"message":"第 8 回合（蓄势阶段）收入与维持已结算"},{"id":15500,"turn":8,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀同盟已散，孤无意与江东为敌。今请停战，共息干戈；若孙权应和，便可专力讨伐刘备。 决策理由：汉中守军仅二，宛城兵精可一战而下；趁吴蜀盟散，先取汉中削弱西线，同时向吴请和，避免两线作战。；密谋揭晓：暗中寻求议和"},{"id":15501,"turn":8,"type":"decision_revealed","factionId":"shu","message":"蜀：曹操篡逆窃据汉室天下，陈兵宛城窥我汉中门户。备身为汉室宗亲，愿与孙吴再续同盟，同心戮力共诛曹贼，兴复汉室。 决策理由：汉中为我抗魏前沿门户，魏宛城驻军足够攻取汉中，因此就地募兵增强防御，同时向吴提议续订同盟，维持联吴抗曹的核心战略。；密谋揭晓：准备守约"},{"id":15502,"turn":8,"type":"decision_revealed","factionId":"wu","message":"吴：周郎新丧，江东同悲。权整军柴桑，固守要冲，以慰英灵。望与蜀汉续盟，共图兴复汉室之业。 决策理由：柴桑面临江州蜀军直接威胁，本回合若不补强城池有失陷之危。征兵五营以确保防线稳固，保留江东根基；外交上续盟蜀汉以维系抗曹阵线。；密谋揭晓：准备守约"},{"id":15503,"turn":8,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":15504,"turn":8,"type":"alliance
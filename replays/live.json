id":22123,"turn":20,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":22124,"turn":20,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 11 金、0 粮"},{"id":22125,"turn":20,"type":"turn_prepared","factionId":null,"message":"第 20 回合（决战阶段）收入与维持已结算"},{"id":22126,"turn":20,"type":"decision_revealed","factionId":"wei","message":"魏：吴军压境，朕先加固洛阳，再遣使与吴议和。若孙权愿罢兵，天下可安；若执意相攻，魏军必死战到底。 决策理由：吴军自宛城可攻洛阳、许昌，洛阳守军薄弱，故先加固城防。同时向吴提出停战，争取喘息之机；若和议不成，再以许昌坚城相抗。；密谋揭晓：无隐秘意图"},{"id":22127,"turn":20,"type":"decision_revealed","factionId":"shu","message":"蜀：孤与孙将军同仇共讨篡汉曹贼，旧盟到期，愿续百年之好，同心戮力光复汉室山河。 决策理由：联吴抗曹是蜀既定国策，旧同盟到期，故提议续盟稳固联盟。汉中边防空虚有被攻占风险，征兵补强防务，符合仁义立本、维系盟友信义的国策。；密谋揭晓：准备守约"},{"id":22128,"turn":20,"type":"decision_revealed","factionId":"wu","message":"吴：吴蜀旧盟虽续期满，中原大势未定。权提宛城之师北上洛阳，与皇叔会猎中原；魏若罢兵则止，若执意相抗，权必奉陪。 决策理由：宛城驻军十一，洛阳魏军仅三，攻之必克。取洛阳则中原门户洞开，威胁许昌魏军，奠定北伐根基。同步拒魏求和、向蜀续盟以维持两线协同。；密谋揭晓：准备守约"},{"id":22129,"turn":20,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":22130,"turn":20,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":22131,"turn":20,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":22132,"turn":20,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 2 兵力"},{"id":22133,"turn":20,"type":"fortify","factionId":"wei","message":"魏 加固了洛阳城防"},{"id":22134,"turn":20,"type":"city_captured","factionId":"wu","message":"吴 攻占洛阳，损失 3 兵力","payload":{"cityId":"luoyang","defenderFactionId":"wei","sourceCityId":"wancheng","targetCityId":"luoyang","troops":10}},{"id":22135,"turn":20,"type":"character_captured","factionId":"wu","message":"夏侯惇在城破后被吴俘虏"},{"id":22136,"turn":21,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 2 金、16 粮"},{"id":22137,"turn":21,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":22138,"turn":21,"type":"turn_prepared","factionId":null,"message":"第 21 回合（决战阶段）收入与维持已结算"},{"id":22139,"turn":21,"type":"decision_revealed","factionId":"wei","message":"魏：吴军虽强，许昌壁垒已固。朕再遣使与吴议和，若孙权肯罢兵，天下可免刀兵；若执意相攻，魏军必死战到底。 决策理由：许昌面临吴自柴桑来犯之危，先募兵五员加强城防，使敌无法轻取；同时向吴再提停战，争取喘息或和谈机会。；密谋揭晓：无隐秘意图"},{"id":22140,"turn":21,"type":"decision_revealed","factionId":"shu","message":"蜀：孤承汉室宗庙，以兴复天下为己任，今愿与孙将军重续同盟之好，同心共讨篡汉曹贼，还四海苍生太平。 决策理由：江州边防空虚，不补强恐遭攻占，故征兵充实防务；接受孙吴结盟提议，延续联吴抗曹国策，维系盟友信义，符合兴复汉室的宗旨。；密谋揭晓：准备守约"},{"id":22141,"turn":21,"type":"decision_revealed","factionId":"wu","message":"吴：魏贼穷蹙许昌孤城。权承皇叔之约，整兵北上会猎中原，誓扫篡汉曹贼。 决策理由：魏仅余许昌八兵，洛阳、宛城、柴桑三面合围。趁吴蜀续盟、魏未及增兵，以柴桑九兵一鼓而下许昌，可灭魏。柴桑虽留一兵，赖盟约与高城防可保无虞。；密谋揭晓：准备守约"},{"id":22142,"turn":21,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":22143,"turn":21,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":22144,"turn":21,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":22145,"turn":21,"type":"recruit","factionId":"shu","message":"蜀 在江州征募 5 兵力"},{"id":22146,"turn":21,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 6，守方损失 5，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":9}},{"id":22147,"turn":22,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":22148,"turn":22,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":22149,"turn":22,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 2 金、11 粮"},{"id":22150,"turn":22,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":22151,"turn":22,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 12 金、0 粮"},{"id":22152,"turn":22,"type":"turn_prepared","factionId":null,"message":"第 22 回合（决战阶段）收入与维持已结算"},{"id":22153,"turn":22,"type":"decision_revealed","factionId":"wei","message":"魏：吴军虽强，许昌尚可坚守。朕已加固城防，静观其变，待敌势稍懈再图进取。 决策理由：许昌是魏国最后根基，当前不宜贸然出击。加固城防可确保吴军无法轻取，争取时间等待停战答复或敌军疲惫。；密谋揭晓：无隐秘意图"},{"id":22154,"turn":22,"type":"decision_revealed","factionId":"shu","message":"蜀：孤承汉室正统，与孙将军同盟共讨篡汉曹贼，今募兵充实军备，借兵助吴伐魏，共破许昌曹逆，光复汉室山河。 决策理由：联吴抗曹是蜀汉既定国策，募兵充实己方军
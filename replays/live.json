dience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[{"attackerFactionId":"shu","targetCityId":"hanzhong","progress":1,"lastPressureTurn":14}],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":21929,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":21930,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：魏国以固守为本，继续整军备武；同时向蜀汉提出停战和谈，愿以诚意化解干戈。 决策理由：西线宛城已稳，东线许昌暂无可失之险，故以洛阳充实武备，储备后续用兵之基；并对蜀递出停战之意，争取分化吴蜀。；密谋揭晓：无隐秘意图"},{"id":21931,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，志在剿灭篡国曹贼，恢复汉室。今曹贼窥伺汉中，备增兵御敌，愿与孙将军共践前约，同举义兵共破曹魏，共享太平。 决策理由：汉中直面魏宛城，防御薄弱有被攻占风险，增兵巩固边防。同时重申吴蜀联合攻魏之约，维系同盟信任，符合联吴抗曹的汉室大义。；密谋揭晓：准备守约"},{"id":21932,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：建业为江东根本，当厚植商利、充裕府库，方能长久支援前线诸军。 决策理由：柴桑驻兵十八、防御坚实，魏无力攻取，门户已固。建业乃都城，商贸专精升至二级可大幅扩充金脉，为后续调兵、结盟、攻伐积聚资财。；密谋揭晓：无隐秘意图"},{"id":21933,"turn":4,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":21934,"turn":4,"type":"develop_city","factionId":"wei","message":"魏 将洛阳建设为军镇专精 1 级"},{"id":21935,"turn":4,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 2 级"},{"id":21936,"turn":4,"type":"transfer","factionId":"shu","message":"蜀 从成都向汉中调动 7 兵力","payload":{"sourceCityId":"chengdu","targetCityId":"hanzhong","troops":7}},{"id":21937,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":21938,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：宛城乃西线门户，今调洛阳之兵增援宛城，厚集兵力以备蜀军。魏国仍愿与各方共谋和平，但绝不惧战。 决策理由：汉中蜀军尚众，宛城当前虽无失城之险，仍需加强守备并为后续进取预留兵力；许昌柴桑方向暂无近忧，故先巩固西线。；密谋揭晓：无隐秘意图"},{"id":21939,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，誓清篡国曹贼，今日兴师问罪宛城，愿与孙将军同践盟约，共复中原，安济天下。 决策理由：吴蜀结盟共抗曹魏，宛城为曹魏西线门户，如今汉中兵力已足，依约出兵进攻宛城，恪守同盟承诺，贯彻伐曹复汉的大义。；密谋揭晓：准备守约"},{"id":21940,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼窃据中原，吴蜀盟好已定，自当共举义兵。权已令柴桑精兵西向许昌，与蜀汉王师遥相呼应，同讨国贼！ 决策理由：蜀再次提议联合攻魏，前番已失约一次，信任受损。今当以信义为先，纳其约而出柴桑之师攻许昌，以最小兵力十一履约，进可扼中原要冲，退不失柴桑根本。吴蜀联盟若再失约则必崩，今务实出兵以固邦交。；密谋揭晓：准备守约"},{"id":21941,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":21942,"turn":5,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 6，守方损失 4，城防降低 1 级","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":9}},{"id":21943,"turn":5,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 7，守方损失 6，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":11}},{"id":21944,"turn":5,"type":"transfer","factionId":"wei","message":"魏 从洛阳向宛城调动 7 兵力","payload":{"sourceCityId":"luoyang","targetCityId":"wancheng","troops":7}},{"id":21945,"turn":5,"type":"joint_attack_honored","factionId":null,"message":"蜀与吴兑现承诺，共同进攻魏"},{"id":21946,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"},{"id":21947,"turn":6,"type":"decision_revealed","factionId":"wei","message":"魏：蜀汉屡犯西境，今当回击以安疆土。魏国愿与吴国化干戈为玉帛，共谋和平。 决策理由：宛城兵多而汉中兵寡，趁蜀军新败之机攻取汉中，可断蜀之臂膀。同时向吴示好，为吴蜀盟约到期后争取外交空间。；密谋揭晓：无隐秘意图"},{"id":21948,"turn":6,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窥我汉中，备整兵御敌，愿与孙将军共履盟约，同讨逆贼，光复汉室山河。 决策理由：汉中直面宛城曹魏大军，不补强极可能被攻占，故调江州兵力增援巩固边防。续邀东吴共攻曹魏，维系同盟信任，贯彻联吴抗曹大义。；密谋揭晓：准备守约"},{"id":21949,"turn":6,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼许昌城防已破，正是进取良机！权亲率江东精锐西征，与蜀汉王师共讨国贼！ 决策理由：吴蜀盟约仅余一回合，曹操许昌城防归零、士气低落。以柴桑十兵全力攻许昌，吴蜀联合夹击可获战力加成；建业商贸专精已稳，吴郡后方无忧。；密谋揭晓：准备守约"},{"id":21950,"turn":6,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":21951,"turn":6,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":21952,"turn":6,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 6，守方损失 5，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":10}},{"id":21953,"turn":6,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 4 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":11}},{"id":21954,"turn":6,"type":"character_captured","factionId":"wei","message":"关羽在城破后被魏俘虏"},{"id":21955,"turn":6,"type":"transfer_cancelled","factionId":"shu","message":"蜀的调兵因战场局势变化而取消"},{"id":21956,"turn":7,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":21957,"turn":7,"type":"turn_prepared","factionId":null,"message":"第 7 回合（蓄势阶段）收入与维持已结算"},{"id":21958,"turn":7,"type":"decision_revealed","factionId":"wei","message":"魏：魏国愿与吴国罢兵休战，共安天下。 决策理由：许昌征兵以固根本，同时向吴示好，分化吴蜀，争取时间。；密谋揭晓：准备守约"},{"id":21959,"turn":7,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窃我汉中、俘我关羽，威逼成都，备今兴师复疆，与孙将军共践盟好，同讨篡汉逆贼，恢复汉室山河。 决策理由：魏占汉中后成都门户洞开，有被攻占风险，因此出动江州精锐反攻汉中收复失地，保障后方安全，接受吴联合攻魏提议，恪守同盟，贯彻联吴抗曹国策。；密谋揭晓：准备守约"},{"id":21960,"turn":7,"type":"decision_revealed","factionId":"wu","message":"吴：吴蜀盟约届满，曹公既有停战之诚，权当顺势允之。江东连年用兵，今当息战养民，厚植根基，以待天时。 决策理由：柴桑两攻许昌皆挫，兵力损耗需整补；吴蜀盟约本回合届满，强续代价过高。建业征兵充实都城武备，为后续蓄力。允魏停战可止边境消耗，专注江东防务与发展。；密谋揭晓：无隐秘意图"},{"id":21961,"turn":7,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":21962,"turn":7,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的停战提议"},{"id":21963,"turn":7,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":21964,"turn":7,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":21965,"turn":7,"type":"recruit","factionId":"wu","message":"吴 在建业征募 5 兵力"},{"id":21966,"turn":7,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻汉中失败，进攻方损失 5，守方损失 3，围城进度升至 1/3","payload":{"sourceCityId":"jiangzhou","targetCityId":"hanzhong","troops":7}},{"id":21967,"turn":7,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":21968,
ek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":27061,"turn":10,"type":"decision_revealed","factionId":"wei","message":"魏：孤今亲率宛城精锐讨伐汉中，刘备窃据益州，久必为吴魏大患。愿与孙将军弃怨修好，共图中原。 决策理由：汉中守军仅5，宛城10可出9，胜算极大。攻取汉中可削弱蜀国西线，并震慑吴国，促其接受联合攻蜀。许昌暂无陷落之危，故倾力西进。；密谋揭晓：无隐秘意图"},{"id":27062,"turn":10,"type":"decision_revealed","factionId":"shu","message":"蜀：曹孟德篡窃汉室，生灵涂炭，备与孙将军同盟讨逆，今日再出锐卒攻宛城，共破汉贼，兴复汉室！ 决策理由：我与东吴有约共伐曹魏，宛城已有围城进度，此役出兵继续施压，既兑现代约巩固同盟，也能缓解汉中边境被攻陷的威胁，削弱曹魏西线实力。；密谋揭晓：准备守约"},{"id":27063,"turn":10,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼困守许昌，屡战屡败。今加固柴桑城防，与皇叔续约共讨，待天时再图北进。 决策理由：柴桑遭魏许昌兵力威胁（攻10防7.2可被破），优先筑城将防力提至8.4以上保城池不失。拒魏停战分化之计，续向蜀提联攻魏，维持战略压力。；密谋揭晓：准备守约"},{"id":27064,"turn":10,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":27065,"turn":10,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":27066,"turn":10,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":27067,"turn":10,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":27068,"turn":10,"type":"fortify","factionId":"wu","message":"吴 加固了柴桑城防"},{"id":27069,"turn":10,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 3 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":9}},{"id":27070,"turn":10,"type":"attack_cancelled","factionId":"shu","message":"蜀 的出征因来源城局势变化而取消","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":4}},{"id":27071,"turn":11,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":27072,"turn":11,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":27073,"turn":11,"type":"turn_prepared","factionId":null,"message":"第 11 回合（争锋阶段）收入与维持已结算"},{"id":27074,"turn":11,"type":"decision_revealed","factionId":"wei","message":"魏：宛城急需增兵，孤已下令募卒固守；同时再向皇叔表停战诚意，愿与蜀共御东吴，保境安民。 决策理由：上回合攻占汉中后，宛城仅余1兵，恐蜀军经汉中反扑。今募5兵充实宛城，巩固西线；再向蜀提议停战，趁吴蜀同盟到期之机拆解敌对，若蜀应允则西线可安，专注对吴。；密谋揭晓：准备守约"},{"id":27075,"turn":11,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窃我汉中，侵我益州，备今提锐卒收复故土，与孙吴同心共讨篡汉逆贼，兴复汉室！ 决策理由：曹魏攻占汉中，直逼益州门户，我接受东吴联合攻魏提议，出兵收复失地，续与东吴结盟，坚守联弱抗曹国策。；密谋揭晓：准备守约"},{"id":27076,"turn":11,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼窃据中原，茶毒天下。今与皇叔续盟，共图许昌。吾已增兵柴桑固江防，整军经武，以待天时同进。 决策理由：柴桑遭魏蜀夹击，征兵三至九人，防力十二点六可御敌。续盟蜀汉，约共攻许昌，相机进兵。；密谋揭晓：准备守约"},{"id":27077,"turn":11,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":27078,"turn":11,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":27079,"turn":11,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":27080,"turn":11,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":27081,"turn":11,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":27082,"turn":11,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 3 兵力"},{"id":27083,"turn":11,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":27084,"turn":11,"type":"city_captured","factionId":"shu","message":"蜀 攻占汉中，损失 3 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"wei","sourceCityId":"chengdu","targetCityId":"hanzhong","troops":7}},{"id":27085,"turn":11,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":27086,"turn":11,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":27087,"turn":12,"type":"siege_decayed","factionId":"wu","message":"吴 对许昌的围城进度衰减"},{"id":27088,"turn":12,"type":"siege_decayed","factionId":"shu","message":"蜀 对宛城的围城进度衰减"},{"id":27089,"turn":12,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":27090,"turn":12,"type":"turn_prepared","factionId":null,"message":"第 12 回合（争锋阶段）收入与维持已结算"},{"id":27091,"turn":12,"type":"decision_revealed","factionId":"wei","message":"魏：孤愿与吴弃怨修好，共伐僭越之刘备。汉中已疲
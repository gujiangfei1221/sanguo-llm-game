ong","troops":4}},{"id":41740,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":41741,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：孙将军，蜀汉据汉中窥中原，唇亡齿寒。今魏军西征汉中，江东若愿共击刘备，两家可罢兵修好，平分益州。 决策理由：宛城已有12兵，趁汉中仅7兵且城防未固，以主力11兵强攻汉中，削弱蜀国前线。同时向吴提议联合攻蜀，离间吴蜀同盟，避免东线压力。；密谋揭晓：无隐秘意图"},{"id":41742,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，与江东盟友缔有讨曹盟约，今提锐旅出汉中取宛城，诛灭篡汉国贼，共安天下！ 决策理由：魏于宛城集结重兵，有攻取我汉中的威胁，主动出击以攻为守，践行与吴联合攻魏盟约，维系盟友信任，符合讨贼兴汉的大义。；密谋揭晓：准备守约"},{"id":41743,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：江东柴桑增兵固防，蓄势再图许昌。与蜀汉盟友同心讨曹，魏之缓兵之计，江东洞若观火。 决策理由：曹操在宛城集结重兵（19兵），名为停战实为图蜀，必拒之以全盟谊。柴桑上回合攻许昌折损五兵，当前八兵不足破城（需11+），故征兵五以恢复北伐主力至13，留足下回合攻许昌之用。接受蜀汉联攻之议，维系同盟信任。；密谋揭晓：准备守约"},{"id":41744,"turn":5,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":41745,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":41746,"turn":5,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":41747,"turn":5,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":41748,"turn":5,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 4，守方损失 4，围城进度升至 1/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":6}},{"id":41749,"turn":5,"type":"attack_cancelled","factionId":"wei","message":"魏 的出征因来源城局势变化而取消","payload":{"sourceCityId":"wancheng","targetCityId":"hanzhong","troops":11}},{"id":41750,"turn":5,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":41751,"turn":6,"type":"turn_prepared","factionId":null,"message":"第 6 回合（蓄势阶段）收入与维持已结算"},{"id":41752,"turn":6,"type":"decision_revealed","factionId":"wei","message":"魏：汉中空虚，备军已疲。今曹某亲率大军西征，必取汉中。孙将军若愿共击刘备，中原与江东从此罢兵修好，共分益州！ 决策理由：蜀汉中仅余两兵，此乃破蜀良机。宛城久被围困，必须主动出击以解危局。趁吴蜀同盟生隙，再邀孙权共击刘备，若成则蜀国孤立。；密谋揭晓：无隐秘意图"},{"id":41753,"turn":6,"type":"decision_revealed","factionId":"shu","message":"蜀：备与江东盟友共缔讨曹盟约，曹贼屯兵宛城欲犯汉中，备今增兵御敌，誓诛篡汉国贼，共复汉室山河。 决策理由：魏军集结宛城，汉中空虚有被攻占风险，调江州精兵增援汉中巩固前线，重申与吴联合攻魏约定，维系同盟信任，践行讨贼大义。；密谋揭晓：准备守约"},{"id":41754,"turn":6,"type":"decision_revealed","factionId":"wu","message":"吴：江东柴桑精兵十二再发许昌，与蜀汉共成夹击之势！曹贼篡汉，天人共愤，江东誓讨国贼。 决策理由：履行与蜀攻魏之盟约，柴桑十三兵出十二攻许昌，留一守城。城防二级，魏最大攻击力8不足以破城（需21.84），后方无忧。继续北伐消耗魏有生力量，配合蜀汉夹击。；密谋揭晓：准备守约"},{"id":41755,"turn":6,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":41756,"turn":6,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":41757,"turn":6,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":41758,"turn":6,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 8，守方损失 4，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":12}},{"id":41759,"turn":6,"type":"character_fallen","factionId":"wu","message":"周瑜在惨烈战斗中阵亡"},{"id":41760,"turn":6,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 3 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":7}},{"id":41761,"turn":6,"type":"character_captured","factionId":"wei","message":"关羽在城破后被魏俘虏"},{"id":41762,"turn":6,"type":"transfer_cancelled","factionId":"shu","message":"蜀的调兵因战场局势变化而取消"},{"id":41763,"turn":7,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":41764,"turn":7,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":41765,"turn":7,"type":"turn_prepared","factionId":null,"message":"第 7 回合（蓄势阶段）收入与维持已结算"},{"id":41766,"turn":7,"type":"decision_revealed","factionId":"wei","message":"魏：孙将军，吴蜀盟约已尽，江东新败，正当休养生息。若两家罢兵，曹某言出必践，江东可安。 决策理由：宛城仅一兵，征兵五以固西线，防蜀军反扑。吴蜀同盟到期且吴国新败，趁机提议停战，避免两线作战，为集中攻蜀创造条件。；密谋揭晓：准备守约"},{"id":41767,"turn":7,"type":"decision_revealed","factionId":"shu","message":"蜀：备承汉室正统，与江东盟友同心讨贼，今誓克汉中，共诛曹贼，光复中原！ 决策理由：汉中被魏侵占，直逼益州根本，践行吴蜀联合攻魏盟约，出兵收复失地，巩固边防，维系同盟信任，符合讨贼兴汉大义。；密谋揭晓：准备守约"},{"id":41768,"turn":7,"type":"decision_revealed","factionId":"wu","message":"吴：江东痛失周瑜，举军哀恸。然讨贼之志不改，柴桑增兵再图许昌。与蜀汉续盟，共诛国贼。 决策理由：上回合攻许昌虽损八兵、降城防一级，然痛失大都督周瑜，江东元气大伤。本回合宜在柴桑征兵五恢复北伐主力；同时接受蜀汉联合攻魏之议，并主动续盟以维系抗曹大局。；密谋揭晓：准备守约"},{"id":41769,"turn":7,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":41770,"turn":7,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":41771,"turn":7,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":41772,"turn":7,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":41773,"turn":7,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":41774,"turn":7,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":41775,"turn":7,"type":"city_captured","factionId":"shu","message":"蜀 攻占汉中，损失 3 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"wei","sourceCityId":"jiangzhou","targetCityId":"hanzhong","troops":7}},{"id":41776,"turn":7,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":41777,"turn":7,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":41778,"turn":8,"type":"siege_decayed","factionId":"shu","message":"蜀 对宛城的围城进度衰减"},{"id":41779,"turn":8,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":41780,"turn":8,"type":"turn_prepared","factionId":null,"message":"第 8 回合（蓄势阶段）收入与维持已结算"},{"id":41781,"turn":8,"type":"decision_revealed","factionId":"wei","message":"魏：许昌危急，先募兵自固。同时再向江东示好，若孙权肯罢兵，便可全力西进讨蜀。 决策理由：吴军柴桑重兵压境，许昌有被攻占之险，故紧急征兵五员增强城防。外交上再提停战，争取避免两线作战，为下一步集中攻蜀创造时机。；密谋揭晓：准备守约"},{"id":41782,"turn":8,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，与江东盟友同心讨贼，续缔同盟共伐篡汉曹贼，誓复中原，安靖天下。 决策理由：汉中刚收复，魏在宛城屯兵，汉中有被攻占风险，调兵增援巩固前线防御，接受东吴同盟提议续盟，维系吴蜀抗曹大局，符合讨贼兴汉大义。；密谋揭晓：准备守约"},{"id":41783,"turn":8,"type":"decision_revealed","factionId":"wu","message":"吴：周公瑾虽殁，江东讨贼之志不灭。今亲率柴桑精兵直捣许昌，与蜀汉共践夹击之约，必破曹贼！ 决策理由：周瑜新丧、江东士气低落，急需一场胜仗提振三军。许昌城防经上回合攻坚已降至一级、守军仅五，正可一举而下。柴桑九兵倾力北伐，协同蜀汉自汉中夹击，践诺讨曹盟约，重建盟友信任。；密谋揭晓：准备守约"},{"id":41784,"turn":8,"type":"diplomacy_response","faction
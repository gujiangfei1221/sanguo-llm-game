ge":"吴：江州已固，巴蜀门户在握。备若识天命，当束手归降，休伤蜀中百姓。 决策理由：江州仅2兵遭蜀围攻，必须增援。调许昌宛城之兵8人入江州，合计10兵驻守，下回合可自江州出大军直捣成都，一举灭蜀。同步再招关羽，乱其军心。；密谋揭晓：无隐秘意图"},{"id":42781,"turn":47,"type":"character_recruited","factionId":"wu","message":"关羽接受招降，转投吴"},{"id":42782,"turn":47,"type":"transfer","factionId":"shu","message":"蜀 从成都向汉中调动 1 兵力","payload":{"sourceCityId":"chengdu","targetCityId":"hanzhong","troops":1}},{"id":42783,"turn":47,"type":"mobilize","factionId":"wu","message":"吴向江州战略集结 8 兵"},{"id":42784,"turn":48,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 12 金、16 粮"},{"id":42785,"turn":48,"type":"turn_prepared","factionId":null,"message":"第 48 回合（决战阶段）收入与维持已结算"}],"createdAt":"2026-08-19T17:42:17.927Z","updatedAt":"2026-08-19T18:43:50.476Z","exportedAt":"2026-08-19T18:44:07.570Z"}
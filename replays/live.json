ocationCityId":"jianye","status":"active","loyalty":80,"resentment":0}],"director":{"lastCaptureTurn":15,"lastEventTurn":18,"lastStandCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":30607,"turn":7,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":30608,"turn":7,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":30609,"turn":8,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":30610,"turn":8,"type":"turn_prepared","factionId":null,"message":"第 8 回合（蓄势阶段）收入与维持已结算"},{"id":30611,"turn":8,"type":"decision_revealed","factionId":"wei","message":"魏：洛阳守备单薄，今征兵固防。又遣使赠金于吴，望孙权明辨利害，弃暗投明。 决策理由：蜀据宛城虎视洛阳，吴有柴桑之兵压许昌。先补洛阳至九兵，确保西线无虞；许昌十七兵足御吴军。再以二十金示好东吴，分化吴蜀同盟，为下一回合夺回宛城创造战机。；密谋揭晓：无隐秘意图"},{"id":30612,"turn":8,"type":"decision_revealed","factionId":"shu","message":"蜀：曹孟德篡汉窃国，天人共愤。孤今与孙将军重缔同盟，同心共讨国贼，兴复汉室指日可待。 决策理由：东吴主动提议缔结盟约，契合我联弱抗曹、兴复汉室的方略，故欣然接受。开发成都农业，充实军粮储备，为后续讨曹做准备。；密谋揭晓：准备守约"},{"id":30613,"turn":8,"type":"decision_revealed","factionId":"wu","message":"吴：江东秣马厉兵，与蜀汉同仇敌忾。曹贼离间之计，权不屑为之。待兵精粮足，再图许昌。 决策理由：柴桑前线驻军12人，遭许昌魏军威胁。征募7兵以充前线，使柴桑守备达19人，防御稳如磐石。拒魏离间之策，保吴蜀盟谊，待机再举。；密谋揭晓：无隐秘意图"},{"id":30614,"turn":8,"type":"gold_offered","factionId":"wei","message":"魏向吴献上 20 金"},{"id":30615,"turn":8,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":30616,"turn":8,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":30617,"turn":8,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 2 级"},{"id":30618,"turn":8,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 7 兵力"},{"id":30619,"turn":8,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":30620,"turn":9,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":30621,"turn":9,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":30622,"turn":9,"type":"turn_prepared","factionId":null,"message":"第 9 回合（争锋阶段）收入与维持已结算"},{"id":30623,"turn":9,"type":"decision_revealed","factionId":"wei","message":"魏：蜀夺宛城，窥我洛阳，孤今发洛阳劲旅八员攻宛城，以固中原。孙权将军：刘备坐大，西吞巴蜀，东结江东，终为吴魏之患。愿与吴共讨蜀汉，平分其地，永结盟好。 决策理由：趁蜀江州兵未援宛城，以洛阳八兵攻宛城六兵，夺回西线门户；许昌十七兵足御吴军，按兵不动。再向吴提议联合攻蜀，离间吴蜀同盟；若吴应则蜀腹背受敌，若拒亦为后续分化伏笔。；密谋揭晓：准备守约"},{"id":30624,"turn":9,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼窥我新得宛城，孤整兵备武，与孙将军共讨国贼，兴复汉室，必不辜负同盟之谊。 决策理由：新取宛城，曹魏必图反扑，汉中为我伐魏前沿要地，募兵充实军力，为后续增援宛城做准备，恪守吴蜀同盟，共抗篡汉曹贼。；密谋揭晓：准备守约"},{"id":30625,"turn":9,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼篡汉，江东义士同仇敌忾。今大军出柴桑，直捣许昌，与盟友共讨国贼！ 决策理由：许昌魏军17兵，柴桑驻19且军事专精L2，出18兵可获加成。拔许昌可消除魏军东进据点，解柴桑威胁并夺金粮充实江东。与蜀盟约一致，正当抗曹之机。；密谋揭晓：准备守约"},{"id":30626,"turn":9,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":30627,"turn":9,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 7 兵力"},{"id":30628,"turn":9,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 11，守方损失 8，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":18}},{"id":30629,"turn":9,"type":"character_fallen","factionId":"wei","message":"郭嘉在惨烈战斗中阵亡"},{"id":30630,"turn":9,"type":"city_captured","factionId":"wei","message":"魏 攻占宛城，损失 3 兵力","payload":{"cityId":"wancheng","defenderFactionId":"shu","sourceCityId":"luoyang","targetCityId":"wancheng","troops":8}},{"id":30631,"turn":10,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":30632,"turn":10,"type":"turn_prepared","factionId":null,"message":"第 10 回合（争锋阶段）收入与维持已结算"},{"id":30633,"turn":10,"type":"decision_revealed","factionId":"wei","message":"魏：魏已加强宛城守备。孤念苍生，愿与蜀汉停战修好；若刘备应允，则西线无战事，共图中原。 决策理由：宛城新复，蜀军自汉中来攻，调许昌二兵增援，确保西线稳固。同时向蜀提议停战，以缓解两面受敌之势；许昌仍留七兵，足御吴军。；密谋揭晓：准备守约"},{"id":30634,"turn":10,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃夺宛城，孤今提义师讨伐国贼，愿与孙将军同心戮力，共破曹魏，兴复汉室。 决策理由：宛城是伐魏前沿要地，被曹魏反扑夺回，今从汉中发主力进攻夺回要地，履行吴蜀同盟共攻曹魏的约定，维系同盟信任，保持对曹魏西线压力。；密谋揭晓：准备守约"},{"id":30635,"turn":10,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼离间之计，权岂能中。柴桑前线秣马厉兵，待天时一到，直捣许昌。 决策理由：柴桑经上回合苦战仅余8兵，亟需补强。自吴郡调7兵赴柴桑，下回合可集15兵攻许昌，一举而下断魏东线。拒魏离间之策，固吴蜀盟谊。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":30636,"turn":10,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":30637,"turn":10,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":30638,"turn":10,"type":"city_pacified","factionId":"shu","message":"宛城多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":30639,"turn":10,"type":"city_captured","factionId":"shu","message":"蜀 攻占宛城，损失 3 兵力","payload":{"cityId":"wancheng","defenderFactionId":"wei","sourceCityId":"hanzhong","targetCityId":"wancheng","troops":7}},{"id":30640,"turn":10,"type":"transfer_cancelled","factionId":"wei","message":"魏的调兵因战场局势变化而取消"},{"id":30641,"turn":10,"type":"transfer","factionId":"wu","message":"吴 从吴郡向柴桑调动 7 兵力","payload":{"sourceCityId":"wujun","targetCityId":"chaisang","troops":7}},{"id":30642,"turn":11,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":30643,"turn":11,"type":"turn_prepared","factionId":null,"message":"第 11 回合（争锋阶段）收入与维持已结算"},{"id":30644,"turn":11,"type":"decision_revealed","factionId":"wei","message":"魏：魏：许昌乃国都，今征兵固守。再赠金于吴，望孙权明辨大势，勿为刘备所欺。 决策理由：吴柴桑十五兵压许昌，国都危殆，征兵五员加强守备。洛阳兵少难守，暂避蜀军锋芒。向吴献金二十，继续离间吴蜀同盟，为下回合分化反击留余地。；密谋揭晓：无隐秘意图"},{"id":30645,"turn":11,"type":"decision_revealed","factionId":"shu","message":"蜀：曹孟德篡汉窃国，天人共愤，孤身为汉室后裔，绝不与篡逆议和，当与孙将军同心讨贼，兴复汉室！ 决策理由：曹魏停战提议实为缓兵之计，意图分化吴蜀同盟。孤恪守同盟大义，誓讨篡汉国贼，故拒绝停战，开发江州商业充实国力，备后续北伐。；密谋揭晓：准备守约"},{"id":30646,"turn":11,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑大军出，直捣许昌！曹贼篡汉，江东义士共讨之。 决策理由：围城进度1/3，若不施压将于下回合衰减，功亏一篑。许昌仅9兵，柴桑15兵出14攻之，军事专精L2大幅加成，胜算极高。拔许昌断魏东线门户，解柴桑长期威胁
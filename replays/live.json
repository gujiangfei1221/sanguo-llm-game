:43486,"turn":8,"type":"turn_prepared","factionId":null,"message":"第 8 回合（蓄势阶段）收入与维持已结算"},{"id":43487,"turn":8,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯，蜀背盟弃义，前番失信于君。曹某愿与君共击蜀汉，汉中巴蜀可分而治之。 决策理由：许昌征兵固防，防吴袭扰；宛城重兵威慑汉中。再邀吴共击蜀，若成则蜀危，若拒则我独守中原，待时而动。；密谋揭晓：准备守约"},{"id":43488,"turn":8,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，愿与吴侯再缔同盟，同心共讨曹贼篡逆，兴复汉室，功成之后共享太平，互不侵伐。 决策理由：曹魏重兵屯驻宛城威胁汉中边防，故征兵补强守备；恪守联吴抗曹核心战略，接受东吴同盟提议，邀约盟友共伐国贼，巩固同盟信任以待北伐战机。；密谋揭晓：准备守约"},{"id":43489,"turn":8,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼篡逆，天人共愤！权承吴蜀盟约，亲率柴桑精兵北伐许昌，与皇叔共破中原！ 决策理由：许昌守军仅八、防御归零、士气低落，柴桑十四兵以军镇二级之利攻之必克。联蜀伐魏大义所在，蜀出汉中可牵制宛城。柴桑虽留一兵，但许昌新克后魏无城邻柴桑，可保安全。战机稍纵即逝，当断则断。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":43490,"turn":8,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":43491,"turn":8,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":43492,"turn":8,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":43493,"turn":8,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 5 兵力"},{"id":43494,"turn":8,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":43495,"turn":8,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 9，守方损失 6，围城进度升至 1/3","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":14}},{"id":43496,"turn":8,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":43497,"turn":9,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":43498,"turn":9,"type":"turn_prepared","factionId":null,"message":"第 9 回合（争锋阶段）收入与维持已结算"},{"id":43499,"turn":9,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯，蜀人两度负君，我愿与吴罢兵修好，共防奸诈。许昌增兵只为自守，无意东进。 决策理由：许昌面临吴国持续压力，征兵增强防守；同时主动向吴示和，以分化吴蜀同盟，为日后专攻蜀汉创造机会。宛城兵力充足，足以威慑汉中。；密谋揭晓：准备守约"},{"id":43500,"turn":9,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，誓诛曹贼篡逆，今与吴侯共践盟约，提汉中精兵出伐宛城，共破中原，兴复汉室！ 决策理由：恪守吴蜀同盟约定，兑现联合伐魏承诺，出兵汉中进攻曹魏宛城，牵制曹魏西线兵力，配合东吴围攻许昌，践行联吴抗曹方略。；密谋揭晓：准备守约"},{"id":43501,"turn":9,"type":"decision_revealed","factionId":"wu","message":"吴：江东整军经武，柴桑聚兵蓄势，待天时一举起北伐之师，曹贼篡逆之期不远矣。 决策理由：上回合攻许昌折兵九，柴桑仅余六兵不足以再攻。调吴郡建业之兵八人集结柴桑，下回合以十三四兵攻许昌（七守军零城防）可期必克。拒绝魏离间之计。；密谋揭晓：准备守约"},{"id":43502,"turn":9,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":43503,"turn":9,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":43504,"turn":9,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":43505,"turn":9,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 3 兵力"},{"id":43506,"turn":9,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 12，守方损失 8，城防降低 1 级","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":19}},{"id":43507,"turn":9,"type":"character_fallen","factionId":"shu","message":"关羽在惨烈战斗中阵亡"},{"id":43508,"turn":9,"type":"character_fallen","factionId":"wei","message":"张辽在惨烈战斗中阵亡"},{"id":43509,"turn":9,"type":"mobilize","factionId":"wu","message":"吴向柴桑战略集结 8 兵"},{"id":43510,"turn":10,"type":"director_stalemate","factionId":"wu","message":"战局久滞，流民投奔吴，补充兵源并集结 2 兵"},{"id":43511,"turn":10,"type":"turn_prepared","factionId":null,"message":"第 10 回合（争锋阶段）收入与维持已结算"},{"id":43512,"turn":10,"type":"decision_revealed","factionId":"wei","message":"魏：吴军压境，许昌暂以守备为先。同时向蜀汉提出停战，愿各守疆界，共安黎民。 决策理由：许昌面临吴国直接威胁，先加固城防；对蜀汉释出和平信号，以分化吴蜀，避免两线作战。；密谋揭晓：准备守约"},{"id":43513,"turn":10,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，誓诛曹贼篡逆，今与吴侯共践盟约，同举义兵北伐中原，兴复汉室，功成之后共享太平。 决策理由：曹魏重兵屯宛城威逼汉中，汉中有失陷风险，故征兵补强边防；接受吴侯联合攻魏提议，恪守联吴抗曹方略，履行同盟承诺，巩固双方信任。；密谋揭晓：准备守约"},{"id":43514,"turn":10,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼篡逆，祸乱天下！权承吴蜀同盟，亲率柴桑精兵十三众北伐许昌，与皇叔共破中原、兴复汉室！ 决策理由：许昌城防归零、围城进度一/三、守军新败；柴桑军镇专精二级、士气正盛，十三兵攻之必克。克许昌则中原门户洞开，曹魏腹地震动，江东基业更固。；密谋揭晓：准备守约"},{"id":43515,"turn":10,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":43516,"turn":10,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":43517,"turn":10,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":43518,"turn":10,"type":"fortify","factionId":"wei","message":"魏 加固了许昌城防"},{"id":43519,"turn":10,"type":"recruit","factionId":"shu","message":"蜀 在汉中征募 2 兵力"},{"id":43520,"turn":10,"type":"city_captured","factionId":"wu","message":"吴 攻占许昌，损失 5 兵力","payload":{"cityId":"xuchang","defenderFactionId":"wei","sourceCityId":"chaisang","targetCityId":"xuchang","troops":13}},{"id":43521,"turn":10,"type":"character_captured","factionId":"wu","message":"曹操在城破后被吴俘虏"},{"id":43522,"turn":10,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":43523,"turn":10,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":43524,"turn":11,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":43525,"turn":11,"type":"turn_prepared","factionId":null,"message":"第 11 回合（争锋阶段）收入与维持已结算"},{"id":43526,"turn":11,"type":"decision_revealed","factionId":"wei","message":"魏：许昌既失，洛阳孤危。今先固洛阳，再请吴侯罢兵，免使蜀汉坐收渔利。 决策理由：洛阳正面临吴军攻取威胁，先征兵至六，稳住防线；同时向吴提出停战，分化吴蜀，争取时间重整旗鼓。；密谋揭晓：准备守约"},{"id":43527,"turn":11,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，誓诛曹贼篡逆，绝不与逆党媾和！今提汉中精兵伐宛城，与吴侯共破曹魏，兴复汉室。 决策理由：恪守吴蜀同盟约定，拒绝曹魏停战分化阴谋，出兵进攻曹魏宛城，牵制西线魏军，配合东吴北伐攻势，践行联吴抗曹兴复汉室方略。；密谋揭晓：准备守约"},{"id":43528,"turn":11,"type":"decision_revealed","factionId":"wu","message":"吴：许昌新定，人心未稳。权谨固江东防线，以为长久之图。曹公若有意止战，权愿与通好共安黎民。 决策理由：许昌8兵孤立于魏境，宛城14兵随时可图。柴桑仅余1兵，亟须固防以为后援。值此新克许昌、曹公被擒之际，向魏提议停战，可保战果、徐图后计。同盟在期，蜀约当守。；密谋揭晓：准备守约"},{"id":43529,"turn":11,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":43530,"turn":11,"type":"fortify","factionId":"wu","message":"吴 加固了柴桑城防"},{"id":43531,"turn":11,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 5 兵力"},{"id":43532,"turn":11,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 6，守方损失 5，围城进度升至 1/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":9}},{"id":43533,"turn":12,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 1 金、0 粮"},{"id":43534,"turn":12,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":43535,"turn":12,"type":"turn_prepared","factionId":null,"message":"第 12 回合（争锋阶段）收入与维持已结算"},{"id":43536,"turn":12,"type":"decision_revealed","factionId":"wei","message":"魏：吴侯既愿罢兵，孤亦以百姓为念，愿与江东共守疆界。宛城增兵只为御蜀，绝无东进之意。 决策理由：接受吴停战可拆解吴蜀联盟，避免腹背受敌。蜀连攻宛城未克，士气已衰；宛城征兵至十四，既固西线，也为下回合反击汉中留有余力。；密谋揭晓：准备守约"},{"id":43537,"turn":12,"type":"decision_revealed","factionId":"shu","message":"蜀：备身为汉室宗亲，誓讨曹贼篡逆，恪守吴蜀同盟，整兵汉中巩固边防，共兴汉室。 决策理由：魏以宛城重兵威逼汉中，汉中有失陷风险，集结后方兵力驰援补强，践行联吴抗曹方略，恪守同盟承诺。；密谋揭晓：准备守约"},{"id":43538,"turn":12,"type":"decision_revealed","factionId":"wu","message":"吴：许昌既定，江东亟须休整。权愿与曹公罢兵通好，各安疆界，共养民生。 决策理由：许昌新克孤悬魏境，柴桑前线仅余一兵。调吴郡六兵充实柴桑以固江东根本。曹公新擒、士气正盛之际，接受魏停战之请可保战果、徐图后计。蜀盟约本回合止，暂不续约以观其动向。；密谋揭晓：无隐秘意图"},{"id":43539,"turn":12,"type":"diplomacy_response","factionId":"wei","message":"魏接受了 吴 的停战提议"},{"id":43540,"turn":12,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的停战提议"},{"id":43541,"turn":12,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":43542,"turn":12,"type":"transfer","factionId":"wu","message":"吴 从吴郡向柴桑调动 6 兵力","payload":{"sourceCityId":"wujun","targetCityId":"chaisang","troops":6}},{"id":43543,"turn":12,"type":"mobilize","factionId":"shu","message":"蜀向汉中战略集结 8 兵"},{"id":43544,"turn":13,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":43545,"turn":13,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 1 金、0 粮"},{"id":43546,"turn":13,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":43547,"turn":13,"type":"turn_prepared","factionId":null,"message":"第 13 回合（争锋阶段）收入与维持已结算"},{"id":43548,"turn":13,"type":"decision_revealed","factionId":"wei","message":"魏：蜀吴盟约已散，刘备坐大，非江东之福。孤愿与吴侯结盟，共制蜀汉，各安疆土。魏军绝不犯吴境一寸。 决策理由：宛城为西线要冲，征兵至十九，既可固守御蜀，亦为下回合攻取汉中蓄力。吴蜀同盟刚散，主动联吴可断蜀之外援，避免两线作战。；密谋揭晓：准备守约"},{"id":43549,"turn":13,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，誓诛篡逆曹贼，愿与吴侯再续同盟之好，共兴汉室，同享太平。 决策理由：我军已在汉中集结优势兵力，继续进攻曹魏宛城牵制西线魏军，同时提议再续吴蜀同盟，恪守联吴抗曹既定方略，巩固同盟信任。；密谋揭晓：准备守约"},{"id":43550,"turn":13,"type":"decision_revealed","factionId":"wu","message":"吴：许昌新定，民生待抚。权调江东精兵充实许昌，以为长久之图。曹公既以诚相待，权愿与永结盟好，共安黎民。 决策理由：停战虽在，然许昌孤悬魏境，仅八兵不足御宛城十三之众。调柴桑六兵、建业二兵共八兵赴许昌，使许昌兵至十六，足以固守。同期向魏提议结盟，巩固和平，使江东休养生息，专注内治。；密谋揭晓：无隐秘意图"},{"id":43551,"turn":13,"type":"alliance_proposed","factionId":"wei","message":"魏 向 吴 提议结盟"},{"id":43552,"turn":13,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":43553,"turn":13,"type":"alliance_proposed","factionId":"wu","message":"吴 向 魏 提议结盟"},{"id":43554,"turn":13,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":43555,"turn":13,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 7，守方损失 7，围城进度升至 2/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":11}},{"id":43556,"turn":13,"type":"mobilize","factionId":"wu","message":"吴向许昌战略集结 8 兵"},{"id":43557,"turn":14,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 1 金、0 粮"},{"id":43558,"turn":14,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":43559,"turn":14,"type":"turn_prepared","factionId":null,"message":"第 14 回合（争锋阶段）收入与维持已结算"},{"id":43560,"turn":14,"type":"decision_revealed","factionId":"wei","message":"魏：蜀屡犯宛城，今与吴结盟，可全力讨贼。汉中兵寡，孤率宛城之师攻之，以解宛城之围。 决策理由：吴蜀盟散，吴已允盟，西线无虞。蜀连攻宛城失利，汉中空虚，今以宛城精锐十一取汉中，断蜀臂膀，宛城之围自解。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":43561,"turn":14,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，誓诛篡逆曹贼，今提汉中精锐再攻宛城，愿与吴侯再续同盟，共成兴汉大事。 决策理由：宛城围城进度已达三分之二，曹魏驻宛大军威逼汉中，今出动汉中全部可用兵力攻取宛城，消除西线威胁，践行联吴抗曹兴复汉室的既定方略。；密谋揭晓：准备守约"},{"id":43562,"turn":14,"type":"decision_revealed","factionId":"wu","message":"吴：江东柴桑要塞当固，权征兵以充实西陲。与曹公既已罢兵通好，当永续盟约共安疆界。蜀汉之约，容后再议。 决策理由：柴桑仅余一兵，张飞在江州虎视，亟须征兵以固西陲。许昌兵十六足以自保，暂不动用。接受魏盟以固北部和平，拒绝蜀盟以免卷入曹刘之争，保江东独立自主。；密谋揭晓：准备守约"},{"id":43563,"turn":14,"type":"diplomacy_response","factionId":"wei","message":"魏接受了 吴 的结盟提议"},{"id":43564,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 魏 的结盟提议"},{"id":43565,"turn":14,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的结盟提议"},{"id":43566,"turn":14,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 7 兵力"},{"id":43567,"turn":14,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 3，守方损失 4","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":4}},{"id":43568,"turn":14,"type":"attack_cancelled","factionId":"wei","message":"魏 的出征因来源城局势变化而取消","payload":{"sourceCityId":"wancheng","targetCityId":"hanzhong","troops":11}},{"id":43569,"turn":15,"type":"diplomacy_changed","factionId":null,"message":"魏 与 吴 的关系变为同盟"},{"id":43570,"turn":15,"type":"director_stalemate","factionId":"wei","message":"战局久滞，流民投奔魏，补充兵源并集结 2 兵"},{"id":43571,"turn":15,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 11 金、0 粮"},{"id":43572,"turn":15,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":43573,"turn":15,"type":"turn_prepared","factionId":null,"message":"第 15 回合（争锋阶段）收入与维持已结算"},{"id":43574,"turn":15,"type":"decision_revealed","factionId":"wei","message":"魏：蜀屡犯宛城，汉中空虚，孤今率宛城之师直取汉中，断蜀一臂。吴为盟好，孤绝不东犯。 决策理由：宛城尚有余力，汉中仅两兵，趁蜀援军未至先取汉中，可解宛城围困并打开西进蜀地门户。与吴盟约未破，不攻许昌。；密谋揭晓：无隐秘意图"},{"id":43575,"turn":15,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，誓诛篡逆曹贼。今曹贼屯兵宛城虎视汉中，备整兵巩固边防，仍愿与江东修好，勿为曹贼离间。 决策理由：汉中当前守军仅2，宛城魏军大兵压境，城池有被攻占风险，集结江州兵力驰援巩固西线；同时秉持联吴抗曹方略，再次向吴提议同盟，维系结盟可能。；密谋揭晓：准备守约"},{"id":43576,"turn":15,"type":"decision_revealed","factionId":"wu","message":"吴：建业商务升造，金源渐丰，江东基业日固。 决策理由：柴桑城防与军事专精俱备，江州之敌不足为虑；建业处后方，虽兵少而无近忧。提升商务专精至二级，每回合增金七枚，长远裨益江东财政，为后续军备与外交积蓄资本。；密谋揭晓：无隐秘意图"},{"id":43577,"turn":15,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":43578,"turn":15,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 2 级"},{"id":43579,"turn":15,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 2 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":7}},{"id":43580,"turn":15,"type":"mobilize_cancelled","factionId":"shu","message":"蜀的战略集结因战场局势变化而取消"},{"id":43581,"turn":16,"type":"ceasefire_expired","factionId":null,"message":"魏 与 吴 的停战到期"},{"id":43582,"turn":16,"type":"siege_decayed","factionId":"shu","message":"蜀 对宛城的围城进度衰减"},{"id":43583,"turn":16,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":43584,"turn":16,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 23 金、34 粮"},{"id":43585,"turn":16,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":43586,"turn":16,"type":"turn_prepared","factionId":null,"message":"第 16 回合（争锋阶段）收入与维持已结算"},{"id":43587,"turn":16,"type":"decision_revealed","factionId":"wei","message":"魏：孤已据汉中，蜀军屡攻宛城徒耗兵力。今愿与玄德停战，各守疆界，休养民生。若允，魏军绝不西犯。 决策理由：蜀江州七兵可威胁汉中，而本回合无增援汉中之合法路线，故先以停战稳住西线；同时在宛城募兵，既防汉中若失后蜀军东进，也为后续反扑保留支点。；密谋揭晓：准备守约"},{"id":43588,"turn":16,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，誓清曹氏篡逆。今曹贼占汉中兵临成都，备整兵固守根本，仍愿与江东重修盟好，共保黎民同兴汉室。 决策理由：成都为我方首都，当前仅1兵驻守，魏占汉中后城池确有被攻占风险，故调江州精兵驰援巩固根本，仍秉持联吴抗曹方略，提议与吴再续同盟。；密谋揭晓：准备守约"},{"id":43589,"turn":16,"type":"decision_revealed","factionId":"wu","message":"吴：建业为江东都城，仅一兵不足固根本，权当增兵以卫桑梓。蜀汉既以诚相待，愿共修盟好，安境保民。 决策理由：建业、吴郡各仅一兵，后方单薄，征兵充实根本以保江东基业。魏盟尚有两回合方届满，暂不宜动刀兵；先受蜀盟以保多边平衡，待第十八回合魏盟届满后视魏蜀战况再定北进之策。；密谋揭晓：准备守约"},{"id":43590,"turn":16,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":43591,"turn":16,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 5 兵力"},{"id":43592,"turn":16,"type":"recruit","factionId":"wu","message":"吴 在建业征募 5 兵力"},{"id":43593,"turn":16,"type":"transfer","factionId":"shu","message":"蜀 从江州向成都调动 6 兵力","payload":{"sourceCityId":"jiangzhou","targetCityId":"chengdu","troops":6}},{"id":43594,"turn":17,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":43595,"turn":17,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":43596,"turn":17,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 14 金、17 粮"},{"id":43597,"turn":17,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":43598,"turn":17,"type":"turn_prepared","factionId":null,"message":"第 17 回合（争锋阶段）收入与维持已结算"}],"createdAt":"2026-08-19T20:06:22.202Z","updatedAt":"2026-08-19T20:26:01.537Z","exportedAt":"2026-08-19T20:26:06.484Z"}
d":37512,"turn":16,"type":"decision_revealed","factionId":"shu","message":"蜀：备与吴侯同心戮力共讨篡汉逆曹，今集结锐旅于宛城，指日攻克洛阳，兴复汉室！ 决策理由：坚持联吴抗曹既定国策，向前线宛城集结兵力，准备合力剿灭曹魏残余，恪守同盟信义，不违伐魏之约。（外交行为不在当前白名单中，已忽略）；密谋揭晓：准备守约"},{"id":37513,"turn":16,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼篡汉，天人共愤。今调江东之众北上许昌，与皇叔共图洛阳，誓灭此贼！ 决策理由：洛阳仅余三兵、城防尽毁，灭魏在即。本回合自柴桑调八兵至许昌集结，下回合可倾许昌之兵一举而下。柴桑留守十五众，固若金汤。魏氏合从之议断然拒绝。；密谋揭晓：准备守约"},{"id":37514,"turn":16,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":37515,"turn":16,"type":"fortify","factionId":"wei","message":"魏 加固了洛阳城防"},{"id":37516,"turn":16,"type":"mobilize","factionId":"shu","message":"蜀向宛城战略集结 8 兵"},{"id":37517,"turn":16,"type":"transfer","factionId":"wu","message":"吴 从柴桑向许昌调动 8 兵力","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":8}},{"id":37518,"turn":16,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":37519,"turn":17,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":37520,"turn":17,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、12 粮"},{"id":37521,"turn":17,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":37522,"turn":17,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 19 金、0 粮"},{"id":37523,"turn":17,"type":"turn_prepared","factionId":null,"message":"第 17 回合（争锋阶段）收入与维持已结算"},{"id":37524,"turn":17,"type":"decision_revealed","factionId":"wei","message":"魏：洛阳危在旦夕，孤愿与皇叔罢兵修好，共御东吴；若蒙应允，此后可助蜀攻吴，勿使江东坐大。 决策理由：洛阳仅余三兵，吴蜀皆可破城，故征兵二员加强城防；同时再向蜀提停战，分化吴蜀同盟，争取一线生机。；密谋揭晓：暗中寻求议和"},{"id":37525,"turn":17,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，誓灭篡汉逆曹，今与吴侯同心合力，洛阳孤城指日可破，曹氏停战分化之谋绝不可得逞！兴复汉室，在此一举！ 决策理由：恪守吴蜀抗曹同盟，兑现联合攻魏约定，趁曹魏仅余孤城洛阳，全力出兵进攻，一举歼灭曹魏残余，推进兴复汉室大业。；密谋揭晓：准备守约"},{"id":37526,"turn":17,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼篡汉，天人共愤！今倾江东精锐北上，誓取洛阳，灭魏在此一举！ 决策理由：许昌已集结12众，洛阳仅余3兵、城防1级。倾11众北上，攻守悬殊。围城进度1/3，此战当可定洛阳。魏灭则天下二分，再与皇叔共商大业。；密谋揭晓：准备守约"},{"id":37527,"turn":17,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":37528,"turn":17,"type":"recruit","factionId":"wei","message":"魏 在洛阳征募 2 兵力"},{"id":37529,"turn":17,"type":"city_captured","factionId":"shu","message":"蜀 攻占洛阳，损失 3 兵力","payload":{"cityId":"luoyang","defenderFactionId":"wei","sourceCityId":"wancheng","targetCityId":"luoyang","troops":9}},{"id":37530,"turn":17,"type":"character_captured","factionId":"shu","message":"郭嘉在城破后被蜀俘虏"},{"id":37531,"turn":17,"type":"attack_cancelled","factionId":"wu","message":"吴 的出征因目标归属变化而取消","payload":{"sourceCityId":"xuchang","targetCityId":"luoyang","troops":11}},{"id":37532,"turn":18,"type":"decisive_alliance_ended","factionId":null,"message":"蜀 与 吴 的同盟因进入两强决战而终止"},{"id":37533,"turn":18,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 8 金、10 粮"},{"id":37534,"turn":18,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":37535,"turn":18,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 19 金、0 粮"},{"id":37536,"turn":18,"type":"turn_prepared","factionId":null,"message":"第 18 回合（争锋阶段）收入与维持已结算"},{"id":37537,"turn":18,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉已灭，吾与吴侯本共安天下，今吴欲犯我边境，备整兵守境，只为护佑苍生，兴复汉室。 决策理由：当前已入吴蜀决战，宛城直面许昌吴军，确有被攻占风险，故而集结主力到宛城前线，同时招降郭嘉为我所用，巩固边境防御。；密谋揭晓：无隐秘意图"},{"id":37538,"turn":18,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏已灭，天下终须一统。今许昌精兵南下，直取宛城，江东锐士当先。 决策理由：魏灭后吴蜀决战已不可避免。宛城仅1兵，攻必克，可得第五城，形成对洛阳的钳形攻势。许昌留4兵仍可勉强抵御洛阳蜀军最大5兵之攻。稳步推进，方为上策。；密谋揭晓：无隐秘意图"},{"id":37539,"turn":18,"type":"city_captured","factionId":"wu","message":"吴 攻占宛城，损失 2 兵力","payload":{"cityId":"wancheng","defenderFactionId":"shu","sourceCityId":"xuchang","targetCityId":"wancheng","troops":8}},{"id":37540,"turn":18,"type":"mobilize_cancelled","factionId":"shu","message":"蜀的战略集结因战场局势变化而取消"},{"id":37541,"turn":19,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":37542,"turn":19,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、43 粮"},{"id":37543,"turn":19,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":37544,"turn":19,"type":"turn_prepared","factionId":null,"message":"第 19 回合（决战阶段）收入与维持已结算"},{"id":37545,"turn":19,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉已平，吴侯不思共安汉室，妄动干戈犯我疆界。备整兵补强边防，护我黎民百姓，终当扫清僭逆，重安汉室天下。 决策理由：宛城陷落后，汉中直面吴军威胁，本回合可被吴军攻占，因此集结成都、江州后方兵力补强汉中防御，同时招降郭嘉充实我方实力，应对吴蜀决战。；密谋揭晓：无隐秘意图"},{"id":37546,"turn":19,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏已灭，江东当兴。柴桑精兵南下，直取江州，以定三分之势。 决策理由：决战阶段仅柴桑→江州一条合法攻击路线。江州守军仅4兵、城防1级，14精兵攻之必克，损耗近零。得江州则断蜀东西两线联络，并作北伐成都、汉中之前进基地。柴桑虽仅余1兵，然江州既下，蜀已无相邻城池可攻，后顾无忧。；密谋揭晓：无隐秘意图"},{"id":37547,"turn":19,"type":"city_captured","factionId":"wu","message":"吴 攻占江州，损失 4 兵力","payload":{"cityId":"jiangzhou","defenderFactionId":"shu","sourceCityId":"chaisang","targetCityId":"jiangzhou","troops":14}},{"id":37548,"turn":19,"type":"character_captured","factionId":"wu","message":"张飞在城破后被吴俘虏"},{"id":37549,"turn":19,"type":"mobilize_cancelled","factionId":"shu","message":"蜀的战略集结因可调兵力不足而取消"},{"id":37550,"turn":20,"type":"director_last_stand","factionId":"shu","message":"蜀触发背水一战（1/2），成都集结 4 兵，但民心动荡"},{"id":37551,"turn":20,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、72 粮"},{"id":37552,"turn":20,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 13 金、16 粮"},{"id":37553,"turn":20,"type":"turn_prepared","factionId":null,"message":"第 20 回合（决战阶段）收入与维持已结算"},{"id":37554,"turn":20,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉已平，吴寇妄犯疆界，备今整兵补强汉中，护佑苍生，誓清僭逆，兴复汉室！ 决策理由：当前汉中防御空虚，吴军可直接攻占，故从成都调全部可调兵力前往汉中补强，同时招降郭嘉充实我方实力，巩固前线应对决战。；密谋揭晓：无隐秘意图"},{"id":37555,"turn":20,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏已灭，江东整军经武，北定中原，西取巴蜀，在此一举！ 决策理由：决战阶段应集中兵力于前线。许昌征兵5众，下回合可与宛城守军合流，兵临洛阳。同时招降张飞以削弱蜀汉战力。；密谋揭晓：无隐秘意图"},{"id":37556,"turn":20,"type":"character_refused","factionId":"wu","message":"张飞拒绝吴招降，忠诚受到动摇"},{"id":37557,"turn":20,"type":"recruit","factionId":"wu","message":"吴 在许昌征募 5 兵力"},{"id":37558,"turn":20,"type":"transfer","factionId":"shu","message":"蜀 从成都向汉中调动 6 兵力","payload":{"sourceCityId":"chengdu","targetCityId":"hanzhong","troops":6}},{"id":37559,"turn":21,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、19 粮"},{"id":37560,"turn":21,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 11 金、14 粮"},{"id":37561,"turn":21,"type":"turn_prepared","factionId":null,"message":"第 21 回合（决战阶段）收入与维持已结算"},{"id":37562,"turn":21,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉已灭，孙权僭越犯我疆土，备提汉室雄师出汉中反攻宛城，清荡吴寇，兴复汉室江山！ 决策理由：当前成都、洛阳、汉中均有被吴军攻占风险，先发制人反攻宛城，削弱吴军西线兵力，缓解我方前线防御压力，同时招降郭嘉为汉室效力。；密谋揭晓：无隐秘意图"},{"id":37563,"turn":21,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏已灭，江东当兴。许昌精兵北上，直取洛阳，断蜀东西两线！ 决策理由：决战阶段，速取洛阳可断蜀东西联络。许昌9兵攻洛阳6守军，兵力2倍于敌，必克。得洛阳后下回合可与宛城合围汉中。同步招降张飞以削弱蜀汉军心。；密谋揭晓：无隐秘意图"},{"id":37564,"turn":21,"type":"character_refused","factionId":"wu","message":"张飞拒绝吴招降，忠诚受到动摇"},{"id":37565,"turn":21,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 4，守方损失 3，围城进度升至 1/3","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":6}},{"id":37566,"turn":21,"type":"city_captured","factionId":"wu","message":"吴 攻占洛阳，损失 3 兵力","payload":{"cityId":"luoyang","defenderFactionId":"shu","sourceCityId":"xuchang","targetCityId":"luoyang","troops":8}},{"id":37567,"turn":22,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 18 金、42 粮"},{"id":37568,"turn":22,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 14 金、18 粮"},{"id":37569,"turn":22,"type":"turn_prepared","factionId":null,"message":"第 22 回合（决战阶段）收入与维持已结算"},{"id":37570,"turn":22,"type":"decision_revealed","factionId":"shu","message":"蜀：孙权背盟僭逆，犯我汉室疆土。备今整兵汉中，巩固边防，誓清吴寇，重安汉室天下！ 决策理由：当前成都、汉中均有可能被吴军攻占，急需补强前线兵力。我在汉中募兵充实防御，同时招降俘虏郭嘉，为我汉室所用，应对吴蜀决战。；密谋揭晓：无隐秘意图"},{"id":37571,"turn":22,"type":"decision_revealed","factionId":"wu","message":"吴：曹魏已灭，江东当兴！雄师西指，直取成都，蜀汉将亡！ 决策理由：决
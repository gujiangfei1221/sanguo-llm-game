","defenderFactionId":"wei","sourceCityId":"chaisang","targetCityId":"xuchang","troops":4}},{"id":3703,"turn":17,"type":"character_captured","factionId":"wu","message":"曹操在城破后被吴俘虏"},{"id":3704,"turn":17,"type":"joint_attack_honored","factionId":null,"message":"吴与蜀兑现承诺，共同进攻魏"},{"id":3705,"turn":17,"type":"joint_attack_honored","factionId":null,"message":"吴与蜀兑现承诺，共同进攻魏"},{"id":3706,"turn":18,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 19 金、0 粮"},{"id":3707,"turn":18,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 11 金、13 粮"},{"id":3708,"turn":18,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":3709,"turn":18,"type":"turn_prepared","factionId":null,"message":"第 18 回合（争锋阶段）收入与维持已结算"},{"id":3710,"turn":18,"type":"decision_revealed","factionId":"wei","message":"魏：吴占许昌后必生骄横，蜀吴同盟亦难久长。孤赠金二十示诚，愿与蜀休战，共防吴寇。 决策理由：汉中为魏蜀前线，增兵至七以固防；向蜀赠金促其接受停战，拆散吴蜀同盟，缓解两线压力。；密谋揭晓：暗中寻求议和"},{"id":3711,"turn":18,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，与吴侯同心共讨曹贼，逆曹离间之计绝不听从，今整兵巩固江州边防，再图汉中，兴复汉室指日可待！ 决策理由：江州遭曹魏威胁，本回合有被攻占风险，故从成都调兵增援巩固边防；恪守吴蜀同盟，拒绝曹魏停战离间，接受联合攻魏约定，维持联弱抗曹格局。；密谋揭晓：准备守约"},{"id":3712,"turn":18,"type":"decision_revealed","factionId":"wu","message":"吴：许昌已克，曹贼就擒，此皆吴蜀同心之功。孤今整军建业、厚蓄兵粮，再邀皇叔东西并举，乘胜进讨曹魏残余，共定中原！ 决策理由：上回合克许昌并俘曹操，本回合无可用进攻路线，故于建业征兵5，为下回合向前线集结做准备。许昌新占须防魏自洛阳、宛城反扑。再向蜀提联合攻魏，维系同盟协作兑现承诺。曹操继续押为质，不杀不纵，留作筹码。；密谋揭晓：准备守约"},{"id":3713,"turn":18,"type":"gold_offered","factionId":"wei","message":"魏向蜀献上 20 金"},{"id":3714,"turn":18,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":3715,"turn":18,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":3716,"turn":18,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":3717,"turn":18,"type":"recruit","factionId":"wu","message":"吴 在建业征募 5 兵力"},{"id":3718,"turn":18,"type":"recruit","factionId":"wei","message":"魏 在汉中征募 3 兵力"},{"id":3719,"turn":18,"type":"transfer","factionId":"shu","message":"蜀 从成都向江州调动 2 兵力","payload":{"sourceCityId":"chengdu","targetCityId":"jiangzhou","troops":2}},{"id":3720,"turn":19,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":3721,"turn":19,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 31 金、17 粮"},{"id":3722,"turn":19,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 5 金、6 粮"},{"id":3723,"turn":19,"type":"turn_prepared","factionId":null,"message":"第 19 回合（决战阶段）收入与维持已结算"},{"id":3724,"turn":19,"type":"decision_revealed","factionId":"wei","message":"魏：吴蜀同盟已散，孙权窃据许昌、囚孤，野心昭然。孤愿与吴休战，共图蜀地；若吴不允，汉中精兵必先取蜀，再复许昌！ 决策理由：汉中为西线根本，募兵至十一以备攻蜀；同时向吴提议停战，拆解吴蜀联合，避免两线作战。若吴应允，则全力西进；若不应，亦无损根本。；密谋揭晓：准备守约"},{"id":3725,"turn":19,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，与吴侯同心共讨曹贼，曹贼离间之计绝不可行。今整兵固防，与吴同心乘胜灭魏，兴复汉室指日可待！ 决策理由：曹魏占据汉中，威胁我成都、江州安全，征募精兵巩固国都防备敌寇。恪守吴蜀同盟，接受吴侯联合攻魏提议，续盟联吴抗曹，维持夹击曹魏的格局。；密谋揭晓：准备守约"},{"id":3726,"turn":19,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑增兵设防，江东门户稳固。同盟期满，孤即遣使续盟，愿与皇叔善始善终，共讨曹魏残余，同定天下。 决策理由：边报显示蜀军自江州可直取柴桑，柴桑守备不足有失陷之虞，故本回合紧急征兵2加固。同盟已到期，立即向蜀提议续盟，避免两线生变，维持联蜀灭魏大局。曹操继续押为质，留作筹码。；密谋揭晓：准备守约"},{"id":3727,"turn":19,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":3728,"turn":19,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":3729,"turn":19,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":3730,"turn":19,"type":"recruit","factionId":"wei","message":"魏 在汉中征募 4 兵力"},{"id":3731,"turn":19,"type":"recruit","factionId":"shu","message":"蜀 在成都征募 5 兵力"},{"id":3732,"turn":19,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 2 兵力"},{"id":3733,"turn":20,"type":"siege_decayed","factionId":"shu","message":"蜀 对汉中的围城进度衰减"},{"id":3734,"turn":20,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 1 金、10 粮"},{"id":3735,"turn":20,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":3736,"turn":20,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 2 金、0 粮"},{"id":3737,"turn":20,"type":"turn_prepared","factionId":null,"message":"第 20 回合（决战阶段）收入与维持已结算"},{"id":3738,"turn":20,"type":"decision_revealed","factionId":"wei","message":"魏：吴囚孤于许昌，野心昭然。孤已调汉中精兵至宛城，不日收复许昌。愿与皇叔弃前嫌，共讨孙权，平分江东！ 决策理由：汉中守军充足，调五兵至宛城增强东线，为下回合夺回许昌、解救曹操做准备；同时向蜀提议联合攻吴，拆散吴蜀联合。；密谋揭晓：准备守约"},{"id":3739,"turn":20,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正朔，与吴侯同心共讨曹贼，今续百年同盟之好，整兵御寇，誓清中原，兴复汉室！ 决策理由：恪守联吴抗曹国策，接受吴侯续盟提议，征募精兵巩固国都成都，防备曹魏借汉中进犯，维持夹击曹魏的格局，践行同盟承诺。；密谋揭晓：准备守约"},{"id":3740,"turn":20,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼囚于我手，此时求和，不过是缓兵之计，孤断然拒绝。吴蜀唇齿相依，孤愿与皇叔续盟，并再约共讨曹魏，下回合大军齐集许昌，誓取洛阳！ 决策理由：魏两线仅剩残兵，此时受俘求和绝非良机，拒绝停战。接受蜀续盟并再提联合攻魏，维持东西夹击。本回合无可用进攻路线，以mobilize将建业、柴桑之兵集结许昌，下回合以优势兵力攻洛阳或宛城兑现联合约定。曹操继续押为质。；密谋揭晓：准备守约"},{"id":3741,"turn":20,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 蜀 提议共同进攻 吴"},{"id":3742,"turn":20,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":3743,"turn":20,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的停战提议"},{"id":3744,"turn":20,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":3745,"turn":20,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":3746,"turn":20,"type":"recruit","factionId":"shu","message":"蜀 在成都征募 4 兵力"},{"id":3747,"turn":20,"type":"mobilize","factionId":"wu","message":"吴向许昌战略集结 7 兵"},{"id":3748,"turn":20,"type":"transfer","factionId":"wei","message":"魏 从汉中向宛城调动 5 兵力","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":5}},{"id":3749,"turn":20,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":3750,"turn":21,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":3751,"turn":21,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 2 金、5 粮"},{"id":3752,"turn":21,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 3 金、9 粮"},{"id":3753,"turn":21,"type":"adminis
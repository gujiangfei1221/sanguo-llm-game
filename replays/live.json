evelop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 2 级"},{"id":10991,"turn":10,"type":"city_captured","factionId":"wei","message":"魏 攻占汉中，损失 2 兵力","payload":{"cityId":"hanzhong","defenderFactionId":"shu","sourceCityId":"wancheng","targetCityId":"hanzhong","troops":5}},{"id":10992,"turn":10,"type":"character_captured","factionId":"wei","message":"关羽在城破后被魏俘虏"},{"id":10993,"turn":10,"type":"mobilize_cancelled","factionId":"shu","message":"蜀的战略集结因战场局势变化而取消"},{"id":10994,"turn":11,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 5 金、6 粮"},{"id":10995,"turn":11,"type":"turn_prepared","factionId":null,"message":"第 11 回合（争锋阶段）收入与维持已结算"}],"createdAt":"2026-08-16T22:50:41.035Z","updatedAt":"2026-08-16T23:03:27.675Z","exportedAt":"2026-08-16T23:04:06.090Z"}
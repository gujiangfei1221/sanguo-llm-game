:[{"id":38173,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":38174,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原腹地，当广积钱粮，以固根本。 决策理由：蓄势阶段优先发展经济，为后续用兵储备资源。；密谋揭晓：无隐秘意图"},{"id":38175,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹贼篡权窃国，天下共讨之。愿与孙吴盟好，共举义兵，清剿中原，还我汉室江山。 决策理由：首回合为蓄势阶段，汉中是对魏前沿重镇，发展军事可增强边境守备。践行联弱抗曹方略，邀约东吴共击篡汉曹魏，名正言顺符合大义。；密谋揭晓：准备守约"},{"id":38176,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：江东初立，当先固本。柴桑乃门户之地，今日增兵以防不测。 决策理由：柴桑直面许昌（魏）与江州（蜀）两路威胁，虽本回合不会被攻破，但作为江东门户必须优先加强。新募5兵使前线兵力达13人，攻防皆有余裕。其余二城暂不调动，静观魏蜀动向再作定夺。；密谋揭晓：无隐秘意图"},{"id":38177,"turn":1,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":38178,"turn":1,"type":"develop_city","factionId":"wei","message":"魏 将许昌建设为商贸专精 1 级"},{"id":38179,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 1 级"},{"id":38180,"turn":1,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":38181,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":38182,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原根本，吴军屯兵柴桑虎视眈眈。本回合先固城防，以保后方安定。 决策理由：柴桑吴军兵力雄厚，许昌有被直接攻占之险。当前不宜冒进，先加强许昌城防，稳固根基后再图进取。；密谋揭晓：无隐秘意图"},{"id":38183,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：（无公开发言） 决策理由：模型调用失败，本回合自动休整：Unexpected token '愿', ...\"\"message\":愿与江东共讨篡汉曹贼\"... is not valid JSON；密谋揭晓：无隐秘意图"},{"id":38184,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼窃据中原，天人共愤。孤已允蜀汉之请，共图许昌。今日整军经武，以待出征。 决策理由：接受蜀汉联合攻魏之议，成唇齿相依之势。本回合开发建业为商贸专精，充实金库为后续用兵蓄资。柴桑已有13兵足以支撑前线，下回合征兵调兵北上，与蜀汉共击许昌。；密谋揭晓：准备守约"},{"id":38185,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的联合进攻提议"},{"id":38186,"turn":2,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 1 级"},{"id":38187,"turn":2,"type":"fortify","factionId":"wei","message":"魏 加固了许昌城防"},{"id":38188,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":38189,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃中原根本，今增兵戍卫，以御吴蜀之众。 决策理由：吴蜀联合攻魏，许昌为都城且直面柴桑重兵。本回合征兵5人增强守备，稳固根基后再图进取。；密谋揭晓：无隐秘意图"},{"id":38190,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，天人共愤。孤依与江东盟约出兵北伐，共讨国贼，望吴侯信守约定，同复汉室江山。 决策理由：此前与东吴约定联合攻魏，期限将至，依约出兵进攻曹魏宛城，践行联吴抗曹方略，坚守信义不违盟约。；密谋揭晓：准备守约"},{"id":38191,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：江东门户重在坚守。柴桑增兵以固根本，为北伐蓄势。 决策理由：联合攻魏之约至第4回合仍有效，本回合先在柴桑征兵5人，使前线兵力由13增至18，下回合可出12精兵攻许昌、留6兵守城（防御7.2可抗魏单路7兵），攻守兼备。稳健务实，不冒柴桑沦陷之险。；密谋揭晓：准备守约"},{"id":38192,"turn":3,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":38193,"turn":3,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 5 兵力"},{"id":38194,"turn":3,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻宛城失败，进攻方损失 5，守方损失 3，城防降低 1 级","payload":{"sourceCityId":"hanzhong","targetCityId":"wancheng","troops":7}},{"id":38195,"turn":3,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":38196,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"}],"createdAt":"2026-08-19T09:19:58.547Z","updatedAt":"2026-08-19T09:21:47.298Z","exportedAt":"2026-08-19T09:22:07.361Z"}
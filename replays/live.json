ent":0},{"id":"luxun","name":"陆逊","originalFactionId":"wu","factionId":"wu","locationCityId":"jianye","status":"active","loyalty":80,"resentment":0}],"director":{"lastCaptureTurn":0,"lastEventTurn":0,"lastStandCounts":{}},"audience":{"influence":3,"lastInterventionTurn":-4,"orders":[]},"domination":{"consecutiveTurns":0},"sieges":[],"worldWearinessApplied":false},"config":{"name":"群雄逐鹿","factions":[{"factionId":"wei","controller":"model","modelId":"deepseek-v4-flash"},{"factionId":"shu","controller":"model","modelId":"doubao-seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":45505,"turn":1,"type":"turn_prepared","factionId":null,"message":"第 1 回合（蓄势阶段）收入与维持已结算"},{"id":45506,"turn":1,"type":"decision_revealed","factionId":"wei","message":"魏：吴主孙权：蜀汉坐大，汉中扼我咽喉。愿与东吴共击刘备，各取所需。 决策理由：先联吴制蜀，避免两线受敌；同时发展许昌商市，充实钱粮，为后续战事蓄力。；密谋揭晓：准备守约"},{"id":45507,"turn":1,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹贼篡汉窃国，愿与江东孙将军共举义兵，清剿奸凶，共安汉室。 决策理由：首回合蓄势整备，发展后方成都农业积攒粮产，主动邀约东吴联合讨曹，契合兴复汉室大义，维系盟友根基。；密谋揭晓：准备守约"},{"id":45508,"turn":1,"type":"decision_revealed","factionId":"wu","message":"吴：江东基业为本，先固边防。周瑜坐镇柴桑，督练水陆军马，以御不测。另遣使致意蜀汉，愿结秦晋之好。 决策理由：柴桑直面许昌、江州两路威胁，优先军事专精以巩固前线；同步提议与蜀汉结盟，顺应天下三分之势，效法赤壁之策。；密谋揭晓：准备守约"},{"id":45509,"turn":1,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":45510,"turn":1,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":45511,"turn":1,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":45512,"turn":1,"type":"develop_city","factionId":"wei","message":"魏 将许昌建设为商贸专精 1 级"},{"id":45513,"turn":1,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 1 级"},{"id":45514,"turn":1,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 1 级"},{"id":45515,"turn":2,"type":"turn_prepared","factionId":null,"message":"第 2 回合（蓄势阶段）收入与维持已结算"},{"id":45516,"turn":2,"type":"decision_revealed","factionId":"wei","message":"魏：继续发展许昌商市，巩固中原根基。愿与东吴共击蜀汉，平分其地，望孙将军早作决断。 决策理由：蓄势阶段以经济为重，升级许昌商业增加收入；再次向吴提议联合攻蜀，为后续军事行动铺路。；密谋揭晓：无隐秘意图"},{"id":45517,"turn":2,"type":"decision_revealed","factionId":"shu","message":"蜀：孙将军愿与我缔盟共讨曹贼，备欣然应允。曹贼篡汉窃国，你我同心戮力，必能清剿奸凶，复安汉室天下。 决策理由：接受东吴结盟提议，缔结吴蜀同盟共抗篡汉曹魏，将前线汉中开发为军事重镇，巩固边境防备，为后续讨曹战事预做准备，合乎兴复汉室的大义。；密谋揭晓：准备守约"},{"id":45518,"turn":2,"type":"decision_revealed","factionId":"wu","message":"吴：江东基业方固，民力未充，此时兴兵非万全之策。望曹公、刘皇叔各安疆土，秋后粮丰甲备，再议长远不迟。 决策理由：柴桑防线稳固（防御9.6，敌军最大攻势7），本回合无失城之虞。建业为都城尚无专精，立商市可固根本、长增金入，为后续调兵结盟蓄资。暂拒两家联合进攻之议，保留外交回旋，待局势明朗再定进止。；密谋揭晓：无隐秘意图"},{"id":45519,"turn":2,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":45520,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 魏 的联合进攻提议"},{"id":45521,"turn":2,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":45522,"turn":2,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 1 级"},{"id":45523,"turn":2,"type":"develop_city","factionId":"wu","message":"吴 将建业建设为商贸专精 1 级"},{"id":45524,"turn":2,"type":"develop_city","factionId":"wei","message":"魏 将许昌建设为商贸专精 2 级"},{"id":45525,"turn":3,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":45526,"turn":3,"type":"turn_prepared","factionId":null,"message":"第 3 回合（蓄势阶段）收入与维持已结算"},{"id":45527,"turn":3,"type":"decision_revealed","factionId":"wei","message":"魏：继续休整，发展洛阳商市，充实国力，以观天下之势。 决策理由：吴蜀同盟已成，短期不宜两线用兵；先固根本，发展洛阳商业，为后续战事积累钱粮。；密谋揭晓：无隐秘意图"},{"id":45528,"turn":3,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹贼篡汉窃国，祸乱天下。愿与孙将军同心戮力，共讨汉贼，兴复汉室，你我共守疆土，永为盟好。 决策理由：蓄势阶段升级成都农业，积攒粮产以备后续战事，再次邀约东吴联合攻魏，巩固吴蜀同盟，契合兴复汉室大义，稳步积蓄讨曹力量。；密谋揭晓：准备守约"},{"id":45529,"turn":3,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，民食为本。吴郡土沃水丰，当兴农桑以充仓廪，固我根基。 决策理由：蓄势阶段当厚植根基。柴桑前线防御9.6对魏最大攻势7，固若金汤，无失城之虞。吴郡尚无专精，立农桑可补江东粮产短板，18粮入配以66存粮足以支撑后续征伐；建业商市L1已立，金流渐稳。吴蜀盟约初成，本回合专注内修，不涉外衅。；密谋揭晓：准备守约"},{"id":45530,"turn":3,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":45531,"turn":3,"type":"develop_city","factionId":"wu","message":"吴 将吴郡建设为农桑专精 1 级"},{"id":45532,"turn":3,"type":"develop_city","factionId":"wei","message":"魏 将洛阳建设为商贸专精 1 级"},{"id":45533,"turn":3,"type":"develop_city","factionId":"shu","message":"蜀 将成都建设为农桑专精 2 级"},{"id":45534,"turn":4,"type":"turn_prepared","factionId":null,"message":"第 4 回合（蓄势阶段）收入与维持已结算"},{"id":45535,"turn":4,"type":"decision_revealed","factionId":"wei","message":"魏：宛城乃西线要冲，当整备军镇，以固疆御敌。 决策理由：吴蜀同盟尚存，暂不轻启战端；先强化宛城军备，为后续应对汉中方向威胁积蓄力量。；密谋揭晓：无隐秘意图"},{"id":45536,"turn":4,"type":"decision_revealed","factionId":"shu","message":"蜀：备乃汉室宗亲，曹贼篡汉窃国，今整备汉中军镇，秣马厉兵，盼与孙同盟共举义兵，清剿奸凶，兴复汉室。 决策理由：蓄势阶段巩固前线军事重镇，升级汉中军事专精提升边防战力，再次邀约东吴联合讨曹，维系同盟，积蓄伐曹力量。；密谋揭晓：准备守约"},{"id":45537,"turn":4,"type":"decision_revealed","factionId":"wu","message":"吴：江东初定，柴桑军镇再加精修，以固江防、徐图远势。 决策理由：蓄势阶段以厚植根基为先。柴桑为江东门户，升级军镇专精可强化防御与征兵上限，为来日战机蓄势。当前我军仅24人，出征7则留1过于单薄，不宜仓促响应联合攻魏之议，待兵力更充、战机更明再定进止。；密谋揭晓：无隐秘意图"},{"id":45538,"turn":4,"type":"diplomacy_response","factionId":"wu","message":"吴拒绝了 蜀 的联合进攻提议"},{"id":45539,"turn":4,"type":"develop_city","factionId":"wei","message":"魏 将宛城建设为军镇专精 1 级"},{"id":45540,"turn":4,"type":"develop_city","factionId":"shu","message":"蜀 将汉中建设为军镇专精 2 级"},{"id":45541,"turn":4,"type":"develop_city","factionId":"wu","message":"吴 将柴桑建设为军镇专精 2 级"},{"id":45542,"turn":5,"type":"turn_prepared","factionId":null,"message":"第 5 回合（蓄势阶段）收入与维持已结算"},{"id":45543,"turn":5,"type":"decision_revealed","factionId":"wei","message":"魏：宛城乃西线要冲，今增兵以固防务。吴蜀同盟未散，暂不轻动，待势而发。 决策理由：蓄势阶段，吴蜀同盟尚存，不宜立即开战。优先充实宛城兵力，强化对汉中方向的防御与后续进攻准备。；密谋揭晓：无隐秘意图"},{"id":45544,"turn":5,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃国，备与孙将军同盟共讨汉贼，今整备内政充实国力，再邀孙将军共举义兵，清剿奸凶，兴复汉室。 决策理由：江州尚未设置城市专精，开发商业可长期增加金收入，充实国力；再次邀约东吴联合攻魏，维系吴蜀同盟，符合联吴抗曹、兴复汉室的既定方略。；密谋揭晓：准备守约"},{"id":45545,"turn":5,"type":"decision_revealed","factionId":"wu","message":"吴：江东新募士卒已编入柴桑营中，厉兵秣马以固江防，静观中原之变。 决策理由：蓄势阶段当以充实军力为先。柴桑前临许昌，为江东门户，今增兵七人使前线达十五人，来日可出兵七攻许昌而仍留八人守城，攻守兼顾。边境防御九点六高于魏军最大攻势七，本回合无失城之虞，可从容征兵。；密谋揭晓：无隐秘意图"},{"id":45546,"turn":5,"type":"joint_attack_proposed","factionId":"shu","message":"蜀 向 吴 提议共同进攻 魏"},{"id":45547,"turn":5,"type":"develop_city","factionId":"shu","message":"蜀 将江州建设为商贸专精 1 级"},{"id":45548,"turn":5,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 7 兵力"},{"id":45549,"turn":5,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 6 兵力"}],"createdAt":"2026-08-20T00:16:34.962Z","updatedAt":"2026-08-20T00:20:09.841Z","exportedAt":"2026-08-20T00:20:09.842Z"}
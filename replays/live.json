,{"id":32714,"turn":19,"type":"turn_prepared","factionId":null,"message":"第 19 回合（决战阶段）收入与维持已结算"},{"id":32715,"turn":19,"type":"decision_revealed","factionId":"wei","message":"魏：吴独占许昌洛阳，同盟已到期，皇叔岂甘为他人作嫁？愿与蜀停战共御吴，平分天下。 决策理由：吴势大且攻占洛阳，蜀吴同盟至19回合到期。本回合巩固宛城防务，同时向蜀提议联合攻吴，分化蜀吴同盟，避免两线作战。；密谋揭晓：准备守约"},{"id":32716,"turn":19,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃据神器，备以兴复汉室为己任，与孙将军同心同盟，岂容奸计分化？今日整兵固防，共诛国贼，克复中原！ 决策理由：坚守联吴抗曹大义，拒绝曹魏停战分化阴谋，接受东吴联合攻魏提议。成都为西川根本，遭曹魏汉中威胁，本回合有失陷可能，故征兵充实防务巩固后方。；密谋揭晓：准备守约"},{"id":32717,"turn":19,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼窥伺许昌，权已调江东精锐驰援。许昌乃中原锁钥，必保无虞。与刘皇叔之盟，当共诛国贼，克定中原。 决策理由：许昌仅1兵，宛城魏军11众虎视，本回合即可陷落，威胁最高。征调洛阳、建业8营赴许昌(1+8=9)，构筑中原防线。洛阳虽减兵至1，魏若反扑则暂失所获，舍车保帅。同步提议蜀续攻魏，以利益唤醒盟友，瓦解魏蜀临时联合。；密谋揭晓：准备守约"},{"id":32718,"turn":19,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 蜀 提议共同进攻 吴"},{"id":32719,"turn":19,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":32720,"turn":19,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":32721,"turn":19,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":32722,"turn":19,"type":"recruit","factionId":"wei","message":"魏 在宛城征募 2 兵力"},{"id":32723,"turn":19,"type":"recruit","factionId":"shu","message":"蜀 在成都征募 3 兵力"},{"id":32724,"turn":19,"type":"mobilize","factionId":"wu","message":"吴向许昌战略集结 8 兵"},{"id":32725,"turn":20,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":32726,"turn":20,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、12 粮"},{"id":32727,"turn":20,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":32728,"turn":20,"type":"turn_prepared","factionId":null,"message":"第 20 回合（决战阶段）收入与维持已结算"},{"id":32729,"turn":20,"type":"decision_revealed","factionId":"wei","message":"魏：吴据许昌洛阳，独大已成天下患。孤愿与皇叔共讨孙权，平分江东之地。若蜀王肯信，则北击许昌，西守汉中，大事可成。 决策理由：宛城兵精粮足，趁吴许昌重兵未稳主动出击，攻其必救。同时再向蜀提议联合攻吴，分化蜀吴旧盟。汉中暂守不攻，避免两线作战。；密谋揭晓：准备守约"},{"id":32730,"turn":20,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃据神器，备以兴复汉室为己任，誓与孙将军同心共诛国贼，岂容奸计离间！今整兵固防，共践伐魏之约。 决策理由：坚守联吴抗曹大义，拒绝曹魏联合攻吴的分化阴谋，接受东吴联合攻魏提议。江州为西川门户，确有被曹魏攻占风险，故征兵充实防务，巩固同盟共讨国贼。；密谋揭晓：准备守约"},{"id":32731,"turn":20,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼窥伺中原，权已整兵固防。与刘皇叔之盟，当共诛国贼，克定中原。 决策理由：柴桑仅1兵，蜀江州3兵可攻，征兵5营强化防御至6，可保无虞。吴蜀同盟届满，提议续盟以维系夹击魏军之势。；密谋揭晓：准备守约"},{"id":32732,"turn":20,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的联合进攻提议"},{"id":32733,"turn":20,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":32734,"turn":20,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":32735,"turn":20,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":32736,"turn":20,"type":"recruit","factionId":"shu","message":"蜀 在江州征募 5 兵力"},{"id":32737,"turn":20,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":32738,"turn":20,"type":"city_captured","factionId":"wei","message":"魏 攻占许昌，损失 5 兵力","payload":{"cityId":"xuchang","defenderFactionId":"wu","sourceCityId":"wancheng","targetCityId":"xuchang","troops":12}},{"id":32739,"turn":20,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":32740,"turn":21,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":32741,"turn":21,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、7 粮"},{"id":32742,"turn":21,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":32743,"turn":21,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 2 金、0 粮"},{"id":32744,"turn":21,"type":"turn_prepared","factionId":null,"message":"第 21 回合（决战阶段）收入与维持已结算"},{"id":32745,"turn":21,"type":"decision_revealed","factionId":"wei","message":"魏：吴坐大，蜀吴旧盟已散。孤愿与皇叔罢兵，共御孙权；汉中已固守，望蜀勿再为吴火中取栗。 决策理由：汉中为攻守枢纽，征兵一营巩固城防，确保不被蜀军所乘。同时再向蜀提议停战，分化吴蜀，若成则西线可安，全力对吴。；密谋揭晓：准备守约"},{"id":32746,"turn":21,"type":"decision_revealed","factionId":"shu","message":"蜀：备以兴复汉室为己任，信守与孙将军同盟之约，共讨篡汉曹贼。今日提西川锐卒进取汉中，扫清国贼北线威胁，同心协力共定中原！ 决策理由：坚守联吴抗曹大义，拒绝曹魏分化离间阴谋，接受东吴续盟提议，调集江州主力进攻曹魏占据的汉中，拔除西川北线威胁，践行联合攻魏盟约。；密谋揭晓：准备守约"},{"id":32747,"turn":21,"type":"decision_revealed","factionId":"wu","message":"吴：权承父兄基业，与刘皇叔盟约已续，当共诛国贼。柴桑乃江东门户，今增兵固守，以保东吴根本。 决策理由：许昌已失于魏，洛阳六兵暂可自保。柴桑面临蜀江州压力，最大攻击八营可撼，征五营后达十一，稳如磐石。续盟蜀汉并提议联合攻魏，维持夹击之势，下回合再图宛城。；密谋揭晓：准备守约"},{"id":32748,"turn":21,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的结盟提议"},{"id":32749,"turn":21,"type":"diplomacy_response","factionId":"wu","message":"吴接受了 蜀 的结盟提议"},{"id":32750,"turn":21,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 蜀 提议共同进攻 魏"},{"id":32751,"turn":21,"type":"recruit","factionId":"wu","message":"吴 在柴桑征募 5 兵力"},{"id":32752,"turn":21,"type":"recruit","factionId":"wei","message":"魏 在汉中征募 1 兵力"},{"id":32753,"turn":21,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻汉中失败，进攻方损失 5，守方损失 4，围城进度升至 1/3","payload":{"sourceCityId":"jiangzhou","targetCityId":"hanzhong","troops":8}},{"id":32754,"turn":21,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":32755,"turn":21,"type":"joint_attack_broken","factionId":"wu","message":"吴未兑现共同进攻承诺"},{"id":32756,"turn":22,"type":"diplomacy_changed","factionId":null,"message":"蜀 与 吴 的关系变为同盟"},{"id":32757,"turn":22,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":32758,"turn":22,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、7 粮"},{"id":32759,"turn":22,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":32760,"turn":22,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 3 金、0 粮"},{"id":32761,"turn":22,"type":"turn_prepared","factionId":null,"message":"第 22 回合（决战阶段）收入与维持已结算"},{"id":32762,"turn":22,"type":"decision_revealed","factionId":"wei","message":"魏：吴踞洛阳，坐大已成天下患。孤愿与皇叔罢兵，共御孙权，保汉室社稷。 决策理由：宛城兵微，吴洛阳之师旦夕可至，故先加固城防以保许昌。同时再向蜀提议停战，若成则西线可安，全力对吴。；密谋揭晓：准备守约"},{"id":32763,"turn":22,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡汉窃据神器，汉中乃西川门户，备与孙将军盟共讨国贼，今日提锐卒进取汉中，兴复汉室指日可待！ 决策理由：坚守联吴抗曹大义，拒绝曹魏停战离间阴谋，接受东吴联合攻魏提议，继续攻打曹魏占据的汉中，拔除西川北线威胁，践行盟约兑现承诺。；密谋揭晓：准备守约"},{"id":32764,"turn":22,"type":"decision_revealed","factionId":"wu","message":"吴：权承父兄遗志，与刘皇叔盟约正固，当同心共诛国贼。宛城孤悬，旦夕可下。 决策理由：宛城仅1兵0民，洛阳遣5兵一击可定，开辟第二战场，对许昌形成侧翼威胁。同步借兵5营至蜀江州，助皇叔再攻关中汉中，践盟共击曹贼。；密谋揭晓：准备守约"},{"id":32765,"turn":22,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":32766,"turn":22,"type":"diplomacy_response","factionId":"shu","message":"蜀接受了 吴 的联合进攻提议"},{"id":32767,"turn":22,"type":"troops_lent","factionId":"wu","message":"吴借给蜀 5 兵，增援江州"},{"id":32768,"turn":22,"type":"fortify","factionId":"wei","message":"魏 加固了宛城城防"},{"id":32769,"turn":22,"type":"city_pacified","factionId":"shu","message":"汉中多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":32770,"turn":22,"type":"city_captured","factionId":"shu","message":"蜀 攻占汉中，损失 2 兵力，获得联合进攻加成","payload":{"cityId":"hanzhong","defenderFactionId":"wei","sourceCityId":"chengdu","targetCityId":"hanzhong","troops":5}},{"id":32771,"turn":22,"type":"city_captured","factionId":"wu","message":"吴 攻占宛城，损失 2 兵力，获得联合进攻加成","payload":{"cityId":"wancheng","defenderFactionId":"wei","sourceCityId":"luoyang","targetCityId":"wancheng","troops":5}},{"id":32772,"turn":22,"type":"character_captured","factionId":"wu","message":"张辽在城破后被吴俘虏"},{"id":32773,"turn":22,"type":"joint_attack_honored","factionId":null,"message":"吴与蜀兑现承诺，共同进攻魏"},{"id":32774,"turn":23,"type":"director_coalition","factionId":"wu","message":"吴势大，引发天下共讨，声望下降"},{"id":32775,"turn":23,"type":"resource_overflow","factionId":"wei","message":"魏 库存溢出，损失 8 金、0 粮"},{"id":32776,"turn":23,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":32777,"turn":23,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":32778,"turn":23,"type":"turn_prepared","factionId":null,"message":"第 23 回合（决战阶段）收入与维持已结算"},{"id":32779,"turn":23,"type":"decision_revealed","factionId":"wei","message":"魏：吴强盛，天下共讨。孤愿与皇叔罢兵休战，共御孙权，以安汉室。 决策理由：许昌仅一城，先募兵自保；同时向蜀停战，分化吴蜀同盟，为下回合集中攻吴创造时机。；密谋揭晓：准备守约"},{"id":32780,"turn":23,"type":"decision_revealed","factionId":"shu","message":"蜀：备信守与孙将军同盟之约，共讨篡汉曹贼，兴复汉室，绝不被奸雄离间，今借兵助吴进讨，共清中原。 决策理由：坚守联吴抗曹大义，拒绝曹魏分化同盟的阴谋，补充江州前线军力，借兵助吴攻魏，践行盟约，巩固同盟信任。；密谋揭晓：准备守约"},{"id":32781,"turn":23,"type":"decision_revealed","factionId":"wu","message":"吴：洛阳乃中原锁钥，权重兵屯守，以安黎庶、固疆圉。与皇叔之盟，当共践克定中原之约。 决策理由：洛阳仅1兵，魏自许昌可发6兵攻，capturePossible为真。征5兵后达6兵，防御力近6.6阈值，可保中原根本不失。宛城虽危，本回合无力兼顾，留待下回合相机处置。声望仅1，不宜急攻，静待时机。；密谋揭晓：准备守约"},{"id":32782,"turn":23,"type":"troops_lent","factionId":"shu","message":"蜀借给吴 5 兵，增援洛阳"},{"id":32783,"turn":23,"type":"recruit","factionId":"shu","message":"蜀 在江州征募 5 兵力"},{"id":32784,"turn":23,"type":"recruit","factionId":"wu","message":"吴 在洛阳征募 5 兵力"},{"id":32785,"turn":23,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 4 兵力"},{"id":32786,"turn":24,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 2 金、2 粮"},{"id":32787,"turn":24,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":32788,"turn":24,"type":"turn_prepared","factionId":null,"message":"第 24 回合（决战阶段）收入与维持已结算"},{"id":32789,"turn":24,"type":"decision_revealed","factionId":"wei","message":"魏：吴踞洛阳、柴桑，兵锋直指许昌。孤先固城防，再与皇叔修好，共抗东吴，以安社稷。 决策理由：许昌为唯一根基，吴洛阳兵力强盛，若贸然出击恐失根本。加固城防以稳守势，同时再向蜀提议停战，分化吴蜀同盟，待下回合同盟期满再图破局。；密谋揭晓：准备守约"},{"id":32790,"turn":24,"type":"decision_revealed","factionId":"shu","message":"蜀：备承汉室正统，与孙将军盟约共讨篡汉曹贼，绝不被曹瞒离间诡计所动，誓同江东共清中原，兴复汉室。 决策理由：坚守联吴抗曹的既定方针，拒绝曹魏停战离间阴谋，调集汉中军力集结于江州前线，准备协同吴军继续攻魏，信守同盟承诺，巩固同盟信任。；密谋揭晓：准备守约"},{"id":32791,"turn":24,"type":"decision_revealed","factionId":"wu","message":"吴：洛阳乃中原锁钥，加固城防以固根本。与皇叔之盟当共践，下回合图许昌。 决策理由：宛城3 garrison、柴桑6 garrison皆在魏许昌11兵威胁下，本回合无力多顾。洛阳为西进许昌根基，虽11 garrison但def 0致defPower仅11，仍有被魏全力一击之虞。优先fortify洛阳使defPower达13.2，彻底稳固中原根本，为T25蜀借5兵到后以16 garrison攻许昌创造必胜条件。；密谋揭晓：准备守约"},{"id":32792,"turn":24,"type":"diplomacy_response","factionId":"shu","message":"蜀拒绝了 魏 的停战提议"},{"id":32793,"turn":24,"type":"fortify","factionId":"wu","message":"吴 加固了洛阳城防"},{"id":32794,"turn":24,"type":"fortify","factionId":"wei","message":"魏 加固了许昌城防"},{"id":32795,"turn":24,"type":"mobilize","factionId":"shu","message":"蜀向江州战略集结 4 兵"},{"id":32796,"turn":25,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 6 金、8 粮"},{"id":32797,"turn":25,"type":"turn_prepared","factionId":null,"message":"第 25 回合（决战阶段）收入与维持已结算"},{"id":32798,"turn":25,"type":"decision_revealed","factionId":"wei","message":"魏：吴踞洛阳，宛城兵微。孤亲提雄师取宛城，以固许昌根本，再图破敌。 决策理由：许昌城防已固，吴洛阳虽强但一时难破。宛城仅3兵，以10兵攻取可扩地并解救被俘将领，同时削弱吴侧翼。；密谋揭晓：无隐秘意图"},{"id":32799,"turn":25,"type":"decision_revealed","factionId":"shu","message":"蜀：备承汉室正统，与孙将军盟约共讨篡汉曹贼，绝不为曹瞒离间诡计所动，整备西川门户，与江东同心共清中原，兴复汉室。 决策理由：巩固汉中这一西川门户的防务，调集江州兵力加强北线，信守吴蜀同盟约定，坚持联吴抗曹既定方针，不为曹魏的分化阴谋所动。；密谋揭晓：准备守约"},{"id":32800,"turn":25,"type":"decision_revealed","factionId":"wu","message":"吴：中原初定，增兵洛阳以固根本，徐图许昌。 决策理由：许昌魏军11 garrison、defLevel 1，defPower约13.2。本回合若从洛阳出兵上限仅10，攻击力不足以破城。征5兵后洛阳达16 garrison，下回合可发15兵攻许昌，胜算已定。魏仅余许昌一城，灭魏在此一举。；密谋揭晓：准备守约"},{"id":32801,"turn":25,"type":"recruit","factionId":"wu","message":"吴 在洛阳征募 5 兵力"},{"id":32802,"turn":25,"type":"city_captured","factionId":"wei","message":"魏 攻占宛城，损失 3 兵力","payload":{"cityId":"wancheng","defenderFactionId":"wu","sourceCityId":"xuchang","targetCityId":"wancheng","troops":10}},{"id":32803,"turn":25,"type":"mobilize","factionId":"shu","message":"蜀向汉中战略集结 8 兵"},{"id":32804,"turn":25,"type":"joint_attack_broken","factionId":"shu","message":"蜀未兑现共同进攻承诺"},{"id":32805,"turn":26,"type":"alliance_expired","factionId":null,"message":"蜀 与 吴 的同盟到期"},{"id":32806,"turn":26,"type":"administration_paid","factionId":"wei","message":"魏 支付行政成本 2 金、2 粮"},{"id":32807,"turn":26,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、10 粮"},{"id":32808,"turn":26,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":32809,"turn":26,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 21 金、0 粮"},{"id":32810,"turn":26,"type":"turn_prepared","factionId":null,"message":"第 26 回合（决战阶段）收入与维持已结算"},{"id":32811,"turn":26,"type":"decision_revealed","factionId":"wei","message":"魏：皇叔明鉴：吴氏坐大，蚕食汉室，唇亡齿寒。孤愿与蜀休兵，共御东吴，以全社稷。 决策理由：许昌孤城难守，调兵亦无法即时抵达；保留宛城兵力以为根本。向蜀提议停战，分化吴蜀同盟，争取喘息之机。；密谋揭晓：准备守约"},{"id":32812,"turn":26,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正统，信守联吴抗曹大义，今提雄师出汉中取宛城，与孙将军同心共灭篡汉曹贼，清定中原兴复汉室。 决策理由：曹魏窃据宛城，威胁我西川门户，出兵攻取可削弱曹魏势力，打通进逼许昌的通道。续盟东吴，坚守联吴抗曹的既定方针，践行盟约信义。；密谋揭晓：准备守约"},{"id":32813,"turn":26,"type":"decision_revealed","factionId":"wu","message":"吴：洛阳王师南下，誓取许昌以定中原。已修书皇叔，续同盟之约，共安天下。 决策理由：魏仅余许昌孤城(1 garrison, def1, defPower 1.32)，洛阳16 garrison发9兵攻之必克。留7 garrison守洛阳(defPower 7.7)防宛城6兵攻，安全无虞。灭魏后中原归一，吴蜀续盟以安边境，金粮充裕足以支撑。；密谋揭晓：准备守约"},{"id":32814,"turn":26,"type":"alliance_proposed","factionId":"shu","message":"蜀 向 吴 提议结盟"},{"id":32815,"turn":26,"type":"alliance_proposed","factionId":"wu","message":"吴 向 蜀 提议结盟"},{"id":32816,"turn":26,"type":"city_pacified","factionId":"shu","message":"宛城多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":32817,"turn":26,"type":"city_captured","factionId":"shu","message":"蜀 攻占宛城，损失 3 兵力","payload":{"cityId":"wancheng","defenderFactionId":"wei","sourceCityId":"hanzhong","targetCityId":"wancheng","troops":8}},{"id":32818,"turn":26,"type":"city_pacified","factionId":"wu","message":"许昌多次易手后地方势力归附，补充 2 兵并恢复 1 级城防"},{"id":32819,"turn":26,"type":"city_captured","factionId":"wu","message":"吴 攻占许昌，损失 3 兵力","payload":{"cityId":"xuchang","defenderFactionId":"wei","sourceCityId":"luoyang","targetCityId":"xuchang","troops":9}},{"id":32820,"turn":26,"type":"character_captured","factionId":"wu","message":"关羽在城破后被吴俘虏"},{"id":32821,"turn":27,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":32822,"turn":27,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":32823,"turn":27,"type":"turn_prepared","factionId":null,"message":"第 27 回合（决战阶段）收入与维持已结算"},{"id":32824,"turn":27,"type":"decision_revealed","factionId":"shu","message":"蜀：备奉汉室正统，曹贼已灭，江东割据阻一统，今出兵取柴桑，清定四海安黎民。 决策理由：曹魏已灭，东吴割据，天下归一乃大势所趋，故此出兵攻取柴桑，推进汉室统一大业。；密谋揭晓：无隐秘意图"},{"id":32825,"turn":27,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼既灭，江东雄师西指江州。蜀中军民若识天数，当开门献城，免遭涂炭。 决策理由：曹魏已亡，吴蜀决战。柴桑6 garrison发5兵攻江州(蜀5 garrison def1)，攻守相近胜算可观。胜则斩断蜀东西联系，下回合径取汉中、成都可期。败亦重创江州，柴桑1 garrison尚可凭后援稳住。；密谋揭晓：无隐秘意图"},{"id":32826,"turn":27,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻柴桑失败，进攻方损失 3，守方损失 2，围城进度升至 1/3","payload":{"sourceCityId":"jiangzhou","targetCityId":"chaisang","troops":4}},{"id":32827,"turn":27,"type":"attack_cancelled","factionId":"wu","message":"吴 的出征因来源城局势变化而取消","payload":{"sourceCityId":"chaisang","targetCityId":"jiangzhou","troops":5}},{"id":32828,"turn":28,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 5 金、6 粮"},{"id":32829,"turn":28,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 8 金、10 粮"},{"id":32830,"turn":28,"type":"turn_prepared","factionId":null,"message":"第 28 回合（决战阶段）收入与维持已结算"}],"createdAt":"2026-08-18T21:14:06.467Z","updatedAt":"2026-08-18T21:50:22.734Z","exportedAt":"2026-08-18T21:54:06.384Z"}
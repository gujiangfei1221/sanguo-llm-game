seed-2.0-lite"},{"factionId":"wu","controller":"model","modelId":"minimax-m3"}]},"events":[{"id":6174,"turn":22,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼篡逆，天人共愤！权亲督宛城精兵十二员，直捣许昌，必擒国贼以安江东！ 决策理由：许昌围城已积一进，城防已破一级，正是毕其功于一役之时。以宛城十二兵全力攻关，柴桑十兵为后援，吴郡八兵固守建业，蜀盟在汉中可牵制魏军，胜算已具。；密谋揭晓：准备守约"},{"id":6175,"turn":22,"type":"recruit","factionId":"wei","message":"魏 在许昌征募 2 兵力"},{"id":6176,"turn":22,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 8，守方损失 6，围城进度升至 2/3","payload":{"sourceCityId":"wancheng","targetCityId":"xuchang","troops":12}},{"id":6177,"turn":22,"type":"mobilize","factionId":"shu","message":"蜀向汉中战略集结 8 兵"},{"id":6178,"turn":23,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 0 金、12 粮"},{"id":6179,"turn":23,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 3 金、4 粮"},{"id":6180,"turn":23,"type":"resource_overflow","factionId":"wu","message":"吴 库存溢出，损失 19 金、0 粮"},{"id":6181,"turn":23,"type":"turn_prepared","factionId":null,"message":"第 23 回合（决战阶段）收入与维持已结算"},{"id":6182,"turn":23,"type":"decision_revealed","factionId":"wei","message":"魏：许昌乃魏都，吴军连番来犯，孤先加固城防，挫其锐气；待敌军力竭，再挥师宛城。 决策理由：吴蜀同盟尚存，许昌围城已至二段。当前吴军最大攻势不足以破城，但为防围城加深，先筑城固守，保全根本，再图反攻。；密谋揭晓：无隐秘意图"},{"id":6183,"turn":23,"type":"decision_revealed","factionId":"shu","message":"蜀：曹贼篡逆窃据神器，备与吴侯永结同盟，共举义兵，整军待发，誓灭曹魏兴复汉室！ 决策理由：恪守联吴抗曹既定国策，拒不落入曹魏离间阴谋，不背盟约，募兵充实后方军力，巩固根本，准备后续协同盟友攻伐曹魏。；密谋揭晓：准备守约"},{"id":6184,"turn":23,"type":"decision_revealed","factionId":"wu","message":"吴：曹贼篡逆，天人共愤！权亲督柴桑精兵，会同蜀汉皇叔，共讨国贼，许昌克日可下！ 决策理由：许昌围城进度已至2/3，城防已破，曹军困守无援。以柴桑九兵全力攻关，军事专精加成，必破此城。克许昌则曹魏名存实亡，江东基业永固。柴桑纵有折损，外有吴郡八兵、后有建业屏障，京师无虞。；密谋揭晓：准备守约"},{"id":6185,"turn":23,"type":"recruit","factionId":"shu","message":"蜀 在成都征募 5 兵力"},{"id":6186,"turn":23,"type":"fortify","factionId":"wei","message":"魏 加固了许昌城防"},{"id":6187,"turn":23,"type":"attack_repulsed","factionId":"wu","message":"吴 进攻许昌失败，进攻方损失 6，守方损失 4，城防降低 1 级","payload":{"sourceCityId":"chaisang","targetCityId":"xuchang","troops":9}},{"id":6188,"turn":24
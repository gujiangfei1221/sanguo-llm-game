ops":6}},{"id":24852,"turn":42,"type":"attack_repulsed","factionId":"shu","message":"蜀 进攻许昌失败，进攻方损失 3，守方损失 2，城防降低 1 级","payload":{"sourceCityId":"wancheng","targetCityId":"xuchang","troops":5}},{"id":24853,"turn":42,"type":"joint_attack_broken","factionId":"wei","message":"魏未兑现共同进攻承诺"},{"id":24854,"turn":43,"type":"administration_paid","factionId":"shu","message":"蜀 支付行政成本 3 金、4 粮"},{"id":24855,"turn":43,"type":"resource_overflow","factionId":"shu","message":"蜀 库存溢出，损失 39 金、50 粮"},{"id":24856,"turn":43,"type":"administration_paid","factionId":"wu","message":"吴 支付行政成本 2 金、2 粮"},{"id":24857,"turn":43,"type":"turn_prepared","factionId":null,"message":"第 43 回合（决战阶段）收入与维持已结算"},{"id":24858,"turn":43,"type":"decision_revealed","factionId":"wei","message":"魏：魏军已出洛阳攻宛城，请吴侯自柴桑攻江州，共分蜀势，会师中原。 决策理由：宛城为蜀军侵魏前线，守军薄弱。今以洛阳四兵攻之，若克则许洛连成一片，蜀失屏障；再约吴攻江州，令蜀首尾难顾。；密谋揭晓：准备守约"},{"id":24859,"turn":43,"type":"decision_revealed","factionId":"shu","message":"蜀：曹魏窥我宛城，吴寇伺我江州，孤整兵固境，收回旧部，誓清逆贼，兴复汉室。 决策理由：宛城本回合可被曹魏攻占，亟需增兵固守，强征兵力巩固前线；招回被俘旧将张飞，收拢军心，强化战力。；密谋揭晓：无隐秘意图"},{"id":24860,"turn":43,"type":"decision_revealed","factionId":"wu","message":"吴：柴桑既定，江东已固。今调兵充实都城，蓄势待发，与魏公分进合击，共图蜀寇。 决策理由：柴桑克后六兵在手，建业仅一兵偏弱。调四兵充实都城，留二兵守柴桑以御江州之敌。盟约本回合到期，须续约以保攻蜀大局，故提议与魏联合攻蜀。；密谋揭晓：准备守约"},{"id":24861,"turn":43,"type":"joint_attack_proposed","factionId":"wei","message":"魏 向 吴 提议共同进攻 蜀"},{"id":24862,"turn":43,"type":"joint_attack_proposed","factionId":"wu","message":"吴 向 魏 提议共同进攻 蜀"},{"id":24863,"turn":43,"type":"forced_levy","factionId":"shu","message":"蜀 在宛城强征 3 兵力，城市发展受损"},{"id":24864,"turn":43,"type":"attack_repulsed","factionId":"wei","message":"魏 进攻宛城失败，进攻方损失 3，守方损失 2，围城进度升至 1/3","payload":{"sourceCityId":"luoyang","targetCityId":"wancheng","troops":4}},{"id":24865,"turn":43,"type":"transfer","factionId":"wu","message":"吴 从柴桑向建业调动 4 兵力","payload":{"sourceCityId":"chaisang","targetCityId":"jianye","troops":4}},{"id":24866,"turn":44,"type":"alliance_expired","factionId":null,"message":"魏 与 吴 的同盟到期"},{"id":24867,"turn":44,"type"
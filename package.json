{
  "name": "sanguo-llm-game",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev -w @sanguo/server\" \"npm run dev -w @sanguo/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start -w @sanguo/server"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
